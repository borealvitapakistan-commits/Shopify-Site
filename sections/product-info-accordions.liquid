    {
      "type": "text",
      "id": "supplement_facts_metafield",
      "label": "Supplement facts image metafield (namespace.key)",
      "info": "Example: health.supplement_facts_image"
    },
    {
      "type": "text",
      "id": "directions_metafield",
      "label": "Directions metafield (namespace.key)",
      "info": "Example: health.directions"
    },
    {
      "type": "text",
      "id": "warnings_metafield",
      "label": "Warnings / disclaimer metafield (namespace.key)",
      "info": "Example: health.warnings"
    },
    {
      "type": "text",
