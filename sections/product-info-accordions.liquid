<script>
  document.addEventListener('DOMContentLoaded', function() {
    var tabSections = document.querySelectorAll('[data-product-info-tabs]');

    tabSections.forEach(function(section) {
      var tabs = Array.prototype.slice.call(section.querySelectorAll('[data-product-info-tab]'));
      var panels = Array.prototype.slice.call(section.querySelectorAll('[data-product-info-panel]'));

      tabs.forEach(function(tab) {
        tab.addEventListener('click', function() {
          var target = tab.getAttribute('data-product-info-tab');

          tabs.forEach(function(item) {
            var isActive = item === tab;
            item.classList.toggle('is-active', isActive);
            item.setAttribute('aria-selected', isActive ? 'true' : 'false');
          });

          panels.forEach(function(panel) {
            var isActive = panel.getAttribute('data-product-info-panel') === target;
            panel.classList.toggle('is-active', isActive);
            panel.hidden = !isActive;
          });
        });
      });

      var showcases = Array.prototype.slice.call(section.querySelectorAll('[data-pdp-ingredients-showcase]'));

      showcases.forEach(function(showcase) {
        var track = showcase.querySelector('[data-pdp-ingredient-track]');
        var prevButtons = Array.prototype.slice.call(showcase.querySelectorAll('[data-pdp-ingredients-prev]'));
        var nextButtons = Array.prototype.slice.call(showcase.querySelectorAll('[data-pdp-ingredients-next], [data-pdp-ingredients-more]'));
        var controls = showcase.querySelector('[data-pdp-ingredients-controls]');
        var dotsWrap = showcase.querySelector('[data-pdp-ingredients-dots]');
        var detailBox = showcase.querySelector('[data-pdp-ingredient-detail]');
        var detailContent = showcase.querySelector('[data-pdp-ingredient-detail-content]');
        var closeDetail = showcase.querySelector('[data-pdp-ingredient-close]');
        var ingredientButtons = Array.prototype.slice.call(showcase.querySelectorAll('[data-pdp-ingredient-toggle]'));
        var cards = Array.prototype.slice.call(showcase.querySelectorAll('[data-pdp-ingredient-card]'));
        var dots = [];

        var getStep = function() {
          var card = cards[0];
          var gap = track ? parseFloat(window.getComputedStyle(track).gap || '0') : 0;
          return card ? (card.getBoundingClientRect().width + gap) : (track ? track.clientWidth : 0);
        };

        var getPageCount = function() {
          if (!track) return 1;
          var step = getStep();
          if (!step) return 1;
          return Math.max(1, Math.ceil((track.scrollWidth - track.clientWidth) / step) + 1);
        };

        var renderDots = function() {
          if (!dotsWrap || !track) return;
          var pageCount = getPageCount();
          dotsWrap.innerHTML = '';
          dots = [];
          for (var index = 0; index < pageCount; index += 1) {
            var dot = document.createElement('button');
            dot.type = 'button';
            dot.className = 'product-ingredients-showcase__dot';
            dot.setAttribute('aria-label', 'Go to ingredient page ' + (index + 1));
            dot.dataset.index = String(index);
            dot.addEventListener('click', function() {
              track.scrollTo({ left: Number(this.dataset.index) * getStep(), behavior: 'smooth' });
            });
            dotsWrap.appendChild(dot);
            dots.push(dot);
          }
        };

        var updateControls = function() {
          if (!track) return;
          var hasOverflow = track.scrollWidth > track.clientWidth + 8;
          if (controls) controls.hidden = !hasOverflow;
          prevButtons.concat(nextButtons).forEach(function(button) {
            button.hidden = !hasOverflow;
          });

          var maxScroll = Math.max(0, track.scrollWidth - track.clientWidth);
          var atStart = track.scrollLeft <= 2;
          var atEnd = track.scrollLeft >= maxScroll - 2;
          prevButtons.forEach(function(button) { button.disabled = atStart; });
          nextButtons.forEach(function(button) { button.disabled = atEnd; });

          var step = getStep();
          var activeIndex = step ? Math.round(track.scrollLeft / step) : 0;
          dots.forEach(function(dot, index) {
            dot.classList.toggle('is-active', index === activeIndex);
          });
        };

        var refreshCarousel = function() {
          renderDots();
          updateControls();
        };

        prevButtons.forEach(function(button) {
          button.addEventListener('click', function() {
            if (!track) return;
            track.scrollBy({ left: -getStep(), behavior: 'smooth' });
          });
        });

        nextButtons.forEach(function(button) {
          button.addEventListener('click', function() {
            if (!track) return;
            track.scrollBy({ left: getStep(), behavior: 'smooth' });
          });
        });

        if (track) {
          track.addEventListener('scroll', updateControls);
        }

        var hideDetail = function() {
          if (!detailBox) return;
          detailBox.hidden = true;
          if (detailContent) detailContent.innerHTML = '';
          ingredientButtons.forEach(function(item) {
            item.classList.remove('is-active');
          });
        };

        ingredientButtons.forEach(function(button) {
          button.addEventListener('click', function() {
            var card = button.closest('[data-pdp-ingredient-card]');
            var description = card ? card.querySelector('.pdp-ingredient-card__description') : null;
            if (!description || !detailBox || !detailContent) return;

            if (!detailBox.hidden && button.classList.contains('is-active')) {
              hideDetail();
              return;
            }

            detailContent.innerHTML = description.innerHTML;
            detailBox.hidden = false;
            ingredientButtons.forEach(function(item) {
              item.classList.toggle('is-active', item === button);
            });
          });
        });

        if (closeDetail) {
          closeDetail.addEventListener('click', hideDetail);
        }

        refreshCarousel();
        window.addEventListener('resize', refreshCarousel);
      });
    });
  });
</script>

