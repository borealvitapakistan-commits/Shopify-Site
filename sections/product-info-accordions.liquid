{%- comment -%}
  Product information tabs
  - Reference-style tabbed card for features, ingredients, and directions
{%- endcomment -%}

{% assign ingredients_value = product.metafields.custom.ingredients %}
{% if ingredients_value == blank %}
  {% assign ingredients_value = product.metafields.health.ingredients %}
{% endif %}

{% assign supplement_value = product.metafields.custom.supplement_facts_image %}
{% if supplement_value == blank %}
  {% assign supplement_value = product.metafields.health.supplement_facts_image %}
{% endif %}

{% assign directions_value = product.metafields.custom.directions %}
{% if directions_value == blank %}
  {% assign directions_value = product.metafields.health.directions %}
{% endif %}

{% assign recommended_use = product.metafields.custom.recommended_use %}
{% if recommended_use == blank %}
  {% assign recommended_use = product.metafields.health.recommended_use %}
{% endif %}

{% assign warnings_value = product.metafields.custom.warnings %}
{% if warnings_value == blank %}
  {% assign warnings_value = product.metafields.health.warnings %}
{% endif %}
{% if warnings_value == blank %}
  {% assign warnings_value = product.metafields.custom.legal_disclaimer %}
{% endif %}

{% assign storage_value = product.metafields.custom.storage %}
{% if storage_value == blank %}
  {% assign storage_value = product.metafields.health.storage %}
{% endif %}

{% assign benefits_value = product.metafields.custom.benefits %}
{% if benefits_value == blank %}
  {% assign benefits_value = product.metafields.health.benefits %}
{% endif %}

{% assign bullet_points = product.metafields.custom.bullet_points.value %}
{% assign is_allergy_relief = false %}
{% if product.handle == 'allergy-relief-capsule-120-vegetarian-capsules' or product.title contains 'Allergy Relief' %}
  {% assign is_allergy_relief = true %}
{% endif %}

{% capture ingredient_search_source %}
  {{ product.title }}
  {{ product.description | strip_html }}
  {% if ingredients_value != blank %}
    {% if ingredients_value.value != blank %}
      {{ ingredients_value | metafield_tag | strip_html }}
    {% else %}
      {{ ingredients_value | strip_html }}
    {% endif %}
  {% endif %}
{% endcapture %}
{% assign ingredient_search_source = ingredient_search_source | downcase %}

{% capture detected_ingredient_cards %}
  {% if ingredient_search_source contains 'punarnava' %}
    <article class="pdp-ingredient-card" data-pdp-ingredient-card>
      <div class="pdp-ingredient-card__visual" data-initials="P"><span aria-hidden="true"></span></div>
      <h4>Punarnava</h4>
      <button type="button" class="pdp-ingredient-card__more" data-pdp-ingredient-toggle>Read More for Ingredients</button>
      <div class="pdp-ingredient-card__description" hidden>
        <strong>Punarnava:</strong> Traditionally used to support healthy fluid balance, kidney comfort, and the body's natural detoxification process.
      </div>
    </article>
  {% endif %}
  {% if ingredient_search_source contains 'gokhru' or ingredient_search_source contains 'gokshura' or ingredient_search_source contains 'tribulus terrestris' %}
    <article class="pdp-ingredient-card" data-pdp-ingredient-card>
      <div class="pdp-ingredient-card__visual" data-initials="G"><span aria-hidden="true"></span></div>
      <h4>Gokhru</h4>
      <button type="button" class="pdp-ingredient-card__more" data-pdp-ingredient-toggle>Read More for Ingredients</button>
      <div class="pdp-ingredient-card__description" hidden>
        <strong>Gokhru:</strong> A valued herbal ingredient used to support urinary wellness, vitality, and normal kidney function.
      </div>
    </article>
  {% endif %}
  {% if ingredient_search_source contains 'varuna' %}
    <article class="pdp-ingredient-card" data-pdp-ingredient-card>
      <div class="pdp-ingredient-card__visual" data-initials="V"><span aria-hidden="true"></span></div>
      <h4>Varuna</h4>
      <button type="button" class="pdp-ingredient-card__more" data-pdp-ingredient-toggle>Read More for Ingredients</button>
      <div class="pdp-ingredient-card__description" hidden>
        <strong>Varuna:</strong> Traditionally used in herbal wellness to support urinary tract comfort and the body's natural cleansing pathways.
      </div>
    </article>
  {% endif %}
  {% if ingredient_search_source contains 'juglans nigra' or ingredient_search_source contains 'black walnut' %}
    <article class="pdp-ingredient-card" data-pdp-ingredient-card>
      <div class="pdp-ingredient-card__visual" data-initials="BW"><span aria-hidden="true"></span></div>
      <h4>Black Walnut</h4>
      <button type="button" class="pdp-ingredient-card__more" data-pdp-ingredient-toggle>Read More for Ingredients</button>
      <div class="pdp-ingredient-card__description" hidden>
        <strong>Black Walnut:</strong> Supports seasonal wellness with naturally occurring plant compounds traditionally associated with immune and digestive support.
      </div>
    </article>
  {% endif %}
  {% if ingredient_search_source contains 'matricaria chamomilla' or ingredient_search_source contains 'chamomile' %}
    <article class="pdp-ingredient-card" data-pdp-ingredient-card>
      <div class="pdp-ingredient-card__visual" data-initials="C"><span aria-hidden="true"></span></div>
      <h4>Chamomile</h4>
      <button type="button" class="pdp-ingredient-card__more" data-pdp-ingredient-toggle>Read More for Ingredients</button>
      <div class="pdp-ingredient-card__description" hidden>
        <strong>Chamomile:</strong> Known for its calming profile, chamomile helps support comfort during seasonal sensitivity and general wellness routines.
      </div>
    </article>
  {% endif %}
  {% if ingredient_search_source contains 'sambucus nigra' or ingredient_search_source contains 'black elderberry' or ingredient_search_source contains 'elderberry' %}
    <article class="pdp-ingredient-card" data-pdp-ingredient-card>
      <div class="pdp-ingredient-card__visual" data-initials="E"><span aria-hidden="true"></span></div>
      <h4>Black Elderberry</h4>
      <button type="button" class="pdp-ingredient-card__more" data-pdp-ingredient-toggle>Read More for Ingredients</button>
      <div class="pdp-ingredient-card__description" hidden>
        <strong>Black Elderberry:</strong> A botanical ingredient often used to support immune resilience and respiratory-season wellness.
      </div>
    </article>
  {% endif %}
  {% if ingredient_search_source contains 'scutellaria baicalensis' or ingredient_search_source contains 'baical skullcap' or ingredient_search_source contains 'skullcap' %}
    <article class="pdp-ingredient-card" data-pdp-ingredient-card>
      <div class="pdp-ingredient-card__visual" data-initials="S"><span aria-hidden="true"></span></div>
      <h4>Baical Skullcap</h4>
      <button type="button" class="pdp-ingredient-card__more" data-pdp-ingredient-toggle>Read More for Ingredients</button>
      <div class="pdp-ingredient-card__description" hidden>
        <strong>Baical Skullcap:</strong> Traditionally used for antioxidant support and comfort during seasonal or environmental sensitivity.
      </div>
    </article>
  {% endif %}
  {% if ingredient_search_source contains 'urtica dioica' or ingredient_search_source contains 'nettle' %}
    <article class="pdp-ingredient-card" data-pdp-ingredient-card>
      <div class="pdp-ingredient-card__visual" data-initials="N"><span aria-hidden="true"></span></div>
      <h4>Nettle</h4>
      <button type="button" class="pdp-ingredient-card__more" data-pdp-ingredient-toggle>Read More for Ingredients</button>
      <div class="pdp-ingredient-card__description" hidden>
        <strong>Nettle:</strong> A mineral-rich herb commonly used to support respiratory comfort and balanced seasonal response.
      </div>
    </article>
  {% endif %}
  {% if ingredient_search_source contains 'vitamin c' or ingredient_search_source contains 'ascorbic' %}
    <article class="pdp-ingredient-card" data-pdp-ingredient-card>
      <div class="pdp-ingredient-card__visual" data-initials="C"><span aria-hidden="true"></span></div>
      <h4>Vitamin C</h4>
      <button type="button" class="pdp-ingredient-card__more" data-pdp-ingredient-toggle>Read More for Ingredients</button>
      <div class="pdp-ingredient-card__description" hidden>
        <strong>Vitamin C:</strong> An essential antioxidant that supports immune function and helps protect cells from oxidative stress.
      </div>
    </article>
  {% endif %}
  {% if ingredient_search_source contains 'boswellia' %}
    <article class="pdp-ingredient-card" data-pdp-ingredient-card>
      <div class="pdp-ingredient-card__visual" data-initials="B"><span aria-hidden="true"></span></div>
      <h4>Boswellia</h4>
      <button type="button" class="pdp-ingredient-card__more" data-pdp-ingredient-toggle>Read More for Ingredients</button>
      <div class="pdp-ingredient-card__description" hidden>
        <strong>Boswellia:</strong> A resin-based botanical traditionally used to support joint comfort, mobility, and inflammatory balance.
      </div>
    </article>
  {% endif %}
  {% if ingredient_search_source contains 'curcumin' or ingredient_search_source contains 'turmeric' %}
    <article class="pdp-ingredient-card" data-pdp-ingredient-card>
      <div class="pdp-ingredient-card__visual" data-initials="T"><span aria-hidden="true"></span></div>
      <h4>Turmeric</h4>
      <button type="button" class="pdp-ingredient-card__more" data-pdp-ingredient-toggle>Read More for Ingredients</button>
      <div class="pdp-ingredient-card__description" hidden>
        <strong>Turmeric:</strong> Provides curcuminoids that support antioxidant activity, joint comfort, and everyday wellness.
      </div>
    </article>
  {% endif %}
  {% if ingredient_search_source contains 'ashwagandha' %}
    <article class="pdp-ingredient-card" data-pdp-ingredient-card>
      <div class="pdp-ingredient-card__visual" data-initials="A"><span aria-hidden="true"></span></div>
      <h4>Ashwagandha</h4>
      <button type="button" class="pdp-ingredient-card__more" data-pdp-ingredient-toggle>Read More for Ingredients</button>
      <div class="pdp-ingredient-card__description" hidden>
        <strong>Ashwagandha:</strong> An adaptogenic herb used to support stress balance, calm energy, and overall vitality.
      </div>
    </article>
  {% endif %}
  {% if ingredient_search_source contains 'shilajit' %}
    <article class="pdp-ingredient-card" data-pdp-ingredient-card>
      <div class="pdp-ingredient-card__visual" data-initials="S"><span aria-hidden="true"></span></div>
      <h4>Shilajit</h4>
      <button type="button" class="pdp-ingredient-card__more" data-pdp-ingredient-toggle>Read More for Ingredients</button>
      <div class="pdp-ingredient-card__description" hidden>
        <strong>Shilajit:</strong> A mineral-rich resin traditionally used to support stamina, energy, and daily performance.
      </div>
    </article>
  {% endif %}
  {% if ingredient_search_source contains 'milk thistle' or ingredient_search_source contains 'silybum' %}
    <article class="pdp-ingredient-card" data-pdp-ingredient-card>
      <div class="pdp-ingredient-card__visual" data-initials="M"><span aria-hidden="true"></span></div>
      <h4>Milk Thistle</h4>
      <button type="button" class="pdp-ingredient-card__more" data-pdp-ingredient-toggle>Read More for Ingredients</button>
      <div class="pdp-ingredient-card__description" hidden>
        <strong>Milk Thistle:</strong> Known for silymarin, milk thistle is commonly used to support liver health and antioxidant protection.
      </div>
    </article>
  {% endif %}
  {% if ingredient_search_source contains 'dandelion' %}
    <article class="pdp-ingredient-card" data-pdp-ingredient-card>
      <div class="pdp-ingredient-card__visual" data-initials="D"><span aria-hidden="true"></span></div>
      <h4>Dandelion</h4>
      <button type="button" class="pdp-ingredient-card__more" data-pdp-ingredient-toggle>Read More for Ingredients</button>
      <div class="pdp-ingredient-card__description" hidden>
        <strong>Dandelion:</strong> Traditionally used to support digestion, fluid balance, and natural detoxification.
      </div>
    </article>
  {% endif %}
{% endcapture %}
{% assign detected_ingredient_cards_clean = detected_ingredient_cards | strip %}

{% if section.settings.ingredients_metafield != blank %}
  {% assign parts = section.settings.ingredients_metafield | split: '.' %}
  {% assign ns = parts[0] %}
  {% assign key = parts[1] %}
  {% if ns != blank and key != blank and product.metafields[ns][key] != blank %}
    {% assign ingredients_value = product.metafields[ns][key] %}
  {% endif %}
{% endif %}

{% if section.settings.supplement_facts_metafield != blank %}
  {% assign parts = section.settings.supplement_facts_metafield | split: '.' %}
  {% assign ns = parts[0] %}
  {% assign key = parts[1] %}
  {% if ns != blank and key != blank and product.metafields[ns][key] != blank %}
    {% assign supplement_value = product.metafields[ns][key] %}
  {% endif %}
{% endif %}

{% if section.settings.directions_metafield != blank %}
  {% assign parts = section.settings.directions_metafield | split: '.' %}
  {% assign ns = parts[0] %}
  {% assign key = parts[1] %}
  {% if ns != blank and key != blank and product.metafields[ns][key] != blank %}
    {% assign directions_value = product.metafields[ns][key] %}
  {% endif %}
{% endif %}

{% if section.settings.warnings_metafield != blank %}
  {% assign parts = section.settings.warnings_metafield | split: '.' %}
  {% assign ns = parts[0] %}
  {% assign key = parts[1] %}
  {% if ns != blank and key != blank and product.metafields[ns][key] != blank %}
    {% assign warnings_value = product.metafields[ns][key] %}
  {% endif %}
{% endif %}

<section class="product-information-layout" id="ProductInfoTabs-{{ section.id }}" data-product-info-tabs>
  <div class="container">
    {% if is_allergy_relief %}
      <article class="product-facts-panel" aria-labelledby="ProductFactsHeading-{{ section.id }}">
        <div class="product-facts-panel__header">
          <p>Product Facts</p>
          <h2 id="ProductFactsHeading-{{ section.id }}">Allergy Relief label, rebuilt for the web</h2>
          <p>
            The physical bottle information is carried into a readable web panel with a semantic ingredient table,
            clear label claims, cautions, and Health Canada NPN context.
          </p>
        </div>

        <dl class="product-facts-panel__meta" aria-label="Label summary">
          <div>
            <dt>NPN</dt>
            <dd>80134953</dd>
          </div>
          <div>
            <dt>Format</dt>
            <dd>120 Vegetarian Capsules</dd>
          </div>
          <div>
            <dt>Strength</dt>
            <dd>405 mg per capsule</dd>
          </div>
          <div>
            <dt>Origin</dt>
            <dd>Made in Canada</dd>
          </div>
        </dl>

        <div class="product-facts-panel__table-wrap">
          <table class="product-facts-panel__table">
            <caption>Medicinal ingredients per capsule</caption>
            <thead>
              <tr>
                <th scope="col">Medicinal ingredient</th>
                <th scope="col">Amount</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <th scope="row">Nettle</th>
                <td>150 mg</td>
              </tr>
              <tr>
                <th scope="row">Black elder</th>
                <td>90 mg</td>
              </tr>
              <tr>
                <th scope="row">Black Walnut</th>
                <td>45 mg</td>
              </tr>
              <tr>
                <th scope="row">Blue chamomile</th>
                <td>45 mg</td>
              </tr>
              <tr>
                <th scope="row">Huang qin</th>
                <td>45 mg</td>
              </tr>
              <tr>
                <th scope="row">Vitamin C</th>
                <td>30 mg</td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="product-facts-panel__detail-grid">
          <section class="product-facts-panel__detail" aria-labelledby="ProductFactsClaims-{{ section.id }}">
            <h3 id="ProductFactsClaims-{{ section.id }}">Label claims</h3>
            <ul>
              <li>Used in herbal medicine to relieve seasonal allergy symptoms.</li>
              <li>Supports immune function.</li>
              <li>Helps reduce oxidative damage caused by free radicals.</li>
              <li>Provides antioxidants that protect cells.</li>
            </ul>
          </section>

          <section class="product-facts-panel__detail" aria-labelledby="ProductFactsNonMedicinal-{{ section.id }}">
            <h3 id="ProductFactsNonMedicinal-{{ section.id }}">Non-medicinal ingredients</h3>
            <p>Vegetarian capsule shell.</p>
          </section>

          <section class="product-facts-panel__detail product-facts-panel__detail--caution" aria-labelledby="ProductFactsCautions-{{ section.id }}">
            <h3 id="ProductFactsCautions-{{ section.id }}">Cautions and warnings</h3>
            <ul>
              <li>Consult a healthcare practitioner before use if you are pregnant, nursing, taking medication, or managing a medical condition.</li>
              <li>Stop use if hypersensitivity or an allergic reaction occurs.</li>
              <li>Keep out of reach of children.</li>
              <li>Store sealed in a cool, dry place.</li>
            </ul>
          </section>

          <section class="product-facts-panel__detail" aria-labelledby="ProductFactsCredibility-{{ section.id }}">
            <h3 id="ProductFactsCredibility-{{ section.id }}">Credibility</h3>
            <ul>
              <li>Health Canada NPN 80134953.</li>
              <li>Made in Canada credibility carried from bottle to screen.</li>
              <li>Teal and gold label cues match the physical Boreal Vita pack.</li>
            </ul>
          </section>
        </div>
      </article>
    {% endif %}

    <div class="product-information-layout__shell">
      <div class="product-information-layout__tabs" role="tablist" aria-label="{{ product.title | escape }} information">
        <button
          class="product-information-layout__tab is-active"
          type="button"
          id="ProductInfoTab-{{ section.id }}-ingredients"
          role="tab"
          aria-selected="true"
          aria-controls="ProductInfoPanel-{{ section.id }}-ingredients"
          data-product-info-tab="ingredients"
        >
          Ingredients
        </button>
        <button
          class="product-information-layout__tab"
          type="button"
          id="ProductInfoTab-{{ section.id }}-features"
          role="tab"
          aria-selected="false"
          aria-controls="ProductInfoPanel-{{ section.id }}-features"
          data-product-info-tab="features"
        >
          Features &amp; Benefits
        </button>
        <button
          class="product-information-layout__tab"
          type="button"
          id="ProductInfoTab-{{ section.id }}-directions"
          role="tab"
          aria-selected="false"
          aria-controls="ProductInfoPanel-{{ section.id }}-directions"
          data-product-info-tab="directions"
        >
          Directions
        </button>
      </div>

      <div class="product-information-layout__content">
        <div
          class="product-information-layout__panel product-information-layout__panel--ingredients is-active"
          id="ProductInfoPanel-{{ section.id }}-ingredients"
          role="tabpanel"
          aria-labelledby="ProductInfoTab-{{ section.id }}-ingredients"
          data-product-info-panel="ingredients"
        >
          <div class="product-ingredients-showcase" data-pdp-ingredients-showcase>
            <div class="product-ingredients-showcase__header">
              <h3>Nature's Best for {{ product.title | escape }}</h3>
              <p>
                Each ingredient is selected to support your wellness routine with clean, purposeful herbal nutrition.
                Tap any ingredient to learn how it helps.
              </p>
            </div>

            <div class="product-ingredients-showcase__viewport">
              <button type="button" class="product-ingredients-showcase__arrow product-ingredients-showcase__arrow--prev" aria-label="Previous ingredients" data-pdp-ingredients-prev>
                <span aria-hidden="true">&#8249;</span>
              </button>
              <div class="product-ingredients-showcase__grid" data-pdp-ingredient-track>
                {% if detected_ingredient_cards_clean != blank %}
                  {{ detected_ingredient_cards }}
                {% else %}
                  <article class="pdp-ingredient-card" data-pdp-ingredient-card>
                    <div class="pdp-ingredient-card__visual" data-initials="BV"><span aria-hidden="true"></span></div>
                    <h4>Herbal Blend</h4>
                    <button type="button" class="pdp-ingredient-card__more" data-pdp-ingredient-toggle>Read More for Ingredients</button>
                    <div class="pdp-ingredient-card__description" hidden>
                      <strong>Herbal Blend:</strong> This product uses a purposeful herbal blend selected to support everyday wellness.
                    </div>
                  </article>
                {% endif %}
              </div>
              <button type="button" class="product-ingredients-showcase__arrow product-ingredients-showcase__arrow--next" aria-label="Next ingredients" data-pdp-ingredients-next>
                <span aria-hidden="true">&#8250;</span>
              </button>
            </div>

            <div class="product-ingredients-showcase__controls" data-pdp-ingredients-controls>
              <button type="button" class="product-ingredients-showcase__control" aria-label="Previous ingredients" data-pdp-ingredients-prev>Prev</button>
              <div class="product-ingredients-showcase__dots" aria-label="Ingredient carousel pages" data-pdp-ingredients-dots></div>
              <button type="button" class="product-ingredients-showcase__control" aria-label="More ingredients" data-pdp-ingredients-more>More</button>
            </div>

            <div class="product-ingredients-showcase__detail" data-pdp-ingredient-detail hidden>
              <button type="button" class="product-ingredients-showcase__detail-close" aria-label="Close ingredient details" data-pdp-ingredient-close>X</button>
              <div data-pdp-ingredient-detail-content></div>
            </div>
          </div>

          {% if ingredients_value != blank %}
            <div class="product-information-layout__block product-information-layout__block--ingredients rte">
              <h3>Full Ingredient Details</h3>
              {% if ingredients_value.value != blank %}
                {{ ingredients_value | metafield_tag }}
              {% else %}
                {{ ingredients_value }}
              {% endif %}
            </div>
          {% else %}
          {% endif %}

          {% if supplement_value != blank %}
            <div class="product-information-layout__block">
              <h3>Supplement Facts</h3>
              <div class="product-information-layout__image">
                <img
                  src="{{ supplement_value | image_url: width: 1200 }}"
                  alt="{{ product.title | escape }} supplement facts"
                  width="{{ supplement_value.width | default: 1200 }}"
                  height="{{ supplement_value.height | default: 1200 }}"
                  loading="lazy"
                >
              </div>
            </div>
          {% endif %}
        </div>

        <div
          class="product-information-layout__panel"
          id="ProductInfoPanel-{{ section.id }}-features"
          role="tabpanel"
          aria-labelledby="ProductInfoTab-{{ section.id }}-features"
          hidden
          data-product-info-panel="features"
        >
          {% if benefits_value != blank %}
            <div class="product-information-layout__block rte">
              <h3>Features &amp; Benefits</h3>
              {% if benefits_value.value != blank %}
                {{ benefits_value | metafield_tag }}
              {% else %}
                {{ benefits_value }}
              {% endif %}
            </div>
          {% endif %}

          {% if bullet_points != blank %}
            <div class="product-information-layout__block">
              <h3>Key Benefits</h3>
              <ul class="product-information-layout__bullets">
                {% for item in bullet_points %}
                  <li>{{ item }}</li>
                {% endfor %}
              </ul>
            </div>
          {% elsif product.description != blank %}
            <div class="product-information-layout__block rte">
              <h3>Product Details</h3>
              {{ product.description }}
            </div>
          {% elsif benefits_value == blank %}
            <div class="product-information-layout__block">
              <h3>Product Details</h3>
              <p>Product benefits and details are listed on the product label.</p>
            </div>
          {% endif %}
        </div>

        <div
          class="product-information-layout__panel"
          id="ProductInfoPanel-{{ section.id }}-directions"
          role="tabpanel"
          aria-labelledby="ProductInfoTab-{{ section.id }}-directions"
          hidden
          data-product-info-panel="directions"
        >
          <div class="product-directions-guide">
            <div class="product-directions-guide__header">
              <span>How To Use</span>
              <h3>Achieve Better Wellness in <em>3 Steps</em></h3>
            </div>

            <div class="product-directions-guide__steps">
              <article class="product-directions-guide__step">
                <div class="product-directions-guide__visual" aria-hidden="true">
                  <span class="product-directions-guide__number">1</span>
                  <svg viewBox="0 0 120 120" fill="none">
                    <rect x="28" y="55" width="64" height="22" rx="11" transform="rotate(-18 28 55)" fill="currentColor" opacity="0.16"></rect>
                    <rect x="37" y="45" width="46" height="18" rx="9" transform="rotate(18 37 45)" fill="currentColor" opacity="0.25"></rect>
                    <path d="M32 84c18-12 38-16 58-8" stroke="currentColor" stroke-width="4" stroke-linecap="round" opacity="0.55"></path>
                  </svg>
                </div>
                <h4>Dosage</h4>
                <p>Follow the serving size on the product label or your healthcare practitioner's advice.</p>
              </article>

              <article class="product-directions-guide__step">
                <div class="product-directions-guide__visual" aria-hidden="true">
                  <span class="product-directions-guide__number">2</span>
