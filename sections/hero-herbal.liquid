<section class="section hero">
  <div class="container">
    <div class="hero-grid">
      <div class="hero-main reveal">
        {% if section.settings.badge_text != blank %}
          <span class="badge sun">{{ section.settings.badge_text }}</span>
        {% endif %}
        <div class="hero-content">
          <h1>{{ section.settings.heading }}</h1>
          <p>{{ section.settings.subheading }}</p>
          {% if section.settings.button_label != blank %}
            <a class="button" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
          {% endif %}
        </div>
        {% if section.settings.image != blank %}
          <div class="hero-image" style="margin-top: 18px;">
            <img
              src="{{ section.settings.image | image_url: width: 900 }}"
              alt="{{ section.settings.heading }}"
              width="{{ section.settings.image.width }}"
              height="{{ section.settings.image.height }}"
            >
          </div>
        {% endif %}
      </div>

      <div class="hero-aside">
        {% for block in section.blocks %}
          <div class="hero-card reveal delay-{{ forloop.index }}">
            <span class="badge">{{ block.settings.tag }}</span>
            <div class="title">{{ block.settings.title }}</div>
            <p>{{ block.settings.text }}</p>
            {% if block.settings.button_label != blank %}
              <a class="button secondary" href="{{ block.settings.button_link }}">{{ block.settings.button_label }}</a>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero herbal",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge",
      "default": "New harvest"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Herbal essentials for everyday calm"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Crafted tinctures, teas, and botanicals sourced from regenerative farms."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop best sellers"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    }
  ],
  "blocks": [
    {
      "type": "side_card",
      "name": "Side card",
      "settings": [
        {
          "type": "text",
          "id": "tag",
          "label": "Tag",
          "default": "Seasonal"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Immune support blends"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Warming herbs for the colder months."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop blends"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "max_blocks": 2,
  "presets": [
    {
      "name": "Hero herbal",
      "blocks": [
        { "type": "side_card" },
        { "type": "side_card" }
      ]
    }
  ]
}
{% endschema %}
