{%- comment -%}
  Custom About Footer (NB style structure)
  Intended for the About Us template.
{%- endcomment -%}

<footer class="about-footer" id="AboutFooter-{{ section.id }}">
  <div class="container">
    <div class="about-footer__newsletter">
      <div class="about-footer__newsletter-copy">
        {% if section.settings.newsletter_heading != blank %}
          <h2>{{ section.settings.newsletter_heading }}</h2>
        {% endif %}
        {% if section.settings.newsletter_text != blank %}
          <p>{{ section.settings.newsletter_text }}</p>
        {% endif %}
      </div>

      {% form 'customer', class: 'about-footer__newsletter-form' %}
        {% if form.posted_successfully? %}
          <p class="about-footer__form-note">{{ section.settings.newsletter_success | default: 'Thanks for subscribing.' }}</p>
        {% else %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label class="visually-hidden" for="AboutFooterEmail-{{ section.id }}">Email</label>
          <div class="about-footer__newsletter-fields">
            <input
              id="AboutFooterEmail-{{ section.id }}"
              type="email"
              name="contact[email]"
              placeholder="{{ section.settings.newsletter_placeholder | default: 'Enter your email' }}"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              required
            >
            <button type="submit" class="about-btn about-btn--primary">
              {{ section.settings.newsletter_button | default: 'Sign up' }}
            </button>
          </div>
          {% if form.errors %}
            <p class="about-footer__form-note">{{ form.errors | default_errors }}</p>
          {% endif %}
        {% endif %}
      {% endform %}
    </div>

    <div class="about-footer__columns">
      <div class="about-footer__col">
        <h3>{{ section.settings.products_title | default: 'Products' }}</h3>
        <ul>
          {% for link in linklists[section.settings.products_menu].links %}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {% endfor %}
        </ul>
      </div>

      <div class="about-footer__col">
        <h3>{{ section.settings.health_title | default: 'Health Needs' }}</h3>
        <ul>
          {% for link in linklists[section.settings.health_menu].links %}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {% endfor %}
        </ul>
      </div>

      <div class="about-footer__col">
        <h3>{{ section.settings.resource_title | default: 'Resource Center' }}</h3>
        <ul>
          {% for link in linklists[section.settings.resource_menu].links %}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {% endfor %}
        </ul>
      </div>

      <div class="about-footer__col">
        <h3>{{ section.settings.company_title | default: 'Company' }}</h3>
        <ul>
          {% for link in linklists[section.settings.company_menu].links %}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {% endfor %}
        </ul>
      </div>
    </div>

    <div class="about-footer__social">
      {% if settings.social_facebook_url != blank %}
        <a href="{{ settings.social_facebook_url }}" aria-label="Facebook" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
        </a>
      {% endif %}
      {% if settings.social_instagram_url != blank %}
        <a href="{{ settings.social_instagram_url }}" aria-label="Instagram" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
        </a>
      {% endif %}
      {% if settings.social_twitter_url != blank %}
        <a href="{{ settings.social_twitter_url }}" aria-label="X / Twitter" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"/></svg>
        </a>
      {% endif %}
      {% if settings.social_youtube_url != blank %}
        <a href="{{ settings.social_youtube_url }}" aria-label="YouTube" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.6 3.5 12 3.5 12 3.5s-7.6 0-9.4.6A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.8.6 9.4.6 9.4.6s7.6 0 9.4-.6a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8zM9.6 15.8V8.2L16 12z"/></svg>
        </a>
      {% endif %}
    </div>

    <div class="about-footer__legal">
      {% for link in linklists[section.settings.legal_menu].links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </div>

    <div class="about-footer__disclaimer">
      {% if section.settings.disclaimer != blank %}
        {{ section.settings.disclaimer }}
      {% else %}
        <p>Statements on this site have not been evaluated by the Food and Drug Administration. Products are not intended to diagnose, treat, cure, or prevent any disease.</p>
      {% endif %}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Custom Footer NB Style",
  "tag": "section",
  "class": "section-custom-footer-nb-style",
  "settings": [
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "Get wellness updates in your inbox"
    },
    {
      "type": "text",
      "id": "newsletter_text",
      "label": "Newsletter text",
      "default": "Be first to know about product launches, health tips, and exclusive offers."
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Newsletter placeholder",
      "default": "Email address"
    },
    {
      "type": "text",
      "id": "newsletter_button",
      "label": "Newsletter button",
      "default": "Sign up"
    },
    {
      "type": "text",
      "id": "newsletter_success",
      "label": "Newsletter success message",
      "default": "Thanks for subscribing."
    },
    {
      "type": "text",
      "id": "products_title",
      "label": "Products column title",
      "default": "Products"
    },
    {
      "type": "link_list",
      "id": "products_menu",
      "label": "Products menu"
    },
    {
      "type": "text",
      "id": "health_title",
      "label": "Health Needs column title",
      "default": "Health Needs"
    },
    {
      "type": "link_list",
      "id": "health_menu",
      "label": "Health Needs menu"
    },
    {
      "type": "text",
      "id": "resource_title",
      "label": "Resource Center column title",
      "default": "Resource Center"
    },
    {
      "type": "link_list",
      "id": "resource_menu",
      "label": "Resource Center menu"
    },
    {
      "type": "text",
      "id": "company_title",
      "label": "Company column title",
      "default": "Company"
    },
    {
      "type": "link_list",
      "id": "company_menu",
      "label": "Company menu"
    },
    {
      "type": "link_list",
      "id": "legal_menu",
      "label": "Legal links menu"
    },
    {
      "type": "richtext",
      "id": "disclaimer",
      "label": "Disclaimer text",
      "default": "<p>Statements on this site have not been evaluated by the Food and Drug Administration. Products are not intended to diagnose, treat, cure, or prevent any disease.</p>"
    }
  ],
  "presets": [
    {
      "name": "Custom Footer NB Style"
    }
  ]
}
{% endschema %}
