{%- comment -%}
  One main homepage sale banner.
{%- endcomment -%}

{% liquid
  assign sale_product = section.settings.product
  assign fallback_collection = collections[section.settings.collection]

  if sale_product == blank and fallback_collection != blank
    assign sale_product = fallback_collection.products.first
  endif

  assign brand_block_count = 0
  assign feature_block_count = 0

  for block in section.blocks
    if block.type == 'brand'
      assign brand_block_count = brand_block_count | plus: 1
    elsif block.type == 'feature'
      assign feature_block_count = feature_block_count | plus: 1
    endif
  endfor
%}

<section class="homepage-main-sale" id="HomepageMainSale-{{ section.id }}">
  <div class="container homepage-main-sale__container">
    <div class="homepage-main-sale__panel" style="--sale-bg: {{ section.settings.background_color | default: '#15599A' }};">
      <div class="homepage-main-sale__content">
        <div class="homepage-main-sale__heading-row">
          <span class="homepage-main-sale__badge" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M12 3 5 6v5c0 4.5 2.8 8.2 7 10 4.2-1.8 7-5.5 7-10V6l-7-3Z"></path><path d="m8.8 12 2.1 2.1 4.3-4.5"></path></svg>
          </span>
          <div>
            {% if section.settings.eyebrow != blank %}
              <p>{{ section.settings.eyebrow }}</p>
            {% endif %}
            <h2>{{ section.settings.heading }}</h2>
          </div>
        </div>

        {% if section.settings.text != blank %}
          <div class="homepage-main-sale__text">{{ section.settings.text }}</div>
        {% endif %}

        <div class="homepage-main-sale__features">
          {% if feature_block_count > 0 %}
            {% for block in section.blocks %}
              {% if block.type == 'feature' %}
                <article class="homepage-main-sale__feature" {{ block.shopify_attributes }}>
                  <span aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M12 3 5 6v5c0 4.5 2.8 8.2 7 10 4.2-1.8 7-5.5 7-10V6l-7-3Z"></path><path d="m8.8 12 2.1 2.1 4.3-4.5"></path></svg>
                  </span>
                  <p>{{ block.settings.text }}</p>
                </article>
              {% endif %}
            {% endfor %}
          {% else %}
            <article class="homepage-main-sale__feature">
              <span aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M6 18V7a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v11"></path><path d="M9 9h6M9 13h6M8 18h8"></path></svg>
              </span>
              <p>Detailed labels and ingredient transparency</p>
            </article>
            <article class="homepage-main-sale__feature">
              <span aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M9 3v6l-4 7a4 4 0 0 0 3.5 6h7a4 4 0 0 0 3.5-6l-4-7V3"></path><path d="M8 3h8"></path></svg>
              </span>
              <p>Formulated for daily wellness support</p>
            </article>
          {% endif %}
        </div>

        {% if section.settings.button_label != blank %}
          <a class="homepage-main-sale__button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
            {{ section.settings.button_label }}
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg>
          </a>
        {% endif %}
      </div>

      <div class="homepage-main-sale__media">
        {% if section.settings.image != blank %}
          {{
            section.settings.image
            | image_url: width: 1100
            | image_tag:
              loading: 'lazy',
              alt: section.settings.heading
          }}
        {% elsif sale_product != blank and sale_product.featured_image != blank %}
          <a href="{{ sale_product.url }}" aria-label="{{ sale_product.title | escape }}">
            {{
              sale_product.featured_image
              | image_url: width: 900
              | image_tag:
                loading: 'lazy',
                alt: sale_product.title
            }}
          </a>
        {% endif %}
      </div>
    </div>

    <div class="homepage-main-sale__strip" aria-label="Featured brands">
      {% if brand_block_count > 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'brand' %}
            {% assign brand_link = block.settings.link | default: section.settings.button_link | default: routes.all_products_collection_url %}
            <a class="homepage-main-sale__brand" href="{{ brand_link }}" {{ block.shopify_attributes }}>
              {% if block.settings.logo != blank %}
                {{
                  block.settings.logo
                  | image_url: width: 220
                  | image_tag:
                    loading: 'lazy',
                    alt: block.settings.name
                }}
              {% else %}
                <span>{{ block.settings.name }}</span>
              {% endif %}
            </a>
          {% endif %}
        {% endfor %}
      {% else %}
        {% assign fallback_brands = 'Quality|Science|Clean Label|Daily Support|Boreal Vita|Premium' | split: '|' %}
        {% for brand in fallback_brands %}
          <a class="homepage-main-sale__brand" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
            <span>{{ brand }}</span>
          </a>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

<style>
  .homepage-main-sale {
    padding: clamp(1.35rem, 2.6vw, 2.25rem) 0;
    background: #ffffff;
  }

  .homepage-main-sale__container {
    width: min(1280px, calc(100vw - clamp(2rem, 10vw, 11rem)));
    max-width: 1280px;
    padding: 0;
  }

  .homepage-main-sale__panel {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(17rem, 0.9fr);
    min-height: 290px;
    overflow: hidden;
    border-radius: 0.45rem 0.45rem 0 0;
    background: var(--sale-bg);
    color: #ffffff;
  }

  .homepage-main-sale__content {
    display: grid;
    gap: 1rem;
    align-content: center;
    padding: clamp(1.25rem, 2.7vw, 2rem);
  }

  .homepage-main-sale__heading-row {
    display: flex;
    align-items: start;
    gap: 1rem;
  }

  .homepage-main-sale__badge {
    display: grid;
    flex: 0 0 auto;
    width: 2.4rem;
    height: 2.4rem;
    place-items: center;
    color: #ffffff;
  }

  .homepage-main-sale__badge svg,
  .homepage-main-sale__feature svg,
  .homepage-main-sale__button svg {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .homepage-main-sale__badge svg {
    width: 2.15rem;
    height: 2.15rem;
    stroke-width: 1.8;
  }

  .homepage-main-sale__heading-row p {
    margin: 0 0 0.2rem;
    color: rgba(255, 255, 255, 0.82);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.02em;
  }

  .homepage-main-sale__heading-row h2 {
    margin: 0;
    color: #ffffff;
    font-family: var(--font-title, "FuturaBT Bold", "DM Sans", sans-serif);
    font-size: clamp(1.85rem, 3vw, 2.55rem);
    font-weight: 800;
    line-height: 1.04;
  }

  .homepage-main-sale__text {
    max-width: 46rem;
    color: rgba(255, 255, 255, 0.94);
    font-size: clamp(0.95rem, 1vw, 1.05rem);
    font-weight: 700;
    line-height: 1.5;
  }

  .homepage-main-sale__text p {
    margin: 0;
  }

  .homepage-main-sale__features {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 0.1rem;
  }

  .homepage-main-sale__feature {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 0.75rem;
    min-height: 4.8rem;
    padding: 0.75rem 0.9rem;
    border-radius: 0.45rem;
    background: #ffffff;
    color: #111111;
  }

  .homepage-main-sale__feature span {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    color: var(--sale-bg);
  }

  .homepage-main-sale__feature svg {
    width: 1.55rem;
    height: 1.55rem;
    stroke-width: 1.8;
  }

  .homepage-main-sale__feature p {
    margin: 0;
    font-size: 0.92rem;
    font-weight: 650;
    line-height: 1.38;
  }

  .homepage-main-sale__button {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    width: fit-content;
    min-height: 2.35rem;
    padding: 0 1rem;
    border-radius: 999px;
    background: #ffffff;
    color: #111111;
    font-size: 0.88rem;
    font-weight: 800;
    line-height: 1;
    text-decoration: none;
    transition: gap 0.18s ease, transform 0.18s ease;
  }

  .homepage-main-sale__button:hover,
  .homepage-main-sale__button:focus-visible {
    gap: 0.58rem;
    color: #111111;
    outline: none;
    transform: translateY(-1px);
  }

  .homepage-main-sale__button svg {
    width: 1rem;
    height: 1rem;
    stroke-width: 2;
  }

  .homepage-main-sale__media {
    display: grid;
    min-height: 290px;
    place-items: center;
    padding: 1rem;
    background: rgba(255, 255, 255, 0.08);
  }

  .homepage-main-sale__media a {
    display: grid;
    place-items: center;
  }

  .homepage-main-sale__media img {
    display: block;
    width: min(100%, 23rem);
    max-height: 17rem;
    object-fit: contain;
  }

  .homepage-main-sale__strip {
    display: flex;
    gap: 0.8rem;
    overflow-x: auto;
    padding: 1.35rem 1rem;
    border-radius: 0 0 0.45rem 0.45rem;
    background: #eef3f8;
    scrollbar-width: none;
  }

  .homepage-main-sale__strip::-webkit-scrollbar {
    display: none;
  }

  .homepage-main-sale__brand {
    flex: 0 0 7.35rem;
    display: grid;
    height: 7.35rem;
    place-items: center;
    border-radius: 999px;
    background: #ffffff;
    color: #111111;
    text-align: center;
    text-decoration: none;
  }

  .homepage-main-sale__brand img {
    width: 72%;
    height: 72%;
    object-fit: contain;
  }

  .homepage-main-sale__brand span {
    max-width: 80%;
    font-size: 0.9rem;
    font-weight: 800;
    line-height: 1.15;
  }

  @media (max-width: 900px) {
    .homepage-main-sale__container {
      width: min(100%, calc(100vw - 2rem));
    }

    .homepage-main-sale__panel {
      grid-template-columns: 1fr;
    }

    .homepage-main-sale__features {
      grid-template-columns: 1fr;
    }

    .homepage-main-sale__media {
      min-height: 220px;
    }
  }
</style>

{% schema %}
{
  "name": "Homepage main sale",
  "tag": "section",
  "class": "section-homepage-main-sale",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Featured offer"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Professional Brands"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Curated supplements selected for quality, transparency, and daily wellness support.</p>"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Featured product"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Fallback collection"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Optional banner image"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#15599A"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature card",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Detailed labeling and ingredient sourcing information"
        }
      ]
    },
    {
      "type": "brand",
      "name": "Brand chip",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Boreal Vita"
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Homepage main sale",
      "blocks": [
        { "type": "feature" },
        { "type": "feature" },
        { "type": "brand" },
        { "type": "brand" },
        { "type": "brand" }
      ]
    }
  ]
}
{% endschema %}
