<section class="about-intro-section" id="AboutIntro-{{ section.id }}">
  <div class="about-intro-section__hero">
    <div class="about-intro-section__hero-bg" aria-hidden="true">
      {% if section.settings.hero_image != blank %}
        <img
          src="{{ section.settings.hero_image | image_url: width: 2200 }}"
          srcset="
            {{ section.settings.hero_image | image_url: width: 900 }} 900w,
            {{ section.settings.hero_image | image_url: width: 1400 }} 1400w,
            {{ section.settings.hero_image | image_url: width: 1800 }} 1800w,
            {{ section.settings.hero_image | image_url: width: 2200 }} 2200w
          "
          sizes="100vw"
          alt="{{ section.settings.hero_image.alt | default: 'Boreal Vita wellness support' | escape }}"
          width="{{ section.settings.hero_image.width }}"
          height="{{ section.settings.hero_image.height }}"
          loading="eager"
        >
      {% else %}
        <img
          class="about-intro-section__watermark-logo"
          src="{{ 'logo-white-440.png' | asset_url }}"
          alt="Boreal Vita"
          width="1749"
          height="496"
          loading="eager"
        >
      {% endif %}
    </div>
    <div class="about-intro-section__hero-overlay"></div>
    <div class="about-intro-section__hero-copy">
      <p class="about-intro-section__eyebrow">Boreal Vita</p>
      <h1>{{ section.settings.heading | default: page.title }}</h1>
      <div class="about-intro-section__hero-text">
        {% if section.settings.paragraph_1 != blank %}
          <p>{{ section.settings.paragraph_1 | escape }}</p>
        {% endif %}
        {% if section.settings.paragraph_2 != blank %}
          <p>{{ section.settings.paragraph_2 | escape }}</p>
        {% endif %}
      </div>
    </div>
  </div>

  <div class="about-intro-section__content">
    <div class="about-intro-section__inner">
      <section class="about-intro-section__block">
        <div class="about-intro-section__heading-wrap">
          <h2>Why Boreal Vita</h2>
        </div>

        <div class="about-reasons-grid">
          <article class="about-reason-card">
            <span class="about-reason-card__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20 6 9 17l-5-5"></path>
              </svg>
            </span>
            <h3>Top Quality Standards</h3>
            <p>We keep quality central from sourcing to fulfillment, with clear standards for ingredient integrity, freshness, and consistency.</p>
          </article>

          <article class="about-reason-card">
            <span class="about-reason-card__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8Z"></path>
                <path d="M7.5 7.5h.01"></path>
              </svg>
            </span>
            <h3>The Best Prices</h3>
            <p>Our product mix is chosen to make everyday wellness easier to maintain, with strong value across trusted supplement categories.</p>
          </article>

          <article class="about-reason-card">
            <span class="about-reason-card__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="9"></circle>
                <path d="M8 14s1.5 2 4 2 4-2 4-2"></path>
                <path d="M9 9h.01"></path>
                <path d="M15 9h.01"></path>
              </svg>
            </span>
            <h3>Satisfaction Guaranteed</h3>
            <p>We want every customer to feel confident before and after checkout, with practical support and a straightforward shopping experience.</p>
          </article>

          <article class="about-reason-card">
            <span class="about-reason-card__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="m14 2-9 12h7l-2 8 9-12h-7l2-8Z"></path>
              </svg>
            </span>
            <h3>High Potency Formulas</h3>
            <p>We focus on purposeful formulas and meaningful ingredient profiles that fit real daily routines, not complicated wellness noise.</p>
          </article>
        </div>
      </section>
    </div>
  </div>
</section>

<style>
  #AboutIntro-{{ section.id }} {
    --about-intro-text: #17131a;
    --about-intro-muted: #6c6472;
    --about-intro-soft: #F4F8F7;
    background: #ffffff;
    color: var(--about-intro-text);
  }

  #AboutIntro-{{ section.id }} .about-intro-section__hero {
    position: relative;
    display: grid;
    min-height: clamp(21rem, 34vw, 30rem);
    overflow: hidden;
    place-items: center;
    isolation: isolate;
  }

  #AboutIntro-{{ section.id }} .about-intro-section__hero-bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 50% 42%, rgba(var(--brand-accent-rgb, 250, 208, 84), 0.18), transparent 19rem),
      radial-gradient(circle at 14% 15%, rgba(255, 255, 255, 0.08), transparent 13rem),
      linear-gradient(135deg, #06181B 0%, #0A282C 54%, #163E43 100%);
  }

  #AboutIntro-{{ section.id }} .about-intro-section__hero-bg img {
    opacity: 0.28;
  }

  #AboutIntro-{{ section.id }} .about-intro-section__hero-bg img:not(.about-intro-section__watermark-logo) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #AboutIntro-{{ section.id }} .about-intro-section__watermark-logo {
    width: min(54rem, 70vw);
    height: auto;
    max-height: 82%;
    object-fit: contain;
    opacity: 0.14;
    transform: translateY(0);
  }

  #AboutIntro-{{ section.id }} .about-intro-section__hero-overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgba(6, 24, 27, 0.36), rgba(6, 24, 27, 0.72)),
      radial-gradient(circle at 50% 44%, rgba(6, 24, 27, 0.18), rgba(6, 24, 27, 0.72));
  }

  #AboutIntro-{{ section.id }} .about-intro-section__hero-copy {
    position: relative;
    z-index: 1;
    width: min(940px, calc(100% - 2rem));
    padding: clamp(3.5rem, 7vw, 5.5rem) 0;
    color: #ffffff;
    text-align: center;
  }

  #AboutIntro-{{ section.id }} .about-intro-section__eyebrow {
    margin: 0 0 0.75rem;
    color: var(--brand-green, #FAD054);
    font-family: var(--font-heading, "FuturaBT Bold", "DM Sans", sans-serif);
    font-size: 0.84rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  #AboutIntro-{{ section.id }} h1 {
    max-width: 980px;
    margin: 0 auto;
    color: #ffffff;
    background: none;
    font-family: var(--font-heading, "FuturaBT Bold", "DM Sans", sans-serif);
    font-size: clamp(2rem, 3.75vw, 3.7rem);
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.13;
    text-transform: none;
    text-shadow: 0 0.9rem 2rem rgba(0, 0, 0, 0.18);
    -webkit-text-fill-color: #ffffff;
  }

  #AboutIntro-{{ section.id }} .about-intro-section__hero-text {
    width: min(780px, 100%);
    margin: clamp(1.1rem, 2vw, 1.6rem) auto 0;
    color: rgba(255, 255, 255, 0.9);
    font-size: clamp(1rem, 1.35vw, 1.16rem);
    line-height: 1.75;
  }

  #AboutIntro-{{ section.id }} .about-intro-section__hero-text p {
    margin: 0 0 0.9rem;
  }

  #AboutIntro-{{ section.id }} .about-intro-section__hero-text p:last-child {
    margin-bottom: 0;
  }

  #AboutIntro-{{ section.id }} .about-intro-section__content {
    padding: clamp(2.8rem, 5vw, 5rem) 1rem clamp(3rem, 6vw, 5.5rem);
  }

  #AboutIntro-{{ section.id }} .about-intro-section__inner {
    width: min(1320px, 100%);
    margin: 0 auto;
  }

  #AboutIntro-{{ section.id }} .about-intro-section__block + .about-intro-section__block {
    margin-top: clamp(3rem, 5.5vw, 5rem);
  }

  #AboutIntro-{{ section.id }} .about-intro-section__heading-wrap {
    display: grid;
    justify-items: center;
    gap: 0.45rem;
    width: 100%;
    margin-bottom: clamp(1.75rem, 3vw, 2.65rem);
    text-align: center;
  }

  #AboutIntro-{{ section.id }} .about-intro-section__heading-line {
    display: none;
  }

  #AboutIntro-{{ section.id }} .about-intro-section__heading-line:last-child {
    display: none;
  }

  #AboutIntro-{{ section.id }} .about-intro-section__heading-wrap h2 {
    margin: 0;
    color: var(--brand-primary, #0A282C);
    background: none;
    font-family: var(--font-title, "FuturaBT Bold", "DM Sans", sans-serif);
    font-size: clamp(2rem, 3.2vw, 3rem);
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.1;
    text-align: center;
    text-transform: none;
    white-space: nowrap;
    -webkit-text-fill-color: currentColor;
  }

  #AboutIntro-{{ section.id }} .about-intro-section__heading-wrap h2::before {
    content: "Boreal Vita";
    display: block;
    margin-bottom: 0.55rem;
    color: var(--brand-accent-dark, #C89F27);
    font-family: var(--font-body, "DM Sans", "Segoe UI", sans-serif);
    font-size: 0.86rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    line-height: 1;
    text-transform: uppercase;
  }

  #AboutIntro-{{ section.id }} .about-reasons-grid,
  #AboutIntro-{{ section.id }} .about-values-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1.1rem, 2vw, 1.7rem);
  }

  #AboutIntro-{{ section.id }} .about-reason-card,
  #AboutIntro-{{ section.id }} .about-value-card {
    display: grid;
    align-content: start;
    gap: 0.9rem;
    text-align: center;
  }

  #AboutIntro-{{ section.id }} .about-reason-card__icon {
    display: grid;
    place-items: center;
    width: 4.25rem;
    height: 4.25rem;
    margin: 0 auto 0.25rem;
    border-radius: 50%;
    background: var(--brand-purple, #0A282C);
    color: #ffffff;
  }

  #AboutIntro-{{ section.id }} .about-reason-card__icon svg {
    width: 2.1rem;
    height: 2.1rem;
  }

  #AboutIntro-{{ section.id }} .about-reason-card h3,
  #AboutIntro-{{ section.id }} .about-value-card h3,
  #AboutIntro-{{ section.id }} .about-purpose-card h3 {
    margin: 0;
    color: #17131a;
    font-family: var(--font-heading, "FuturaBT Bold", "DM Sans", sans-serif);
    font-size: clamp(1.15rem, 1.45vw, 1.45rem);
    font-weight: 800;
    letter-spacing: 0.04em;
    line-height: 1.18;
    text-transform: uppercase;
  }

  #AboutIntro-{{ section.id }} .about-reason-card p,
  #AboutIntro-{{ section.id }} .about-value-card p,
  #AboutIntro-{{ section.id }} .about-purpose-card p {
    margin: 0;
    color: var(--about-intro-muted);
    font-size: 0.98rem;
    line-height: 1.68;
  }

  #AboutIntro-{{ section.id }} .about-purpose-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.2rem, 2.4vw, 2rem);
  }

  #AboutIntro-{{ section.id }} .about-purpose-card {
    position: relative;
    display: grid;
    min-height: 13rem;
    align-content: center;
    gap: 0.85rem;
    overflow: hidden;
    padding: clamp(1.8rem, 3vw, 2.65rem);
    border-radius: 8px;
    color: #ffffff;
    text-align: center;
    isolation: isolate;
  }

  #AboutIntro-{{ section.id }} .about-purpose-card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      linear-gradient(135deg, rgba(31, 23, 38, 0.78), rgba(10, 40, 44, 0.62)),
      var(--brand-title-gradient, linear-gradient(135deg, #0A282C 0%, #163E43 100%));
  }

  #AboutIntro-{{ section.id }} .about-purpose-card::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(circle at 20% 20%, rgba(250, 208, 84, 0.28), transparent 10rem),
      radial-gradient(circle at 85% 35%, rgba(255, 255, 255, 0.16), transparent 12rem);
  }

  #AboutIntro-{{ section.id }} .about-purpose-card h3,
  #AboutIntro-{{ section.id }} .about-purpose-card p {
    color: #ffffff;
  }

  #AboutIntro-{{ section.id }} .about-value-card__visual {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 8px;
    background:
      linear-gradient(135deg, rgba(31, 23, 38, 0.34), rgba(10, 40, 44, 0.36)),
      var(--brand-title-gradient, linear-gradient(135deg, #0A282C 0%, #163E43 100%));
  }

  #AboutIntro-{{ section.id }} .about-value-card__visual--innovation {
    background:
      radial-gradient(circle at 20% 22%, rgba(250, 208, 84, 0.72), transparent 22%),
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--brand-green) 18%, white),
        color-mix(in srgb, var(--brand-primary) 10%, white)
      );
  }

  #AboutIntro-{{ section.id }} .about-value-card__visual--quality {
    background:
      radial-gradient(circle at 72% 26%, rgba(10, 40, 44, 0.42), transparent 24%),
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--brand-primary) 12%, white),
        color-mix(in srgb, var(--brand-green) 16%, white)
      );
  }

  #AboutIntro-{{ section.id }} .about-value-card__visual--experience {
    background:
      radial-gradient(circle at 28% 70%, rgba(216, 185, 106, 0.76), transparent 22%),
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--brand-primary) 14%, white),
        var(--brand-soft, #F4F8F7)
      );
  }

  #AboutIntro-{{ section.id }} .about-value-card__visual--empowerment {
    background:
      radial-gradient(circle at 70% 28%, rgba(250, 208, 84, 0.68), transparent 22%),
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--brand-green) 24%, white),
        color-mix(in srgb, var(--brand-primary) 8%, white)
      );
  }

  @media (max-width: 989px) {
    #AboutIntro-{{ section.id }} .about-reasons-grid,
    #AboutIntro-{{ section.id }} .about-values-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    #AboutIntro-{{ section.id }} h1 {
      font-size: clamp(1.85rem, 9vw, 2.7rem);
    }

    #AboutIntro-{{ section.id }} .about-intro-section__heading-wrap {
      gap: 0.7rem;
    }

    #AboutIntro-{{ section.id }} .about-intro-section__heading-line {
      height: 1px;
    }

    #AboutIntro-{{ section.id }} .about-intro-section__heading-wrap h2 {
      max-width: 18ch;
      white-space: normal;
    }

    #AboutIntro-{{ section.id }} .about-reasons-grid,
    #AboutIntro-{{ section.id }} .about-values-grid,
    #AboutIntro-{{ section.id }} .about-purpose-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

{% schema %}
{
  "name": "About Us intro",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "More than providing medicine, we guide you toward the right wellness support for your condition."
    },
    {
      "type": "textarea",
      "id": "paragraph_1",
      "label": "Paragraph 1",
      "default": "Boreal Vita pairs trusted wellness products with practical guidance so customers can choose with confidence."
    },
    {
      "type": "textarea",
      "id": "paragraph_2",
      "label": "Paragraph 2",
      "default": "Our focus is clear support, dependable quality, and easier decisions for everyday health needs."
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero background image"
    }
  ],
  "presets": [
    {
      "name": "About Us intro"
    }
  ]
}
{% endschema %}
