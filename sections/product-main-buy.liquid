  .product-main-buy__accordion[open] summary svg {
    transform: rotate(180deg);
  }

  .product-main-buy__accordion:first-child summary {
    background: var(--brand-purple, #0A282C);
    color: #ffffff;
  }

  .product-main-buy__accordion-content {
    padding: clamp(1.15rem, 2.4vw, 1.9rem);
    color: #393b40;
    font-size: clamp(1rem, 1.22vw, 1.12rem);
    line-height: 1.62;
  }

  .product-main-buy__accordion-content > :first-child {
    margin-top: 0;
  }

  .product-main-buy__accordion-content > :last-child {
    margin-bottom: 0;
  }

  .product-main-buy__accordion-content ul {
    margin: 0 0 1rem;
    padding-left: 1.25rem;
  }

  .product-main-buy__accordion-content h3 {
    margin: 1.25rem 0 0.45rem;
    color: #111114;
    font-size: 1.1rem;
    line-height: 1.25;
  }

  .product-main-buy__mobile-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 1rem;
    background: #fff;
    border-top: 1px solid var(--pdp-border);
    box-shadow: 0 -6px 24px rgba(0, 0, 0, 0.08);
  }

  .product-main-buy__mobile-price {
    font-weight: 700;
    font-family: var(--font-price-address, "DM Sans", "Segoe UI", sans-serif);
    font-stretch: semi-condensed;
  }

  .product-main-buy__mobile-bar .btn {
    min-height: 3rem;
    border-radius: 999px;
    padding: 0 1.25rem;
    font-size: 0.95rem;
    font-weight: 900;
  }

  .product-main-buy__mobile-spacer {
    height: 76px;
  }

  @media (max-width: 989px) {
    .product-main-buy {
      padding-bottom: 2.35rem;
    }

    .product-main-buy__grid {
      grid-template-columns: 1fr;
      gap: 1.35rem;
      padding-top: 1.45rem;
    }

    .product-main-buy__media {
      position: static;
      display: flex;
      flex-direction: column;
      gap: 0.9rem;
    }

    .product-main-buy__thumb-shell {
      display: block;
      width: 100%;
      max-height: none;
      border: 0;
      border-radius: 0;
      padding: 0;
      background: transparent;
    }

    .product-main-buy__thumb-scroll {
      display: none;
    }

    .product-main-buy__thumbs {
      flex-direction: row;
      justify-content: flex-start;
      gap: 0.5rem;
      max-height: none;
      overflow-x: auto;
      overflow-y: hidden;
      border: 0;
      border-radius: 0;
      padding: 0.15rem 0 0.35rem;
    }

    .product-main-buy__thumb {
      width: 70px;
      min-width: 70px;
      height: 70px;
    }

    .product-main-buy__thumb.is-active,
    .product-main-buy__thumb.is-hovered {
      transform: translateY(-1px);
    }

    .product-main-buy__main {
      min-height: clamp(20rem, 82vw, 29rem);
      height: auto;
      padding: 0.95rem;
      cursor: default;
    }

    .product-main-buy__zoom-lens,
    .product-main-buy__zoom-indicator {
      display: none;
    }

    .product-main-buy__buy {
      padding: 0.3rem 0 0;
      border-radius: 12px;
    }

    .product-main-buy__title {
      font-size: clamp(1.72rem, 7vw, 2.4rem) !important;
      margin-bottom: 0.7rem;
    }

    .product-main-buy__price {
      font-size: 1.75rem;
    }

    .product-main-buy__atc.btn,
    .product-main-buy__buy-now.btn {
      height: 3rem;
      font-size: 1rem;
    }

    .product-main-buy__actions {
      gap: 0.6rem;
    }

    .product-main-buy__cart-notice {
      align-items: flex-start;
      flex-wrap: wrap;
    }

    .product-main-buy__cart-notice-link {
      margin-left: 0;
    }
  }

  @media (max-width: 540px) {
    .product-main-buy__main {
      min-height: 20rem;
    }

    .product-main-buy__label-facts {
      grid-template-columns: 1fr;
    }

    .product-main-buy__accordion summary {
      min-height: 3.55rem;
      padding: 0 0.85rem;
      font-size: 0.9rem;
    }
  }

  @media (min-width: 990px) {
    .product-main-buy__mobile-bar,
    .product-main-buy__mobile-spacer {
      display: none;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var section = document.getElementById('ProductMainBuy-{{ section.id }}');
    if (!section) return;

    var variantDataEl = section.querySelector('[data-variant-json]');
    var variants = [];
    if (variantDataEl) {
      try {
        variants = JSON.parse(variantDataEl.textContent || '[]');
      } catch (error) {
        console.warn('Unable to parse variant JSON for section {{ section.id }}.', error);
      }
    }
    var select = section.querySelector('[data-variant-select]');
    var priceEl = section.querySelector('[data-price]');
    var compareEl = section.querySelector('[data-compare]');
    var availabilityEl = section.querySelector('[data-availability]');
    var skuEl = section.querySelector('[data-sku]');
    var productSizeEl = section.querySelector('[data-product-size]');
    var atcButton = section.querySelector('[data-atc]');
    var buyNowButton = section.querySelector('[data-buy-now]');
    var mobileAtc = section.querySelector('[data-mobile-atc]');
    var mobilePrice = section.querySelector('[data-mobile-price]');
    var mainImage = section.querySelector('[data-main-image]');
    var thumbs = Array.prototype.slice.call(section.querySelectorAll('.product-main-buy__thumb'));
    var thumbsTrack = section.querySelector('[data-product-thumbs]');
    var thumbScrollButtons = Array.prototype.slice.call(section.querySelectorAll('[data-thumb-scroll]'));
    var zoomContainer = section.querySelector('[data-zoom-container]');
    var zoomLens = section.querySelector('[data-zoom-lens]');
    var supportsHover = window.matchMedia && window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    var selectedThumb = null;
    var moneyFormat = {{ shop.money_format | json }};
    var deliveryWindow = section.querySelector('[data-delivery-window]');
    var breadcrumb = section.querySelector('[data-pdp-breadcrumb]');
    var quantityInput = section.querySelector('.product-main-buy__quantity');
    var quantityDecrease = section.querySelector('[data-quantity-decrease]');
    var quantityIncrease = section.querySelector('[data-quantity-increase]');

    var normalizeBreadcrumbLabel = function(label) {
      var cleanLabel = String(label || '').replace(/\s+/g, ' ').trim();
      var lowerLabel = cleanLabel.toLowerCase();

      if (!cleanLabel || lowerLabel === 'home' || lowerLabel === 'home page' || lowerLabel === 'homepage') {
        return 'All Products';
      }

      if (lowerLabel === 'best sellings' || lowerLabel === 'best selling') {
        return 'Best Sellers';
      }

      if (lowerLabel === 'new arrival') {
        return 'New Arrivals';
      }

      return cleanLabel;
    };

    if (breadcrumb) {
      var sourceLink = breadcrumb.querySelector('[data-pdp-breadcrumb-source]');
      var productPath = breadcrumb.getAttribute('data-product-path') || window.location.pathname;
      var sourceLabel = '';
      var sourceUrl = '';

      try {
        var params = new URLSearchParams(window.location.search);
        sourceLabel = params.get('bv_source') || '';
        sourceUrl = params.get('bv_source_url') || '';

        if (!sourceLabel && window.sessionStorage) {
          var storedBreadcrumb = window.sessionStorage.getItem('bvPdpBreadcrumb:' + productPath) || window.sessionStorage.getItem('bvPdpBreadcrumb');
          if (storedBreadcrumb) {
            var parsedBreadcrumb = JSON.parse(storedBreadcrumb);
            sourceLabel = parsedBreadcrumb && parsedBreadcrumb.label ? parsedBreadcrumb.label : '';
            sourceUrl = parsedBreadcrumb && parsedBreadcrumb.url ? parsedBreadcrumb.url : '';
          }
        }
      } catch (error) {
        sourceLabel = '';
        sourceUrl = '';
      }

      if (sourceLink && sourceLabel) {
        sourceLink.textContent = normalizeBreadcrumbLabel(sourceLabel);
        sourceLink.setAttribute('href', sourceUrl || {{ routes.all_products_collection_url | json }});
      }
    }

    var formatMoney = function(cents) {
      if (window.Shopify && Shopify.formatMoney) {
        return Shopify.formatMoney(cents, moneyFormat);
      }
      return '$' + (cents / 100).toFixed(2);
    };

    if (deliveryWindow && window.Intl) {
      var startDate = new Date();
      var endDate = new Date();
      startDate.setDate(startDate.getDate() + 2);
      endDate.setDate(endDate.getDate() + 6);
      var dateFormatter = new Intl.DateTimeFormat('en-GB', {
        weekday: 'long',
        day: 'numeric',
        month: 'long'
      });
      deliveryWindow.innerHTML = 'Estimated delivery between <strong>' + dateFormatter.format(startDate).replace(',', '') + '</strong> and <strong>' + dateFormatter.format(endDate).replace(',', '') + '</strong>.';
    }

    var setQuantity = function(nextValue) {
      if (!quantityInput) return;
      var min = Number(quantityInput.getAttribute('min') || 1);
      var parsedValue = Number(nextValue || min);
      if (!Number.isFinite(parsedValue)) {
        parsedValue = min;
      }
      quantityInput.value = Math.max(min, Math.floor(parsedValue));
    };

    if (quantityDecrease) {
      quantityDecrease.addEventListener('click', function() {
        setQuantity(Number(quantityInput && quantityInput.value) - 1);
      });
    }

    if (quantityIncrease) {
      quantityIncrease.addEventListener('click', function() {
        setQuantity(Number(quantityInput && quantityInput.value) + 1);
      });
    }

    if (quantityInput) {
      quantityInput.addEventListener('change', function() {
        setQuantity(quantityInput.value);
      });
    }

    var isMeaningfulProductMeta = function(value) {
      var cleanValue = String(value || '').replace(/\s+/g, '').toLowerCase();
      return cleanValue !== '' &&
        cleanValue !== '0' &&
        cleanValue !== '0.0' &&
        cleanValue !== '0.00' &&
        cleanValue !== '0g' &&
        cleanValue !== '0.0g' &&
        cleanValue !== '0.00g' &&
        cleanValue !== '0kg' &&
        cleanValue !== '0.0kg' &&
        cleanValue !== '0.00kg' &&
        cleanValue !== '0lb' &&
        cleanValue !== '0.0lb' &&
        cleanValue !== '0.00lb' &&
        cleanValue !== '0lbs' &&
        cleanValue !== '0.0lbs' &&
        cleanValue !== '0.00lbs' &&
        cleanValue !== '0oz' &&
        cleanValue !== '0.0oz' &&
        cleanValue !== '0.00oz';
    };

    if (productSizeEl && !isMeaningfulProductMeta(productSizeEl.textContent)) {
      productSizeEl.textContent = '';
      productSizeEl.style.display = 'none';
    }

    var normalizeUrl = function(url) {
      return String(url || '').replace(/&amp;/g, '&');
    };

    var resolveThumbSrc = function(thumb) {
      if (!thumb) return '';

      var src = normalizeUrl(thumb.getAttribute('data-image-src') || thumb.dataset.imageSrc);
      if (src) return src;

      var thumbImg = thumb.querySelector('img');
      if (!thumbImg || !thumbImg.src) return '';
      return normalizeUrl(thumbImg.src.replace(/width=\d+/, 'width=900'));
    };

    var imageSwapVersion = 0;

    var swapMainImage = function(src, alt) {
      if (!mainImage || !src) return;
      var nextSrc = normalizeUrl(src);
      var currentSrc = normalizeUrl(mainImage.currentSrc || mainImage.getAttribute('src'));
      if (nextSrc === currentSrc && (!alt || alt === mainImage.getAttribute('alt'))) {
        mainImage.classList.remove('is-fading');
        return;
      }
      imageSwapVersion += 1;
      var swapVersion = imageSwapVersion;
      mainImage.classList.add('is-fading');
      var preload = new Image();
      preload.onload = function() {
        if (swapVersion !== imageSwapVersion) return;
        mainImage.setAttribute('src', nextSrc);
        if (alt) mainImage.setAttribute('alt', alt);
        mainImage.classList.remove('is-fading');
      };
      preload.onerror = function() {
        if (swapVersion !== imageSwapVersion) return;
        mainImage.setAttribute('src', nextSrc);
        if (alt) mainImage.setAttribute('alt', alt);
        mainImage.classList.remove('is-fading');
      };
      preload.src = nextSrc;
    };

    var setThumbStates = function(activeThumb, hoveredThumb) {
      thumbs.forEach(function(thumb) {
        thumb.classList.remove('is-active');
        thumb.classList.remove('is-hovered');
      });

      if (activeThumb) activeThumb.classList.add('is-active');
      if (hoveredThumb && hoveredThumb !== activeThumb) hoveredThumb.classList.add('is-hovered');
    };

    thumbScrollButtons.forEach(function(button) {
      button.addEventListener('click', function() {
        if (!thumbsTrack) return;
        var direction = button.getAttribute('data-thumb-scroll') === 'prev' ? -1 : 1;
        var scrollDistance = thumbsTrack.clientHeight || 84;
        thumbsTrack.scrollBy({
          top: direction * scrollDistance * 0.72,
          left: direction * scrollDistance * 0.72,
          behavior: 'smooth'
        });
      });
    });

    var setSelectedThumb = function(thumb) {
      if (!thumb) return;
      selectedThumb = thumb;
      setThumbStates(selectedThumb, null);
      if (zoomContainer) {
        zoomContainer.setAttribute('data-selected-image-id', thumb.getAttribute('data-image-id') || '');
      }
    };

    var previewThumb = function(thumb, persistSelection) {
      if (!thumb) return;
      var src = resolveThumbSrc(thumb);
      if (!src) return;

      var alt = thumb.getAttribute('data-image-alt') || '';
      swapMainImage(src, alt);

      if (persistSelection) {
        setSelectedThumb(thumb);
      } else {
        setThumbStates(selectedThumb, thumb);
      }
    };

    thumbs.forEach(function(thumb) {
      if (thumb.classList.contains('is-active') && !selectedThumb) {
        selectedThumb = thumb;
      }

      thumb.addEventListener('click', function(e) {
        e.preventDefault();
        previewThumb(thumb, true);
      });

      thumb.addEventListener('mouseenter', function() {
        if (!supportsHover) return;
        previewThumb(thumb, false);
      });

      thumb.addEventListener('mouseleave', function() {
        if (!supportsHover || !selectedThumb) return;
        previewThumb(selectedThumb, false);
        setThumbStates(selectedThumb, null);
      });

      thumb.addEventListener('focus', function() {
        previewThumb(thumb, false);
      });

      thumb.addEventListener('blur', function() {
        if (!selectedThumb) return;
        previewThumb(selectedThumb, false);
        setThumbStates(selectedThumb, null);
      });
    });

    if (!selectedThumb && thumbs.length) {
      selectedThumb = thumbs[0];
      setThumbStates(selectedThumb, null);
    }

    var positionZoomLens = function(clientX, clientY) {
      if (!zoomContainer || !mainImage || !zoomLens) return;
      var rect = zoomContainer.getBoundingClientRect();
      if (!rect.width || !rect.height) return;

      var xPx = clientX - rect.left;
      var yPx = clientY - rect.top;
      var x = Math.max(0, Math.min(100, (xPx / rect.width) * 100));
      var y = Math.max(0, Math.min(100, (yPx / rect.height) * 100));

      mainImage.style.transformOrigin = x + '% ' + y + '%';

      var lensRect = zoomLens.getBoundingClientRect();
      var halfWidth = lensRect.width / 2;
      var halfHeight = lensRect.height / 2;
      var clampedLeft = Math.max(halfWidth, Math.min(xPx, rect.width - halfWidth));
      var clampedTop = Math.max(halfHeight, Math.min(yPx, rect.height - halfHeight));

      zoomLens.style.left = clampedLeft + 'px';
      zoomLens.style.top = clampedTop + 'px';
    };

    if (zoomContainer && mainImage && supportsHover) {
      zoomContainer.addEventListener('mouseenter', function(e) {
        zoomContainer.classList.add('is-zooming');
        positionZoomLens(e.clientX, e.clientY);
      });

      zoomContainer.addEventListener('mousemove', function(e) {
        positionZoomLens(e.clientX, e.clientY);
      });

      zoomContainer.addEventListener('mouseleave', function() {
        zoomContainer.classList.remove('is-zooming');
        mainImage.style.transformOrigin = 'center center';
      });
    }

    // Variant select - update price, availability, SKU, image
    var update = function(variantId) {
      var variant = null;
      for (var i = 0; i < variants.length; i++) {
        if (variants[i].id === Number(variantId)) {
          variant = variants[i];
          break;
        }
      }
      if (!variant) return;
      var soldOut = !variant.available || (variant.inventory_management && Number(variant.inventory_quantity || 0) <= 0);

      if (priceEl) priceEl.textContent = formatMoney(variant.price);
      if (mobilePrice) mobilePrice.textContent = formatMoney(variant.price);

      if (compareEl) {
        if (variant.compare_at_price && variant.compare_at_price > variant.price) {
          compareEl.textContent = formatMoney(variant.compare_at_price);
          compareEl.style.display = 'inline';
        } else {
          compareEl.style.display = 'none';
        }
      }

      if (availabilityEl) {
        availabilityEl.textContent = soldOut ? {{ section.settings.out_of_stock_label | json }} : {{ section.settings.in_stock_label | json }};
      }

      if (productSizeEl) {
        var sizeText = '';
        if (variant.title && variant.title !== 'Default Title') {
          sizeText = variant.title;
        } else if (isMeaningfulProductMeta(variant.weight_text)) {
          sizeText = variant.weight_text;
        }

        productSizeEl.textContent = sizeText;
        productSizeEl.style.display = sizeText ? 'block' : 'none';
      }

      if (skuEl) {
        if (variant.sku) {
          skuEl.textContent = 'SKU: ' + variant.sku;
          skuEl.style.display = 'block';
        } else {
          skuEl.style.display = 'none';
        }
      }

      if (atcButton) {
        atcButton.disabled = soldOut;
        var atcLabel = soldOut ? {{ section.settings.out_of_stock_label | json }} : {{ section.settings.add_to_cart_label | json }};
        var atcText = atcButton.querySelector('span') || atcButton;
        atcText.textContent = atcLabel;
      }

      if (buyNowButton) {
        buyNowButton.disabled = soldOut;
      }

      if (mobileAtc) {
        mobileAtc.disabled = soldOut;
        mobileAtc.textContent = soldOut ? {{ section.settings.out_of_stock_label | json }} : {{ section.settings.add_to_cart_label | json }};
      }

      // Update main image when variant has its own image
      if (variant.image_url && mainImage) {
        var matchingThumb = null;
        thumbs.forEach(function(thumb) {
          if (thumb.getAttribute('data-image-id') === String(variant.image_id)) {
            matchingThumb = thumb;
          }
        });

        if (matchingThumb) {
          previewThumb(matchingThumb, true);
        } else {
          swapMainImage(variant.image_url, mainImage.getAttribute('alt'));
        }
      }
    };

    if (select) {
      select.addEventListener('change', function(e) {
        update(e.target.value);
      });
    }
  });
</script>

