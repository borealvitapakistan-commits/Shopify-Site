    padding: 0.62rem 0.78rem;
    background: color-mix(in srgb, var(--brand-soft, #F4F8F7) 76%, #ffffff);
    color: var(--pdp-text);
    font-size: clamp(0.95rem, 1vw, 1.05rem);
