    font-family: var(--font-body, "DM Sans", "Segoe UI", sans-serif);
    font-size: clamp(0.86rem, 0.98vw, 0.98rem);
    font-weight: 520;
    line-height: 1.22;
    letter-spacing: 0;
    white-space: normal;
