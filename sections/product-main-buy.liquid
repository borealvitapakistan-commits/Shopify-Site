  .product-main-buy__short-description > :first-child {
    margin-top: 0;
  }

  .product-main-buy__short-description > :last-child {
    margin-bottom: 0;
  }

  .product-main-buy__benefits {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.64rem 0.72rem;
    max-width: 42rem;
    margin: 0 0 1.32rem;
  }

  .product-main-buy__benefit-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.46rem;
    min-height: 2rem;
    border-radius: 999px;
    padding: 0.23rem 0.78rem 0.23rem 0.25rem;
