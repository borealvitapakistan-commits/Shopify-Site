{%- comment -%}
  Product Main Buy Layout
  - Thumbnails left, main image center, buy box right
{%- endcomment -%}

{% assign current_variant = product.selected_or_first_available_variant %}
{% assign is_allergy_relief = false %}
{% if product.handle == 'allergy-relief-capsule-120-vegetarian-capsules' or product.title contains 'Allergy Relief' %}
  {% assign is_allergy_relief = true %}
{% endif %}
{% assign initial_sold_out = false %}
{% if current_variant.available == false %}
  {% assign initial_sold_out = true %}
{% endif %}
{% if current_variant.inventory_management != blank and current_variant.inventory_quantity <= 0 %}
  {% assign initial_sold_out = true %}
{% endif %}

{% assign trust_text = section.settings.trust_text %}
{% assign trust_metafield = section.settings.trust_metafield %}
{% if trust_metafield != blank %}
  {% assign trust_parts = trust_metafield | split: '.' %}
  {% assign trust_namespace = trust_parts[0] %}
  {% assign trust_key = trust_parts[1] %}
  {% if trust_namespace != blank and trust_key != blank %}
    {% assign trust_value = product.metafields[trust_namespace][trust_key] %}
    {% if trust_value != blank %}
      {% assign trust_text = trust_value %}
    {% endif %}
  {% endif %}
{% endif %}

{% assign rating_value = nil %}
{% assign rating_count = nil %}
{% if product.metafields.reviews.rating != blank %}
  {% assign rating_value = product.metafields.reviews.rating.value | default: product.metafields.reviews.rating %}
{% endif %}
{% if product.metafields.reviews.rating_count != blank %}
  {% assign rating_count = product.metafields.reviews.rating_count.value | default: product.metafields.reviews.rating_count %}
{% endif %}
{% if rating_value != blank %}
  {% assign rating_number = rating_value | plus: 0 %}
{% else %}
  {% assign rating_number = 5 %}
{% endif %}
{% assign review_count = rating_count | default: 0 %}
{% assign review_count_number = review_count | plus: 0 %}

{% assign ingredients_value = product.metafields.custom.ingredients | default: product.metafields.health.ingredients %}
{% assign legal_value = product.metafields.custom.legal_disclaimer | default: product.metafields.health.legal_disclaimer %}
{% assign shipping_value = product.metafields.custom.shipping_returns | default: product.metafields.health.shipping_returns %}
{% assign bullet_points = product.metafields.custom.bullet_points.value %}
{% assign short_description = product.metafields.custom.short_description | default: product.metafields.custom.subtitle %}
{% assign product_size = product.metafields.custom.item_weight | default: product.metafields.custom.size %}
{% if product_size == blank and current_variant.title != 'Default Title' %}
  {% assign product_size = current_variant.title %}
{% endif %}
{% if product_size == blank and current_variant.weight > 0 %}
  {% assign product_size = current_variant.weight | weight_with_unit %}
{% endif %}
{% capture product_size_rendered %}{{ product_size }}{% endcapture %}
{% assign product_size_text = product_size_rendered | strip %}
{% assign product_size_zero_check = product_size_text | downcase | remove: ' ' %}
{% if product_size_zero_check == '0' or product_size_zero_check == '0.0' or product_size_zero_check == '0.00' or product_size_zero_check == '0.0g' or product_size_zero_check == '0.00g' or product_size_zero_check == '0g' or product_size_zero_check == '0.0kg' or product_size_zero_check == '0.00kg' or product_size_zero_check == '0kg' or product_size_zero_check == '0.0lb' or product_size_zero_check == '0.00lb' or product_size_zero_check == '0lb' or product_size_zero_check == '0.0lbs' or product_size_zero_check == '0.00lbs' or product_size_zero_check == '0lbs' or product_size_zero_check == '0.0oz' or product_size_zero_check == '0.00oz' or product_size_zero_check == '0oz' %}
  {% assign product_size = blank %}
  {% assign product_size_text = blank %}
{% endif %}
{% if is_allergy_relief %}
  {% assign product_size = '120 Vegetarian Capsules / 405 mg per capsule' %}
  {% assign product_size_text = product_size %}
{% endif %}
{% assign npn_value = product.metafields.custom.npn | default: product.metafields.custom.npn_number | default: product.metafields.health.npn %}
{% if npn_value == blank and is_allergy_relief %}
  {% assign npn_value = '80134953' %}
{% endif %}
{% assign product_identifier_type = 'SKU' %}
{% assign product_identifier_value = current_variant.sku %}
{% if npn_value != blank %}
  {% assign product_identifier_type = 'NPN' %}
  {% assign product_identifier_value = npn_value %}
{% endif %}
{% assign product_identifier_text = product_identifier_value | strip %}
{% assign product_identifier_zero_check = product_identifier_text | downcase | remove: ' ' %}
{% if product_identifier_zero_check == '0' or product_identifier_zero_check == '0.0' or product_identifier_zero_check == '0.00' %}
  {% assign product_identifier_value = blank %}
  {% assign product_identifier_text = blank %}
{% endif %}

{% assign breadcrumb_source_title = blank %}
{% assign breadcrumb_source_url = blank %}
{% if collection != blank %}
  {% assign collection_title_downcase = collection.title | downcase %}
  {% unless collection.handle == 'frontpage' or collection.handle == 'homepage' or collection.handle == 'home-page' or collection_title_downcase == 'home page' or collection_title_downcase == 'homepage' %}
    {% assign breadcrumb_source_title = collection.title %}
    {% assign breadcrumb_source_url = collection.url %}
  {% endunless %}
{% endif %}
{% if breadcrumb_source_title == blank %}
  {% for product_collection in product.collections %}
    {% assign product_collection_title_downcase = product_collection.title | downcase %}
    {% unless product_collection.handle == 'frontpage' or product_collection.handle == 'homepage' or product_collection.handle == 'home-page' or product_collection_title_downcase == 'home page' or product_collection_title_downcase == 'homepage' %}
      {% assign breadcrumb_source_title = product_collection.title %}
      {% assign breadcrumb_source_url = product_collection.url %}
      {% break %}
    {% endunless %}
  {% endfor %}
{% endif %}
{% if breadcrumb_source_title == blank %}
  {% assign breadcrumb_source_title = 'All Products' %}
  {% assign breadcrumb_source_url = routes.all_products_collection_url %}
{% endif %}

{% assign main_image = product.featured_image %}
{% if main_image == blank and product.images.size > 0 %}
  {% assign main_image = product.images.first %}
{% endif %}
{% assign has_media = false %}
{% if main_image != blank %}
  {% assign has_media = true %}
{% endif %}
{% assign show_thumb_strip = false %}
{% if section.settings.show_thumbnails and product.images.size > 1 %}
  {% assign show_thumb_strip = true %}
{% endif %}
{% assign has_custom_benefit_blocks = false %}
{% for block in section.blocks %}
  {% if block.type == 'benefit' and block.settings.text != blank %}
    {% assign has_custom_benefit_blocks = true %}
  {% endif %}
{% endfor %}

{% capture variant_data %}[
{% for variant in product.variants %}
  {
    "id": {{ variant.id }},
    "available": {{ variant.available | json }},
    "inventory_management": {{ variant.inventory_management | json }},
    "inventory_quantity": {{ variant.inventory_quantity | json }},
    "price": {{ variant.price | json }},
    "compare_at_price": {{ variant.compare_at_price | json }},
    "title": {{ variant.title | json }},
    "sku": {{ variant.sku | json }},
    "weight_text": {{ variant.weight | weight_with_unit | json }},
    "image_id": {{ variant.featured_image.id | default: 0 }},
    "image_url": {{ variant.featured_image | image_url: width: 900 | json }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]{% endcapture %}

<section class="product-main-buy" id="ProductMainBuy-{{ section.id }}">
  <div class="product-main-buy__marquee" aria-label="Store guarantees">
    <div class="product-main-buy__marquee-track">
      {% for i in (1..8) %}
        <span>Third-party tested</span>
        <span>GMP compliant facility</span>
        <span>60-day money back guarantee</span>
      {% endfor %}
    </div>
  </div>

  <div class="container product-main-buy__grid {% unless has_media %}product-main-buy__grid--no-media{% endunless %}">
    {% if has_media %}
      <div class="product-main-buy__media {% unless show_thumb_strip %}product-main-buy__media--no-thumbs{% endunless %}">
        <div class="product-main-buy__main" data-zoom-container data-selected-image-id="{{ main_image.id }}">
          <img
            src="{{ main_image | image_url: width: 720 }}"
            srcset="
              {{ main_image | image_url: width: 360 }} 360w,
              {{ main_image | image_url: width: 540 }} 540w,
              {{ main_image | image_url: width: 720 }} 720w,
              {{ main_image | image_url: width: 900 }} 900w
            "
            sizes="(min-width: 990px) 42vw, 92vw"
            alt="{{ main_image.alt | default: product.title | escape }}"
            width="{{ main_image.width }}"
            height="{{ main_image.height }}"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            data-main-image
          >
          <span class="product-main-buy__zoom-lens" aria-hidden="true" data-zoom-lens></span>
          <span class="product-main-buy__zoom-indicator" aria-hidden="true">2.6x Zoom</span>
        </div>

        <div class="product-main-buy__media-status" data-availability>
          {% if initial_sold_out == false %}
            {{ section.settings.in_stock_label }}
          {% else %}
            {{ section.settings.out_of_stock_label }}
          {% endif %}
        </div>

        {% if show_thumb_strip %}
          <div class="product-main-buy__thumb-shell" aria-label="Product thumbnails">
            <button class="product-main-buy__thumb-scroll product-main-buy__thumb-scroll--prev" type="button" aria-label="Previous product image" data-thumb-scroll="prev">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="m6 15 6-6 6 6"></path>
              </svg>
            </button>
            <div class="product-main-buy__thumbs" data-product-thumbs>
              {% for image in product.images %}
                {% assign is_active = false %}
                {% if image.id == main_image.id %}
                  {% assign is_active = true %}
                {% endif %}
                <button class="product-main-buy__thumb {% if is_active %}is-active{% endif %}" type="button" data-image-id="{{ image.id }}" data-image-src="{{ image | image_url: width: 900 }}" data-image-alt="{{ image.alt | default: product.title | escape }}">
                  <img
                    src="{{ image | image_url: width: 120 }}"
                    srcset="
                      {{ image | image_url: width: 80 }} 80w,
                      {{ image | image_url: width: 120 }} 120w,
                      {{ image | image_url: width: 180 }} 180w
                    "
                    sizes="70px"
                    alt="{{ image.alt | default: product.title | escape }}"
                    width="{{ image.width }}"
                    height="{{ image.height }}"
                    loading="lazy"
                  >
                </button>
              {% endfor %}
            </div>
            <button class="product-main-buy__thumb-scroll product-main-buy__thumb-scroll--next" type="button" aria-label="Next product image" data-thumb-scroll="next">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="m6 9 6 6 6-6"></path>
              </svg>
            </button>
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="product-main-buy__buy">
      <nav class="product-main-buy__breadcrumbs" aria-label="Breadcrumb" data-pdp-breadcrumb data-product-path="{{ product.url }}">
        <a href="{{ routes.root_url }}">Home</a>
        <span aria-hidden="true">/</span>
        <a href="{{ breadcrumb_source_url }}" data-pdp-breadcrumb-source>{{ breadcrumb_source_title }}</a>
        <span aria-hidden="true">/</span>
        <span data-pdp-breadcrumb-product>{{ product.title }}</span>
      </nav>

      <h1 class="product-main-buy__title">{{ product.title }}</h1>

      {% if short_description != blank %}
        <div class="product-main-buy__short-description">
          {% if short_description.value != blank %}
            {{ short_description | metafield_tag }}
          {% else %}
            {{ short_description }}
          {% endif %}
        </div>
      {% elsif product.description != blank %}
        <p class="product-main-buy__short-description">{{ product.description | strip_html | truncatewords: 18 }}</p>
      {% endif %}

      {% if has_custom_benefit_blocks %}
        <div class="product-main-buy__benefits" aria-label="Product benefits">
          {% for block in section.blocks %}
            {% if block.type == 'benefit' and block.settings.text != blank %}
              {% assign benefit_text = block.settings.text | strip %}
              <span
                class="product-main-buy__benefit-chip"
                style="--benefit-bg: {{ block.settings.background_color }}; --benefit-text: {{ block.settings.text_color }}; --benefit-icon-color: {{ block.settings.icon_color }};"
                {{ block.shopify_attributes }}
              >
                <span class="product-main-buy__benefit-icon" aria-hidden="true">
                  {% render 'product-benefit-icon',
                    icon: block.settings.icon,
                    text: benefit_text,
                    custom_icon: block.settings.custom_icon
                  %}
                </span>
                <span>{{ benefit_text }}</span>
              </span>
            {% endif %}
          {% endfor %}
        </div>
      {% elsif bullet_points != blank %}
        <div class="product-main-buy__benefits" aria-label="Product benefits">
          {% for item in bullet_points limit: 6 %}
            {% assign benefit_text = item | strip %}
            <span class="product-main-buy__benefit-chip">
              <span class="product-main-buy__benefit-icon" aria-hidden="true">
                {% render 'product-benefit-icon', icon: 'auto', text: benefit_text %}
              </span>
              <span>{{ benefit_text }}</span>
            </span>
          {% endfor %}
        </div>
      {% endif %}

      {% if review_count_number > 0 %}
        <div class="product-main-buy__rating" style="--rating: {{ rating_number }};">
          <span class="product-main-buy__stars" aria-hidden="true"></span>
          <span class="product-main-buy__rating-count">{{ review_count_number }} {% if review_count_number == 1 %}review{% else %}reviews{% endif %}</span>
        </div>
      {% endif %}

      <div class="product-main-buy__price-row">
        <span class="product-main-buy__price" data-price>{{ current_variant.price | money }}</span>
        <span class="product-main-buy__compare" data-compare {% if current_variant.compare_at_price == blank or current_variant.compare_at_price <= current_variant.price %}style="display:none;"{% endif %}>
          {{ current_variant.compare_at_price | money }}
        </span>
      </div>

      {% if product_size_text != blank %}
        <div class="product-main-buy__meta-line product-main-buy__meta-line--size" data-product-size>
          {{ product_size_text }}
        </div>
      {% endif %}

      <div
        class="product-main-buy__sku"
        {% if product_identifier_type == 'SKU' %}data-sku{% endif %}
        {% if product_identifier_value == blank %}style="display:none;"{% endif %}
      >
        {{ product_identifier_type }}: {{ product_identifier_value }}
      </div>

      {% if is_allergy_relief %}
        <div class="product-main-buy__label-facts" aria-label="Product label facts">
          <span>
            <strong>NPN</strong>
            80134953
          </span>
          <span>
            <strong>Count</strong>
            120 Vegetarian Capsules
          </span>
          <span>
            <strong>Strength</strong>
            405 mg per capsule
          </span>
          <span>
            <strong>Origin</strong>
            Made in Canada
          </span>
        </div>
      {% endif %}

      {% assign form_id = 'ProductForm-' | append: section.id %}
      {% form 'product', product, id: form_id, class: 'product-main-buy__form', data-product-form: '', data-pdp-main-form: '' %}
        {% unless product.has_only_default_variant %}
          <label class="product-main-buy__label" for="VariantSelect-{{ section.id }}">{{ section.settings.variant_label }}</label>
          <select id="VariantSelect-{{ section.id }}" name="id" class="product-main-buy__select" data-variant-select>
            {% for variant in product.variants %}
              <option value="{{ variant.id }}" {% if variant.id == current_variant.id %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>
                {{ variant.title }}
              </option>
            {% endfor %}
          </select>
        {% else %}
          <input type="hidden" name="id" value="{{ current_variant.id }}">
        {% endunless %}

        <div class="product-main-buy__purchase-row">
          <label class="product-main-buy__label product-main-buy__label--visually-hidden" for="Quantity-{{ section.id }}">{{ section.settings.quantity_label }}</label>
          <div class="product-main-buy__quantity-control" data-quantity-control>
            <button class="product-main-buy__quantity-button" type="button" aria-label="Decrease quantity" data-quantity-decrease>
              <span aria-hidden="true">-</span>
            </button>
            <input id="Quantity-{{ section.id }}" class="product-main-buy__quantity" type="number" name="quantity" min="1" value="1" inputmode="numeric">
            <button class="product-main-buy__quantity-button" type="button" aria-label="Increase quantity" data-quantity-increase>
              <span aria-hidden="true">+</span>
            </button>
          </div>

          <div class="product-main-buy__actions">
            <button class="btn btn--primary product-main-buy__atc" type="submit" data-atc {% if initial_sold_out %}disabled{% endif %}>
              <span>
                {% if initial_sold_out == false %}
                  {{ section.settings.add_to_cart_label }}
                {% else %}
                  {{ section.settings.out_of_stock_label }}
                {% endif %}
              </span>
            </button>

            <button class="btn product-main-buy__buy-now" type="submit" name="return_to" value="/checkout" data-buy-now {% if initial_sold_out %}disabled{% endif %}>
              Buy Now
            </button>
          </div>
        </div>

        {% if section.settings.show_dynamic_checkout %}
          <div class="product-main-buy__dynamic">
            {{ form | payment_button }}
          </div>
        {% endif %}
      {% endform %}

      <div class="product-main-buy__cart-notice" role="status" aria-live="polite" hidden data-pdp-cart-notice>
        <span class="product-main-buy__cart-notice-icon" aria-hidden="true">
          <svg viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.78-9.72a.75.75 0 0 0-1.06-1.06L9 10.94 7.28 9.22a.75.75 0 0 0-1.06 1.06l2.25 2.25c.3.3.77.3 1.06 0l4.25-4.25Z" clip-rule="evenodd"></path>
          </svg>
        </span>
        <span>You have added this product to the cart. You can now view it in Add to Cart.</span>
        <a href="{{ routes.cart_url }}" class="product-main-buy__cart-notice-link">View Cart</a>
      </div>

      {% if trust_text != blank %}
        <div class="product-main-buy__trust">
          {% if trust_text.value != blank %}
            {{ trust_text | metafield_tag }}
          {% else %}
            {{ trust_text }}
          {% endif %}
        </div>
      {% endif %}

      <div class="product-main-buy__assurance">
        <div class="product-main-buy__assurance-item">
          <span class="product-main-buy__assurance-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9">
              <circle cx="12" cy="12" r="9"></circle>
              <path d="M12 7v5l3 2"></path>
            </svg>
          </span>
          <span data-delivery-window>Estimated delivery in 2-6 business days.</span>
        </div>
        <div class="product-main-buy__assurance-item">
          <span class="product-main-buy__assurance-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9">
              <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7S1 12 1 12Z"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
          </span>
          <span><strong>10</strong> people looking for this product right now</span>
        </div>
        <div class="product-main-buy__assurance-item">
          <span class="product-main-buy__assurance-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9">
              <path d="M21 12a9 9 0 0 1-15.3 6.4"></path>
              <path d="M3 12A9 9 0 0 1 18.3 5.6"></path>
              <path d="M21 4v6h-6"></path>
              <path d="M3 20v-6h6"></path>
            </svg>
          </span>
          <span>60-Day Money Back Guarantee</span>
        </div>
      </div>

      <div class="product-main-buy__details">
        <details class="product-main-buy__accordion" open>
          <summary>
            <span>Product Details</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="m6 9 6 6 6-6"></path>
            </svg>
          </summary>
          <div class="product-main-buy__accordion-content rte">
            {% if bullet_points != blank %}
              <ul>
                {% for item in bullet_points %}
                  <li>{{ item }}</li>
                {% endfor %}
              </ul>
            {% endif %}

            {% if product.description != blank %}
              {{ product.description }}
            {% elsif bullet_points == blank %}
              <p>Product details coming soon.</p>
            {% endif %}

            {% if ingredients_value != blank %}
              <h3>Ingredients</h3>
              {% if ingredients_value.value != blank %}
                {{ ingredients_value | metafield_tag }}
              {% else %}
                {{ ingredients_value }}
              {% endif %}
            {% endif %}

            {% if legal_value != blank %}
              <h3>Important information</h3>
              {% if legal_value.value != blank %}
                {{ legal_value | metafield_tag }}
              {% else %}
                {{ legal_value }}
              {% endif %}
            {% endif %}
          </div>
        </details>

        <details class="product-main-buy__accordion" id="reviews">
          <summary>
            <span>Reviews</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="m6 9 6 6 6-6"></path>
            </svg>
          </summary>
          <div class="product-main-buy__accordion-content">
            {% if rating_value != blank %}
              <p><strong>{{ rating_number }}/5</strong>{% if rating_count != blank %} from {{ rating_count }} reviews{% endif %}</p>
            {% else %}
              <p>Customer reviews will appear here as soon as they are available.</p>
            {% endif %}
          </div>
        </details>

        <details class="product-main-buy__accordion">
          <summary>
            <span>Shipping &amp; Returns</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="m6 9 6 6 6-6"></path>
            </svg>
          </summary>
          <div class="product-main-buy__accordion-content rte">
            {% if shipping_value != blank %}
              {% if shipping_value.value != blank %}
                {{ shipping_value | metafield_tag }}
              {% else %}
                {{ shipping_value }}
              {% endif %}
            {% else %}
              <p>Orders are prepared quickly, tracking is provided when available, and unopened items can be returned according to the store return policy.</p>
            {% endif %}
          </div>
        </details>
      </div>
    </div>
  </div>

  {% if section.settings.enable_mobile_bar %}
    <div class="product-main-buy__mobile-bar" data-mobile-bar>
      <div class="product-main-buy__mobile-price" data-mobile-price>{{ current_variant.price | money }}</div>
      <button class="btn btn--primary" type="submit" form="ProductForm-{{ section.id }}" data-mobile-atc>
        {{ section.settings.add_to_cart_label }}
      </button>
    </div>
    <div class="product-main-buy__mobile-spacer" aria-hidden="true"></div>
  {% endif %}

  <script type="application/json" data-variant-json>
    {{ variant_data | strip }}
  </script>
</section>

<style>
  .product-main-buy {
    --pdp-font: var(--font-body, "DM Sans", sans-serif);
    --pdp-text: var(--brand-primary, #0A282C);
    --pdp-muted: var(--color-muted-foreground, #33585D);
    --pdp-border: rgba(var(--color-primary-rgb, 10, 40, 44), 0.2);
    --pdp-border-strong: rgba(var(--color-primary-rgb, 10, 40, 44), 0.42);
    --pdp-soft: var(--brand-soft, #F4F8F7);
    --pdp-link: var(--brand-purple, #0A282C);
    --pdp-link-hover: var(--brand-purple-dark, #06181B);
    --pdp-success: var(--brand-purple, #0A282C);
    --pdp-success-hover: var(--brand-purple-dark, #06181B);
    --pdp-zoom-blue: var(--brand-purple, #0A282C);
    font-family: var(--pdp-font);
    padding: 0 0 3rem;
    background: #fff;
    color: var(--pdp-text);
  }

  .product-main-buy__marquee {
    display: none;
    width: 100%;
    overflow: hidden;
    background: var(--brand-purple, #0A282C);
    color: #ffffff;
    font-family: var(--font-heading, "FuturaBT Bold", "DM Sans", sans-serif);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    line-height: 1;
    text-transform: uppercase;
  }

  .product-main-buy__marquee-track {
    display: inline-flex;
    min-width: max-content;
    gap: 1.15rem;
    padding: 0.62rem 0;
    animation: pdpTrustMarquee 30.8s linear infinite;
    will-change: transform;
  }

  .product-main-buy__marquee-track span {
    display: inline-flex;
    align-items: center;
    gap: 1.15rem;
    white-space: nowrap;
  }

  .product-main-buy__marquee-track span::after {
    content: "";
    width: 0.26rem;
    height: 0.26rem;
    border-radius: 50%;
    background: var(--brand-green, #FAD054);
  }

  @keyframes pdpTrustMarquee {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(-50%, 0, 0); }
  }

  .product-main-buy__grid {
    display: grid;
    grid-template-columns: minmax(440px, 0.95fr) minmax(390px, 1fr);
    gap: clamp(2.2rem, 5vw, 5.25rem);
    align-items: start;
    max-width: 1180px;
    padding-top: clamp(2.4rem, 4vw, 3.2rem);
  }

  .product-main-buy__grid--no-media {
    grid-template-columns: 1fr;
  }

  .product-main-buy__media {
    position: static;
    display: grid;
    grid-template-columns: clamp(3.8rem, 4.6vw, 4.45rem) minmax(0, 1fr);
    grid-template-rows: auto auto;
    align-items: start;
    gap: clamp(0.68rem, 1.15vw, 0.95rem);
    min-width: 0;
  }

  .product-main-buy__media--no-thumbs {
    display: flex;
    flex-direction: column;
  }

  .product-main-buy__thumb-shell {
    grid-column: 1;
    grid-row: 1 / span 2;
    display: grid;
    grid-template-rows: 1.45rem minmax(0, 1fr) 1.45rem;
    gap: 0.3rem;
    align-self: start;
    width: 100%;
    max-height: clamp(18.2rem, 31vw, 24rem);
    padding: 0.34rem;
    border: 1px solid rgba(var(--color-primary-rgb, 10, 40, 44), 0.15);
    border-radius: 0.95rem;
    background: #ffffff;
  }

  .product-main-buy__thumb-scroll {
    display: grid;
    place-items: center;
    width: 100%;
    height: 1.45rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: rgba(var(--color-primary-rgb, 10, 40, 44), 0.55);
    cursor: pointer;
    transition: background 0.18s ease, color 0.18s ease;
  }

  .product-main-buy__thumb-scroll:hover,
  .product-main-buy__thumb-scroll:focus-visible {
    background: rgba(var(--brand-green-rgb, 250, 208, 84), 0.18);
    color: var(--brand-primary, #0A282C);
    outline: none;
  }

  .product-main-buy__thumb-scroll svg {
    width: 1.02rem;
    height: 1.02rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .product-main-buy__thumbs {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 0.42rem;
    min-height: 0;
    overflow-x: hidden;
    overflow-y: auto;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    scrollbar-width: none;
  }

  .product-main-buy__thumbs::-webkit-scrollbar {
    display: none;
  }

  .product-main-buy__thumb {
    flex: 0 0 auto;
    border: 1px solid rgba(var(--color-primary-rgb, 10, 40, 44), 0.1);
    background: #fff;
    border-radius: 0.58rem;
    padding: 0.16rem;
    width: 100%;
    height: clamp(4.25rem, 5.3vw, 5rem);
    cursor: pointer;
    opacity: 0.72;
    transition: border-color 0.18s ease, box-shadow 0.18s ease, opacity 0.18s ease, transform 0.18s ease;
  }

  .product-main-buy__thumb.is-active,
  .product-main-buy__thumb.is-hovered {
    border-color: var(--brand-accent, #FAD054);
    opacity: 1;
    box-shadow: 0 0 0 1.5px rgba(var(--brand-green-rgb, 250, 208, 84), 0.62);
    transform: translateX(1px);
  }

  .product-main-buy__thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }

  .product-main-buy__main {
    grid-column: 2;
    grid-row: 1;
    border: 0;
    border-radius: 0;
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: clamp(20rem, 35vw, 27rem);
    aspect-ratio: 1 / 1;
    padding: 0;
    overflow: hidden;
    position: relative;
    cursor: default;
    --zoom-level: 2.8;
    --lens-size: 32%;
  }

  .product-main-buy__main img {
    display: block;
    max-width: 96%;
    max-height: 96%;
    width: auto;
    height: auto;
    object-fit: contain;
    object-position: center;
    transition: opacity 0.26s ease, transform 0.16s ease;
    transform: none;
    transform-origin: center center;
    will-change: transform;
  }

  .product-main-buy__main.is-zooming {
    cursor: default;
  }

  .product-main-buy__main.is-zooming img {
    transform: none;
  }

  .product-main-buy__main img.is-fading {
    opacity: 0;
  }

  .product-main-buy__zoom-lens {
    position: absolute;
    display: none;
    width: var(--lens-size);
    aspect-ratio: 1;
    border: 2px solid var(--pdp-zoom-blue);
    background: rgba(var(--brand-green-rgb, 250, 208, 84), 0.22);
    box-shadow:
      0 0 0 1px rgba(248, 242, 251, 0.94) inset,
      0 0 0 1px rgba(var(--color-primary-rgb, 10, 40, 44), 0.18);
    border-radius: 0.5rem;
    pointer-events: none;
    opacity: 0;
    transform: translate(-50%, -50%);
    transition: opacity 0.11s ease;
  }

  .product-main-buy__zoom-indicator {
    position: absolute;
    display: none;
    top: 0.9rem;
    left: 0.9rem;
    pointer-events: none;
    z-index: 2;
    font-size: 0.79rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--brand-purple, #0A282C);
    background: var(--brand-soft, #F4F8F7);
    border: 1px solid rgba(var(--color-primary-rgb, 10, 40, 44), 0.22);
    border-radius: 999px;
    padding: 0.3rem 0.7rem;
    opacity: 0;
    transition: opacity 0.11s ease;
  }

  .product-main-buy__main.is-zooming .product-main-buy__zoom-lens,
  .product-main-buy__main.is-zooming .product-main-buy__zoom-indicator {
    opacity: 1;
  }

  .product-main-buy__buy {
    border: 0;
    border-radius: 0;
    padding: 0;
    box-shadow: none;
    background: #fff;
    position: static;
    padding-top: clamp(0.25rem, 1vw, 1.2rem);
  }

  .product-main-buy__breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.34rem;
    margin: 0 0 2.15rem;
    color: #4d5b5f;
    font-size: 0.92rem;
    line-height: 1.35;
  }

  .product-main-buy__breadcrumbs a {
    color: inherit;
    text-decoration: none;
  }

  .product-main-buy__breadcrumbs a:hover,
  .product-main-buy__breadcrumbs a:focus-visible {
    color: var(--brand-primary, #0A282C);
    text-decoration: underline;
  }

  .product-main-buy__title {
    font-family: var(--font-heading, "FuturaBT Bold", "DM Sans", sans-serif) !important;
    margin: 0 0 0.78rem;
    font-size: clamp(2rem, 3vw, 2.75rem) !important;
    font-weight: 700 !important;
    line-height: 1.12;
    letter-spacing: 0;
    color: var(--pdp-text);
  }

  .product-main-buy__short-description {
    max-width: 34rem;
