    line-height: 1.2;
  }

  .product-main-buy__label-facts strong {
    color: #5f4f45;
    font-family: var(--font-heading, "DM Sans", sans-serif);
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .product-main-buy__form {
    display: flex;
    flex-direction: column;
    gap: 0.76rem;
    margin-top: 0.65rem;
  }

  .product-main-buy__label {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--pdp-text);
  }

  .product-main-buy__label--visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .product-main-buy__purchase-row {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    flex-wrap: wrap;
  }

  .product-main-buy__select,
  .product-main-buy__quantity-control {
    height: 36px;
    border-radius: 999px;
    border: 1px solid rgba(10, 40, 44, 0.24);
