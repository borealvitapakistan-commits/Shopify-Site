  .product-main-buy__benefit-chip:nth-child(3n) {
    background: var(--benefit-bg, #F6EAFE);
  }

  .product-main-buy__benefit-chip:nth-child(4n) {
    background: var(--benefit-bg, #EAFFE5);
  }

  .product-main-buy__benefit-chip:nth-child(5n) {
    background: var(--benefit-bg, #FFF6D7);
  }

  .product-main-buy__benefit-chip:nth-child(6n) {
    background: var(--benefit-bg, #ECEEFF);
  }

  .product-main-buy__benefit-icon {
    display: inline-grid;
    flex: 0 0 auto;
    width: 1.62rem;
    height: 1.62rem;
    place-items: center;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.66);
    color: var(--benefit-icon-color, var(--brand-primary, #0A282C));
    box-shadow: inset 0 0 0 1px rgba(var(--color-primary-rgb, 10, 40, 44), 0.06);
  }

  .product-main-buy__benefit-icon svg {
    width: 1rem;
    height: 1rem;
  }

  .product-main-buy__benefit-icon img {
    display: block;
    width: 1.12rem;
    height: 1.12rem;
    object-fit: contain;
  }

  .product-main-buy__rating {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.98rem;
    color: #1f2d30;
    margin-bottom: 1.35rem;
  }

  .product-main-buy__rating-text,
  .product-main-buy__rating-count {
    color: #1f2d30;
    font-weight: 500;
  }

  .product-main-buy__stars {
    position: relative;
    display: inline-block;
    font-size: 1.15rem;
    line-height: 1;
  }

  .product-main-buy__stars::before {
    content: '\2605\2605\2605\2605\2605';
    color: #ddd;
  }

  .product-main-buy__stars::after {
    content: '\2605\2605\2605\2605\2605';
    color: #ffc400;
    position: absolute;
    left: 0;
    top: 0;
    width: calc(var(--rating) / 5 * 100%);
    overflow: hidden;
  }

  .product-main-buy__price-row {
    display: flex;
    align-items: baseline;
    gap: 0.72rem;
    line-height: 1;
    margin: 0 0 1.35rem;
  }

  .product-main-buy__price {
    font-size: clamp(1.35rem, 1.9vw, 1.7rem);
    font-weight: 800;
    color: #2f3437;
    font-family: var(--font-price-address, "DM Sans", "Segoe UI", sans-serif);
    font-stretch: semi-condensed;
  }

  .product-main-buy__compare {
    font-size: 1.02rem;
    color: var(--pdp-muted);
    text-decoration: line-through;
    font-family: var(--font-price-address, "DM Sans", "Segoe UI", sans-serif);
    font-stretch: semi-condensed;
  }

  .product-main-buy__availability {
    margin: 0 0 1.15rem;
    font-size: 1.18rem;
    font-weight: 800;
    color: var(--pdp-text);
  }

  .product-main-buy__media-status {
    grid-column: 2;
    grid-row: 2;
    margin: 0.35rem 0 0;
    text-align: center;
    color: #000000;
    font-size: 1rem;
    font-weight: 700;
  }

  .product-main-buy__meta-line {
    margin: 0 0 1.38rem;
    color: #63666b;
    font-size: 1.04rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .product-main-buy__sku {
    font-size: 1rem;
    color: #5f4f45;
    margin-bottom: 1.35rem;
