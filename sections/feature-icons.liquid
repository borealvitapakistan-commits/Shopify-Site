<section class="section">
  <div class="container">
    <div class="feature-grid">
      {% for block in section.blocks %}
        <div class="feature-item reveal delay-{{ forloop.index }}">
          <div class="feature-icon">
            {% case block.settings.icon %}
              {% when 'leaf' %}
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke="currentColor">
                  <path d="M12 3C8 7 6 12 6 16c0 3 2 5 5 5 6 0 7-8 1-18z"></path>
                  <path d="M6 16c2-1 5-1 8 0"></path>
                </svg>
              {% when 'lab' %}
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke="currentColor">
                  <path d="M10 2h4"></path>
                  <path d="M10 2v6l-5 9a3 3 0 0 0 2.6 4.5h8.8A3 3 0 0 0 19 17l-5-9V2"></path>
                  <path d="M8 14h8"></path>
                </svg>
              {% when 'shield' %}
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke="currentColor">
                  <path d="M12 3l7 4v5c0 5-3.5 8.5-7 9-3.5-.5-7-4-7-9V7l7-4z"></path>
                  <path d="M9 12l2 2 4-4"></path>
                </svg>
              {% when 'earth' %}
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke="currentColor">
                  <circle cx="12" cy="12" r="9"></circle>
                  <path d="M3 12h18"></path>
                  <path d="M12 3a14 14 0 0 0 0 18"></path>
                </svg>
              {% when 'drop' %}
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke="currentColor">
                  <path d="M12 3c3 4 6 7 6 11a6 6 0 0 1-12 0c0-4 3-7 6-11z"></path>
                </svg>
              {% else %}
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke="currentColor">
                  <path d="M12 2l2.5 5 5.5.8-4 3.9.9 5.4L12 15l-4.9 2.1.9-5.4-4-3.9 5.5-.8L12 2z"></path>
                </svg>
            {% endcase %}
          </div>
          <strong>{{ block.settings.title }}</strong>
          <p>{{ block.settings.text }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Feature icons",
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "leaf", "label": "Leaf" },
            { "value": "lab", "label": "Lab tested" },
            { "value": "shield", "label": "Shield" },
            { "value": "earth", "label": "Earth" },
            { "value": "drop", "label": "Drop" },
            { "value": "spark", "label": "Spark" }
          ],
          "default": "leaf"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Organic herbs"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "No fillers, just whole botanicals."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Feature icons",
      "blocks": [
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" }
      ]
    }
  ]
}
{% endschema %}
