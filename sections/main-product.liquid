{% comment %}
  Main Product Section - iHerb-style PDP
  Clean, modern layout with thumbnail gallery, tabs, trust badges, and recommendations
{% endcomment %}

{% assign current_variant = product.selected_or_first_available_variant %}
{% assign initial_sold_out = false %}
{% if current_variant.available == false %}
  {% assign initial_sold_out = true %}
{% endif %}
{% if current_variant.inventory_management != blank and current_variant.inventory_quantity <= 0 %}
  {% assign initial_sold_out = true %}
{% endif %}

<link rel="stylesheet" href="{{ 'section-main-product.css' | asset_url }}" media="print" onload="this.media='all'">

<section class="pdp-section">
  <div class="container">
    {%- comment -%} Breadcrumbs {%- endcomment -%}
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <ol class="breadcrumbs__list">
        <li class="breadcrumbs__item">
          <a href="{{ routes.root_url }}" class="breadcrumbs__link">Home</a>
          {% render 'icon-chevron-right' %}
        </li>
        {% if product.collections.first %}
          <li class="breadcrumbs__item">
            <a href="{{ product.collections.first.url }}" class="breadcrumbs__link">{{ product.collections.first.title }}</a>
            {% render 'icon-chevron-right' %}
          </li>
        {% endif %}
        <li class="breadcrumbs__item breadcrumbs__item--current">
          <span>{{ product.title | truncate: 50 }}</span>
        </li>
      </ol>
    </nav>

    <div class="pdp-grid">
      {%- comment -%} Image Gallery with Thumbnails Below {%- endcomment -%}
      <div class="pdp-gallery">
        <div class="pdp-gallery__main">
          {% if product.featured_media %}
            <img
              id="ProductMainImage"
              src="{{ product.featured_media | image_url: width: 800 }}"
              alt="{{ product.featured_media.alt | escape }}"
              class="pdp-gallery__image"
              width="{{ product.featured_media.width }}"
              height="{{ product.featured_media.height }}"
              loading="eager"
            >
          {% else %}
            {{ 'product-1' | placeholder_svg_tag: 'pdp-gallery__placeholder' }}
          {% endif %}
          
          {% if product.compare_at_price > product.price %}
            {% assign savings = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round %}
            <span class="pdp-badge pdp-badge--sale">Save {{ savings }}%</span>
          {% endif %}
        </div>

        {% if product.media.size > 1 %}
          <div class="pdp-gallery__thumbs">
            {% for media in product.media limit: 6 %}
              <button
                type="button"
                class="pdp-gallery__thumb {% if forloop.first %}is-active{% endif %}"
                data-media-id="{{ media.id }}"
                data-image-url="{{ media | image_url: width: 800 }}"
                aria-label="View {{ media.alt | default: product.title }}"
              >
                <img
                  src="{{ media | image_url: width: 120 }}"
                  alt="{{ media.alt | escape }}"
                  width="{{ media.width }}"
                  height="{{ media.height }}"
                  loading="lazy"
                >
              </button>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      {%- comment -%} Product Info {%- endcomment -%}
      <div class="pdp-info">
        {% if product.vendor %}
          <a href="{{ routes.collections_url }}/vendors?q={{ product.vendor | url_encode }}" class="pdp-info__vendor">{{ product.vendor }}</a>
        {% endif %}

        <h1 class="pdp-info__title">{{ product.title }}</h1>

        {%- comment -%} Rating Row {%- endcomment -%}
        <div class="pdp-info__rating">
          <div class="rating-stars">
            {% assign rating = product.metafields.reviews.rating.value | default: 4.8 %}
            {% assign rating_int = rating | floor %}
            {% for i in (1..5) %}
              {% if i <= rating_int %}
                <svg class="star-icon star-icon--filled" viewBox="0 0 20 20" fill="currentColor">
                  <polygon points="10,1 12.5,6.5 18.5,7 14,11 15.5,17 10,14 4.5,17 6,11 1.5,7 7.5,6.5"/>
                </svg>
              {% else %}
                <svg class="star-icon star-icon--empty" viewBox="0 0 20 20" fill="currentColor">
                  <polygon points="10,1 12.5,6.5 18.5,7 14,11 15.5,17 10,14 4.5,17 6,11 1.5,7 7.5,6.5"/>
                </svg>
              {% endif %}
            {% endfor %}
          </div>
          <span class="rating-value">{{ rating }}</span>
          <a href="#reviews" class="rating-count">({{ product.metafields.reviews.rating_count | default: '127' }} reviews)</a>
        </div>

        {%- comment -%} Price {%- endcomment -%}
        <div class="pdp-info__price" id="ProductPrice">
          <span class="pdp-price__current">{{ product.price | money }}</span>
          {% if product.compare_at_price > product.price %}
            <span class="pdp-price__compare">{{ product.compare_at_price | money }}</span>
            <span class="pdp-price__savings">
              You save {{ product.compare_at_price | minus: product.price | money }}
            </span>
          {% endif %}
        </div>

        {%- comment -%} Short Description {%- endcomment -%}
        {% if product.metafields.custom.short_description %}
          <p class="pdp-info__short-desc">{{ product.metafields.custom.short_description }}</p>
        {% endif %}

        {%- comment -%} Purchase Card {%- endcomment -%}
        <div class="pdp-purchase-card">
          {% form 'product', product, id: 'ProductForm', class: 'pdp-form', data-product-form: '' %}
            {% comment %}
              Automatically inserted by Shop Pay Installments theme updater
            {% endcomment %}
            {% unless settings.disable_autogenerated_payment_terms %}
              {{ form | payment_terms }}
            {% endunless %}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" id="ProductVariantId">

            {%- comment -%} Variant Selectors {%- endcomment -%}
            {% unless product.has_only_default_variant %}
              {% for option in product.options_with_values %}
                <div class="pdp-variant-selector">
                  <label class="pdp-variant-selector__label">
                    {{ option.name }}:
                    <span class="pdp-variant-selector__selected">{{ option.selected_value }}</span>
                  </label>
                  <div class="pdp-variant-selector__options">
                    {% for value in option.values %}
                      <button
                        type="button"
                        class="pdp-variant-option {% if option.selected_value == value %}is-selected{% endif %}"
                        data-option-position="{{ option.position }}"
                        data-option-value="{{ value | escape }}"
                        aria-label="{{ option.name }}: {{ value }}"
                      >
                        {{ value }}
                      </button>
                    {% endfor %}
                  </div>
                </div>
              {% endfor %}
            {% endunless %}

            {%- comment -%} Hidden variant select {%- endcomment -%}
            <select name="id" id="ProductSelect" class="visually-hidden" aria-label="Product variants">
              {% for variant in product.variants %}
                {% assign variant_sold_out = false %}
                {% if variant.available == false %}
                  {% assign variant_sold_out = true %}
                {% elsif variant.inventory_management != blank and variant.inventory_quantity <= 0 %}
                  {% assign variant_sold_out = true %}
                {% endif %}
                <option
                  value="{{ variant.id }}"
                  {% if variant == product.selected_or_first_available_variant %}selected{% endif %}
                  {% if variant_sold_out %}disabled{% endif %}
                  data-price="{{ variant.price }}"
                  data-compare-price="{{ variant.compare_at_price }}"
                  data-available="{{ variant.available }}"
                  data-inventory-management="{{ variant.inventory_management }}"
                  data-inventory-quantity="{{ variant.inventory_quantity }}"
                >
                  {{ variant.title }} - {{ variant.price | money }}
                </option>
              {% endfor %}
            </select>

            {%- comment -%} Quantity & Stock {%- endcomment -%}
            <div class="pdp-quantity-row">
              <div class="pdp-quantity">
                <button type="button" class="pdp-quantity__btn" data-action="decrease" aria-label="Decrease quantity">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/></svg>
                </button>
                <input
                  type="number"
                  name="quantity"
                  id="ProductQuantity"
                  value="1"
                  min="1"
                  class="pdp-quantity__input"
                  aria-label="Quantity"
                >
                <button type="button" class="pdp-quantity__btn" data-action="increase" aria-label="Increase quantity">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                </button>
              </div>
              <span class="pdp-stock {% if initial_sold_out %}pdp-stock--out{% else %}pdp-stock--in{% endif %}" id="ProductStock">
                {% if initial_sold_out %}
                  Out of Stock
                {% else %}
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                  In Stock
                {% endif %}
              </span>
            </div>

            {%- comment -%} Add to Cart Button {%- endcomment -%}
            <button
              type="submit"
              name="add"
              class="pdp-btn pdp-btn--primary"
              {% if initial_sold_out %}disabled{% endif %}
              id="AddToCart"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"/></svg>
              <span id="AddToCartText">
                {% if initial_sold_out %}Sold Out{% else %}Add to Cart{% endif %}
              </span>
            </button>
          {% endform %}

          {%- comment -%} Trust Badges Row {%- endcomment -%}
          <div class="pdp-trust-row">
            {% for block in section.blocks %}
              {% if block.type == 'trust_badge' %}
                <div class="pdp-trust-badge" {{ block.shopify_attributes }}>
                  {% case block.settings.icon %}
                    {% when 'shipping' %}
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                    {% when 'secure' %}
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    {% when 'returns' %}
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 11-2.12-9.36L23 10"/></svg>
                    {% when 'quality' %}
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                    {% else %}
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                  {% endcase %}
                  <span>{{ block.settings.text }}</span>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{%- comment -%} Product Details Tabs {%- endcomment -%}
<section class="pdp-tabs-section">
  <div class="container">
    <div class="pdp-tabs" data-tabs>
      <div class="pdp-tabs__nav" role="tablist">
        {% assign tab_index = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'tab' %}
            {% assign tab_index = tab_index | plus: 1 %}
            <button 
              class="pdp-tabs__trigger {% if tab_index == 1 %}is-active{% endif %}"
              role="tab"
              aria-selected="{% if tab_index == 1 %}true{% else %}false{% endif %}"
              aria-controls="tab-panel-{{ tab_index }}"
              data-tab-trigger="{{ tab_index }}"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.title }}
            </button>
          {% endif %}
        {% endfor %}
      </div>
      
      <div class="pdp-tabs__content">
        {% assign tab_index = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'tab' %}
            {% assign tab_index = tab_index | plus: 1 %}
            <div 
              class="pdp-tabs__panel {% if tab_index == 1 %}is-active{% endif %}"
              role="tabpanel"
              id="tab-panel-{{ tab_index }}"
              data-tab-panel="{{ tab_index }}"
              {{ block.shopify_attributes }}
            >
              <div class="pdp-tabs__panel-content rte">
                {% if block.settings.content != blank %}
                  {{ block.settings.content }}
                {% elsif block.settings.use_product_description and block.settings.title == 'Description' %}
                  {{ product.description }}
                {% elsif block.settings.title == 'Benefits' %}
                  <ul>
                    <li>High potency formula for maximum absorption</li>
                    <li>Third-party tested for purity and potency</li>
                    <li>Non-GMO and Gluten Free certified</li>
                    <li>Made in USA in a GMP certified facility</li>
                  </ul>
                {% elsif block.settings.title == 'Ingredients' %}
                  <p>See supplement facts label for full ingredient list.</p>
                {% elsif block.settings.title == 'Directions' %}
                  <p>Take 1 capsule daily with a meal, or as directed by your healthcare professional.</p>
                {% elsif block.settings.title == 'FAQs' %}
                  <details class="pdp-faq">
                    <summary>How should I take this supplement?</summary>
                    <p>Take 1 capsule daily with a meal or as directed by your healthcare professional.</p>
                  </details>
                  <details class="pdp-faq">
                    <summary>Is this product vegan-friendly?</summary>
                    <p>Yes, this product is 100% vegan and made without any animal-derived ingredients.</p>
                  </details>
                  <details class="pdp-faq">
                    <summary>Are there any allergens?</summary>
                    <p>This product is free from common allergens including gluten, dairy, soy, and nuts.</p>
                  </details>
                {% else %}
                  <p>Content coming soon.</p>
                {% endif %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{%- comment -%} Frequently Bought Together {%- endcomment -%}
{% if section.settings.show_recommendations %}
  <section class="pdp-recommendations">
    <div class="container">
      <h2 class="section-title">{{ section.settings.recommendations_title | default: 'Frequently Bought Together' }}</h2>
      <div class="pdp-recommendations__grid">
        {% assign rec_collection = collections[section.settings.recommendations_collection] %}
        {% if rec_collection.products.size > 0 %}
          {% for rec_product in rec_collection.products limit: 4 %}
            {% if rec_product.id != product.id %}
              {% render 'product-card-carousel', product: rec_product %}
            {% endif %}
          {% endfor %}
        {% else %}
          {% for rec_product in product.collections.first.products limit: 5 %}
            {% if rec_product.id != product.id %}
              {% render 'product-card-carousel', product: rec_product %}
            {% endif %}
          {% endfor %}
        {% endif %}
      </div>
    </div>
  </section>
{% endif %}

{%- comment -%} Disclaimer {%- endcomment -%}
<section class="pdp-disclaimer">
  <div class="container">
    <p>
      * These statements have not been evaluated by the Food and Drug Administration.
      This product is not intended to diagnose, treat, cure, or prevent any disease.
    </p>
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Gallery thumbnail switching
  const mainImage = document.getElementById('ProductMainImage');
  const thumbnails = document.querySelectorAll('.pdp-gallery__thumb');
  const galleryMain = document.querySelector('.pdp-gallery__main');
  
  thumbnails.forEach(thumb => {
    thumb.addEventListener('click', function() {
      const imageUrl = this.dataset.imageUrl;
      if (mainImage && imageUrl) {
        mainImage.src = imageUrl;
        thumbnails.forEach(t => t.classList.remove('is-active'));
        this.classList.add('is-active');
      }
    });
  });

  if (galleryMain && mainImage) {
    galleryMain.addEventListener('mousemove', function(e) {
      const rect = galleryMain.getBoundingClientRect();
      const x = ((e.clientX - rect.left) / rect.width) * 100;
      const y = ((e.clientY - rect.top) / rect.height) * 100;
      mainImage.style.transformOrigin = `${x}% ${y}%`;
    });

    galleryMain.addEventListener('mouseleave', function() {
      mainImage.style.transformOrigin = 'center center';
    });
  }
  
  // Variant selection
  const variantOptions = document.querySelectorAll('.pdp-variant-option');
  const variantSelect = document.getElementById('ProductSelect');
  const variantIdInput = document.getElementById('ProductVariantId');
  
  variantOptions.forEach(option => {
    option.addEventListener('click', function() {
      const position = this.dataset.optionPosition;
      this.parentElement.querySelectorAll('.pdp-variant-option').forEach(o => o.classList.remove('is-selected'));
      this.classList.add('is-selected');
      
      // Update selected label
      const label = this.closest('.pdp-variant-selector').querySelector('.pdp-variant-selector__selected');
      if (label) label.textContent = this.dataset.optionValue;
      
      updateVariant();
    });
  });
  
  function updateVariant() {
    const selectedOptions = [];
    document.querySelectorAll('.pdp-variant-selector').forEach(selector => {
      const selected = selector.querySelector('.pdp-variant-option.is-selected');
      if (selected) selectedOptions.push(selected.dataset.optionValue);
    });
    
    for (let i = 0; i < variantSelect.options.length; i++) {
      const option = variantSelect.options[i];
      const matches = selectedOptions.every(val => option.text.includes(val));
      
      if (matches) {
        variantSelect.selectedIndex = i;
        variantIdInput.value = option.value;
        
        const price = parseInt(option.dataset.price);
        const comparePrice = parseInt(option.dataset.comparePrice);
        const available = option.dataset.available === 'true';
        const inventoryManagement = option.dataset.inventoryManagement;
        const inventoryQuantity = parseInt(option.dataset.inventoryQuantity || '0', 10);
        const soldOut = !available || (inventoryManagement && inventoryQuantity <= 0);

        updatePrice(price, comparePrice);
        updateAvailability(soldOut);
        break;
      }
    }
  }
  
  function updatePrice(price, comparePrice) {
    const priceContainer = document.getElementById('ProductPrice');
    const formattedPrice = Shopify.formatMoney(price);
    let html = `<span class="pdp-price__current">${formattedPrice}</span>`;
    
    if (comparePrice && comparePrice > price) {
      const formattedCompare = Shopify.formatMoney(comparePrice);
      const savings = Shopify.formatMoney(comparePrice - price);
      html += `<span class="pdp-price__compare">${formattedCompare}</span>`;
      html += `<span class="pdp-price__savings">You save ${savings}</span>`;
    }
    
    priceContainer.innerHTML = html;
  }
  
  function updateAvailability(soldOut) {
    const addToCartBtn = document.getElementById('AddToCart');
    const addToCartText = document.getElementById('AddToCartText');
    const stockStatus = document.getElementById('ProductStock');
    
    if (!soldOut) {
      addToCartBtn.disabled = false;
      addToCartText.textContent = 'Add to Cart';
      stockStatus.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg> In Stock';
      stockStatus.classList.remove('pdp-stock--out');
      stockStatus.classList.add('pdp-stock--in');
    } else {
      addToCartBtn.disabled = true;
      addToCartText.textContent = 'Sold Out';
      stockStatus.textContent = 'Out of Stock';
      stockStatus.classList.remove('pdp-stock--in');
      stockStatus.classList.add('pdp-stock--out');
    }
  }
  
  // Quantity buttons
  const quantityInput = document.getElementById('ProductQuantity');
  document.querySelectorAll('.pdp-quantity__btn').forEach(btn => {
    btn.addEventListener('click', function() {
      const action = this.dataset.action;
      let value = parseInt(quantityInput.value) || 1;
      
      if (action === 'increase') {
        quantityInput.value = value + 1;
      } else if (action === 'decrease' && value > 1) {
        quantityInput.value = value - 1;
      }
    });
  });
  
  // Tabs functionality
  const tabTriggers = document.querySelectorAll('[data-tab-trigger]');
  const tabPanels = document.querySelectorAll('[data-tab-panel]');
  
  tabTriggers.forEach(trigger => {
    trigger.addEventListener('click', function() {
      const tabId = this.dataset.tabTrigger;
      
      tabTriggers.forEach(t => {
        t.classList.remove('is-active');
        t.setAttribute('aria-selected', 'false');
      });
      tabPanels.forEach(p => p.classList.remove('is-active'));
      
      this.classList.add('is-active');
      this.setAttribute('aria-selected', 'true');
      document.querySelector(`[data-tab-panel="${tabId}"]`).classList.add('is-active');
    });
  });
  
  // AJAX Add to Cart
  const productForm = document.getElementById('ProductForm');
  if (productForm) {
    productForm.addEventListener('submit', function(e) {
      e.preventDefault();
      
      const addToCartBtn = document.getElementById('AddToCart');
      const addToCartText = document.getElementById('AddToCartText');
      const originalText = addToCartText.textContent;
      
      addToCartBtn.disabled = true;
      addToCartText.textContent = 'Adding...';
      
      const formData = new FormData(this);
      
      fetch('/cart/add.js', {
        method: 'POST',
        body: formData
      })
      .then(response => response.json())
      .then(data => {
        addToCartText.textContent = 'Added!';
        
        // Open cart drawer if available
        if (typeof window.openCartDrawer === 'function') {
          window.openCartDrawer();
        }
        
        setTimeout(() => {
          addToCartBtn.disabled = false;
          addToCartText.textContent = originalText;
        }, 1500);
      })
      .catch(error => {
        console.error('Error:', error);
        addToCartBtn.disabled = false;
        addToCartText.textContent = originalText;
      });
    });
  }
});
</script>

{% schema %}
{
  "name": "Product Page",
  "tag": "div",
  "class": "section-main-product",
  "settings": [
    {
      "type": "header",
      "content": "Recommendations"
    },
    {
      "type": "checkbox",
      "id": "show_recommendations",
      "label": "Show product recommendations",
      "default": true
    },
    {
      "type": "text",
      "id": "recommendations_title",
      "label": "Recommendations heading",
      "default": "Frequently Bought Together"
    },
    {
      "type": "collection",
      "id": "recommendations_collection",
      "label": "Recommendations collection",
      "info": "Leave empty to use products from the same collection"
    }
  ],
  "blocks": [
    {
      "type": "trust_badge",
      "name": "Trust Badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "shipping",
          "options": [
            { "value": "shipping", "label": "Shipping" },
            { "value": "secure", "label": "Secure" },
            { "value": "returns", "label": "Returns" },
            { "value": "quality", "label": "Quality" }
          ]
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free Shipping $49+"
        }
      ]
    },
    {
      "type": "tab",
      "name": "Content Tab",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Tab Title",
          "default": "Description"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "info": "Leave empty to use defaults"
        },
        {
          "type": "checkbox",
          "id": "use_product_description",
          "label": "Use product description",
          "default": false,
          "info": "For Description tab only"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Page",
      "blocks": [
        { "type": "trust_badge", "settings": { "icon": "shipping", "text": "Free Shipping $49+" } },
        { "type": "trust_badge", "settings": { "icon": "secure", "text": "Secure Checkout" } },
        { "type": "trust_badge", "settings": { "icon": "returns", "text": "30-Day Returns" } },
