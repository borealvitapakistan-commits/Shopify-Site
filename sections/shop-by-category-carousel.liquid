{%- comment -%}
  Branded Shop by Category carousel for homepage.
{%- endcomment -%}

{% liquid
  assign heading = section.settings.heading | default: 'Shop by category'
  assign eyebrow = section.settings.eyebrow | default: 'Explore wellness collections'
%}

<section class="shop-category-carousel-section" id="ShopCategoryCarousel-{{ section.id }}">
  <div class="container shop-category-carousel__container">
    <div class="shop-category-carousel__header">
      <div class="shop-category-carousel__header-copy">
        {% if eyebrow != blank %}
          <p class="shop-category-carousel__eyebrow">{{ eyebrow }}</p>
        {% endif %}
        <h2 class="shop-category-carousel__title">{{ heading }}</h2>
      </div>
    </div>

    <div class="shop-category-carousel__shell">
      <button type="button" class="shop-category-carousel__nav shop-category-carousel__nav--prev" aria-label="Previous categories" data-category-carousel-prev>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M15 18l-6-6 6-6"></path>
        </svg>
      </button>

      <div class="shop-category-carousel__track" data-category-carousel-track aria-label="{{ heading | escape }}">
        {% for block in section.blocks %}
          {% liquid
            assign category_url = block.settings.collection.url | default: block.settings.link | default: routes.all_products_collection_url
            assign category_title = block.settings.title | default: block.settings.collection.title | default: 'Category'
            assign category_icon = block.settings.icon | default: 'supplements'
            assign category_tone = block.settings.tone | default: 'mist'
          %}
          <a href="{{ category_url }}" class="shop-category-carousel__item" {{ block.shopify_attributes }}>
            <span class="shop-category-carousel__orb shop-category-carousel__orb--{{ category_tone }}">
              {% if block.settings.image != blank %}
                <img
                  src="{{ block.settings.image | image_url: width: 280 }}"
                  alt="{{ category_title | escape }}"
                  class="shop-category-carousel__image"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                  loading="lazy"
                >
              {% else %}
                <span class="shop-category-carousel__icon" aria-hidden="true">
                  {% case category_icon %}
                    {% when 'supplements' %}
                      <svg viewBox="0 0 80 80">
                        <rect x="17" y="26" width="18" height="28" rx="4"></rect>
                        <path d="M20 26v-7h12v7"></path>
                        <rect x="29" y="22" width="31" height="36" rx="6"></rect>
                        <path d="M35 22v-8h19v8"></path>
                        <circle cx="44.5" cy="40" r="7"></circle>
                        <path d="M44.5 33v14M37.5 40h14"></path>
                        <rect x="61" y="31" width="8" height="20" rx="3"></rect>
                      </svg>
                    {% when 'sports' %}
                      <svg viewBox="0 0 80 80">
                        <path d="M18 51h9v-22h-9"></path>
                        <path d="M53 51h9v-22h-9"></path>
                        <rect x="27" y="31" width="8" height="20" rx="2"></rect>
                        <rect x="45" y="31" width="8" height="20" rx="2"></rect>
                        <path d="M35 41h10"></path>
                        <path d="M27 23c2-7 8-11 15-11 8 0 14 4 16 11"></path>
                      </svg>
                    {% when 'bath-personal-care' %}
                      <svg viewBox="0 0 80 80">
                        <path d="M18 42h44c0 11-8 18-18 18H36c-10 0-18-7-18-18Z"></path>
                        <path d="M24 42c0-8 7-14 16-14h6c9 0 16 6 16 14"></path>
                        <path d="M52 25c0-6 4-9 9-9 4 0 7 2 8 5"></path>
                        <path d="M60 19l6 3"></path>
                        <circle cx="28" cy="31" r="2.5"></circle>
                        <circle cx="35" cy="24" r="2.5"></circle>
                      </svg>
                    {% when 'beauty' %}
                      <svg viewBox="0 0 80 80">
                        <path d="M40 62c-12 0-21-11-21-24 0-8 3-15 9-20"></path>
                        <path d="M40 62c12 0 21-11 21-24 0-8-3-15-9-20"></path>
                        <path d="M28 26c3-9 10-14 12-14s9 5 12 14"></path>
                        <path d="M33 40c2 2 4 3 7 3s5-1 7-3"></path>
                        <path d="M36 49c2 2 4 3 8 3"></path>
                        <path d="M49 38l5 13"></path>
                      </svg>
                    {% when 'grocery' %}
                      <svg viewBox="0 0 80 80">
                        <rect x="15" y="25" width="19" height="30" rx="3"></rect>
                        <path d="M20 25v-8h9v8"></path>
                        <rect x="35" y="18" width="16" height="38" rx="3"></rect>
                        <path d="M43 18v-7"></path>
                        <path d="M39 31h8"></path>
                        <rect x="53" y="24" width="13" height="32" rx="3"></rect>
                        <path d="M60 24v-9"></path>
                      </svg>
                    {% when 'home' %}
                      <svg viewBox="0 0 80 80">
                        <rect x="18" y="28" width="17" height="28" rx="4"></rect>
                        <path d="M21 28v-8h11v8"></path>
                        <rect x="37" y="22" width="18" height="34" rx="5"></rect>
                        <path d="M43 22v-9h6v9"></path>
                        <rect x="55" y="35" width="10" height="21" rx="3"></rect>
                        <circle cx="60" cy="60" r="6"></circle>
                        <circle cx="47" cy="63" r="4"></circle>
                      </svg>
                    {% when 'baby-kids' %}
                      <svg viewBox="0 0 80 80">
                        <circle cx="40" cy="41" r="19"></circle>
                        <path d="M27 28c0-7 5-12 12-12"></path>
                        <path d="M53 28c0-7-5-12-12-12"></path>
                        <circle cx="33" cy="39" r="2.5"></circle>
                        <circle cx="47" cy="39" r="2.5"></circle>
                        <path d="M34 48c2 3 5 5 10 5 4 0 7-2 9-5"></path>
                        <path d="M22 56c-4 0-7 3-7 7"></path>
                        <path d="M58 56c4 0 7 3 7 7"></path>
                      </svg>
                    {% when 'pets' %}
                      <svg viewBox="0 0 80 80">
                        <path d="M28 53c-7 0-12-5-12-12 0-8 6-14 14-14 5 0 9 2 12 6 2-1 4-2 7-2 8 0 14 6 14 14 0 7-5 12-12 12H28Z"></path>
                        <path d="M31 31c-2-7 1-13 7-15 6 2 9 8 7 15"></path>
                        <circle cx="32" cy="41" r="2.3"></circle>
                        <circle cx="49" cy="41" r="2.3"></circle>
                        <path d="M39 46c2 2 5 2 7 0"></path>
                        <path d="M58 31c5-6 11-5 13 1-1 5-5 8-11 8"></path>
                      </svg>
                    {% when 'general-health' %}
                      <svg viewBox="0 0 80 80">
                        <circle cx="40" cy="40" r="23"></circle>
                        <path d="M40 27v26"></path>
                        <path d="M27 40h26"></path>
                      </svg>
                    {% else %}
                      <svg viewBox="0 0 80 80">
                        <circle cx="40" cy="40" r="23"></circle>
                        <path d="M40 27v26"></path>
                        <path d="M27 40h26"></path>
                      </svg>
                  {% endcase %}
                </span>
              {% endif %}
            </span>
            <span class="shop-category-carousel__label">{{ category_title }}</span>
          </a>
        {% endfor %}
      </div>

      <button type="button" class="shop-category-carousel__nav shop-category-carousel__nav--next" aria-label="Next categories" data-category-carousel-next>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 18l6-6-6-6"></path>
        </svg>
      </button>
    </div>
  </div>
</section>

<style>
  .shop-category-carousel-section {
    padding: clamp(1.6rem, 3vw, 2.45rem) 0;
    background: #ffffff;
    border-top: 1px solid rgba(10, 40, 44, 0.1);
    border-bottom: 1px solid rgba(10, 40, 44, 0.1);
  }

  .shop-category-carousel__container {
    position: relative;
  }

  .shop-category-carousel__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: clamp(1rem, 1.8vw, 1.35rem);
  }

  .shop-category-carousel__header-copy {
    display: grid;
    gap: 0.28rem;
  }

  .shop-category-carousel__eyebrow {
    display: none;
    margin: 0;
    color: rgba(var(--brand-primary-rgb, 10, 40, 44), 0.68);
    font-family: var(--font-body, "DM Sans", "Segoe UI", sans-serif);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    line-height: 1;
    text-transform: uppercase;
  }

  .shop-category-carousel__title {
    margin: 0;
    color: var(--brand-primary, #0A282C);
    font-family: var(--font-title, "FuturaBT Bold", "DM Sans", sans-serif);
    font-size: clamp(1.25rem, 1.05rem + 0.65vw, 1.7rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: 0;
    -webkit-text-fill-color: currentColor;
  }

  .shop-category-carousel__shell {
    position: relative;
  }

  .shop-category-carousel__track {
    display: flex;
    gap: clamp(0.85rem, 1.35vw, 1.1rem);
    overflow-x: auto;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 0.1rem 0.1rem 0.25rem;
    margin: 0 -0.1rem;
    mask-image: none;
  }

  .shop-category-carousel__track::-webkit-scrollbar {
    display: none;
  }

  .shop-category-carousel__item {
    flex: 0 0 clamp(9.5rem, 12.8vw, 11.25rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    color: var(--brand-primary, #0A282C);
    text-align: center;
    text-decoration: none;
    scroll-snap-align: start;
    transition: transform 0.2s ease;
  }

  .shop-category-carousel__item:hover,
  .shop-category-carousel__item:focus-visible {
    color: #111111;
    transform: translateY(-0.12rem);
    outline: none;
  }

  .shop-category-carousel__orb {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: clamp(7.2rem, 9.5vw, 8.6rem);
    border-radius: 0.65rem;
    border: 1px solid rgba(var(--brand-primary-rgb, 10, 40, 44), 0.11);
    background: #ffffff;
    box-shadow: none;
    overflow: hidden;
    transition: transform 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .shop-category-carousel__orb--mist,
  .shop-category-carousel__orb--dew,
  .shop-category-carousel__orb--gold,
  .shop-category-carousel__orb--foam {
    background: #ffffff;
  }

  .shop-category-carousel__item:hover .shop-category-carousel__orb,
  .shop-category-carousel__item:focus-visible .shop-category-carousel__orb {
    transform: translateY(-0.08rem);
    box-shadow: none;
    border-color: #111111;
  }

  .shop-category-carousel__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 76px;
    height: 76px;
  }

  .shop-category-carousel__icon svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.25;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .shop-category-carousel__image {
    width: 74%;
    height: 74%;
    object-fit: contain;
  }

  .shop-category-carousel__label {
    display: block;
    min-height: 2.35em;
    color: currentColor;
    font-family: var(--font-body, "DM Sans", "Segoe UI", sans-serif);
    font-size: 0.92rem;
    font-weight: 800;
    line-height: 1.35;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.18em;
    transition: text-decoration-color 0.18s ease;
  }

  .shop-category-carousel__item:hover .shop-category-carousel__label,
  .shop-category-carousel__item:focus-visible .shop-category-carousel__label {
    text-decoration-color: currentColor;
  }

  .shop-category-carousel__nav {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.35rem;
    height: 2.35rem;
    border: 1px solid rgba(10, 40, 44, 0.16);
    border-radius: 999px;
    background: #ffffff;
    color: var(--brand-primary, #0A282C);
    cursor: pointer;
    box-shadow: none;
    transform: translateY(-50%);
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .shop-category-carousel__nav:hover,
  .shop-category-carousel__nav:focus-visible {
    background: #ffffff;
    color: #111111;
    border-color: #111111;
    outline: none;
  }

  .shop-category-carousel__nav:disabled {
    opacity: 0.42;
    cursor: not-allowed;
  }

  .shop-category-carousel__nav--prev {
    left: -1.1rem;
  }

  .shop-category-carousel__nav--next {
    right: -1.1rem;
  }

  @media (max-width: 767px) {
    .shop-category-carousel-section {
      padding: 1.7rem 0 2rem;
    }

    .shop-category-carousel__header {
      margin-bottom: 1rem;
    }

    .shop-category-carousel__title {
      font-size: 1.28rem;
    }

    .shop-category-carousel__item {
      flex-basis: 9.2rem;
      gap: 0.58rem;
    }

    .shop-category-carousel__orb {
      height: 7.2rem;
    }

    .shop-category-carousel__icon {
      width: 68px;
      height: 68px;
    }

    .shop-category-carousel__label {
      font-size: 0.92rem;
      min-height: 2.5em;
    }

    .shop-category-carousel__nav {
      display: none;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var section = document.getElementById('ShopCategoryCarousel-{{ section.id }}');
    if (!section) return;

    var track = section.querySelector('[data-category-carousel-track]');
    var prevButton = section.querySelector('[data-category-carousel-prev]');
    var nextButton = section.querySelector('[data-category-carousel-next]');

    if (!track || !prevButton || !nextButton) return;

    var getScrollAmount = function() {
      var item = track.querySelector('.shop-category-carousel__item');
      if (!item) return track.clientWidth * 0.8;

      var gap = parseFloat(window.getComputedStyle(track).gap || '0');
      return item.getBoundingClientRect().width + gap;
    };

    var updateNavState = function() {
      var maxScrollLeft = Math.max(0, track.scrollWidth - track.clientWidth);
      prevButton.disabled = track.scrollLeft <= 2;
      nextButton.disabled = track.scrollLeft >= maxScrollLeft - 2;
    };

    prevButton.addEventListener('click', function() {
      track.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' });
    });

    nextButton.addEventListener('click', function() {
      track.scrollBy({ left: getScrollAmount(), behavior: 'smooth' });
    });

    var frame = null;
    track.addEventListener('scroll', function() {
      if (frame) window.cancelAnimationFrame(frame);
      frame = window.requestAnimationFrame(function() {
        updateNavState();
        frame = null;
      });
    }, { passive: true });

    window.addEventListener('resize', updateNavState);
    updateNavState();
  });
</script>

{% schema %}
{
  "name": "Shop by category carousel",
  "tag": "section",
  "class": "section-shop-by-category-carousel",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Explore wellness collections"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Supplements"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Fallback link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Optional image"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Fallback icon",
          "default": "supplements",
          "options": [
            { "value": "supplements", "label": "Supplements" },
            { "value": "sports", "label": "Sports" },
            { "value": "bath-personal-care", "label": "Bath & Personal Care" },
            { "value": "beauty", "label": "Beauty" },
            { "value": "grocery", "label": "Grocery" },
            { "value": "home", "label": "Home" },
            { "value": "baby-kids", "label": "Baby & Kids" },
            { "value": "pets", "label": "Pets" },
            { "value": "general-health", "label": "General health" }
          ]
        },
        {
          "type": "select",
          "id": "tone",
          "label": "Orb tone",
          "default": "mist",
          "options": [
            { "value": "mist", "label": "Mist" },
            { "value": "dew", "label": "Dew" },
            { "value": "gold", "label": "Gold" },
            { "value": "foam", "label": "Foam" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by category carousel",
      "blocks": [
        { "type": "category", "settings": { "title": "Supplements", "icon": "supplements", "tone": "mist" } },
        { "type": "category", "settings": { "title": "Sports", "icon": "sports", "tone": "dew" } },
        { "type": "category", "settings": { "title": "Bath & Personal Care", "icon": "bath-personal-care", "tone": "gold" } },
        { "type": "category", "settings": { "title": "Beauty", "icon": "beauty", "tone": "mist" } },
        { "type": "category", "settings": { "title": "Grocery", "icon": "grocery", "tone": "dew" } },
        { "type": "category", "settings": { "title": "Home", "icon": "home", "tone": "gold" } },
        { "type": "category", "settings": { "title": "Baby & Kids", "icon": "baby-kids", "tone": "foam" } }
      ]
    }
  ]
}
{% endschema %}
