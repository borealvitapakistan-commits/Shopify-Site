{%- comment -%}
  Customer Login Page
{%- endcomment -%}

{%- liquid
  assign auth_logo_width = 220
  assign auth_logo_height = auth_logo_width | times: 84 | divided_by: 306
  assign help_url = '/pages/faq'
  if pages['faq'] != blank
    assign help_url = pages['faq'].url
  elsif pages['faqs'] != blank
    assign help_url = pages['faqs'].url
  elsif pages['contact-us'] != blank
    assign help_url = pages['contact-us'].url
  elsif pages['contact'] != blank
    assign help_url = pages['contact'].url
  endif
-%}

<div class="main-login">
  <div class="container">
    <div class="login-auth-shell">
      <div class="login-auth-brand">
        <a href="{{ routes.root_url }}" class="login-auth-brand__link" aria-label="{{ shop.name | escape }} home">
          <img
            src="{{ 'header-logo-color.png' | asset_url }}"
            alt="{{ shop.name | escape }}"
            class="login-auth-brand__logo"
            width="{{ auth_logo_width }}"
            height="{{ auth_logo_height }}"
            loading="eager"
          >
        </a>
      </div>

      <div class="login-auth-card">
        <div class="login-auth-card__top">
          <a href="{{ routes.root_url }}" class="login-auth-card__cancel">Cancel</a>
        </div>

        <div class="login-auth-card__header">
          <h1 class="login-auth-card__title">Sign in or create an account</h1>
          <p class="login-auth-card__subtitle">Choose your preferred method below to get started.</p>
        </div>

        <div class="login-auth-grid">
          <div class="login-auth-grid__form">
            <div class="login-auth-panel" data-login-panel>
              {%- form 'customer_login', class: 'auth-form login-auth-form' -%}
                {%- if form.errors -%}
                  <div class="form-error">
                    {{ form.errors | default_errors }}
                  </div>
                {%- endif -%}

                <div class="form-group">
                  <label for="CustomerEmail" class="visually-hidden">
                    {{ 'customer.login.email' | t }}
                  </label>
                  <input
                    type="email"
                    name="customer[email]"
                    id="CustomerEmail"
                    class="form-input login-auth-form__input"
                    autocomplete="email"
                    autocorrect="off"
                    autocapitalize="off"
                    required
                    placeholder="Email or mobile number"
                  >
                </div>

                <div class="form-group">
                  <label for="CustomerPassword" class="visually-hidden">
                    {{ 'customer.login.password' | t }}
                  </label>
                  <input
                    type="password"
                    name="customer[password]"
                    id="CustomerPassword"
                    class="form-input login-auth-form__input"
                    autocomplete="current-password"
                    required
                    placeholder="Password"
                  >
                </div>

                <button type="submit" class="btn btn-primary btn-full login-auth-form__submit">
                  Continue
                </button>

                <div class="login-auth-form__support">
                  <a href="{{ help_url }}" class="login-auth-form__help">Need help?</a>
                </div>

                <div class="auth-divider login-auth-form__divider">
                  <span>or</span>
                </div>

                <div class="login-auth-actions">
                  <a href="{{ routes.account_register_url }}" class="login-auth-action login-auth-action--secondary">
                    <span class="login-auth-action__icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24">
                        <path d="M12 5v14"/>
                        <path d="M5 12h14"/>
                      </svg>
                    </span>
                    <span>Create an account</span>
                  </a>

                  <button type="button" class="login-auth-action login-auth-action--secondary" id="RecoverPassword" data-open-recover>
                    <span class="login-auth-action__icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24">
                        <circle cx="12" cy="12" r="9"/>
                        <path d="M9.75 9.75a2.75 2.75 0 1 1 4.56 2.06c-.78.63-1.31 1.1-1.31 2.19"/>
                        <circle cx="12" cy="17.2" r="0.7" fill="currentColor" stroke="none"/>
                      </svg>
                    </span>
                    <span>{{ 'customer.login.forgot_password' | t }}</span>
                  </button>
                </div>

                <label class="checkbox-label login-auth-form__remember">
                  <input type="checkbox" name="remember_me">
                  <span>Keep me signed in</span>
                </label>

                <p class="terms-text login-auth-form__terms">
                  By continuing, you've read and agree to our
                  <a href="/policies/terms-of-service">Terms and Conditions</a>
                  and
                  <a href="/policies/privacy-policy">Privacy Policy</a>.
                </p>
              {%- endform -%}
            </div>

            <div class="login-auth-panel login-auth-panel--recover" data-recover-panel hidden>
              <div class="login-auth-panel__recover-header">
                <h2 class="login-auth-panel__recover-title">{{ 'customer.recover_password.title' | t }}</h2>
                <p class="login-auth-panel__recover-subtitle">{{ 'customer.recover_password.subtext' | t }}</p>
              </div>

              {%- form 'recover_customer_password', class: 'auth-form login-auth-form login-auth-form--recover' -%}
                {%- if form.posted_successfully? or form.errors -%}
                  <div class="login-auth-form__state" data-force-recover-open="true" hidden></div>
                {%- endif -%}

                {%- if form.posted_successfully? -%}
                  <div class="form-success">
                    {{ 'customer.recover_password.success' | t }}
                  </div>
                {%- endif -%}

                {%- if form.errors -%}
                  <div class="form-error">
                    {{ form.errors | default_errors }}
                  </div>
                {%- endif -%}

                <div class="form-group">
                  <label for="RecoverEmail" class="visually-hidden">
                    {{ 'customer.recover_password.email' | t }}
                  </label>
                  <input
                    type="email"
                    name="email"
                    id="RecoverEmail"
                    class="form-input login-auth-form__input"
                    autocomplete="email"
                    autocorrect="off"
                    autocapitalize="off"
                    required
                    placeholder="Email address"
                  >
                </div>

                <button type="submit" class="btn btn-primary btn-full login-auth-form__submit">
                  {{ 'customer.recover_password.submit' | t }}
                </button>

                <button type="button" class="login-auth-back-link" id="HideRecoverPasswordLink" data-close-recover>
                  <span aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                      <path d="m14 6-6 6 6 6"/>
                    </svg>
                  </span>
                  <span>{{ 'customer.recover_password.cancel' | t }}</span>
                </button>
              {%- endform -%}
            </div>
          </div>

          <aside class="login-auth-promise">
            <div class="login-auth-promise__eyebrow">
              <span class="login-auth-promise__badge" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path d="m12 2 2.7 2.1 3.4-.2 1.2 3.2 2.8 2-1.2 3.2.5 3.4-2.9 1.8-1.3 3.1-3.4-.3L12 22l-2.7-2.1-3.4.3-1.3-3.1-2.9-1.8.5-3.4-1.2-3.2 2.8-2 1.2-3.2 3.4.2Z"/>
                  <path d="m9 12.3 2 2 4-4.3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <span>Boreal Vita Quality Promise</span>
            </div>

            <p class="login-auth-promise__text">
              Quality you can trust, backed by how we source, verify, and store everyday wellness essentials.
            </p>

            <div class="login-auth-benefits">
              <div class="login-auth-benefit">
                <span class="login-auth-benefit__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24">
                    <path d="M12 3 5 6v5c0 4.4 3 8.5 7 9.5 4-1 7-5.1 7-9.5V6Z"/>
                    <path d="m9.5 12.2 1.7 1.7 3.3-3.6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                <span>Authentic products</span>
              </div>

              <div class="login-auth-benefit">
                <span class="login-auth-benefit__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24">
                    <path d="M4 19h16"/>
                    <path d="M7 19V8h10v11"/>
                    <path d="M9.5 8V5h5v3"/>
                    <path d="M9 12h6"/>
                    <path d="M9 15h4"/>
                  </svg>
                </span>
                <span>Tested ingredients</span>
              </div>

              <div class="login-auth-benefit">
                <span class="login-auth-benefit__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24">
                    <path d="M12 4c3.9 0 7 2.7 7 6 0 5-7 10-7 10S5 15 5 10c0-3.3 3.1-6 7-6Z"/>
                    <path d="M9 10c.8-1 1.8-1.6 3-1.6S14.2 9 15 10"/>
                  </svg>
                </span>
                <span>Preserved freshness</span>
              </div>

              <div class="login-auth-benefit">
                <span class="login-auth-benefit__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24">
                    <path d="M7 18a2 2 0 1 0 0 .1"/>
                    <path d="M17 18a2 2 0 1 0 0 .1"/>
                    <path d="M6 6h15l-1.5 7.5H8L6 3H3"/>
                  </svg>
                </span>
                <span>Easy returns and refunds</span>
              </div>
            </div>

            <div class="login-auth-rating">
              <span class="login-auth-rating__chip">BV</span>
              <div class="login-auth-rating__content">
                <div class="login-auth-rating__score">
                  <strong>4.8</strong>
                  <span class="login-auth-rating__stars" role="img" aria-label="Rated 4.8 out of 5">★★★★☆</span>
                </div>
                <span class="login-auth-rating__caption">Boreal Vita store reviews</span>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const loginPanel = document.querySelector('[data-login-panel]');
    const recoverPanel = document.querySelector('[data-recover-panel]');
    const openRecoverTrigger = document.querySelector('[data-open-recover]');
    const closeRecoverTrigger = document.querySelector('[data-close-recover]');
    const forceRecoverOpen = document.querySelector('[data-force-recover-open]');

    if (!loginPanel || !recoverPanel) return;

    const setRecoverOpen = function(isOpen) {
      loginPanel.hidden = isOpen;
      recoverPanel.hidden = !isOpen;
      window.location.hash = isOpen ? 'recover' : 'login';
    };

    if (window.location.hash === '#recover' || forceRecoverOpen) {
      setRecoverOpen(true);
    }

    openRecoverTrigger?.addEventListener('click', function(event) {
      event.preventDefault();
      setRecoverOpen(true);
    });

    closeRecoverTrigger?.addEventListener('click', function(event) {
      event.preventDefault();
      setRecoverOpen(false);
    });
  });
</script>

{% schema %}
{
  "name": "Login",
  "settings": [],
  "presets": [
    {
      "name": "Login"
    }
  ]
}
{% endschema %}
