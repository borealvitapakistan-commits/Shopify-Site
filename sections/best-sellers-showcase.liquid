{%- assign best_seller_products_collection_handle = section.settings.products_collection | default: 'all' -%}
{%- assign best_seller_products_collection = collections[best_seller_products_collection_handle] -%}

<section class="best-sellers-showcase" id="BestSellersShowcase-{{ section.id }}">
  <div class="container">
    <div class="best-sellers-showcase__inner">
      {% if section.settings.heading != blank %}
        <h2 class="section-title best-sellers-showcase__title">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <p class="best-sellers-showcase__subheading">{{ section.settings.subheading }}</p>
      {% endif %}

      <div class="best-sellers-showcase__tabs" role="tablist" aria-label="Best sellers categories">
        <button
          class="best-sellers-showcase__tab is-active"
          type="button"
          role="tab"
          aria-selected="true"
          aria-controls="BestSellersPanel-{{ section.id }}-support"
          id="BestSellersTab-{{ section.id }}-support"
          data-best-sellers-tab="support"
        >
          {{ section.settings.support_tab_label | default: 'Support' }}
        </button>
        <button
          class="best-sellers-showcase__tab"
          type="button"
          role="tab"
          aria-selected="false"
          aria-controls="BestSellersPanel-{{ section.id }}-brands"
          id="BestSellersTab-{{ section.id }}-brands"
          data-best-sellers-tab="brands"
        >
          {{ section.settings.brands_tab_label | default: 'Brands' }}
        </button>
        <button
          class="best-sellers-showcase__tab"
          type="button"
          role="tab"
          aria-selected="false"
          aria-controls="BestSellersPanel-{{ section.id }}-products"
          id="BestSellersTab-{{ section.id }}-products"
          data-best-sellers-tab="products"
        >
          {{ section.settings.products_tab_label | default: 'Products' }}
        </button>
      </div>

      <div class="best-sellers-showcase__panels">
        <div
          class="best-sellers-showcase__panel is-active"
          id="BestSellersPanel-{{ section.id }}-support"
          role="tabpanel"
          aria-labelledby="BestSellersTab-{{ section.id }}-support"
          data-best-sellers-panel="support"
        >
          <div class="best-sellers-showcase__grid">
            {%- assign support_count = 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'item' -%}
                {%- assign support_count = support_count | plus: 1 -%}
                {% liquid
                  assign card_collection = collections[block.settings.collection]
                  assign card_title = block.settings.title | default: card_collection.title | default: 'Support'
                  assign card_link = block.settings.link | default: card_collection.url | default: routes.all_products_collection_url
                  assign card_image = block.settings.image
                  assign icon_asset = ''
                  case block.settings.icon
                    when 'general-health'
                      assign icon_asset = 'category-general-health.png'
                    when 'gentle-health'
                      assign icon_asset = 'category-gentle-health.png'
                    when 'vitamins'
                      assign icon_asset = 'category-vitamins.png'
                    when 'nutrition'
                      assign icon_asset = 'category-nutrition.png'
                    when 'nutritional'
                      assign icon_asset = 'category-nutritional.png'
                    when 'antioxidants'
                      assign icon_asset = 'category-antioxidants.png'
                    when 'performance'
                      assign icon_asset = 'category-performance.png'
                    when 'minerals'
                      assign icon_asset = 'category-minerals.png'
                    when 'oils'
                      assign icon_asset = 'category-oils.png'
                  endcase
                %}
                <a href="{{ card_link }}" class="best-sellers-card best-sellers-card--support" {{ block.shopify_attributes }}>
                  <span class="best-sellers-card__media">
                    {% if card_image != blank %}
                      {{
                        card_image
                        | image_url: width: 520
                        | image_tag:
                          class: 'best-sellers-card__image',
                          alt: card_title,
                          loading: 'lazy',
                          widths: '180, 240, 320, 420, 520',
                          sizes: '(min-width: 1200px) 220px, (min-width: 768px) 22vw, 44vw'
                      }}
                    {% elsif icon_asset != blank %}
                      <img
                        class="best-sellers-card__image best-sellers-card__image--icon"
                        src="{{ icon_asset | asset_url }}"
                        alt="{{ card_title | escape }}"
                        loading="lazy"
                        width="220"
                        height="220"
                      >
                    {% else %}
                      {{ 'collection-1' | placeholder_svg_tag: 'best-sellers-card__image best-sellers-card__image--placeholder' }}
                    {% endif %}
                  </span>
                  <span class="best-sellers-card__title">{{ card_title }}</span>
                </a>
              {%- endif -%}
            {%- endfor -%}

            {%- if support_count == 0 -%}
              {%- assign support_titles = 'Immune Support|Mood Support|Daily Support|Adaptogen Support' | split: '|' -%}
              {%- assign support_assets = 'category-vitamins.png|category-oils.png|category-general-health.png|category-nutritional.png' | split: '|' -%}
              {%- for title in support_titles -%}
                <a href="{{ routes.all_products_collection_url }}" class="best-sellers-card best-sellers-card--support">
                  <span class="best-sellers-card__media">
                    <img
                      class="best-sellers-card__image best-sellers-card__image--icon"
                      src="{{ support_assets[forloop.index0] | asset_url }}"
                      alt="{{ title | escape }}"
                      loading="lazy"
                      width="220"
                      height="220"
                    >
                  </span>
                  <span class="best-sellers-card__title">{{ title }}</span>
                </a>
              {%- endfor -%}
            {%- endif -%}
          </div>
        </div>

        <div
          class="best-sellers-showcase__panel"
          id="BestSellersPanel-{{ section.id }}-brands"
          role="tabpanel"
          aria-labelledby="BestSellersTab-{{ section.id }}-brands"
          hidden
          data-best-sellers-panel="brands"
        >
          <div class="best-sellers-showcase__grid best-sellers-showcase__grid--brands">
            {%- assign brand_count = 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'brand' -%}
                {%- assign brand_count = brand_count | plus: 1 -%}
                {% liquid
                  assign brand_title = block.settings.title | default: 'Brand'
                  assign brand_link = block.settings.link | default: routes.all_products_collection_url
                  assign brand_image = block.settings.image
                %}
                <a href="{{ brand_link }}" class="best-sellers-card best-sellers-card--brand" {{ block.shopify_attributes }}>
                  <span class="best-sellers-card__brand-media">
                    {% if brand_image != blank %}
                      {{
                        brand_image
                        | image_url: width: 420
                        | image_tag:
                          class: 'best-sellers-card__brand-image',
                          alt: brand_title,
                          loading: 'lazy',
                          widths: '180, 240, 320, 420',
                          sizes: '(min-width: 1200px) 220px, (min-width: 768px) 22vw, 44vw'
                      }}
                    {% else %}
                      <span class="best-sellers-card__brand-wordmark">{{ brand_title }}</span>
                    {% endif %}
                  </span>
                  {% if brand_image != blank %}
                    <span class="best-sellers-card__brand-label">{{ brand_title }}</span>
                  {% endif %}
                </a>
              {%- endif -%}
            {%- endfor -%}

            {%- if brand_count == 0 -%}
              {%- assign fallback_brand_titles = 'Logo One|Logo Two|Logo Three|Logo Four' | split: '|' -%}
              {%- for brand_title in fallback_brand_titles -%}
                <a href="{{ routes.all_products_collection_url }}" class="best-sellers-card best-sellers-card--brand">
                  <span class="best-sellers-card__brand-media">
                    <span class="best-sellers-card__brand-wordmark">{{ brand_title }}</span>
                  </span>
                </a>
              {%- endfor -%}
            {%- endif -%}
          </div>
        </div>

        <div
          class="best-sellers-showcase__panel"
          id="BestSellersPanel-{{ section.id }}-products"
          role="tabpanel"
          aria-labelledby="BestSellersTab-{{ section.id }}-products"
          hidden
          data-best-sellers-panel="products"
        >
          <div class="best-sellers-showcase__product-grid">
            {% if best_seller_products_collection != blank %}
              {% for product in best_seller_products_collection.products limit: section.settings.products_to_show %}
                {% render 'product-card-amzn',
                  product: product,
                  show_rating: false,
                  show_pricing: true,
                  show_unit_price: false,
                  show_delivery: false,
                  show_social_proof: false,
                  show_add_to_cart: false
                %}
              {% else %}
                <div class="best-sellers-showcase__empty">No products found in this collection.</div>
              {% endfor %}
            {% else %}
              <div class="best-sellers-showcase__empty">Assign a collection to show products here.</div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #BestSellersShowcase-{{ section.id }} {
    padding: clamp(2.25rem, 3.8vw, 3.75rem) 0;
    background:
      radial-gradient(circle at 50% 0%, rgba(var(--brand-green-rgb, 250, 208, 84), 0.08), transparent 22rem),
      linear-gradient(180deg, #ffffff 0%, rgba(var(--brand-purple-rgb, 10, 40, 44), 0.035) 100%);
  }

  #BestSellersShowcase-{{ section.id }} .best-sellers-showcase__inner {
    width: min(1500px, 100%);
    margin: 0 auto;
    text-align: center;
  }

  #BestSellersShowcase-{{ section.id }} .best-sellers-showcase__title.section-title {
    display: block;
    margin-bottom: 0.55rem;
    text-align: center;
  }

  #BestSellersShowcase-{{ section.id }} .best-sellers-showcase__subheading {
    width: min(760px, 100%);
    margin: 0 auto 1.5rem;
    color: var(--color-muted-foreground, #33585D);
    font-size: clamp(1rem, 1.3vw, 1.14rem);
    line-height: 1.6;
    text-align: center;
  }

  #BestSellersShowcase-{{ section.id }} .best-sellers-showcase__tabs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin: 0 0 1.4rem;
  }

  #BestSellersShowcase-{{ section.id }} .best-sellers-showcase__tab {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: min(100%, 200px);
    min-height: 50px;
    padding: 0.78rem 1.45rem;
    border: 2px solid rgba(var(--color-primary-rgb, 10, 40, 44), 0.32);
    border-radius: 16px;
    background: #ffffff;
    color: var(--brand-purple, #0A282C);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1;
    transition: transform 0.18s ease, border-color 0.18s ease, background-color 0.18s ease, box-shadow 0.18s ease, color 0.18s ease;
  }

  #BestSellersShowcase-{{ section.id }} .best-sellers-showcase__tab:hover,
  #BestSellersShowcase-{{ section.id }} .best-sellers-showcase__tab:focus-visible {
    transform: translateY(-1px);
    border-color: var(--brand-green, #FAD054);
    box-shadow: 0 10px 24px rgba(var(--color-primary-rgb, 10, 40, 44), 0.08);
    outline: none;
  }

  #BestSellersShowcase-{{ section.id }} .best-sellers-showcase__tab.is-active {
    background: var(--brand-title-gradient, linear-gradient(135deg, #0A282C 0%, #163E43 100%));
    border-color: transparent;
    color: #ffffff;
    box-shadow: 0 12px 28px rgba(var(--color-primary-rgb, 10, 40, 44), 0.14);
  }

  #BestSellersShowcase-{{ section.id }} .best-sellers-showcase__panel {
    display: none;
  }

  #BestSellersShowcase-{{ section.id }} .best-sellers-showcase__panel.is-active {
    display: block;
  }

  #BestSellersShowcase-{{ section.id }} .best-sellers-showcase__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    align-items: stretch;
    justify-content: center;
  }

  #BestSellersShowcase-{{ section.id }} .best-sellers-showcase__product-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    align-items: stretch;
    justify-items: center;
    justify-content: center;
  }

  #BestSellersShowcase-{{ section.id }} .best-sellers-showcase__product-grid .amzn-card {
    width: 100%;
    max-width: 240px;
    height: 100%;
  }

  #BestSellersShowcase-{{ section.id }} .best-sellers-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    min-height: 100%;
    width: 100%;
    max-width: 240px;
    padding: 0.9rem 0.8rem 0.82rem;
    border: 1px solid rgba(var(--color-primary-rgb, 10, 40, 44), 0.12);
    border-radius: 18px;
    background: #ffffff;
    box-shadow: 0 8px 22px rgba(var(--color-primary-rgb, 10, 40, 44), 0.05);
    text-decoration: none;
    transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
  }

  #BestSellersShowcase-{{ section.id }} .best-sellers-card:hover,
  #BestSellersShowcase-{{ section.id }} .best-sellers-card:focus-visible {
    transform: translateY(-4px);
    border-color: rgba(var(--brand-green-rgb, 250, 208, 84), 0.52);
    box-shadow: 0 18px 36px rgba(var(--color-primary-rgb, 10, 40, 44), 0.12);
    outline: none;
  }

  #BestSellersShowcase-{{ section.id }} .best-sellers-card__media {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 132px;
    padding: 0.2rem 0.5rem 0;
  }

  #BestSellersShowcase-{{ section.id }} .best-sellers-card__image {
    width: min(152px, 78%);
    max-width: 100%;
    height: auto;
    object-fit: contain;
    transition: transform 0.24s ease;
  }

  #BestSellersShowcase-{{ section.id }} .best-sellers-card:hover .best-sellers-card__image,
  #BestSellersShowcase-{{ section.id }} .best-sellers-card:focus-visible .best-sellers-card__image {
    transform: scale(1.04);
  }

  #BestSellersShowcase-{{ section.id }} .best-sellers-card__image--icon {
    filter: saturate(0.94);
  }

  #BestSellersShowcase-{{ section.id }} .best-sellers-card__image--placeholder {
    width: min(152px, 78%);
    height: auto;
    color: rgba(var(--color-primary-rgb, 10, 40, 44), 0.18);
  }

  #BestSellersShowcase-{{ section.id }} .best-sellers-card__title {
    color: var(--brand-purple-dark, #06181B);
    font-size: clamp(0.98rem, 1.15vw, 1.18rem);
    font-weight: 700;
    line-height: 1.24;
    text-align: center;
    text-wrap: balance;
  }

  #BestSellersShowcase-{{ section.id }} .best-sellers-card__brand-media {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 72px;
  }

  #BestSellersShowcase-{{ section.id }} .best-sellers-card__brand-image {
    max-width: min(150px, 100%);
    max-height: 46px;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  #BestSellersShowcase-{{ section.id }} .best-sellers-card__brand-wordmark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    color: var(--brand-purple, #0A282C);
    font-size: clamp(0.88rem, 1.05vw, 0.98rem);
    font-weight: 800;
    letter-spacing: 0.06em;
    line-height: 1.12;
    text-transform: uppercase;
    text-align: center;
  }

  #BestSellersShowcase-{{ section.id }} .best-sellers-card__brand-label {
    color: var(--color-muted-foreground, #33585D);
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
  }

  #BestSellersShowcase-{{ section.id }} .best-sellers-showcase__empty {
    grid-column: 1 / -1;
    padding: 1.6rem;
    border: 1px dashed rgba(var(--color-primary-rgb, 10, 40, 44), 0.18);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.72);
    color: var(--color-muted-foreground, #33585D);
    text-align: center;
  }

  @media (min-width: 768px) {
    #BestSellersShowcase-{{ section.id }} .best-sellers-showcase__grid {
      grid-template-columns: repeat(4, minmax(180px, 240px));
      gap: 1.15rem;
    }

    #BestSellersShowcase-{{ section.id }} .best-sellers-showcase__product-grid {
      grid-template-columns: repeat(4, minmax(180px, 240px));
    }
  }

  @media (max-width: 767px) {
    #BestSellersShowcase-{{ section.id }} .best-sellers-showcase__tabs {
      gap: 0.75rem;
    }

    #BestSellersShowcase-{{ section.id }} .best-sellers-showcase__tab {
      width: 100%;
    }
  }

  @media (max-width: 560px) {
    #BestSellersShowcase-{{ section.id }} .best-sellers-showcase__grid,
    #BestSellersShowcase-{{ section.id }} .best-sellers-showcase__product-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (min-width: 768px) and (max-width: 1099px) {
    #BestSellersShowcase-{{ section.id }} .best-sellers-showcase__grid,
    #BestSellersShowcase-{{ section.id }} .best-sellers-showcase__product-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 420px) {
    #BestSellersShowcase-{{ section.id }} .best-sellers-showcase__product-grid .amzn-card,
    #BestSellersShowcase-{{ section.id }} .best-sellers-card {
      max-width: none;
    }
  }
</style>

<script>
  (function() {
    var section = document.getElementById('BestSellersShowcase-{{ section.id }}');
    if (!section) return;

    var tabs = Array.prototype.slice.call(section.querySelectorAll('[data-best-sellers-tab]'));
    var panels = Array.prototype.slice.call(section.querySelectorAll('[data-best-sellers-panel]'));

    if (!tabs.length || !panels.length) return;

    var activateTab = function(tabId) {
      tabs.forEach(function(tab) {
        var isActive = tab.getAttribute('data-best-sellers-tab') === tabId;
        tab.classList.toggle('is-active', isActive);
        tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });

      panels.forEach(function(panel) {
        var isActive = panel.getAttribute('data-best-sellers-panel') === tabId;
        panel.classList.toggle('is-active', isActive);
        panel.hidden = !isActive;
      });
    };

    tabs.forEach(function(tab, index) {
      tab.addEventListener('click', function() {
        activateTab(tab.getAttribute('data-best-sellers-tab'));
      });

      tab.addEventListener('keydown', function(event) {
        if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;

        event.preventDefault();
        var direction = event.key === 'ArrowRight' ? 1 : -1;
        var nextIndex = (index + direction + tabs.length) % tabs.length;
        tabs[nextIndex].focus();
        activateTab(tabs[nextIndex].getAttribute('data-best-sellers-tab'));
      });
    });
  })();
</script>

