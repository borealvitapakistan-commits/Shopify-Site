{%- comment -%}
  Product Gallery
  - Secondary image grid from product.images
{%- endcomment -%}

{% assign gallery_count = 0 %}
{% assign use_positions = false %}
{% if section.settings.image_positions != blank %}
  {% assign use_positions = true %}
{% endif %}

{% capture gallery_markup %}
  {% if use_positions %}
    {% assign positions = section.settings.image_positions | split: ',' %}
    {% for pos in positions %}
      {% assign index = pos | strip | plus: 0 %}
      {% if index > 0 %}
        {% assign index_zero = index | minus: 1 %}
        {% assign image = product.images[index_zero] %}
        {% if image != blank %}
          {% assign gallery_count = gallery_count | plus: 1 %}
          {% if section.settings.enable_lightbox %}
            <button class="product-gallery__item" type="button" data-lightbox-src="{{ image | image_url: width: 2000 }}">
              <img
                src="{{ image | image_url: width: 900 }}"
                alt="{{ image.alt | default: product.title | escape }}"
                width="{{ image.width }}"
                height="{{ image.height }}"
                loading="lazy"
              >
            </button>
          {% else %}
            <div class="product-gallery__item">
              <img
                src="{{ image | image_url: width: 900 }}"
                alt="{{ image.alt | default: product.title | escape }}"
                width="{{ image.width }}"
                height="{{ image.height }}"
                loading="lazy"
              >
            </div>
          {% endif %}
        {% endif %}
      {% endif %}
      {% if section.settings.image_limit > 0 and gallery_count >= section.settings.image_limit %}
        {% break %}
      {% endif %}
    {% endfor %}
  {% else %}
    {% assign skipped = 0 %}
    {% for image in product.images %}
      {% if section.settings.skip_first > 0 and skipped < section.settings.skip_first %}
        {% assign skipped = skipped | plus: 1 %}
        {% continue %}
      {% endif %}
      {% if section.settings.image_limit > 0 and gallery_count >= section.settings.image_limit %}
        {% break %}
      {% endif %}
      {% assign gallery_count = gallery_count | plus: 1 %}
      {% if section.settings.enable_lightbox %}
        <button class="product-gallery__item" type="button" data-lightbox-src="{{ image | image_url: width: 2000 }}">
          <img
            src="{{ image | image_url: width: 900 }}"
            alt="{{ image.alt | default: product.title | escape }}"
            width="{{ image.width }}"
            height="{{ image.height }}"
            loading="lazy"
          >
        </button>
      {% else %}
        <div class="product-gallery__item">
          <img
            src="{{ image | image_url: width: 900 }}"
            alt="{{ image.alt | default: product.title | escape }}"
            width="{{ image.width }}"
            height="{{ image.height }}"
            loading="lazy"
          >
        </div>
      {% endif %}
    {% endfor %}
  {% endif %}
{% endcapture %}

{% if gallery_count > 0 %}
  <section class="product-gallery" id="ProductGallery-{{ section.id }}" data-gallery>
    <div class="container">
      {% if section.settings.heading != blank %}
        <h2 class="product-section-heading">{{ section.settings.heading }}</h2>
      {% endif %}
      <div class="product-gallery__grid" style="--gallery-columns: {{ section.settings.columns_desktop }};">
        {{ gallery_markup }}
      </div>
    </div>

    {% if section.settings.enable_lightbox %}
      <div class="product-gallery__lightbox" data-lightbox hidden>
        <button class="product-gallery__lightbox-close" type="button" data-lightbox-close aria-label="Close">
          &times;
        </button>
        <img
          class="product-gallery__lightbox-image"
          data-lightbox-image
          alt="Expanded product image"
          width="1200"
          height="1200"
        >
      </div>
    {% endif %}
  </section>

  <style>
    .product-gallery {
      padding: 2.5rem 0;
      background: #fff;
    }

    .product-gallery__grid {
      display: grid;
      grid-template-columns: repeat(var(--gallery-columns, 3), minmax(0, 1fr));
      gap: 1rem;
    }

    .product-gallery__item {
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
      padding: 0;
      background: #fff;
      overflow: hidden;
      cursor: pointer;
    }

    .product-gallery__item img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .product-gallery__lightbox {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.65);
      display: grid;
      place-items: center;
      padding: 2rem;
      z-index: 50;
    }

    .product-gallery__lightbox-image {
      max-width: min(900px, 90vw);
      max-height: 80vh;
      border-radius: var(--radius);
      background: #fff;
    }

    .product-gallery__lightbox-close {
      position: absolute;
      top: 24px;
      right: 24px;
      width: 40px;
      height: 40px;
      border-radius: 50%;
      border: none;
      background: #fff;
      font-size: 1rem;
      cursor: pointer;
    }

    @media (max-width: 900px) {
      .product-gallery__grid {
        grid-template-columns: repeat({{ section.settings.columns_mobile }}, minmax(0, 1fr));
      }
    }
  </style>

  {% if section.settings.enable_lightbox %}
    <script>
      (function() {
        const section = document.getElementById('ProductGallery-{{ section.id }}');
        if (!section) return;
        const lightbox = section.querySelector('[data-lightbox]');
        if (!lightbox) return;
        const image = lightbox.querySelector('[data-lightbox-image]');
        const closeBtn = lightbox.querySelector('[data-lightbox-close]');
        const triggers = Array.from(section.querySelectorAll('[data-lightbox-src]'));

        const open = (src, alt) => {
          image.src = src;
          image.alt = alt || '';
          lightbox.hidden = false;
          document.body.style.overflow = 'hidden';
        };

        const close = () => {
          lightbox.hidden = true;
          image.src = '';
          document.body.style.overflow = '';
        };

        triggers.forEach((trigger) => {
          trigger.addEventListener('click', () => {
            const img = trigger.querySelector('img');
            open(trigger.dataset.lightboxSrc, img ? img.alt : '');
          });
        });

        closeBtn.addEventListener('click', close);
        lightbox.addEventListener('click', (event) => {
          if (event.target === lightbox) close();
        });

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') close();
        });
      })();
    </script>
  {% endif %}
{% endif %}

{% schema %}
{
  "name": "Product gallery",
  "tag": "section",
  "class": "section-product-gallery",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Product gallery"
    },
    {
      "type": "range",
      "id": "image_limit",
      "label": "Max images",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "skip_first",
      "label": "Skip first images",
      "min": 0,
      "max": 5,
      "step": 1,
      "default": 1
    },
    {
      "type": "text",
      "id": "image_positions",
      "label": "Specific image positions (comma-separated)",
      "info": "Example: 2,3,5. Leave blank to use sequential images."
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "checkbox",
      "id": "enable_lightbox",
      "label": "Enable lightbox",
      "default": true
    }
  ]
}
{% endschema %}
