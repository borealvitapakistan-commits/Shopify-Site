{%- comment -%}
  Shop by Health Benefit grid shown below the Wellness Bundles section.
{%- endcomment -%}

<section class="health-benefit-grid-section" id="HealthBenefitGrid-{{ section.id }}">
  <div class="container health-benefit-grid__container">
    {% if section.settings.heading != blank %}
      <div class="health-benefit-grid__header">
        <h2 class="health-benefit-grid__title">{{ section.settings.heading }}</h2>
      </div>
    {% endif %}

    <div class="health-benefit-grid">
      {% for block in section.blocks %}
        {% liquid
          assign benefit_link = block.settings.collection.url | default: block.settings.link | default: routes.all_products_collection_url
          assign benefit_title = block.settings.title | default: block.settings.collection.title | default: 'Health Benefit'
          assign benefit_text = block.settings.text
          assign benefit_icon = block.settings.icon | default: 'immune'
        %}
        <a class="health-benefit-card" href="{{ benefit_link }}" {{ block.shopify_attributes }}>
          <span class="health-benefit-card__icon-wrap" aria-hidden="true">
            <span class="health-benefit-card__icon-ring"></span>
            <span class="health-benefit-card__icon">
              {% case benefit_icon %}
                {% when 'beauty' %}
                  <svg viewBox="0 0 80 80">
                    <path d="M24 58c2-17 6-27 16-39"/>
                    <path d="M37 20c6-4 12-4 18 0"/>
                    <path d="M32 56c7-4 14-5 21-2"/>
                    <path d="M24 58c10 5 23 5 34 0"/>
                    <path d="M35 22c-4 7-3 13 2 18"/>
                    <path d="M47 21c5 8 5 16-1 22"/>
                  </svg>
                {% when 'immune' %}
                  <svg viewBox="0 0 80 80">
                    <path d="M40 63S21 54 21 33V21c8 0 14-3 19-8 5 5 11 8 19 8v12c0 21-19 30-19 30Z"/>
                    <path d="m31 39 7 7 13-17"/>
                    <path d="M40 21v6"/>
                  </svg>
                {% when 'energy' %}
                  <svg viewBox="0 0 80 80">
                    <path d="M43 8 22 45h17l-3 27 22-39H41l2-25Z"/>
                  </svg>
                {% when 'heart' %}
                  <svg viewBox="0 0 80 80">
                    <path d="M14 42h13l6-14 9 28 8-20h16"/>
                    <path d="M24 30c0-9 6-16 15-16 5 0 9 2 12 6 3-4 7-6 12-6 9 0 15 7 15 16 0 15-25 30-27 32-1-1-8-5-15-11"/>
                  </svg>
                {% when 'bone' %}
                  <svg viewBox="0 0 80 80">
                    <path d="M25 28c-5 0-9-4-9-9s4-9 9-9c4 0 7 2 8 5h14c1-3 4-5 8-5 5 0 9 4 9 9s-4 9-9 9c-4 0-7-2-8-5H33c-1 3-4 5-8 5Z"/>
                    <path d="M55 52c5 0 9 4 9 9s-4 9-9 9c-4 0-7-2-8-5H33c-1 3-4 5-8 5-5 0-9-4-9-9s4-9 9-9c4 0 7 2 8 5h14c1-3 4-5 8-5Z"/>
                    <path d="M31 24 49 56"/>
                  </svg>
                {% when 'brain' %}
                  <svg viewBox="0 0 80 80">
                    <path d="M31 58c-8 0-14-6-14-13 0-5 3-9 7-11 0-8 6-14 14-14 4 0 8 2 10 5 8-1 15 5 15 13 5 2 8 7 8 13 0 8-7 14-15 14"/>
                    <path d="M35 24c-4 3-6 7-5 12"/>
                    <path d="M47 23c4 3 6 8 4 13"/>
                    <path d="M27 44c5 2 10 1 14-2"/>
                    <path d="M45 45c4 1 7 3 10 7"/>
                  </svg>
                {% when 'digestive' %}
                  <svg viewBox="0 0 80 80">
                    <path d="M31 18c-8 2-13 8-13 16 0 7 4 13 11 15"/>
                    <path d="M49 18c8 2 13 8 13 16 0 7-4 13-11 15"/>
                    <path d="M33 18v30c0 8 5 13 12 13 6 0 10-4 10-10 0-7-6-10-12-7"/>
                    <path d="M51 18v22"/>
                    <path d="M29 35h12"/>
                  </svg>
                {% when 'stress' %}
                  <svg viewBox="0 0 80 80">
                    <path d="M40 60c-14 0-24-10-24-24s10-24 24-24 24 10 24 24-10 24-24 24Z"/>
                    <path d="M40 50c-6 0-11-5-11-11V28"/>
                    <path d="M40 22v-7M57 27l4-6M63 42h7M23 27l-4-6"/>
                    <path d="M34 34c3-2 9-2 12 0"/>
                  </svg>
                {% when 'sleep' %}
                  <svg viewBox="0 0 80 80">
                    <path d="M52 16c-14 2-25 14-25 29 0 8 3 15 9 20-13-2-23-13-23-27 0-15 12-27 27-27 4 0 8 1 12 5Z"/>
                    <path d="M54 20h11l-11 13h11"/>
                    <path d="M57 39h9l-9 11h9"/>
                  </svg>
                {% else %}
                  <svg viewBox="0 0 80 80">
                    <circle cx="40" cy="40" r="23"/>
                    <path d="M40 27v26"/>
                    <path d="M27 40h26"/>
                  </svg>
              {% endcase %}
            </span>
          </span>
          <span class="health-benefit-card__title">{{ benefit_title }}</span>
          {% if benefit_text != blank %}
            <span class="health-benefit-card__text">{{ benefit_text }}</span>
          {% endif %}
        </a>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .health-benefit-grid-section {
    padding: clamp(2rem, 4vw, 3.35rem) 0 clamp(2.3rem, 4.5vw, 3.8rem);
    background: #ffffff;
  }

  .health-benefit-grid__container {
    max-width: 1320px;
  }

  .health-benefit-grid__header {
    margin-bottom: clamp(1.35rem, 2.8vw, 2.2rem);
    text-align: left;
  }

  .health-benefit-grid__title {
    margin: 0;
    color: var(--brand-primary, #0A282C);
    background: none;
    -webkit-background-clip: initial;
    background-clip: initial;
    -webkit-text-fill-color: currentColor;
    font-family: var(--font-title, "FuturaBT Bold", "DM Sans", sans-serif);
    font-size: clamp(1.35rem, 1.08rem + 0.95vw, 2.2rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: 0.01em;
  }

  .health-benefit-grid {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 0.85rem;
  }

  @media (min-width: 640px) {
    .health-benefit-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.15rem;
    }
  }

  @media (min-width: 990px) {
    .health-benefit-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }

  @media (min-width: 1200px) {
    .health-benefit-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 0.9rem;
    }
  }

  .health-benefit-card {
    display: grid;
    align-content: start;
    justify-items: center;
    gap: 0.78rem;
    min-height: 214px;
    padding: 1.35rem 0.9rem 1.1rem;
    border: 1px solid rgba(var(--brand-primary-rgb, 10, 40, 44), 0.08);
    border-radius: 12px;
    background: #ffffff;
    color: var(--brand-primary, #0A282C);
    text-align: center;
    text-decoration: none;
    box-shadow: 0 0.7rem 1.6rem rgba(10, 40, 44, 0.05);
    transition:
      transform 0.22s ease,
      box-shadow 0.22s ease,
      border-color 0.22s ease;
  }

  .health-benefit-card:hover,
  .health-benefit-card:focus-visible {
    outline: none;
    transform: translateY(-2px);
    border-color: rgba(var(--brand-primary-rgb, 10, 40, 44), 0.2);
    box-shadow: 0 1rem 1.9rem rgba(10, 40, 44, 0.08);
  }

  .health-benefit-card__icon-wrap {
    position: relative;
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    margin-top: 0.2rem;
  }

  .health-benefit-card__icon-ring {
    position: absolute;
    inset: 0;
    display: none;
  }

  .health-benefit-card__icon {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    color: var(--brand-primary, #0A282C);
  }

  .health-benefit-card__icon svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .health-benefit-card__title {
    display: block;
    max-width: 13ch;
    color: var(--brand-primary, #0A282C);
    font-family: var(--font-title, "FuturaBT Bold", "DM Sans", sans-serif);
    font-size: clamp(0.86rem, 0.78rem + 0.18vw, 0.98rem);
    font-weight: 800;
    line-height: 1.22;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .health-benefit-card__text {
    display: block;
    max-width: 15ch;
    color: #33585D;
    font-size: clamp(0.72rem, 0.68rem + 0.12vw, 0.8rem);
    font-weight: 600;
    line-height: 1.35;
    text-wrap: balance;
  }

  @media (max-width: 639px) {
    .health-benefit-card {
      min-height: 196px;
      gap: 0.7rem;
      padding: 1.4rem 1rem 1.25rem;
    }

    .health-benefit-card__icon-wrap {
      width: 68px;
      height: 68px;
    }

    .health-benefit-card__icon {
      width: 58px;
      height: 58px;
    }
  }
</style>

{% schema %}
{
  "name": "Health Benefit Grid",
  "tag": "section",
  "class": "section-health-benefit-grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Health Benefit"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Immune Support"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Short text",
          "default": "Strengthen your body's defense"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Fallback link"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "immune",
          "options": [
            { "value": "immune", "label": "Immune Support" },
            { "value": "energy", "label": "Energy & Vitality" },
            { "value": "heart", "label": "Heart Health" },
            { "value": "bone", "label": "Bone & Joint" },
            { "value": "beauty", "label": "Healthy Beauty" },
            { "value": "brain", "label": "Brain Health" },
            { "value": "digestive", "label": "Digestive & Gut Health" },
            { "value": "stress", "label": "Stress Relief" },
            { "value": "sleep", "label": "Sleep Support" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Health Benefit Grid",
      "blocks": [
        { "type": "benefit", "settings": { "title": "Immune Support", "text": "Strengthen your body's defense", "icon": "immune" } },
        { "type": "benefit", "settings": { "title": "Energy & Vitality", "text": "Boost energy and fight fatigue", "icon": "energy" } },
        { "type": "benefit", "settings": { "title": "Stress & Sleep", "text": "Relax your mind. Sleep better.", "icon": "sleep" } },
        { "type": "benefit", "settings": { "title": "Heart Health", "text": "Care for your heart naturally", "icon": "heart" } },
        { "type": "benefit", "settings": { "title": "Bone & Joint", "text": "Stronger bones. Better mobility.", "icon": "bone" } },
        { "type": "benefit", "settings": { "title": "Digestive Health", "text": "Support gut health and digestion", "icon": "digestive" } }
      ]
    }
  ]
}
{% endschema %}
