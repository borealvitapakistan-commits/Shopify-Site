{%- comment -%}
  Shop by Health Benefit grid shown below the Wellness Bundles section.
{%- endcomment -%}

<section class="health-benefit-grid-section" id="HealthBenefitGrid-{{ section.id }}">
  <div class="container health-benefit-grid__container">
    {% if section.settings.heading != blank %}
      <div class="health-benefit-grid__header">
        <h2 class="health-benefit-grid__title">{{ section.settings.heading }}</h2>
      </div>
    {% endif %}

    <div class="health-benefit-grid">
      {% for block in section.blocks %}
        {% liquid
          assign benefit_link = block.settings.collection.url | default: block.settings.link | default: routes.all_products_collection_url
          assign benefit_title = block.settings.title | default: block.settings.collection.title | default: 'Health Benefit'
          assign benefit_icon = block.settings.icon | default: 'beauty'
        %}
        <a class="health-benefit-card" href="{{ benefit_link }}" {{ block.shopify_attributes }}>
          <span class="health-benefit-card__icon-wrap" aria-hidden="true">
            <span class="health-benefit-card__icon-ring"></span>
            <span class="health-benefit-card__icon">
              {% case benefit_icon %}
                {% when 'beauty' %}
                  <svg viewBox="0 0 80 80">
                    <path d="M24 58c2-17 6-27 16-39"/>
                    <path d="M37 20c6-4 12-4 18 0"/>
                    <path d="M32 56c7-4 14-5 21-2"/>
                    <path d="M24 58c10 5 23 5 34 0"/>
                    <path d="M35 22c-4 7-3 13 2 18"/>
                    <path d="M47 21c5 8 5 16-1 22"/>
                  </svg>
                {% when 'cold-flu' %}
                  <svg viewBox="0 0 80 80">
                    <path d="M40 63S21 54 21 33V21c8 0 14-3 19-8 5 5 11 8 19 8v12c0 21-19 30-19 30Z"/>
                    <path d="M40 27v18"/>
                    <path d="M31 36h18"/>
                  </svg>
                {% when 'brain' %}
                  <svg viewBox="0 0 80 80">
                    <path d="M31 58c-8 0-14-6-14-13 0-5 3-9 7-11 0-8 6-14 14-14 4 0 8 2 10 5 8-1 15 5 15 13 5 2 8 7 8 13 0 8-7 14-15 14"/>
                    <path d="M35 24c-4 3-6 7-5 12"/>
                    <path d="M47 23c4 3 6 8 4 13"/>
                    <path d="M27 44c5 2 10 1 14-2"/>
                    <path d="M45 45c4 1 7 3 10 7"/>
                  </svg>
                {% when 'digestive' %}
                  <svg viewBox="0 0 80 80">
                    <path d="M31 18c-8 2-13 8-13 16 0 7 4 13 11 15"/>
                    <path d="M49 18c8 2 13 8 13 16 0 7-4 13-11 15"/>
                    <path d="M33 18v30c0 8 5 13 12 13 6 0 10-4 10-10 0-7-6-10-12-7"/>
                    <path d="M51 18v22"/>
                    <path d="M29 35h12"/>
                  </svg>
                {% when 'stress' %}
                  <svg viewBox="0 0 80 80">
                    <path d="M40 60c-14 0-24-10-24-24s10-24 24-24 24 10 24 24-10 24-24 24Z"/>
                    <path d="M40 50c-6 0-11-5-11-11V28"/>
                    <path d="M40 22v-7M57 27l4-6M63 42h7M23 27l-4-6"/>
                    <path d="M34 34c3-2 9-2 12 0"/>
                  </svg>
                {% when 'sleep' %}
                  <svg viewBox="0 0 80 80">
                    <path d="M52 16c-14 2-25 14-25 29 0 8 3 15 9 20-13-2-23-13-23-27 0-15 12-27 27-27 4 0 8 1 12 5Z"/>
                    <path d="M54 20h11l-11 13h11"/>
                    <path d="M57 39h9l-9 11h9"/>
                  </svg>
                {% else %}
                  <svg viewBox="0 0 80 80">
                    <circle cx="40" cy="40" r="23"/>
                    <path d="M40 27v26"/>
                    <path d="M27 40h26"/>
                  </svg>
              {% endcase %}
            </span>
          </span>
          <span class="health-benefit-card__title">{{ benefit_title }}</span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .health-benefit-grid-section {
    padding: clamp(2rem, 4vw, 3.35rem) 0 clamp(2.3rem, 4.5vw, 3.8rem);
    background:
      radial-gradient(circle at 50% 0%, rgba(var(--brand-green-rgb, 250, 208, 84), 0.08), rgba(255, 255, 255, 0) 34%),
      #ffffff;
  }

  .health-benefit-grid__container {
    max-width: 1320px;
  }

  .health-benefit-grid__header {
    margin-bottom: clamp(1.35rem, 2.8vw, 2.2rem);
    text-align: center;
  }

  .health-benefit-grid__title {
    margin: 0;
    color: var(--brand-primary, #0A282C);
    background: var(--brand-title-gradient, linear-gradient(135deg, #0A282C 0%, #163E43 100%));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    font-family: var(--font-title, "FuturaBT Bold", "DM Sans", sans-serif);
    font-size: clamp(1.35rem, 1.08rem + 0.95vw, 2.2rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: 0.01em;
  }

  .health-benefit-grid {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .health-benefit-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.15rem;
    }
  }

  @media (min-width: 990px) {
    .health-benefit-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }

  @media (min-width: 1200px) {
    .health-benefit-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 1.35rem;
    }
  }

  .health-benefit-card {
    display: grid;
    align-content: start;
    justify-items: center;
    gap: 1.15rem;
    min-height: 258px;
    padding: 1.65rem 1.1rem 1.45rem;
    border: 1px solid rgba(var(--brand-primary-rgb, 10, 40, 44), 0.08);
    border-radius: 1.1rem;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(249, 252, 252, 1));
    color: var(--brand-primary, #0A282C);
    text-align: center;
    text-decoration: none;
    box-shadow: 0 0.7rem 1.6rem rgba(10, 40, 44, 0.05);
    transition:
      transform 0.22s ease,
      box-shadow 0.22s ease,
      border-color 0.22s ease;
  }

  .health-benefit-card:hover,
  .health-benefit-card:focus-visible {
    outline: none;
    transform: translateY(-4px);
    border-color: rgba(var(--brand-green-rgb, 250, 208, 84), 0.48);
    box-shadow: 0 1.1rem 2.2rem rgba(10, 40, 44, 0.1);
  }

  .health-benefit-card__icon-wrap {
    position: relative;
    display: grid;
    place-items: center;
    width: 96px;
    height: 96px;
    margin-top: 0.2rem;
  }

  .health-benefit-card__icon-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 3px solid rgba(var(--brand-primary-rgb, 10, 40, 44), 0.58);
    box-shadow: inset 0 0 0 7px rgba(var(--brand-green-rgb, 250, 208, 84), 0.12);
  }

  .health-benefit-card__icon {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 70px;
    height: 70px;
    color: rgba(var(--brand-primary-rgb, 10, 40, 44), 0.72);
  }

  .health-benefit-card__icon svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .health-benefit-card__title {
    display: block;
    max-width: 11ch;
    color: var(--brand-primary, #0A282C);
    font-family: var(--font-title, "FuturaBT Bold", "DM Sans", sans-serif);
    font-size: clamp(1.05rem, 0.95rem + 0.2vw, 1.18rem);
    font-weight: 800;
    line-height: 1.28;
    letter-spacing: 0;
    text-wrap: balance;
  }

  @media (max-width: 639px) {
    .health-benefit-card {
      min-height: 228px;
      gap: 1rem;
      padding: 1.4rem 1rem 1.25rem;
    }

    .health-benefit-card__icon-wrap {
      width: 88px;
      height: 88px;
    }

    .health-benefit-card__icon {
      width: 64px;
      height: 64px;
    }
  }
</style>

{% schema %}
{
  "name": "Health Benefit Grid",
  "tag": "section",
  "class": "section-health-benefit-grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Health Benefit"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Healthy Beauty"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Fallback link"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "beauty",
          "options": [
            { "value": "beauty", "label": "Healthy Beauty" },
            { "value": "cold-flu", "label": "Cold & Flu" },
            { "value": "brain", "label": "Brain Health" },
            { "value": "digestive", "label": "Digestive & Gut Health" },
            { "value": "stress", "label": "Stress Relief" },
            { "value": "sleep", "label": "Sleep Support" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Health Benefit Grid",
      "blocks": [
        { "type": "benefit", "settings": { "title": "Healthy Beauty", "icon": "beauty" } },
        { "type": "benefit", "settings": { "title": "Cold & Flu", "icon": "cold-flu" } },
        { "type": "benefit", "settings": { "title": "Brain Health", "icon": "brain" } },
        { "type": "benefit", "settings": { "title": "Digestive & Gut Health", "icon": "digestive" } },
        { "type": "benefit", "settings": { "title": "Stress Relief", "icon": "stress" } },
        { "type": "benefit", "settings": { "title": "Sleep Support", "icon": "sleep" } }
      ]
    }
  ]
}
{% endschema %}
