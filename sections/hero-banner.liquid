<script>
  (function () {
    const section = document.querySelector('[data-hero-slider="{{ section.id }}"]');
    if (!section) return;

    const track = section.querySelector('[data-hero-track]');
    const slides = Array.from(section.querySelectorAll('[data-hero-slide]'));
    const dots = Array.from(section.querySelectorAll('[data-hero-dot]'));
    const tabs = Array.from(section.querySelectorAll('[data-hero-tab]'));
    const prevButton = section.querySelector('[data-hero-prev]');
    const nextButton = section.querySelector('[data-hero-next]');
    const viewAllButton = section.querySelector('[data-hero-view-all]');
    const overlay = section.querySelector('[data-hero-overlay]');
    const closeButtons = overlay ? Array.from(overlay.querySelectorAll('[data-hero-close]')) : [];

    if (!track || slides.length === 0) return;

    let activeIndex = 0;
    let autoplayTimer = null;
    let overlayHideTimer = null;

    const isOverlayOpen = () => overlay && !overlay.hidden;

    const stopAutoplay = () => {
      window.clearInterval(autoplayTimer);
      autoplayTimer = null;
    };

    const update = () => {
      track.style.transform = `translateX(-${activeIndex * 100}%)`;

      slides.forEach((slide, index) => {
        slide.classList.toggle('is-active', index === activeIndex);
      });

      dots.forEach((dot, index) => {
        const isActive = index === activeIndex;
        dot.classList.toggle('is-active', isActive);
        if (isActive) {
          dot.setAttribute('aria-current', 'true');
        } else {
          dot.removeAttribute('aria-current');
        }
      });

      tabs.forEach((tab, index) => {
        const isActive = index === activeIndex;
        tab.classList.toggle('is-active', isActive);
        tab.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      });
    };

    const setActive = (index) => {
      activeIndex = (index + slides.length) % slides.length;
      update();
    };

    const reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const autoplay = section.dataset.autoplay === 'true' && !reduceMotion;
    const interval = Number(section.dataset.interval) || 5000;

    const startAutoplay = () => {
      if (!autoplay || slides.length < 2 || isOverlayOpen()) return;
      stopAutoplay();
      autoplayTimer = window.setInterval(() => {
        setActive(activeIndex + 1);
      }, interval);
    };

    const restartAutoplay = () => {
      if (!autoplay) return;
      startAutoplay();
    };

    const setOverlayOpen = (isOpen) => {
      if (!overlay) return;

      if (overlayHideTimer) {
        window.clearTimeout(overlayHideTimer);
        overlayHideTimer = null;
      }

      if (isOpen) {
        overlay.hidden = false;
        document.body.classList.add('hero-banner-overlay-open');
        stopAutoplay();
        if (viewAllButton) {
          viewAllButton.setAttribute('aria-expanded', 'true');
        }
        window.requestAnimationFrame(() => {
          overlay.classList.add('is-open');
        });
        return;
      }

      overlay.classList.remove('is-open');
      document.body.classList.remove('hero-banner-overlay-open');
      if (viewAllButton) {
        viewAllButton.setAttribute('aria-expanded', 'false');
      }
      overlayHideTimer = window.setTimeout(() => {
        overlay.hidden = true;
        overlayHideTimer = null;
      }, 220);
      startAutoplay();
    };

    if (prevButton) {
      prevButton.addEventListener('click', () => {
        setActive(activeIndex - 1);
        restartAutoplay();
      });
    }

    if (nextButton) {
      nextButton.addEventListener('click', () => {
        setActive(activeIndex + 1);
        restartAutoplay();
      });
    }

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        setActive(Number(dot.dataset.heroIndex) || 0);
        restartAutoplay();
      });
    });

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        setActive(Number(tab.dataset.heroIndex) || 0);
        restartAutoplay();
      });
    });

    if (viewAllButton && overlay) {
      viewAllButton.addEventListener('click', () => {
        setOverlayOpen(true);
      });
    }

    closeButtons.forEach((button) => {
      button.addEventListener('click', () => {
        setOverlayOpen(false);
      });
    });

    if (overlay) {
      overlay.addEventListener('click', (event) => {
        if (event.target === overlay) {
          setOverlayOpen(false);
        }
      });
    }

    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOverlayOpen()) {
        setOverlayOpen(false);
      }
    });

    update();
    startAutoplay();
  })();
</script>

