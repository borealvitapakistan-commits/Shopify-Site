  .hero-banner__promo-image,
  .hero-banner__promo-placeholder {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero-banner__promo-image {
    object-fit: cover;
    transition: transform 0.24s ease;
  }

  .hero-banner__promo:hover {
    transform: translateY(-2px);
    box-shadow: 0 18px 38px rgba(15, 23, 42, 0.22);
  }

  .hero-banner__promo:hover .hero-banner__promo-image {
    transform: scale(1.025);
  }

  .hero-banner__promo-placeholder {
    background: var(--brand-yellow-gradient, linear-gradient(135deg, #FAD054 0%, #FFF8E7 100%));
  }

  .hero-banner__overlay[hidden] {
    display: none !important;
  }

  .hero-banner__overlay {
    position: fixed;
    inset: 0;
    z-index: 70;
    display: grid;
    place-items: center;
    padding: clamp(1rem, 2vw, 1.75rem);
    opacity: 0;
    transition: opacity 180ms ease;
  }

  .hero-banner__overlay.is-open {
    opacity: 1;
  }

  .hero-banner__overlay-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(7, 12, 20, 0.52);
    backdrop-filter: blur(4px);
  }

  .hero-banner__overlay-panel {
