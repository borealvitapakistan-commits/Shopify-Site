    font-family: var(--font-body, "DM Sans", "Segoe UI", sans-serif);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-primary-light, #2E5B61);
  }

  .hero-banner__overlay-title {
    margin: 0;
    font-family: var(--font-heading, "FuturaBT Bold", "DM Sans", sans-serif);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    line-height: 1.05;
    color: var(--brand-primary, #0A282C);
  }

  .hero-banner__overlay-close {
    display: inline-grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 999px;
    background: rgba(10, 40, 44, 0.06);
    color: var(--brand-primary, #0A282C);
    transition: background-color 180ms ease, color 180ms ease, transform 180ms ease;
  }

  .hero-banner__overlay-close:hover,
  .hero-banner__overlay-close:focus-visible {
    background: var(--brand-primary, #0A282C);
    color: #ffffff;
    outline: none;
    transform: translateY(-1px);
  }

  .hero-banner__overlay-grid {
    display: grid;
    gap: 0.95rem;
  }

  .hero-banner__overlay-card {
    position: relative;
    display: block;
    min-height: clamp(132px, 16vw, 176px);
    border-radius: 22px;
    overflow: hidden;
    color: #ffffff;
    text-decoration: none;
    background: #d9e5e7;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.14);
    transition: transform 220ms ease, box-shadow 220ms ease;
  }

  .hero-banner__overlay-card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(10, 40, 44, 0.62) 0%, rgba(10, 40, 44, 0.28) 36%, rgba(10, 40, 44, 0.06) 100%);
  }

  .hero-banner__overlay-image,
  .hero-banner__overlay-placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero-banner__overlay-image {
    object-fit: cover;
  }

  .hero-banner__overlay-card-copy {
    position: absolute;
    z-index: 1;
    left: clamp(1rem, 2vw, 1.6rem);
    bottom: clamp(0.95rem, 1.8vw, 1.3rem);
    display: grid;
    gap: 0.25rem;
    max-width: min(58%, 28rem);
  }

  .hero-banner__overlay-card-title {
    display: block;
    font-family: var(--font-heading, "FuturaBT Bold", "DM Sans", sans-serif);
    font-size: clamp(1.15rem, 2vw, 1.85rem);
    font-weight: 700;
    line-height: 1.05;
  }

  .hero-banner__overlay-card-text {
    display: block;
    font-family: var(--font-body, "DM Sans", "Segoe UI", sans-serif);
    font-size: clamp(0.92rem, 1.2vw, 1.05rem);
    font-weight: 600;
    line-height: 1.2;
  }

  .hero-banner__overlay-card:hover,
  .hero-banner__overlay-card:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 20px 36px rgba(10, 40, 44, 0.18);
    outline: none;
  }

  body.hero-banner-overlay-open {
    overflow: hidden;
  }

  @media (max-width: 989px) {
    .hero-banner__inner {
      grid-template-columns: 1fr;
      padding: 0.75rem var(--slideshow-edge-gutter, 0.75rem);
    }

    .hero-banner__seo-headline {
      padding: 1rem var(--slideshow-edge-gutter, 0.75rem) 0;
      font-size: clamp(1.85rem, 8vw, 3rem);
    }

    .hero-banner--has-category-strip {
      padding-bottom: 0;
    }

    .hero-banner--has-category-strip .hero-banner__slider {
      padding-bottom: 0;
    }

    .hero-banner__media {
      height: auto;
    }

    .hero-banner__promos {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto;
      height: auto;
      gap: 0.75rem;
    }

    .hero-banner__promo {
      aspect-ratio: 2.12 / 1;
    }

    .hero-banner__controls,
    .hero-banner--has-category-strip .hero-banner__controls {
      bottom: 0.7rem;
    }

    .hero-banner__category-strip {
      position: relative;
      right: auto;
      bottom: auto;
      left: auto;
      transform: none;
      margin-top: 0.72rem;
    }

    .hero-banner__category-shell {
      display: flex;
      gap: 0.45rem;
      width: 100%;
      padding: 0.4rem;
      border-radius: 14px;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .hero-banner__category-shell::-webkit-scrollbar {
      display: none;
    }

    .hero-banner__category-card,
    .hero-banner__view-all {
      flex: 0 0 auto;
      border-radius: 15px;
      box-shadow: none;
    }

    .hero-banner__category-card {
      min-width: 156px;
      padding: 0.7rem 0.82rem;
      border: 1px solid rgba(10, 40, 44, 0.08);
      background: #ffffff;
    }

    .hero-banner__category-card.is-active {
      margin: 0;
    }

    .hero-banner__view-all {
      min-width: max-content;
      padding: 0.72rem 0.95rem;
      border: 1px solid rgba(10, 40, 44, 0.08);
      background: #ffffff;
    }

    .hero-banner[data-mobile-fit="ratio"] .hero-banner__media {
      aspect-ratio: var(--hero-mobile-ratio);
    }

    .hero-banner[data-mobile-fit="auto"] .hero-banner__media {
      aspect-ratio: auto;
      height: auto;
    }

    .hero-banner[data-mobile-fit="auto"] .hero-banner__slide-link,
    .hero-banner[data-mobile-fit="auto"] .hero-banner__picture {
      height: auto;
    }

    .hero-banner[data-mobile-fit="auto"] .hero-banner__image {
      height: auto;
      object-fit: contain;
    }

    .hero-banner__overlay {
      padding: 0.8rem;
    }

    .hero-banner__overlay-panel {
      border-radius: 22px;
      max-height: 90vh;
    }

    .hero-banner__overlay-card {
      min-height: 146px;
    }

    .hero-banner__overlay-card-copy {
      max-width: 72%;
    }
  }

  @media (max-width: 767px) {
    .hero-banner__promos {
      aspect-ratio: auto;
    }

    .hero-banner__promo {
      aspect-ratio: 1.5 / 1;
    }

    .hero-banner__overlay-header {
      align-items: center;
    }

    .hero-banner__overlay-card-copy {
      max-width: 82%;
    }

    .hero-banner__overlay-card-title {
      font-size: 1.08rem;
    }

    .hero-banner__overlay-card-text {
      font-size: 0.86rem;
    }
  }

  @media (max-width: 1180px) {
    .hero-banner {
      --hero-desktop-height: clamp(240px, 36vw, 330px);
    }

    .hero-banner__inner {
      grid-template-columns: 1fr;
      gap: 0.95rem;
    }

    .hero-banner__promos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: auto;
      gap: 0.85rem;
    }

    .hero-banner--has-category-strip {
      padding-bottom: 0;
    }

    .hero-banner--has-category-strip .hero-banner__slider {
      padding-bottom: 0;
    }

    .hero-banner__category-strip {
      position: relative;
      right: auto;
      bottom: auto;
      left: auto;
      transform: none;
      margin-top: 0.85rem;
    }

    .hero-banner__category-shell {
      display: flex;
      gap: 0.45rem;
      width: 100%;
      padding: 0.4rem;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .hero-banner__category-shell::-webkit-scrollbar {
      display: none;
    }

    .hero-banner__category-card,
    .hero-banner__view-all {
      flex: 0 0 auto;
      box-shadow: none;
    }

    .hero-banner__category-card {
      min-width: 150px;
    }
  }

  .hero-banner {
    --hero-desktop-ratio: 1.18 / 1;
    --hero-desktop-height: clamp(420px, 45vw, 650px);
    overflow: hidden;
    padding: clamp(2rem, 4vw, 4.25rem) 0 clamp(2rem, 4vw, 4.5rem);
    background:
      radial-gradient(circle at 82% 16%, rgba(245, 217, 136, 0.28), transparent 18rem),
      radial-gradient(circle at 8% 20%, rgba(34, 129, 145, 0.28), transparent 22rem),
      var(--bv-grad-heading);
    color: var(--bv-white);
    isolation: isolate;
  }

  .hero-banner::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    z-index: -1;
    height: clamp(5rem, 12vw, 10rem);
    background: linear-gradient(180deg, transparent, rgba(10, 39, 42, 0.5));
    pointer-events: none;
  }

  .hero-banner__atmosphere,
  .hero-banner__glow {
    position: absolute;
    pointer-events: none;
  }

  .hero-banner__atmosphere {
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }

  .hero-banner__atmosphere::before {
    content: "";
    position: absolute;
    inset: 0;
    opacity: 0.18;
    background-image:
      linear-gradient(115deg, transparent 0 46%, rgba(255, 255, 255, 0.24) 46% 46.35%, transparent 46.35%),
      linear-gradient(105deg, transparent 0 60%, rgba(245, 217, 136, 0.18) 60% 60.28%, transparent 60.28%);
  }

  .hero-banner__glow {
    display: block;
    border-radius: 999px;
    filter: blur(8px);
  }

  .hero-banner__glow--gold {
    top: clamp(1rem, 4vw, 4rem);
    right: clamp(1rem, 7vw, 8rem);
    width: clamp(10rem, 24vw, 23rem);
    aspect-ratio: 1;
    background: rgba(233, 165, 38, 0.22);
  }

  .hero-banner__glow--teal {
    right: clamp(10rem, 28vw, 36rem);
    bottom: -8rem;
    width: clamp(14rem, 32vw, 30rem);
    aspect-ratio: 1;
    background: rgba(34, 129, 145, 0.26);
  }

  .hero-banner__inner,
  .hero-banner.hero-banner--no-promos .hero-banner__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(19rem, 0.86fr) minmax(0, 1.14fr);
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4.5rem);
    width: min(1220px, calc(100% - 2rem));
    max-width: none;
    padding: 0;
