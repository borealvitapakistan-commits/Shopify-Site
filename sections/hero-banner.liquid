    border-radius: 28px;
    background: #ffffff;
    box-shadow: 0 34px 72px rgba(7, 12, 20, 0.34);
    padding: clamp(1rem, 2vw, 1.45rem);
    transform: translateY(20px) scale(0.985);
    opacity: 0;
    transition: transform 220ms ease, opacity 220ms ease;
  }

  .hero-banner__overlay.is-open .hero-banner__overlay-panel {
    transform: translateY(0) scale(1);
    opacity: 1;
  }

  .hero-banner__overlay-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
