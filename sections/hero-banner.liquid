{%- comment -%}
  Hero Banner Slider
{%- endcomment -%}

{%- assign mobile_ratio = '4 / 5' -%}
{%- assign mobile_image_fit_mode = 'ratio' -%}
{%- case section.settings.mobile_ratio -%}
  {%- when 'auto' -%}
    {%- assign mobile_image_fit_mode = 'auto' -%}
  {%- when 'match' -%}
    {%- assign mobile_ratio = '16 / 5' -%}
  {%- when '16-9' -%}
    {%- assign mobile_ratio = '16 / 9' -%}
  {%- when '4-3' -%}
    {%- assign mobile_ratio = '4 / 3' -%}
  {%- when '1-1' -%}
    {%- assign mobile_ratio = '1 / 1' -%}
  {%- when '3-4' -%}
    {%- assign mobile_ratio = '3 / 4' -%}
  {%- when '4-5' -%}
    {%- assign mobile_ratio = '4 / 5' -%}
{%- endcase -%}

{%- assign promo_top_image = section.settings.promo_top_image -%}
{%- assign promo_top_link = section.settings.promo_top_link -%}
{%- assign promo_bottom_image = section.settings.promo_bottom_image -%}
{%- assign promo_bottom_link = section.settings.promo_bottom_link -%}

{%- for block in section.blocks offset: 1 limit: 2 -%}
  {%- if forloop.index == 1 -%}
    {%- if promo_top_image == blank -%}
      {%- assign promo_top_image = block.settings.image -%}
    {%- endif -%}
    {%- if promo_top_link == blank -%}
      {%- assign promo_top_link = block.settings.link -%}
    {%- endif -%}
  {%- elsif forloop.index == 2 -%}
    {%- if promo_bottom_image == blank -%}
      {%- assign promo_bottom_image = block.settings.image -%}
    {%- endif -%}
    {%- if promo_bottom_link == blank -%}
      {%- assign promo_bottom_link = block.settings.link -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}

{%- assign show_promos = false -%}
{%- if promo_top_image != blank or promo_bottom_image != blank -%}
  {%- assign show_promos = true -%}
{%- endif -%}

{%- assign show_bottom_strip = false -%}
{%- if section.settings.show_bottom_strip and section.blocks.size > 0 -%}
  {%- assign show_bottom_strip = true -%}
{%- endif -%}

{%- assign show_view_all_button = false -%}
{%- if show_bottom_strip and section.blocks.size > 1 and section.settings.view_all_label != blank -%}
  {%- assign show_view_all_button = true -%}
{%- endif -%}

{%- assign hero_tab_count = section.blocks.size -%}
{%- if hero_tab_count < 1 -%}
  {%- assign hero_tab_count = 1 -%}
{%- endif -%}

{%- assign view_all_heading = section.settings.view_all_heading | default: 'Explore all featured banners' -%}
{%- assign hero_eyebrow = section.settings.hero_eyebrow | default: 'Northern apothecary meets modern science' -%}
{%- assign hero_lead = section.settings.hero_lead | default: 'Canadian-made herbal supplements with clear labels, NPN-registered formulas, and delivery for Pakistan.' -%}
{%- assign hero_cta_label = section.settings.hero_cta_label | default: 'Shop wellness formulas' -%}
{%- assign hero_cta_link = section.settings.hero_cta_link | default: routes.all_products_collection_url -%}
{%- assign hero_proof_1 = section.settings.hero_proof_1 | default: 'Made in Canada' -%}
{%- assign hero_proof_2 = section.settings.hero_proof_2 | default: 'NPN registered' -%}
{%- assign hero_proof_3 = section.settings.hero_proof_3 | default: 'Readable product facts' -%}
{%- assign bv_region = localization.country.iso_code | default: 'CA' | upcase -%}
{%- assign bv_market_handle = localization.market.handle | default: '' | downcase -%}
{%- if bv_market_handle == 'united-states' or bv_market_handle == 'us' or bv_region == 'US' -%}
  {%- assign bv_region = 'US' -%}
{%- elsif bv_market_handle == 'pakistan' or bv_market_handle == 'pk' or bv_region == 'PK' -%}
  {%- assign bv_region = 'PK' -%}
{%- else -%}
  {%- assign bv_region = 'CA' -%}
{%- endif -%}
{%- assign seo_h1_ca = section.settings.seo_h1 | default: 'Herbal By Nature, Backed by Modern Science' -%}
{%- assign seo_h1_us = 'Herbal Wellness Supplements You Can Trust' -%}
{%- assign seo_h1_pk = "Boreal Vita Herbal Wellness for Pakistan" -%}
{%- assign seo_h1 = seo_h1_ca -%}
{%- if bv_region == 'US' -%}
  {%- assign seo_h1 = seo_h1_us -%}
{%- elsif bv_region == 'PK' -%}
  {%- assign seo_h1 = seo_h1_pk -%}
{%- endif -%}

<section
  class="hero-banner{% unless show_promos %} hero-banner--no-promos{% endunless %}{% if show_bottom_strip %} hero-banner--has-category-strip{% endif %}"
  style="--hero-tab-count: {{ hero_tab_count }};"
  data-hero-slider="{{ section.id }}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-interval="{{ section.settings.autoplay_interval | times: 1000 }}"
  data-mobile-fit="{{ mobile_image_fit_mode }}"
>
  <div class="hero-banner__atmosphere" aria-hidden="true">
    <span class="hero-banner__glow hero-banner__glow--gold"></span>
    <span class="hero-banner__glow hero-banner__glow--teal"></span>
  </div>

  <div class="hero-banner__inner">
    <div class="hero-banner__copy">
      {% if hero_eyebrow != blank %}
        <p class="hero-banner__eyebrow"><span class="hero-banner__eyebrow-text">{{ hero_eyebrow }}</span></p>
      {% endif %}

      {% if request.page_type == 'index' and seo_h1 != blank %}
        <h1
          class="hero-banner__seo-headline"
          data-region-text
          data-region-ca="{{ seo_h1_ca | escape }}"
          data-region-us="{{ seo_h1_us | escape }}"
          data-region-pk="{{ seo_h1_pk | escape }}"
        >{{ seo_h1 }}</h1>
      {% elsif seo_h1 != blank %}
        <h2 class="hero-banner__seo-headline">{{ seo_h1 }}</h2>
      {% endif %}

      {% if hero_lead != blank %}
        <p class="hero-banner__lead">{{ hero_lead }}</p>
      {% endif %}

      {% if hero_cta_label != blank %}
        <a class="hero-banner__cta" href="{{ hero_cta_link }}">{{ hero_cta_label }}</a>
      {% endif %}

      <div class="hero-banner__proof-list" role="group" aria-label="Boreal Vita proof points">
        {% if hero_proof_1 != blank %}<span>{{ hero_proof_1 }}</span>{% endif %}
        {% if hero_proof_2 != blank %}<span>{{ hero_proof_2 }}</span>{% endif %}
        {% if hero_proof_3 != blank %}<span>{{ hero_proof_3 }}</span>{% endif %}
      </div>
    </div>

    <div class="hero-banner__stage">
      <div class="hero-banner__slider">
        <div class="hero-banner__viewport">
          <div class="hero-banner__track" data-hero-track>
            {% for block in section.blocks %}
              {% assign slide_image = block.settings.image | default: block.settings.mobile_image %}
              {% assign slide_link = block.settings.link | default: routes.all_products_collection_url %}
              {% assign slide_title = block.settings.nav_title | default: slide_image.alt %}
              {% if slide_title == blank %}
                {% assign slide_title = 'Featured category ' | append: forloop.index %}
              {% endif %}
              <div class="hero-banner__slide{% if forloop.first %} is-active{% endif %}" data-hero-slide {{ block.shopify_attributes }}>
                <div class="hero-banner__media">
                  <a class="hero-banner__slide-link" href="{{ slide_link }}" aria-label="{{ slide_title | escape }}">
                    {% if slide_image != blank %}
                      <picture class="hero-banner__picture">
                        {% if block.settings.mobile_image != blank and block.settings.image != blank %}
                          <source
                            media="(max-width: 767px)"
                            srcset="
                              {{ block.settings.mobile_image | image_url: width: 420 }} 420w,
                              {{ block.settings.mobile_image | image_url: width: 640 }} 640w,
                              {{ block.settings.mobile_image | image_url: width: 900 }} 900w,
                              {{ block.settings.mobile_image | image_url: width: 1200 }} 1200w
                            "
                            sizes="100vw"
                          >
                        {% endif %}
                        <img
                          class="hero-banner__image"
                          src="{{ slide_image | image_url: width: 1600 }}"
                          srcset="
                            {{ slide_image | image_url: width: 720 }} 720w,
                            {{ slide_image | image_url: width: 1100 }} 1100w,
                            {{ slide_image | image_url: width: 1400 }} 1400w,
                            {{ slide_image | image_url: width: 1600 }} 1600w
                          "
                          sizes="(min-width: 1180px) 52vw, (min-width: 768px) 90vw, 100vw"
                          alt="{{ slide_image.alt | default: slide_title | escape }}"
                          width="{{ slide_image.width }}"
                          height="{{ slide_image.height }}"
                          loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                          fetchpriority="{% if forloop.first %}high{% else %}auto{% endif %}"
                          decoding="async"
                        >
                      </picture>
                    {% else %}
                      <img
                        class="hero-banner__image hero-banner__image--fallback"
                        src="{{ 'bv-hero-northern-apothecary.jpg' | asset_url }}"
                        alt="Boreal Vita supplement bottles with botanical apothecary ingredients"
                        width="1586"
                        height="992"
                        loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                        fetchpriority="{% if forloop.first %}high{% else %}auto{% endif %}"
                        decoding="async"
                      >
                    {% endif %}
                  </a>
                </div>
              </div>
            {% endfor %}
          </div>
        </div>

        {% if section.blocks.size > 1 %}
          <button class="hero-banner__nav hero-banner__nav--prev" type="button" aria-label="Previous slide" data-hero-prev>
            <svg width="28" height="44" viewBox="0 0 28 44" fill="none" aria-hidden="true">
              <path d="M22 4L6 22L22 40" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </button>
          <button class="hero-banner__nav hero-banner__nav--next" type="button" aria-label="Next slide" data-hero-next>
            <svg width="28" height="44" viewBox="0 0 28 44" fill="none" aria-hidden="true">
              <path d="M6 4L22 22L6 40" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </button>
        {% endif %}

        <div class="hero-banner__fact-card" role="group" aria-label="Product clarity promise">
          <span>Product Facts</span>
          <strong>Clear dosage. Large labels.</strong>
          <small>Built for calm decisions, not tiny print.</small>
        </div>

        {% if show_bottom_strip %}
          <div class="hero-banner__category-strip" aria-label="Hero slide categories">
            <div class="hero-banner__category-shell">
              {% for block in section.blocks %}
                {% assign nav_image = block.settings.image | default: block.settings.mobile_image %}
                {% assign nav_title = block.settings.nav_title | default: nav_image.alt %}
                {% assign nav_action = block.settings.nav_caption | default: 'Shop Now' %}
                {% if nav_title == blank %}
                  {% assign nav_title = 'Featured category ' | append: forloop.index %}
                {% endif %}
                <button
                  class="hero-banner__category-card{% if forloop.first %} is-active{% endif %}"
                  type="button"
                  data-hero-tab
                  data-hero-index="{{ forloop.index0 }}"
                  aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
                >
                  <span class="hero-banner__category-title">{{ nav_title }}</span>
                  <span class="hero-banner__category-action">{{ nav_action }}</span>
                </button>
              {% endfor %}

              {% if show_view_all_button %}
                <button
                  class="hero-banner__view-all"
                  type="button"
                  data-hero-view-all
                  aria-haspopup="dialog"
                  aria-controls="HeroBannerOverlay-{{ section.id }}"
                  aria-expanded="false"
                >
                  <span>{{ section.settings.view_all_label }}</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                    <path d="M8 5l8 7-8 7"></path>
                  </svg>
                </button>
              {% endif %}
            </div>
          </div>
        {% endif %}
      </div>
    </div>

    {% if show_promos %}
      <div class="hero-banner__promos" aria-label="Featured promotions">
        {% if promo_top_image != blank %}
          <a class="hero-banner__promo" href="{{ promo_top_link | default: routes.all_products_collection_url }}">
            <img
              class="hero-banner__promo-image"
              src="{{ promo_top_image | image_url: width: 900 }}"
              srcset="
                {{ promo_top_image | image_url: width: 420 }} 420w,
                {{ promo_top_image | image_url: width: 640 }} 640w,
                {{ promo_top_image | image_url: width: 900 }} 900w
              "
              sizes="(min-width: 990px) 28vw, 50vw"
              alt="{{ promo_top_image.alt | default: shop.name | escape }}"
              width="{{ promo_top_image.width }}"
              height="{{ promo_top_image.height }}"
              loading="eager"
            >
          </a>
        {% endif %}

        {% if promo_bottom_image != blank %}
          <a class="hero-banner__promo" href="{{ promo_bottom_link | default: routes.all_products_collection_url }}">
            <img
              class="hero-banner__promo-image"
              src="{{ promo_bottom_image | image_url: width: 900 }}"
              srcset="
                {{ promo_bottom_image | image_url: width: 420 }} 420w,
                {{ promo_bottom_image | image_url: width: 640 }} 640w,
                {{ promo_bottom_image | image_url: width: 900 }} 900w
              "
              sizes="(min-width: 990px) 28vw, 50vw"
              alt="{{ promo_bottom_image.alt | default: shop.name | escape }}"
              width="{{ promo_bottom_image.width }}"
              height="{{ promo_bottom_image.height }}"
              loading="lazy"
            >
          </a>
        {% endif %}
      </div>
    {% endif %}
  </div>

  {% if show_view_all_button %}
    <div class="hero-banner__overlay" id="HeroBannerOverlay-{{ section.id }}" hidden data-hero-overlay>
      <button class="hero-banner__overlay-backdrop" type="button" data-hero-close aria-label="Close all banners"></button>
      <div class="hero-banner__overlay-panel" role="dialog" aria-modal="true" aria-labelledby="HeroBannerOverlayTitle-{{ section.id }}">
        <div class="hero-banner__overlay-header">
          <div class="hero-banner__overlay-copy">
            <p class="hero-banner__overlay-eyebrow">Featured categories</p>
            <p class="hero-banner__overlay-title" id="HeroBannerOverlayTitle-{{ section.id }}">{{ view_all_heading }}</p>
          </div>
          <button class="hero-banner__overlay-close" type="button" data-hero-close aria-label="Close all banners">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" aria-hidden="true">
              <path d="M18 6L6 18"></path>
              <path d="M6 6l12 12"></path>
            </svg>
          </button>
        </div>

        <div class="hero-banner__overlay-grid">
          {% for block in section.blocks %}
            {% assign grid_image = block.settings.image | default: block.settings.mobile_image %}
            {% assign grid_link = block.settings.link | default: routes.all_products_collection_url %}
            {% assign grid_title = block.settings.grid_title | default: block.settings.nav_title | default: grid_image.alt %}
            {% assign grid_text = block.settings.grid_text | default: block.settings.nav_caption %}
            {% if grid_title == blank %}
              {% assign grid_title = 'Featured category ' | append: forloop.index %}
            {% endif %}
            <a class="hero-banner__overlay-card" href="{{ grid_link }}" aria-label="{{ grid_title | escape }}">
              {% if grid_image != blank %}
                <img
                  class="hero-banner__overlay-image"
                  src="{{ grid_image | image_url: width: 1600 }}"
                  srcset="
                    {{ grid_image | image_url: width: 720 }} 720w,
                    {{ grid_image | image_url: width: 1100 }} 1100w,
                    {{ grid_image | image_url: width: 1600 }} 1600w
                  "
                  sizes="(min-width: 990px) 900px, 100vw"
                  alt="{{ grid_image.alt | default: grid_title | escape }}"
                  width="{{ grid_image.width }}"
                  height="{{ grid_image.height }}"
                  loading="lazy"
                >
              {% else %}
                <div class="hero-banner__overlay-placeholder"></div>
              {% endif %}
              <span class="hero-banner__overlay-card-copy">
                <span class="hero-banner__overlay-card-title">{{ grid_title }}</span>
                {% if grid_text != blank %}
                  <span class="hero-banner__overlay-card-text">{{ grid_text }}</span>
                {% endif %}
              </span>
            </a>
          {% endfor %}
        </div>
      </div>
    </div>
  {% endif %}
</section>

<style>
  .hero-banner {
    --hero-desktop-ratio: 2.24 / 1;
    --hero-mobile-ratio: {{ mobile_ratio }};
    --hero-desktop-height: clamp(250px, calc(28vw - 1in), 380px);
    position: relative;
    width: 100%;
    background: #fff;
  }

  .hero-banner--has-category-strip {
    padding-bottom: clamp(1.35rem, 3.2vw, 2.1rem);
  }

  .hero-banner__seo-headline {
    max-width: 1920px;
    margin: 0 auto;
    padding: clamp(1.15rem, 2.4vw, 2.4rem) var(--slideshow-edge-gutter, clamp(0.75rem, 1.45vw, 1.75rem)) 0;
    color: var(--brand-primary, #0A282C);
    font-family: var(--font-title, "FuturaBT Bold", "DM Sans", sans-serif);
    font-size: clamp(2.2rem, 4vw, 4.2rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .hero-banner__inner {
    display: grid;
    grid-template-columns: minmax(0, 2.25fr) minmax(320px, 0.95fr);
    align-items: stretch;
    gap: clamp(1rem, 1.7vw, 1.5rem);
    width: 100%;
    max-width: 1920px;
    margin-inline: auto;
    padding: clamp(0.9rem, 1.6vw, 1.75rem) var(--slideshow-edge-gutter, clamp(0.75rem, 1.45vw, 1.75rem));
  }

  .hero-banner--no-promos {
    --hero-desktop-ratio: 16 / 5;
    --hero-desktop-height: clamp(235px, calc(31vw - 1in), 420px);
  }

  .hero-banner--no-promos .hero-banner__inner {
    grid-template-columns: 1fr;
  }

  .hero-banner__slider {
    position: relative;
    min-width: 0;
    isolation: isolate;
  }

  .hero-banner--has-category-strip .hero-banner__slider {
    padding-bottom: clamp(2.35rem, 4.1vw, 3.05rem);
  }

  .hero-banner__viewport {
    width: 100%;
    overflow: hidden;
    border-radius: 18px;
    background: var(--color-muted);
    transition: box-shadow 0.24s ease, transform 0.24s ease;
  }

  .hero-banner__slider:hover .hero-banner__viewport {
    transform: translateY(-2px);
    box-shadow: 0 18px 38px rgba(15, 23, 42, 0.22);
  }

  .hero-banner__track {
    display: flex;
    width: 100%;
    transition: transform 0.6s ease;
    will-change: transform;
  }

  .hero-banner__slide {
    min-width: 100%;
    position: relative;
  }

  .hero-banner__media {
    position: relative;
    width: 100%;
    aspect-ratio: var(--hero-desktop-ratio);
    height: var(--hero-desktop-height);
  }

  .hero-banner__slide-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero-banner__picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero-banner__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-banner__image--placeholder,
  .hero-banner__overlay-placeholder {
    background: var(--brand-yellow-gradient, linear-gradient(135deg, #FAD054 0%, #FFF8E7 100%));
  }

  .hero-banner__controls {
    position: absolute;
    left: 50%;
    bottom: clamp(0.7rem, 1.4vw, 1rem);
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 0.36rem;
    padding: 0.22rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.88);
    box-shadow: 0 8px 22px rgba(31, 23, 38, 0.16);
    transform: translateX(-50%);
  }

  .hero-banner--has-category-strip .hero-banner__controls {
    bottom: clamp(3rem, 6vw, 4rem);
  }

  .hero-banner__control,
  .hero-banner__dot,
  .hero-banner__category-card,
  .hero-banner__view-all,
  .hero-banner__overlay-backdrop,
  .hero-banner__overlay-close {
    appearance: none;
    border: 0;
    cursor: pointer;
  }

  .hero-banner__control {
    display: inline-grid;
    place-items: center;
    width: 1.55rem;
    height: 1.55rem;
    padding: 0;
    border-radius: 999px;
    background: #ffffff;
    color: var(--brand-primary, #0A282C);
    box-shadow: 0 0 0 1px rgba(10, 40, 44, 0.14) inset;
    transition: background-color 0.18s ease, color 0.18s ease, transform 0.18s ease;
  }

  .hero-banner__control:hover,
  .hero-banner__control:focus-visible {
    background: var(--brand-primary, #0A282C);
    color: #ffffff;
    outline: none;
    transform: translateY(-1px);
  }

  .hero-banner__dots {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    padding: 0 0.08rem;
  }

  .hero-banner__dot {
    width: 0.42rem;
    height: 0.42rem;
    padding: 0;
    border-radius: 999px;
    background: rgba(10, 40, 44, 0.28);
    transition: background-color 0.18s ease, transform 0.18s ease, width 0.18s ease;
  }

  .hero-banner__dot.is-active {
    width: 0.92rem;
    background: var(--brand-accent, #FAD054);
  }

  .hero-banner__dot:hover,
  .hero-banner__dot:focus-visible {
    background: var(--brand-primary, #0A282C);
    outline: none;
    transform: scale(1.12);
  }

  .hero-banner__category-strip {
    position: absolute;
    right: clamp(0.7rem, 1.5vw, 1.05rem);
    bottom: 0;
    left: clamp(0.7rem, 1.5vw, 1.05rem);
    z-index: 4;
    display: flex;
    justify-content: center;
    transform: translateY(18%);
  }

  .hero-banner__category-shell {
    display: grid;
    grid-template-columns: repeat(var(--hero-tab-count), minmax(0, 1fr)) auto;
    align-items: stretch;
    width: min(100%, 920px);
    padding: 0.22rem;
    background: rgba(255, 255, 255, 0.97);
    border: 1px solid rgba(10, 40, 44, 0.08);
    border-radius: 14px;
    box-shadow: 0 14px 28px rgba(10, 40, 44, 0.12);
    overflow: hidden;
    backdrop-filter: blur(12px);
  }

  .hero-banner__category-card,
  .hero-banner__view-all {
    position: relative;
    min-width: 0;
    background: transparent;
    font: inherit;
  }

  .hero-banner__category-card {
    display: grid;
    justify-items: center;
    gap: 0.16rem;
    padding: 0.58rem 0.78rem 0.54rem;
    text-align: center;
    color: var(--brand-text, #22343A);
    transition: background-color 180ms ease, color 180ms ease, transform 180ms ease, box-shadow 180ms ease;
  }

  .hero-banner__category-card + .hero-banner__category-card,
  .hero-banner__view-all {
    box-shadow: inset 1px 0 0 rgba(10, 40, 44, 0.08);
  }

  .hero-banner__category-card::after {
