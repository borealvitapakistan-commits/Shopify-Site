{%- comment -%}
  Deals Picked for You - Product Grid Section
{%- endcomment -%}

{%- assign collection = collections[section.settings.collection] -%}
{%- assign mission_link = section.settings.mission_link -%}
{%- assign deals_eyebrow = section.settings.eyebrow | default: '' -%}
{%- if mission_link == blank -%}
  {%- assign mission_link = '/pages/about-us' -%}
  {%- if pages['about-us'] != blank -%}
    {%- assign mission_link = pages['about-us'].url -%}
  {%- elsif pages['about'] != blank -%}
    {%- assign mission_link = pages['about'].url -%}
  {%- elsif pages['contact'] != blank -%}
    {%- assign mission_link = pages['contact'].url | append: '?view=about-us' -%}
  {%- elsif pages['contact-us'] != blank -%}
    {%- assign mission_link = pages['contact-us'].url | append: '?view=about-us' -%}
  {%- endif -%}
{%- endif -%}

<section class="deals-picked-section" id="DealsPicked-{{ section.id }}">
  <div class="container">
    <div class="deals-picked__header">
      <div class="deals-picked__heading-wrap">
        {% if deals_eyebrow != blank %}
          <p class="deals-picked__eyebrow">{{ deals_eyebrow }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="deals-picked__title">{{ section.settings.heading }}</h2>
        {% endif %}
      </div>
    </div>

    <div class="deals-picked__carousel" data-deals-carousel>
      <button type="button" class="deals-picked__nav deals-picked__nav--prev" aria-label="Previous deals" data-deals-prev>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M15 18l-6-6 6-6"></path>
        </svg>
      </button>

      <div class="deals-picked__track" data-deals-track>
        {% if collection != blank and collection.products.size > 0 %}
          {% for product in collection.products limit: section.settings.products_to_show %}
            <div class="deals-picked__slide">
              {% render 'product-card-amzn',
                product: product,
                show_rating: true,
                show_pricing: true,
                show_unit_price: true,
                show_delivery: false,
                show_social_proof: false,
                show_add_to_cart: true,
                inline_sale_pricing: true
              %}
            </div>
          {% endfor %}
        {% else %}
          <div class="deals-picked__empty">
            {% if collection == blank %}
              Select a collection to display deals
            {% else %}
              No products found in this collection
            {% endif %}
          </div>
        {% endif %}
      </div>

      <button type="button" class="deals-picked__nav deals-picked__nav--next" aria-label="Next deals" data-deals-next>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 18l6-6-6-6"></path>
        </svg>
      </button>
    </div>

    {% if section.settings.show_mission_banner %}
      <div class="deals-picked__mission">
        <div class="deals-picked__mission-copy">
          {% if section.settings.mission_heading != blank %}
            <h3 class="deals-picked__mission-title">{{ section.settings.mission_heading }}</h3>
          {% endif %}

          {% if section.settings.mission_text != blank %}
            <div class="deals-picked__mission-text rte">
              {{ section.settings.mission_text }}
            </div>
          {% endif %}

          {% if section.settings.mission_button_label != blank %}
            <a class="deals-picked__mission-button" href="{{ mission_link }}">
              {{ section.settings.mission_button_label }}
            </a>
          {% endif %}
        </div>

        <div class="deals-picked__mission-art" aria-hidden="true">
          {% if section.settings.mission_image != blank %}
            <img
              class="deals-picked__mission-image"
              src="{{ section.settings.mission_image | image_url: width: 2200 }}"
              srcset="
                {{ section.settings.mission_image | image_url: width: 900 }} 900w,
                {{ section.settings.mission_image | image_url: width: 1400 }} 1400w,
                {{ section.settings.mission_image | image_url: width: 1800 }} 1800w,
                {{ section.settings.mission_image | image_url: width: 2200 }} 2200w
              "
              sizes="(max-width: 767px) 100vw, 58vw"
              alt="{{ section.settings.mission_image.alt | default: section.settings.mission_heading | escape }}"
              width="{{ section.settings.mission_image.width }}"
              height="{{ section.settings.mission_image.height }}"
              loading="lazy"
            >
          {% else %}
            <img
              class="deals-picked__mission-image deals-picked__mission-image--fallback"
              src="{{ 'deals-mission-healthcare.jfif' | asset_url }}"
              alt="Healthcare professionals illustration"
              width="626"
              height="351"
              loading="lazy"
            >
          {% endif %}
        </div>
      </div>
    {% endif %}
  </div>
</section>

<style>
  .deals-picked-section {
    padding: clamp(1.45rem, 2.8vw, 2.6rem) 0;
    background: #ffffff;
  }

  .deals-picked-section .container {
    display: flex;
    flex-direction: column;
    width: min(1280px, calc(100vw - clamp(2rem, 10vw, 11rem)));
    max-width: 1280px;
    padding-right: 0;
    padding-left: 0;
  }

  .deals-picked-section .deals-picked__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
    margin-bottom: 1.45rem;
  }

  .deals-picked__heading-wrap {
    display: grid;
    justify-items: center;
    gap: 1rem;
    width: 100%;
    text-align: center;
  }

  .deals-picked__heading-line {
    display: none;
  }

  .deals-picked__heading-line:last-child {
    display: none;
  }

  .deals-picked__eyebrow {
    margin: 0;
    color: var(--brand-accent-dark, #C89F27);
    font-family: var(--font-heading, "FuturaBT Bold", "DM Sans", sans-serif);
    font-size: clamp(0.86rem, 1.05vw, 1.08rem);
    font-weight: 800;
    letter-spacing: 0.02em;
    line-height: 1;
    text-transform: uppercase;
  }

  .deals-picked__title {
    margin: 0;
    color: var(--brand-primary, #0A282C);
    background: none;
    -webkit-background-clip: initial;
    background-clip: initial;
    font-family: var(--font-title, "FuturaBT Bold", "DM Sans", sans-serif);
    font-size: clamp(1.9rem, 3vw, 2.75rem);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.15;
    text-align: center;
    text-transform: none;
    white-space: normal;
    -webkit-text-fill-color: currentColor;
  }

  .deals-picked__carousel + .deals-picked__mission {
    margin-top: clamp(1rem, 2vw, 1.5rem);
  }

  .deals-picked__carousel {
    position: relative;
  }

  .deals-picked__track {
    display: flex;
    gap: clamp(0.95rem, 1.35vw, 1.25rem);
    overflow-x: auto;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    width: 100%;
    padding: 1.15rem 0.2rem 1.15rem;
    margin: -0.45rem -0.2rem -0.7rem;
  }

  .deals-picked__track::-webkit-scrollbar {
    display: none;
  }

  .deals-picked__slide {
    flex: 0 0 clamp(13rem, 17vw, 14.25rem);
    scroll-snap-align: start;
  }

  .deals-picked__nav {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-background);
    color: inherit;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    transform: translateY(-50%);
    transition: all 0.2s ease;
  }

  .deals-picked__nav:hover,
  .deals-picked__nav:focus-visible {
    background: linear-gradient(135deg, var(--brand-purple-light, #163E43) 0%, var(--brand-purple, #0A282C) 100%);
    color: var(--color-primary-foreground);
    border-color: var(--brand-purple, #0A282C);
    outline: none;
  }

  .deals-picked__nav:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .deals-picked__nav--prev {
    left: -12px;
  }

  .deals-picked__nav--next {
    right: -12px;
  }

  .deals-picked__mission {
    display: grid;
    grid-template-columns: minmax(240px, 0.9fr) minmax(320px, 1.4fr);
    align-items: center;
    gap: clamp(1.4rem, 3vw, 3.6rem);
    margin-top: clamp(1.8rem, 3vw, 2.8rem);
    padding: 0;
    background: transparent;
    border: 0;
    border-radius: 0;
    overflow: visible;
  }

  .deals-picked__mission-copy {
    display: grid;
    align-content: center;
    gap: 1rem;
    max-width: 32rem;
    padding-left: 0;
  }

  .deals-picked__mission-title {
    margin: 0;
    color: var(--brand-primary, #0A282C);
    background: var(--brand-title-gradient, linear-gradient(135deg, #0A282C 0%, #163E43 100%));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    font-family: var(--font-title, "FuturaBT Bold", "DM Sans", sans-serif);
    font-size: clamp(1.45rem, 1.05rem + 1.4vw, 2.35rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: 0.045em;
    text-transform: uppercase;
  }

  .deals-picked__mission-text {
    color: var(--brand-text, #22343A);
    font-family: var(--font-body, "DM Sans", "Segoe UI", sans-serif);
    font-size: clamp(0.98rem, 0.92rem + 0.18vw, 1.08rem);
    line-height: 1.85;
  }

  .deals-picked__mission-text p {
    margin: 0;
  }

  .deals-picked__mission-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    width: fit-content;
    padding: 0 1.6rem;
    border-radius: 10px;
    background: var(--brand-green-gradient, linear-gradient(135deg, #C89F27 0%, #FAD054 100%));
    color: var(--brand-primary, #0A282C);
    font-family: var(--font-title, "FuturaBT Bold", "DM Sans", sans-serif);
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-decoration: none;
    text-transform: uppercase;
    box-shadow: 0 10px 22px rgba(var(--brand-green-rgb, 250, 208, 84), 0.2);
    transition: transform 0.18s ease, box-shadow 0.22s ease, background 0.18s ease, color 0.18s ease;
  }

  .deals-picked__mission-button:hover,
  .deals-picked__mission-button:focus-visible {
    background: var(--brand-green-gradient, linear-gradient(135deg, #163E43 0%, #0A282C 100%));
    color: #ffffff;
    box-shadow: 0 12px 26px rgba(var(--brand-primary-rgb, 10, 40, 44), 0.2);
    outline: none;
    transform: translateY(-1px);
  }

  .deals-picked__mission-art {
    align-self: stretch;
    display: grid;
    place-items: center;
    justify-self: end;
    width: 100%;
    min-height: clamp(260px, 28vw, 420px);
  }

  .deals-picked__mission-image,
  .deals-picked__mission-scene {
    width: 100%;
    max-width: 42rem;
    height: auto;
    display: block;
  }

  .deals-picked__mission-image--fallback {
    justify-self: end;
  }

  .deals-picked__empty {
    flex: 0 0 100%;
    padding: 2rem 1rem;
    text-align: center;
    color: var(--color-muted-foreground);
    font-size: 1rem;
  }

  @media (min-width: 640px) {
    .deals-picked__slide {
      flex-basis: clamp(13.25rem, 18vw, 14.5rem);
    }
  }

  @media (min-width: 1024px) {
    .deals-picked__slide {
      flex-basis: clamp(13.75rem, 16vw, 14.75rem);
    }
  }

  @media (max-width: 1023px) {
    .deals-picked__mission {
      grid-template-columns: 1fr;
      gap: 1.25rem;
      text-align: center;
    }

    .deals-picked__mission-copy {
      justify-items: center;
      max-width: 100%;
      padding-left: 0;
    }

    .deals-picked__mission-art {
      min-height: 220px;
    }
  }

  @media (max-width: 639px) {
    .deals-picked-section .container {
      width: 100%;
      max-width: var(--site-content-max-width, var(--site-max-width, 1920px));
      padding-right: var(--site-edge-gutter, 0.9rem);
      padding-left: var(--site-edge-gutter, 0.9rem);
    }

    .deals-picked-section .deals-picked__header {
      gap: 0.75rem;
      margin-bottom: 1.15rem;
    }

    .deals-picked__heading-wrap {
      gap: 0.72rem;
    }

    .deals-picked__heading-line {
      display: none;
    }

    .deals-picked__title {
      font-size: clamp(1.65rem, 8vw, 2.05rem);
      max-width: 18ch;
    }

    .deals-picked__nav {
      display: none;
    }

    .deals-picked__mission {
      margin-top: 1.4rem;
      padding: 0;
      border-radius: 0;
    }

    .deals-picked__mission-title {
      font-size: 1.22rem;
    }

    .deals-picked__mission-text {
      font-size: 0.94rem;
      line-height: 1.75;
    }

    .deals-picked__mission-button {
      width: 100%;
      max-width: 190px;
    }

    .deals-picked__mission-art {
      min-height: 180px;
    }
  }

  @media (max-width: 1120px) {
    .deals-picked__mission {
      grid-template-columns: 1fr;
      gap: 1.4rem;
    }

    .deals-picked__mission-copy {
      max-width: 100%;
    }

    .deals-picked__mission-art {
      justify-self: center;
      width: min(100%, 42rem);
      min-height: 220px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const section = document.getElementById('DealsPicked-{{ section.id }}');
    if (!section) return;

    const track = section.querySelector('[data-deals-track]');
    const prevButton = section.querySelector('[data-deals-prev]');
    const nextButton = section.querySelector('[data-deals-next]');

    if (!track || !prevButton || !nextButton) return;

    const getScrollAmount = function() {
      const slide = track.querySelector('.deals-picked__slide');
      if (!slide) return track.clientWidth * 0.85;

      const gap = parseFloat(window.getComputedStyle(track).gap || '0');
      return slide.getBoundingClientRect().width + gap;
    };

    const updateNavState = function() {
      const maxScrollLeft = Math.max(0, track.scrollWidth - track.clientWidth);
      prevButton.disabled = track.scrollLeft <= 2;
      nextButton.disabled = track.scrollLeft >= maxScrollLeft - 2;
    };

    prevButton.addEventListener('click', function() {
      track.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' });
    });

    nextButton.addEventListener('click', function() {
      track.scrollBy({ left: getScrollAmount(), behavior: 'smooth' });
    });

    let frame = null;
    track.addEventListener('scroll', function() {
      if (frame) window.cancelAnimationFrame(frame);
      frame = window.requestAnimationFrame(function() {
        updateNavState();
        frame = null;
      });
    }, { passive: true });

    window.addEventListener('resize', updateNavState);
    updateNavState();
  });
</script>

{% schema %}
{
  "name": "Deals picked for you",
  "tag": "section",
  "class": "section-deals-picked",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Deals Picked for You"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 5,
      "max": 20,
      "step": 1,
      "default": 10
    },
    {
      "type": "checkbox",
      "id": "show_shop_all",
      "label": "Show 'Shop All' link",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_mission_banner",
      "label": "Show mission banner below products",
      "default": true
    },
    {
      "type": "text",
      "id": "mission_heading",
      "label": "Mission heading",
      "default": "OUR MISSION - WELLNESS FOR LIFE!"
    },
    {
      "type": "richtext",
      "id": "mission_text",
      "label": "Mission text",
      "default": "<p>At Boreal Vita we aim to explore the goodness of nature with innovation. We are dedicated to play our role in building a happy and healthy community.</p>"
    },
    {
      "type": "text",
      "id": "mission_button_label",
      "label": "Mission button label",
      "default": "Learn more"
    },
    {
      "type": "url",
      "id": "mission_link",
      "label": "Mission button link"
    },
    {
      "type": "image_picker",
      "id": "mission_image",
      "label": "Mission illustration image"
    }
  ],
  "blocks": [
    {
      "type": "discount",
      "name": "Legacy discount block",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "20% off"
        },
        {
          "type": "text",
          "id": "discount",
          "label": "Discount amount",
          "default": "20"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Deals picked for you"
    }
  ]
}
{% endschema %}
