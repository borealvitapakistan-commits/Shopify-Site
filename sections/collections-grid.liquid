{%- comment -%}
  Collections Grid Section
{%- endcomment -%}

<section class="collections-grid-section{% if section.settings.prominent_hover %} collections-grid-section--prominent-hover{% endif %}">
  <div class="container">
    {% if section.settings.title != blank %}
      <h2 class="section-title section-title--center">{{ section.settings.title }}</h2>
    {% endif %}

    <div class="collections-grid" style="--collections-grid-columns-desktop: {% if section.blocks.size == 2 %}2{% else %}3{% endif %};">
      {% for block in section.blocks %}
        <a href="{{ block.settings.collection.url | default: '/collections/all' }}" class="collection-card">
          <div class="collection-card__image">
            {% if block.settings.image %}
              <img
                src="{{ block.settings.image | image_url: width: 600 }}"
                alt="{{ block.settings.collection.title | default: block.settings.title }}"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
                loading="lazy"
              >
            {% elsif block.settings.collection.image %}
              <img
                src="{{ block.settings.collection.image | image_url: width: 600 }}"
                alt="{{ block.settings.collection.title }}"
                width="{{ block.settings.collection.image.width }}"
                height="{{ block.settings.collection.image.height }}"
                loading="lazy"
              >
            {% else %}
              {{ 'collection-1' | placeholder_svg_tag }}
            {% endif %}
          </div>
          {% if block.settings.title != blank %}
            <div class="collection-card__content">
              <h3 class="collection-card__title">{{ block.settings.title }}</h3>
            </div>
          {% endif %}
        </a>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .collections-grid-section {
    padding: 4rem 0;
  }

  .collections-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .collections-grid {
      grid-template-columns: repeat(var(--collections-grid-columns-desktop, 3), 1fr);
      gap: 1.5rem;
    }
  }

  .collection-card {
    position: relative;
    display: block;
    border-radius: var(--radius);
    overflow: hidden;
    aspect-ratio: 4/3;
  }

  .collection-card__image {
    position: absolute;
    inset: 0;
  }

  .collection-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
  }

  .collection-card:hover .collection-card__image img {
    transform: scale(1.05);
  }

  .collection-card__content {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.4);
    transition: background 0.3s;
  }

  .collection-card:hover .collection-card__content {
    background: rgba(0, 0, 0, 0.5);
  }

  .collection-card__title {
    color: var(--color-primary-foreground, #ffffff);
    font-size: 1.25rem;
    font-weight: 600;
    text-align: center;
    margin: 0;
  }

  .collections-grid-section--prominent-hover .collection-card__content {
    align-items: flex-end;
    justify-content: flex-start;
    padding: 1.25rem;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.1) 25%, rgba(0, 0, 0, 0.7) 100%);
  }

  .collections-grid-section--prominent-hover .collection-card:hover .collection-card__content,
  .collections-grid-section--prominent-hover .collection-card:focus-visible .collection-card__content {
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.34) 0%, rgba(0, 0, 0, 0.86) 100%);
  }

  .collections-grid-section--prominent-hover .collection-card__title {
    text-align: left;
    font-size: clamp(1.05rem, 1vw + 0.75rem, 1.6rem);
    font-weight: 700;
    line-height: 1.15;
    text-shadow: 0 8px 20px rgba(0, 0, 0, 0.65);
    transform: translateY(16px);
    opacity: 0;
    transition: transform 0.35s ease, opacity 0.35s ease;
  }

  .collections-grid-section--prominent-hover .collection-card:hover .collection-card__title,
  .collections-grid-section--prominent-hover .collection-card:focus-visible .collection-card__title {
    transform: translateY(0);
    opacity: 1;
  }

  .collections-grid-section--prominent-hover .collection-card:focus-visible {
    outline: 2px solid rgba(248, 246, 218, 0.9);
    outline-offset: 2px;
  }

  @media (hover: none) {
    .collections-grid-section--prominent-hover .collection-card__content {
      background: linear-gradient(180deg, rgba(0, 0, 0, 0.22) 15%, rgba(0, 0, 0, 0.78) 100%);
    }

    .collections-grid-section--prominent-hover .collection-card__title {
      transform: translateY(0);
      opacity: 1;
    }
  }
</style>

{% schema %}
{
  "name": "Collections Grid",
  "tag": "section",
  "class": "section-collections-grid",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Shop by Category"
    },
    {
      "type": "checkbox",
      "id": "prominent_hover",
      "label": "Prominent hover overlay",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom Title"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collections Grid",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
