{%- comment -%}
  Product Main Information
  - Pulls data from product object only
  - Includes buy box, variants, quantity, and CTA
{%- endcomment -%}

{% assign current_variant = product.selected_or_first_available_variant %}
{% assign current_sold_out = false %}
{% if current_variant.available == false %}
  {% assign current_sold_out = true %}
{% endif %}
{% if current_variant.inventory_management != blank and current_variant.inventory_quantity <= 0 %}
  {% assign current_sold_out = true %}
{% endif %}
{% assign low_stock_metafield = section.settings.low_stock_metafield %}
{% assign low_stock_threshold = section.settings.low_stock_threshold | default: 0 %}
{% assign low_stock_namespace = '' %}
{% assign low_stock_key = '' %}

{% if low_stock_metafield != blank %}
  {% assign low_parts = low_stock_metafield | split: '.' %}
  {% assign low_stock_namespace = low_parts[0] %}
  {% assign low_stock_key = low_parts[1] %}
{% endif %}

{% assign current_low_stock = false %}
{% assign current_inventory = current_variant.inventory_quantity | default: 0 %}
{% if low_stock_namespace != blank and low_stock_key != blank %}
  {% assign low_value = current_variant.metafields[low_stock_namespace][low_stock_key] %}
  {% if low_value == blank %}
    {% assign low_value = product.metafields[low_stock_namespace][low_stock_key] %}
  {% endif %}
  {% if low_value != blank %}
    {% if low_value.value != blank %}
      {% assign low_value = low_value.value %}
    {% endif %}
    {% assign low_value_number = low_value | plus: 0 %}
    {% if low_value == true or low_value == 'true' %}
      {% assign current_low_stock = true %}
    {% elsif low_value_number > 0 %}
      {% if current_inventory <= low_value_number %}
        {% assign current_low_stock = true %}
      {% endif %}
    {% else %}
      {% assign current_low_stock = true %}
    {% endif %}
  {% endif %}
{% endif %}

{% if low_stock_threshold > 0 and current_variant.inventory_management != blank and current_inventory <= low_stock_threshold %}
  {% assign current_low_stock = true %}
{% endif %}

{% assign availability_label = section.settings.label_in_stock %}
{% assign availability_class = 'is-in' %}
{% if current_sold_out %}
  {% assign availability_label = section.settings.label_out_of_stock %}
  {% assign availability_class = 'is-out' %}
{% elsif current_low_stock %}
  {% assign availability_label = section.settings.label_low_stock %}
  {% assign availability_class = 'is-low' %}
{% endif %}

{% capture labels_json %}{
  "in": {{ section.settings.label_in_stock | json }},
  "out": {{ section.settings.label_out_of_stock | json }},
  "low": {{ section.settings.label_low_stock | json }},
  "add_to_cart": {{ section.settings.add_to_cart_label | json }},
  "sold_out": {{ section.settings.sold_out_label | json }}
}{% endcapture %}

{% capture variant_data %}[
{% for variant in product.variants %}
  {% assign variant_low_stock = false %}
  {% assign variant_inventory = variant.inventory_quantity | default: 0 %}
  {% assign variant_sold_out = false %}
  {% if variant.available == false %}
    {% assign variant_sold_out = true %}
  {% elsif variant.inventory_management != blank and variant_inventory <= 0 %}
    {% assign variant_sold_out = true %}
  {% endif %}
  {% if low_stock_namespace != blank and low_stock_key != blank %}
    {% assign low_value = variant.metafields[low_stock_namespace][low_stock_key] %}
    {% if low_value == blank %}
      {% assign low_value = product.metafields[low_stock_namespace][low_stock_key] %}
    {% endif %}
    {% if low_value != blank %}
      {% if low_value.value != blank %}
        {% assign low_value = low_value.value %}
      {% endif %}
      {% assign low_value_number = low_value | plus: 0 %}
      {% if low_value == true or low_value == 'true' %}
        {% assign variant_low_stock = true %}
      {% elsif low_value_number > 0 %}
        {% if variant_inventory <= low_value_number %}
          {% assign variant_low_stock = true %}
        {% endif %}
      {% else %}
        {% assign variant_low_stock = true %}
      {% endif %}
    {% endif %}
  {% endif %}

  {% if low_stock_threshold > 0 and variant.inventory_management != blank and variant_inventory <= low_stock_threshold %}
    {% assign variant_low_stock = true %}
  {% endif %}
  {
    "id": {{ variant.id }},
    "available": {{ variant.available | json }},
    "inventory_management": {{ variant.inventory_management | json }},
    "inventory_quantity": {{ variant.inventory_quantity | json }},
    "sold_out": {{ variant_sold_out | json }},
    "price": {{ variant.price | json }},
    "compare_at_price": {{ variant.compare_at_price | json }},
    "low_stock": {{ variant_low_stock | json }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]{% endcapture %}

<section class="product-main" id="ProductMain-{{ section.id }}">
  <div class="container product-main__grid">
    <div class="product-main__summary">
      {% if product.vendor != blank %}
        <p class="product-main__vendor">{{ product.vendor }}</p>
      {% endif %}
      <h1 class="product-main__title">{{ product.title }}</h1>

      <div class="product-main__price-line">
        <span class="product-main__price" data-price>{{ current_variant.price | money }}</span>
        <span class="product-main__compare" data-compare {% if current_variant.compare_at_price == blank or current_variant.compare_at_price <= current_variant.price %}style="display:none;"{% endif %}>
          {{ current_variant.compare_at_price | money }}
        </span>
      </div>

      <div class="product-main__availability {{ availability_class }}" data-availability>
        {{ availability_label }}
      </div>
    </div>

    <div class="product-main__buy">
      {% assign form_id = 'ProductForm-' | append: section.id %}
      {% form 'product', product, id: form_id, class: 'product-main__form', data-product-form: '' %}
        {% comment %}
          Automatically inserted by Shop Pay Installments theme updater
        {% endcomment %}
        {% unless settings.disable_autogenerated_payment_terms %}
          {{ form | payment_terms }}
        {% endunless %}
        {% unless product.has_only_default_variant %}
          <div class="product-main__field">
            <label class="product-main__label" for="VariantSelect-{{ section.id }}">{{ section.settings.variant_label }}</label>
            <select id="VariantSelect-{{ section.id }}" name="id" class="product-main__select" data-variant-select>
              {% for variant in product.variants %}
                {% assign option_sold_out = false %}
                {% if variant.available == false %}
                  {% assign option_sold_out = true %}
                {% elsif variant.inventory_management != blank and variant.inventory_quantity <= 0 %}
                  {% assign option_sold_out = true %}
                {% endif %}
                <option value="{{ variant.id }}" {% if variant.id == current_variant.id %}selected{% endif %} {% if option_sold_out %}disabled{% endif %}>
                  {{ variant.title }}
                </option>
              {% endfor %}
            </select>
          </div>
        {% else %}
          <input type="hidden" name="id" value="{{ current_variant.id }}">
        {% endunless %}

        <div class="product-main__field">
          <label class="product-main__label" for="Quantity-{{ section.id }}">{{ section.settings.quantity_label }}</label>
          <input id="Quantity-{{ section.id }}" class="product-main__quantity" type="number" name="quantity" min="1" value="1">
        </div>

        <button class="btn btn--primary btn--full product-main__atc" type="submit" data-atc {% if current_sold_out %}disabled{% endif %}>
          {% if current_sold_out %}
            {{ section.settings.sold_out_label }}
          {% else %}
            {{ section.settings.add_to_cart_label }}
          {% endif %}
        </button>

        {% if section.settings.show_dynamic_checkout %}
          <div class="product-main__buy-now">
            {{ form | payment_button }}
          </div>
        {% endif %}
      {% endform %}
    </div>
  </div>

  {% if section.settings.enable_mobile_bar %}
    <div class="product-main__mobile-bar" data-mobile-bar>
      <div class="product-main__mobile-price" data-mobile-price>{{ current_variant.price | money }}</div>
      <button class="btn btn--primary" type="submit" form="{{ form_id }}" data-mobile-atc>
        {{ section.settings.add_to_cart_label }}
      </button>
    </div>
    <div class="product-main__mobile-spacer" aria-hidden="true"></div>
  {% endif %}

  <script type="application/json" data-variant-json>
    {{ variant_data | strip }}
  </script>
  <script type="application/json" data-labels-json>
    {{ labels_json | strip }}
  </script>
</section>

<style>
  .product-main {
    padding: 2.5rem 0 3rem;
    background: #fff;
  }

  .product-main__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: 2rem;
  }

  .product-main__summary {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .product-main__vendor {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-muted-foreground);
  }

  .product-main__title {
    font-size: clamp(1.75rem, 2vw, 2.5rem);
  }

  .product-main__price-line {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: 1.5rem;
    font-weight: 700;
  }

  .product-main__compare {
    font-size: 1rem;
    color: var(--color-muted-foreground);
    text-decoration: line-through;
  }

  .product-main__availability {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
    background: var(--color-muted);
  }

  .product-main__availability.is-in {
    color: var(--color-success);
  }

  .product-main__availability.is-out {
    color: var(--color-destructive);
  }

  .product-main__availability.is-low {
    color: var(--color-accent);
  }

  .product-section-heading {
    font-size: 1.5rem;
    margin: 0 0 1.5rem;
  }

  .product-main__buy {
    position: sticky;
    top: calc(var(--header-height, 64px) + 24px);
    align-self: start;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.5rem;
    box-shadow: var(--shadow-sm);
  }

  .product-main__form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .product-main__field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .product-main__label {
    font-size: 0.85rem;
    font-weight: 600;
  }

  .product-main__select,
  .product-main__quantity {
    height: 44px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    padding: 0 0.75rem;
    font-size: 1rem;
    background: #fff;
  }

  .product-main__atc {
    height: 3.25rem;
  }

  .product-main__buy-now .shopify-payment-button__button {
    width: 100%;
    border-radius: var(--radius-sm);
  }

  .product-main__mobile-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 1rem;
    background: #fff;
    border-top: 1px solid var(--color-border);
    box-shadow: 0 -6px 24px rgba(0, 0, 0, 0.08);
  }

  .product-main__mobile-price {
    font-weight: 700;
  }

  .product-main__mobile-spacer {
    height: 76px;
  }

  @media (max-width: 900px) {
    .product-main__grid {
      grid-template-columns: 1fr;
    }

    .product-main__buy {
      position: static;
    }
  }

  @media (min-width: 901px) {
    .product-main__mobile-bar,
    .product-main__mobile-spacer {
      display: none;
    }
  }
</style>

<script>
  (function() {
    const section = document.getElementById('ProductMain-{{ section.id }}');
    if (!section) return;

    const variantDataEl = section.querySelector('[data-variant-json]');
    const labelsEl = section.querySelector('[data-labels-json]');
    if (!variantDataEl || !labelsEl) return;

    const variants = JSON.parse(variantDataEl.textContent || '[]');
    const labels = JSON.parse(labelsEl.textContent || '{}');
    const select = section.querySelector('[data-variant-select]');
    const priceEl = section.querySelector('[data-price]');
    const compareEl = section.querySelector('[data-compare]');
    const availabilityEl = section.querySelector('[data-availability]');
    const atcButton = section.querySelector('[data-atc]');
    const mobilePrice = section.querySelector('[data-mobile-price]');
    const mobileAtc = section.querySelector('[data-mobile-atc]');
    const moneyFormat = {{ shop.money_format | json }};

    const formatMoney = (cents) => {
      if (window.Shopify && Shopify.formatMoney) {
        return Shopify.formatMoney(cents, moneyFormat);
      }
      return (cents / 100).toFixed(2);
    };

    const updateAvailability = (variant) => {
      if (!availabilityEl) return;
      availabilityEl.classList.remove('is-in', 'is-out', 'is-low');
      if (variant.sold_out) {
        availabilityEl.textContent = labels.out || 'Out of stock';
        availabilityEl.classList.add('is-out');
        return;
      }
      if (variant.low_stock) {
        availabilityEl.textContent = labels.low || 'Low stock';
        availabilityEl.classList.add('is-low');
        return;
      }
      availabilityEl.textContent = labels.in || 'In stock';
      availabilityEl.classList.add('is-in');
    };

    const updateButtons = (variant) => {
      if (atcButton) {
        if (!variant.sold_out) {
          atcButton.disabled = false;
          atcButton.textContent = labels.add_to_cart || 'Add to cart';
        } else {
          atcButton.disabled = true;
          atcButton.textContent = labels.sold_out || 'Sold out';
        }
      }
      if (mobileAtc) {
        if (!variant.sold_out) {
          mobileAtc.disabled = false;
          mobileAtc.textContent = labels.add_to_cart || 'Add to cart';
        } else {
          mobileAtc.disabled = true;
          mobileAtc.textContent = labels.sold_out || 'Sold out';
        }
      }
    };

    const updatePrice = (variant) => {
      if (priceEl) priceEl.textContent = formatMoney(variant.price);
      if (mobilePrice) mobilePrice.textContent = formatMoney(variant.price);
      if (!compareEl) return;
      if (variant.compare_at_price && variant.compare_at_price > variant.price) {
        compareEl.textContent = formatMoney(variant.compare_at_price);
        compareEl.style.display = 'inline';
      } else {
        compareEl.style.display = 'none';
      }
    };

    const update = (variantId) => {
      const variant = variants.find((item) => item.id === Number(variantId));
      if (!variant) return;
      updatePrice(variant);
      updateAvailability(variant);
      updateButtons(variant);
    };

    if (select) {
      select.addEventListener('change', (event) => update(event.target.value));
      update(select.value);
    } else if (variants[0]) {
      update(variants[0].id);
    }
  })();
</script>

{% schema %}
{
  "name": "Product main",
  "tag": "section",
  "class": "section-product-main",
  "settings": [
    {
      "type": "text",
      "id": "variant_label",
      "label": "Variant label",
      "default": "Select option"
    },
    {
      "type": "text",
      "id": "quantity_label",
      "label": "Quantity label",
      "default": "Quantity"
    },
    {
      "type": "text",
      "id": "add_to_cart_label",
      "label": "Add to cart label",
      "default": "Add to cart"
    },
    {
      "type": "text",
      "id": "sold_out_label",
      "label": "Sold out label",
      "default": "Out of stock"
    },
    {
      "type": "text",
      "id": "label_in_stock",
      "label": "In stock label",
      "default": "In stock"
    },
    {
      "type": "text",
      "id": "label_out_of_stock",
      "label": "Out of stock label",
      "default": "Out of stock"
    },
    {
      "type": "text",
      "id": "label_low_stock",
      "label": "Low stock label",
      "default": "Low stock"
    },
    {
      "type": "text",
      "id": "low_stock_metafield",
      "label": "Low stock metafield (namespace.key)",
      "info": "Optional. If set and the metafield has a value, the variant is marked low stock."
    },
    {
      "type": "range",
      "id": "low_stock_threshold",
      "label": "Low stock threshold (inventory quantity)",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Show buy now button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_mobile_bar",
      "label": "Enable mobile sticky bar",
      "default": true
    }
  ]
}
{% endschema %}
