{%- comment -%}
  Homepage video product ad.
{%- endcomment -%}

{% liquid
  assign ad_product = section.settings.product
  assign fallback_collection = collections[section.settings.collection]

  if ad_product == blank and fallback_collection != blank
    assign ad_product = fallback_collection.products.first
  endif

  assign ad_variant = ad_product.selected_or_first_available_variant
  assign ad_price = ad_variant.price
  assign ad_compare = ad_variant.compare_at_price
%}

<section class="homepage-video-ad" id="HomepageVideoAd-{{ section.id }}">
  <div class="container homepage-video-ad__container">
    {% if section.settings.heading != blank %}
      <div class="homepage-video-ad__header">
        <h2>{{ section.settings.heading }}</h2>
      </div>
    {% endif %}

    <div class="homepage-video-ad__card">
      <div class="homepage-video-ad__media">
        {% if section.settings.video != blank %}
          {{
            section.settings.video
            | video_tag:
              controls: true,
              autoplay: false,
              loop: false,
              muted: true,
              playsinline: true,
              image_size: '1200x'
          }}
        {% elsif section.settings.video_url != blank %}
          {% if section.settings.video_url.type == 'youtube' %}
            <iframe
              src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?rel=0&modestbranding=1"
              title="{{ section.settings.heading | default: 'Product video' | escape }}"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
              loading="lazy"
            ></iframe>
          {% elsif section.settings.video_url.type == 'vimeo' %}
            <iframe
              src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}"
              title="{{ section.settings.heading | default: 'Product video' | escape }}"
              allow="autoplay; fullscreen; picture-in-picture"
              allowfullscreen
              loading="lazy"
            ></iframe>
          {% endif %}
        {% elsif section.settings.cover_image != blank %}
          {{
            section.settings.cover_image
            | image_url: width: 1400
            | image_tag:
              class: 'homepage-video-ad__cover',
              loading: 'lazy',
              alt: section.settings.heading
          }}
          <span class="homepage-video-ad__play" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="m9 7 8 5-8 5V7Z"></path></svg>
          </span>
        {% elsif ad_product != blank and ad_product.featured_image != blank %}
          {{
            ad_product.featured_image
            | image_url: width: 1000
            | image_tag:
              class: 'homepage-video-ad__cover homepage-video-ad__cover--product',
              loading: 'lazy',
              alt: ad_product.title
          }}
          <span class="homepage-video-ad__play" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="m9 7 8 5-8 5V7Z"></path></svg>
          </span>
        {% endif %}
      </div>

      <div class="homepage-video-ad__product">
        {% if ad_product != blank and ad_product.featured_image != blank %}
          <a class="homepage-video-ad__product-image" href="{{ ad_product.url }}" aria-label="{{ ad_product.title | escape }}">
            {{
              ad_product.featured_image
              | image_url: width: 520
              | image_tag:
                loading: 'lazy',
                alt: ad_product.title
            }}
          </a>
        {% endif %}
      </div>

      <div class="homepage-video-ad__copy">
        {% if section.settings.label != blank %}
          <p class="homepage-video-ad__label">{{ section.settings.label }}</p>
        {% endif %}

        {% if ad_product != blank %}
          <h3>
            <a href="{{ ad_product.url }}">{{ ad_product.title }}</a>
          </h3>
        {% else %}
          <h3>{{ section.settings.fallback_title }}</h3>
        {% endif %}

        {% if section.settings.rating_text != blank %}
          <p class="homepage-video-ad__rating">{{ section.settings.rating_text }}</p>
        {% endif %}

        {% if ad_product != blank and ad_variant != blank %}
          <div class="homepage-video-ad__price">
            <span>{{ ad_price | money }}</span>
            {% if ad_compare and ad_compare > ad_price %}
              <s>{{ ad_compare | money }}</s>
            {% endif %}
          </div>
        {% endif %}

        {% if section.settings.offer_text != blank %}
          <p class="homepage-video-ad__offer">{{ section.settings.offer_text }}</p>
        {% endif %}

        {% if section.settings.delivery_text != blank %}
          <p class="homepage-video-ad__delivery">{{ section.settings.delivery_text }}</p>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<style>
  .homepage-video-ad {
    padding: clamp(1.25rem, 2.4vw, 2rem) 0;
    background: #ffffff;
  }

  .homepage-video-ad__container {
    width: min(1280px, calc(100vw - clamp(2rem, 10vw, 11rem)));
    max-width: 1280px;
    padding: 0;
  }

  .homepage-video-ad__header {
    margin-bottom: 1rem;
  }

  .homepage-video-ad__header h2 {
    margin: 0;
    color: var(--brand-primary, #0A282C);
    font-family: var(--font-title, "FuturaBT Bold", "DM Sans", sans-serif);
    font-size: clamp(1.25rem, 1.05rem + 0.65vw, 1.7rem);
    font-weight: 800;
    line-height: 1.1;
  }

  .homepage-video-ad__card {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(13rem, 0.68fr) minmax(20rem, 1fr);
    min-height: 280px;
    overflow: hidden;
    border: 1px solid rgba(10, 40, 44, 0.12);
    border-radius: 0.45rem;
    background: #ffffff;
  }

  .homepage-video-ad__media {
    position: relative;
    display: grid;
    min-height: 280px;
    place-items: center;
    overflow: hidden;
    background: #f2f2f2;
  }

  .homepage-video-ad__media video,
  .homepage-video-ad__media iframe,
  .homepage-video-ad__cover {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 280px;
    border: 0;
    object-fit: cover;
  }

  .homepage-video-ad__cover--product {
    width: 70%;
    height: 70%;
    min-height: 0;
    object-fit: contain;
  }

  .homepage-video-ad__play {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: 1px solid rgba(10, 40, 44, 0.16);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.92);
    color: var(--brand-primary, #0A282C);
  }

  .homepage-video-ad__play svg {
    width: 1.15rem;
    height: 1.15rem;
    fill: currentColor;
  }

  .homepage-video-ad__product {
    display: grid;
    min-height: 280px;
    place-items: center;
    background: #f7f7f7;
  }

  .homepage-video-ad__product-image {
    display: grid;
    width: min(78%, 13rem);
    place-items: center;
  }

  .homepage-video-ad__product-image img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .homepage-video-ad__copy {
    display: grid;
    align-content: start;
    gap: 0.55rem;
    padding: clamp(1rem, 1.8vw, 1.35rem);
  }

  .homepage-video-ad__label {
    margin: 0;
    color: rgba(10, 40, 44, 0.62);
    font-size: 0.76rem;
    font-weight: 700;
  }

  .homepage-video-ad__copy h3 {
    margin: 0;
    color: #111111;
    font-family: var(--font-body, "DM Sans", sans-serif);
    font-size: clamp(1rem, 1.2vw, 1.18rem);
    font-weight: 700;
    line-height: 1.3;
  }

  .homepage-video-ad__copy h3 a {
    color: inherit;
    text-decoration: none;
  }

  .homepage-video-ad__copy h3 a:hover,
  .homepage-video-ad__copy h3 a:focus-visible {
    text-decoration: underline;
    outline: none;
  }

  .homepage-video-ad__rating,
  .homepage-video-ad__delivery {
    margin: 0;
    color: #333333;
    font-size: 0.9rem;
    line-height: 1.35;
  }

  .homepage-video-ad__price {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    color: #111111;
    font-family: var(--font-heading, "Coolvetica", "DM Sans", sans-serif);
  }

  .homepage-video-ad__price span {
    font-size: clamp(1.3rem, 1.9vw, 1.9rem);
    font-weight: 500;
    line-height: 1;
  }

  .homepage-video-ad__price s {
    color: rgba(10, 40, 44, 0.52);
    font-size: 0.9rem;
  }

  .homepage-video-ad__offer {
    width: fit-content;
    margin: 0;
    padding: 0.22rem 0.42rem;
    background: #d8f2c7;
    color: #111111;
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1;
  }

  @media (max-width: 900px) {
    .homepage-video-ad__container {
      width: min(100%, calc(100vw - 2rem));
    }

    .homepage-video-ad__card {
      grid-template-columns: 1fr;
    }
  }
</style>

{% schema %}
{
  "name": "Homepage video ad",
  "tag": "section",
  "class": "section-homepage-video-ad",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Video"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Shopify-hosted video"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "YouTube or Vimeo URL",
      "accept": ["youtube", "vimeo"]
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "Fallback cover image"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Featured product"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Fallback collection"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Small label",
      "default": "Sponsored"
    },
    {
      "type": "text",
      "id": "fallback_title",
      "label": "Fallback title",
      "default": "Clean-label herbal wellness support"
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating text",
      "default": "4.8 stars | trusted by customers"
    },
    {
      "type": "text",
      "id": "offer_text",
      "label": "Offer text",
      "default": "Save on your first order"
    },
    {
      "type": "text",
      "id": "delivery_text",
      "label": "Delivery text",
      "default": "Fast delivery across Pakistan"
    }
  ],
  "presets": [
    {
      "name": "Homepage video ad"
    }
  ]
}
{% endschema %}
