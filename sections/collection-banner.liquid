{%- comment -%}
  Collection Banner Section
{%- endcomment -%}

<section
  class="collection-banner{% if collection.image %} collection-banner--with-image{% endif %}"
  {% if collection.image %}
    style="--collection-banner-image: url('{{ collection.image | image_url: width: 1920 }}');"
  {% endif %}
>
  <div class="collection-banner__overlay"></div>
  <div class="container">
    <div class="collection-banner__content">
      <h1 class="collection-banner__title">{{ collection.title }}</h1>
      {% if collection.description != blank %}
        <div class="collection-banner__description">
          {{ collection.description }}
        </div>
      {% endif %}
      <p class="collection-banner__count">{{ collection.products_count }} products</p>
    </div>
  </div>
</section>

<style>
  .collection-banner {
    position: relative;
    padding: 4rem 0;
    background:
      radial-gradient(circle at 50% 0%, rgba(var(--brand-green-rgb, 250, 208, 84), 0.16), transparent 24rem),
      linear-gradient(180deg, rgba(248, 242, 251, 0.98) 0%, rgba(243, 249, 231, 0.74) 100%),
      var(--collection-banner-image, none);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .collection-banner__overlay {
    position: absolute;
    inset: 0;
    background: rgba(255, 255, 255, 0.7);
  }

  .collection-banner__content {
    position: relative;
    z-index: 1;
    text-align: center;
    color: var(--brand-purple-dark, #06181B);
  }

  .collection-banner__title {
    font-size: 2rem;
    margin-bottom: 0.5rem;
    color: var(--brand-purple-dark, #06181B);
  }

  @media (min-width: 768px) {
    .collection-banner__title {
      font-size: 2.5rem;
    }
  }

  .collection-banner__description {
    max-width: 600px;
    margin: 0 auto 1rem;
    color: #3F5641;
    opacity: 1;
  }

  .collection-banner__count {
    font-size: 0.875rem;
    color: #3F5641;
    opacity: 1;
    margin: 0;
  }
</style>

{% schema %}
{
  "name": "Collection Banner",
  "tag": "section",
  "class": "section-collection-banner"
}
{% endschema %}
