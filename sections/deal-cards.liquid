<section class="section">
  <div class="container">
    <div class="section-title">
      <div>
        <h2>{{ section.settings.heading }}</h2>
        <div class="hint">{{ section.settings.subheading }}</div>
      </div>
      {% if section.settings.link_label != blank %}
        <a href="{{ section.settings.link_url }}">{{ section.settings.link_label }}</a>
      {% endif %}
    </div>
    <div class="deal-grid">
      {% for block in section.blocks %}
        <div class="deal-card reveal delay-{{ forloop.index }}">
          <div class="deal-value">{{ block.settings.title }}</div>
          <p>{{ block.settings.text }}</p>
          {% if block.settings.button_label != blank %}
            <a class="button secondary" href="{{ block.settings.button_link }}">{{ block.settings.button_label }}</a>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Deal cards",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Herbal bundles & rituals"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Curated sets for energy, calm, and daily immunity."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "View all bundles"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    }
  ],
  "blocks": [
    {
      "type": "deal",
      "name": "Deal",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "3 for $48"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Daily tonic trio"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop bundle"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Deal cards",
      "blocks": [
        { "type": "deal" },
        { "type": "deal" },
        { "type": "deal" }
      ]
    }
  ]
}
{% endschema %}
