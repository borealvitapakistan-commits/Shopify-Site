{%- capture account_menu_panel_markup -%}
  <div class="header-account-menu__content">
    <p class="header-account-menu__welcome">Welcome!</p>

    <div class="header-account-menu__list">
      <a href="{{ account_dashboard_url }}" class="header-account-menu__link">
        <span class="header-account-menu__icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21a8 8 0 0 0-16 0"></path>
            <circle cx="12" cy="8" r="4"></circle>
          </svg>
        </span>
        <span>My Account</span>
      </a>

      <a href="{{ account_orders_url }}" class="header-account-menu__link">
        <span class="header-account-menu__icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="5" y="3" width="14" height="18" rx="2"></rect>
            <path d="M9 8h6M9 12h6M9 16h4"></path>
          </svg>
        </span>
        <span>Orders</span>
      </a>

      <button type="button" class="header-account-menu__link header-account-menu__link--button" data-open-wishlist>
        <span class="header-account-menu__icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 6h11M9 12h11M9 18h11"></path>
            <path d="M4 6h.01M4 12h.01M4 18h.01"></path>
          </svg>
        </span>
        <span>My Wishlist</span>
        <span class="wishlist-count-badge header-account-menu__count" style="display: none;">0</span>
      </button>

      <a href="{{ account_reviews_url }}" class="header-account-menu__link">
        <span class="header-account-menu__icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 20h9"></path>
            <path d="M16.5 3.5a2.1 2.1 0 1 1 3 3L7 19l-4 1 1-4 12.5-12.5Z"></path>
          </svg>
        </span>
        <span>My Reviews</span>
      </a>

      <a href="{{ account_messages_url }}" class="header-account-menu__link">
        <span class="header-account-menu__icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4Z"></path>
          </svg>
        </span>
        <span>Messages</span>
      </a>
    </div>

    <a href="{{ account_cta_url }}" class="header-account-menu__cta">{{ account_cta_label }}</a>

    {% if customer %}
      <a href="{{ account_logout_url }}" class="header-account-menu__secondary-link">Log out</a>
    {% endif %}
  </div>
{%- endcapture -%}

