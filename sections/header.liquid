{%- assign logo_width = section.settings.logo_width | default: 250 -%}
{%- assign fallback_logo_height = logo_width | times: 496 | divided_by: 1749 -%}
{%- assign logo_height = fallback_logo_height -%}
{%- assign sticky_logo_width = 190 -%}
{%- assign sticky_fallback_logo_height = sticky_logo_width | times: 496 | divided_by: 1749 -%}
{%- assign sticky_logo_height = sticky_fallback_logo_height -%}
{%- assign brand_name = settings.brand_name | default: shop.name -%}
{%- if section.settings.logo != blank -%}
  {%- assign logo_height = logo_width | times: section.settings.logo.height | divided_by: section.settings.logo.width -%}
{%- endif -%}
{%- if section.settings.sticky_logo != blank -%}
  {%- assign sticky_logo_height = sticky_logo_width | times: section.settings.sticky_logo.height | divided_by: section.settings.sticky_logo.width -%}
{%- endif -%}
{%- capture header_white_logo_markup -%}
  <img
    src="{{ 'logo-white-440.png' | asset_url }}"
    alt="{{ brand_name | escape }}"
    class="header-brand-lockup__logo"
    width="220"
    height="62"
    loading="eager"
  >
{%- endcapture -%}
{%- capture mobile_header_logo_markup -%}
  {%- if section.settings.logo != blank -%}
    <img
      src="{{ section.settings.logo | image_url: width: logo_width }}"
      alt="{{ brand_name | escape }}"
      class="header-brand-lockup__logo"
      width="{{ logo_width }}"
      height="{{ logo_height }}"
      loading="eager"
    >
  {%- else -%}
    <img
      src="{{ 'logo-white-440.png' | asset_url }}"
      alt="{{ brand_name | escape }}"
      class="header-brand-lockup__logo"
      width="{{ logo_width }}"
      height="{{ logo_height }}"
      loading="eager"
    >
  {%- endif -%}
{%- endcapture -%}
{%- capture sticky_header_logo_markup -%}
  {%- if section.settings.sticky_logo != blank -%}
    <img
      src="{{ section.settings.sticky_logo | image_url: width: sticky_logo_width }}"
      alt="{{ brand_name | escape }}"
      class="header-brand-lockup__logo"
      width="{{ sticky_logo_width }}"
      height="{{ sticky_logo_height }}"
      loading="eager"
    >
  {%- else -%}
    <img
      src="{{ 'header-logo-color-380.png' | asset_url }}"
      alt="{{ brand_name | escape }}"
      class="header-brand-lockup__logo"
      width="{{ sticky_logo_width }}"
      height="{{ sticky_logo_height }}"
      loading="eager"
    >
  {%- endif -%}
{%- endcapture -%}

