    const header = document.querySelector('[data-header]');
    const accountMenus = header ? Array.from(header.querySelectorAll('[data-account-menu]')) : [];
    const mobileToggle = header ? header.querySelector('[data-mobile-toggle]') : null;
    const mobileNav = header ? header.querySelector('[data-mobile-nav]') : null;
    const mobileSearchToggle = header ? header.querySelector('[data-mobile-search-toggle]') : null;
    const mobileSearch = header ? header.querySelector('[data-mobile-search]') : null;
    const mobileSearchInput = mobileSearch ? mobileSearch.querySelector('.header-mobile__search-input') : null;
    const topStripMarquee = header ? header.querySelector('[data-top-strip-marquee]') : null;
    const pageLinks = header ? Array.from(header.querySelectorAll('[data-page-link]')) : [];
    const navDropdowns = header ? Array.from(header.querySelectorAll('.header-nav-dropdown')) : [];
    let topStripMarqueeFrame = null;
    let dropdownPositionFrame = null;

    const syncDropdownPosition = function(dropdown) {
      if (!dropdown) return;

      const dropdownItem = dropdown.closest('.header-secondary-nav__item--has-dropdown');
      const itemRect = dropdownItem ? dropdownItem.getBoundingClientRect() : null;
      const top = itemRect ? Math.max(8, itemRect.bottom + 8) : 120;

      dropdown.style.setProperty('--header-dropdown-top', `${Math.round(top)}px`);
    };

    const syncDropdownPositions = function() {
      if (!navDropdowns.length) return;
      navDropdowns.forEach(syncDropdownPosition);
    };

    const requestDropdownPositionSync = function() {
      if (!navDropdowns.length) return;

      if (dropdownPositionFrame) {
        window.cancelAnimationFrame(dropdownPositionFrame);
      }

      dropdownPositionFrame = window.requestAnimationFrame(function() {
        syncDropdownPositions();
        dropdownPositionFrame = null;
      });
    };

    const syncTopStripMarquee = function() {
      if (!topStripMarquee) return;

      const marqueeTrack = topStripMarquee.querySelector('.header-top-strip__marquee-track');
      const marqueeGroup = topStripMarquee.querySelector('.header-top-strip__marquee-group');

      if (!marqueeTrack || !marqueeGroup) return;

      const groupWidth = Math.ceil(marqueeGroup.getBoundingClientRect().width);

      if (!groupWidth) return;

      const speed = 62;
      const duration = Math.max(groupWidth / speed, 32);

      marqueeTrack.style.setProperty('--marquee-duration', `${duration}s`);
    };

    const requestTopStripMarqueeSync = function() {
      if (!topStripMarquee) return;

      if (topStripMarqueeFrame) {
        window.cancelAnimationFrame(topStripMarqueeFrame);
      }

      topStripMarqueeFrame = window.requestAnimationFrame(function() {
        syncTopStripMarquee();
        topStripMarqueeFrame = null;
      });
    };

    if (topStripMarquee) {
      requestTopStripMarqueeSync();
      window.addEventListener('load', requestTopStripMarqueeSync);
      window.addEventListener('resize', requestTopStripMarqueeSync);

      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(requestTopStripMarqueeSync);
      }
    }

    if (navDropdowns.length) {
      const dropdownCloseTimers = new WeakMap();

      const clearDropdownClose = function(dropdownItem) {
        const timer = dropdownCloseTimers.get(dropdownItem);
        if (!timer) return;

        window.clearTimeout(timer);
        dropdownCloseTimers.delete(dropdownItem);
      };

	      const closeDropdown = function(dropdownItem) {
	        if (!dropdownItem) return;
	
	        clearDropdownClose(dropdownItem);
	        dropdownItem.classList.remove('is-dropdown-open');
	        const trigger = dropdownItem.querySelector('.header-secondary-nav__link, .header-sticky-nav__link');
	        if (trigger) {
	          trigger.setAttribute('aria-expanded', 'false');
	        }
	      };

      const openDropdown = function(dropdownItem, dropdown) {
        if (!dropdownItem || !dropdown) return;

        navDropdowns.forEach(function(otherDropdown) {
          const otherItem = otherDropdown.closest('.header-secondary-nav__item--has-dropdown');

          if (otherItem && otherItem !== dropdownItem) {
            closeDropdown(otherItem);
          }
        });

	        clearDropdownClose(dropdownItem);
	        syncDropdownPosition(dropdown);
	        dropdownItem.classList.add('is-dropdown-open');
	        const trigger = dropdownItem.querySelector('.header-secondary-nav__link, .header-sticky-nav__link');
	        if (trigger) {
	          trigger.setAttribute('aria-expanded', 'true');
	        }
	      };

      const scheduleDropdownClose = function(dropdownItem) {
        if (!dropdownItem) return;

        clearDropdownClose(dropdownItem);

        const timer = window.setTimeout(function() {
          const hasPointer = dropdownItem.matches(':hover');
          const hasFocus = dropdownItem.contains(document.activeElement);

          if (!hasPointer && !hasFocus) {
            dropdownItem.classList.remove('is-dropdown-open');
          }

          dropdownCloseTimers.delete(dropdownItem);
        }, 420);

        dropdownCloseTimers.set(dropdownItem, timer);
      };

	      navDropdowns.forEach(function(dropdown) {
	        const dropdownItem = dropdown.closest('.header-secondary-nav__item--has-dropdown');
	        const trigger = dropdownItem ? dropdownItem.querySelector('.header-secondary-nav__link, .header-sticky-nav__link') : null;
	
	        if (!dropdownItem) return;
	
	        if (trigger) {
	          trigger.setAttribute('aria-haspopup', 'true');
	          trigger.setAttribute('aria-expanded', 'false');
	          trigger.addEventListener('click', function(event) {
	            event.preventDefault();
	            event.stopPropagation();
	
	            if (dropdownItem.classList.contains('is-dropdown-open')) {
	              closeDropdown(dropdownItem);
	              return;
	            }
	
	            openDropdown(dropdownItem, dropdown);
	          });
	        }
	
	        dropdown.addEventListener('click', function(event) {
	          event.stopPropagation();
	        });

        dropdownItem.addEventListener('keydown', function(event) {
          if (event.key === 'Escape') {
            closeDropdown(dropdownItem);
            const trigger = dropdownItem.querySelector('.header-secondary-nav__link, .header-sticky-nav__link');

            if (trigger) {
              trigger.focus();
            }
          }
        });
      });

	      requestDropdownPositionSync();
	      window.addEventListener('load', requestDropdownPositionSync);
	      window.addEventListener('resize', requestDropdownPositionSync);
	      document.addEventListener('click', function(event) {
	        const clickedInsideDropdown = navDropdowns.some(function(dropdown) {
	          const dropdownItem = dropdown.closest('.header-secondary-nav__item--has-dropdown');
	          return dropdownItem && dropdownItem.contains(event.target);
	        });
	
	        if (!clickedInsideDropdown) {
	          navDropdowns.forEach(function(dropdown) {
	            closeDropdown(dropdown.closest('.header-secondary-nav__item--has-dropdown'));
	          });
	        }
	      });
	    }

    const syncPageLinkState = function() {
      if (!pageLinks.length) return;

      const pathname = window.location.pathname.toLowerCase();
      const searchParams = new URLSearchParams(window.location.search);
      const isAboutPage = pathname.includes('/about') || searchParams.get('view') === 'about-us';
      const isContactPage = !isAboutPage && pathname.includes('/contact');

      if (!isAboutPage && !isContactPage) {
        return;
      }

      pageLinks.forEach(function(link) {
        const isActive =
          (link.dataset.pageLink === 'about' && isAboutPage) ||
          (link.dataset.pageLink === 'contact' && isContactPage);

        link.classList.toggle('is-active', isActive);

        if (isActive) {
          link.setAttribute('aria-current', 'page');
        } else {
          link.removeAttribute('aria-current');
        }
      });
    };

    syncPageLinkState();

    const accountMenuCloseTimers = new WeakMap();

    const clearAccountMenuCloseTimer = function(menu) {
      const existingTimer = accountMenuCloseTimers.get(menu);

      if (existingTimer) {
        window.clearTimeout(existingTimer);
        accountMenuCloseTimers.delete(menu);
      }
    };

    const setAccountMenuOpen = function(menu, isOpen, pinned) {
      if (!menu) return;

      const trigger = menu.querySelector('[data-account-menu-toggle]');
      clearAccountMenuCloseTimer(menu);
      menu.classList.toggle('is-open', isOpen);
      menu.classList.toggle('is-pinned', Boolean(isOpen && pinned));

      if (trigger) {
        trigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      }
    };

    const closeAccountMenus = function(exceptMenu) {
      accountMenus.forEach(function(menu) {
        if (menu !== exceptMenu) {
          setAccountMenuOpen(menu, false, false);
        }
      });
    };

    const scheduleAccountMenuClose = function(menu) {
      if (!menu || menu.classList.contains('is-pinned')) return;

      clearAccountMenuCloseTimer(menu);

      const closeTimer = window.setTimeout(function() {
        if (!menu.matches(':hover') && !menu.contains(document.activeElement) && !menu.classList.contains('is-pinned')) {
          setAccountMenuOpen(menu, false, false);
        }
      }, 360);

      accountMenuCloseTimers.set(menu, closeTimer);
    };

    if (accountMenus.length) {
      accountMenus.forEach(function(menu) {
        const trigger = menu.querySelector('[data-account-menu-toggle]');
        const panel = menu.querySelector('[data-account-menu-panel]');

        menu.addEventListener('mouseenter', function() {
          closeAccountMenus(menu);
          setAccountMenuOpen(menu, true, false);
        });

        menu.addEventListener('mouseleave', function() {
          scheduleAccountMenuClose(menu);
        });

        menu.addEventListener('focusin', function() {
          closeAccountMenus(menu);
          setAccountMenuOpen(menu, true, false);
        });

        menu.addEventListener('focusout', function() {
          window.setTimeout(function() {
            if (!menu.contains(document.activeElement) && !menu.matches(':hover') && !menu.classList.contains('is-pinned')) {
              setAccountMenuOpen(menu, false, false);
            }
          }, 0);
        });

        if (trigger) {
          trigger.addEventListener('click', function(event) {
            event.preventDefault();
            event.stopPropagation();

            const shouldOpen = !menu.classList.contains('is-open') || !menu.classList.contains('is-pinned');
            closeAccountMenus(shouldOpen ? menu : null);

            if (shouldOpen) {
              setAccountMenuOpen(menu, true, true);
            } else {
              setAccountMenuOpen(menu, false, false);
            }
          });
        }

        if (panel) {
          panel.addEventListener('click', function(event) {
            const wishlistTrigger = event.target.closest('[data-open-wishlist]');

            if (wishlistTrigger) {
              event.preventDefault();
              event.stopPropagation();

              if (window.Wishlist && typeof window.Wishlist.openModal === 'function') {
                window.Wishlist.openModal();
              }

              return;
            }

            event.stopPropagation();
          });
        }
      });

      document.addEventListener('click', function(event) {
        const clickedInsideMenu = accountMenus.some(function(menu) {
          return menu.contains(event.target);
        });

        if (!clickedInsideMenu) {
          closeAccountMenus(null);
        }
      });

      document.addEventListener('keydown', function(event) {
        if (event.key === 'Escape') {
          closeAccountMenus(null);
        }
      });
    }

    const setMobileMenuOpen = function(isOpen) {
      if (!mobileToggle || !mobileNav) return;
      mobileNav.classList.toggle('is-open', isOpen);
      mobileToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      mobileToggle.querySelector('.menu-icon').style.display = isOpen ? 'none' : 'block';
      mobileToggle.querySelector('.close-icon').style.display = isOpen ? 'block' : 'none';
      document.body.classList.toggle('menu-open', isOpen);
    };

    const setMobileSearchOpen = function(isOpen) {
      if (!mobileSearchToggle || !mobileSearch) return;
      mobileSearch.classList.toggle('is-open', isOpen);
      mobileSearch.setAttribute('aria-hidden', isOpen ? 'false' : 'true');
      mobileSearchToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      if (isOpen && mobileSearchInput) {
        window.setTimeout(function() {
          mobileSearchInput.focus();
        }, 120);
      }
    };

    if (mobileToggle && mobileNav) {
      mobileToggle.setAttribute('aria-expanded', 'false');
      mobileToggle.addEventListener('click', function() {
        const isOpen = !mobileNav.classList.contains('is-open');
        if (isOpen) {
          setMobileSearchOpen(false);
        }
        setMobileMenuOpen(isOpen);
      });
    }

    if (mobileSearchToggle && mobileSearch) {
      mobileSearchToggle.addEventListener('click', function() {
        const isOpen = !mobileSearch.classList.contains('is-open');
        if (isOpen) {
          setMobileMenuOpen(false);
        }
        setMobileSearchOpen(isOpen);
      });
    }

    const syncStickyState = function() {
      const currentScroll = window.pageYOffset;
      if (header) {
        header.classList.toggle('is-sticky', currentScroll > 100);
      }
      if (currentScroll > 100) {
        closeAccountMenus(null);
        setMobileSearchOpen(false);
        setMobileMenuOpen(false);
      }
    };

    syncStickyState();
    window.addEventListener('scroll', function() {
      syncStickyState();
      requestDropdownPositionSync();
    });
  });
</script>

