{%- comment -%}
  Customer Registration Page - Matches React design
{%- endcomment -%}

<div class="main-register">
  <div class="container">
    <div class="auth-wrapper">
      <div class="auth-card">
        <div class="auth-header">
          <h1 class="auth-title">{{ 'customer.register.title' | t }}</h1>
          <p class="auth-subtitle">Create an account to track orders & save favorites</p>
        </div>

        {%- form 'create_customer', class: 'auth-form' -%}
          {%- if form.errors -%}
            <div class="form-error">
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <div class="form-row-2">
            <div class="form-group">
              <label for="FirstName" class="form-label">
                {{ 'customer.register.first_name' | t }}
              </label>
              <input
                type="text"
                name="customer[first_name]"
                id="FirstName"
                class="form-input"
                autocomplete="given-name"
                required
                placeholder="John"
              >
            </div>

            <div class="form-group">
              <label for="LastName" class="form-label">
                {{ 'customer.register.last_name' | t }}
              </label>
              <input
                type="text"
                name="customer[last_name]"
                id="LastName"
                class="form-input"
                autocomplete="family-name"
                required
                placeholder="Doe"
              >
            </div>
          </div>

          <div class="form-group">
            <label for="Email" class="form-label">
              {{ 'customer.register.email' | t }}
            </label>
            <input
              type="email"
              name="customer[email]"
              id="Email"
              class="form-input"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              required
              placeholder="you@example.com"
            >
          </div>

          <div class="form-group">
            <label for="Password" class="form-label">
              {{ 'customer.register.password' | t }}
            </label>
            <input
              type="password"
              name="customer[password]"
              id="Password"
              class="form-input"
              autocomplete="new-password"
              required
              placeholder="••••••••"
              minlength="5"
            >
            <span class="form-hint">Minimum 5 characters</span>
          </div>

          <div class="form-group">
            <label class="checkbox-label">
              <input type="checkbox" name="marketing_consent" value="true">
              <span>I want to receive promotional emails and updates</span>
            </label>
          </div>

          <button type="submit" class="btn btn-primary btn-full">
            {{ 'customer.register.submit' | t }}
          </button>

          <p class="terms-text">
            By creating an account, you agree to our 
            <a href="/pages/terms-of-service">Terms of Service</a> and 
            <a href="/pages/privacy-policy">Privacy Policy</a>
          </p>
        {%- endform -%}

        <div class="auth-divider">
          <span>or</span>
        </div>

        <div class="auth-footer">
          <p>Already have an account?</p>
          <a href="{{ routes.account_login_url }}" class="btn btn-outline btn-full">
            {{ 'customer.login.sign_in' | t }}
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Register",
  "settings": [],
  "presets": [
    {
      "name": "Register"
    }
  ]
}
{% endschema %}
