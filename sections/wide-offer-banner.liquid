{%- comment -%}
  Wide promotional offer banner for the homepage.
  Renders an uploaded banner image when provided, otherwise builds a themed banner.
{%- endcomment -%}

{% liquid
  assign banner_link = section.settings.link | default: routes.all_products_collection_url
  assign collection_handle = section.settings.collection | default: 'all'
  assign promo_collection = collections[collection_handle]
  if promo_collection == blank
    assign promo_collection = collections.all
  endif
%}

<section class="wide-offer-banner-section">
  <div class="container">
    <a class="wide-offer-banner" href="{{ banner_link }}" aria-label="{{ section.settings.eyebrow | escape }} {{ section.settings.heading | escape }} {{ section.settings.accent | escape }}">
      {% if section.settings.image != blank %}
        <img
          class="wide-offer-banner__image"
          src="{{ section.settings.image | image_url: width: 2400 }}"
          srcset="
            {{ section.settings.image | image_url: width: 900 }} 900w,
            {{ section.settings.image | image_url: width: 1400 }} 1400w,
            {{ section.settings.image | image_url: width: 1900 }} 1900w,
            {{ section.settings.image | image_url: width: 2400 }} 2400w
          "
          sizes="(max-width: 768px) 94vw, 1440px"
          alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          loading="lazy"
        >
      {% else %}
        <span class="wide-offer-banner__shine" aria-hidden="true"></span>
        <span class="wide-offer-banner__sticker wide-offer-banner__sticker--one" aria-hidden="true">%</span>
        <span class="wide-offer-banner__sticker wide-offer-banner__sticker--two" aria-hidden="true">%</span>
        <span class="wide-offer-banner__sticker wide-offer-banner__sticker--three" aria-hidden="true">%</span>

        <div class="wide-offer-banner__products" aria-hidden="true">
          {% for product in promo_collection.products limit: 6 %}
            {% if product.featured_image != blank %}
              <span class="wide-offer-banner__product wide-offer-banner__product--{{ forloop.index }}">
                <img
                  src="{{ product.featured_image | image_url: width: 360 }}"
                  alt="{{ product.featured_image.alt | default: product.title | escape }}"
                  width="{{ product.featured_image.width }}"
                  height="{{ product.featured_image.height }}"
                  loading="lazy"
                >
              </span>
            {% endif %}
          {% endfor %}
        </div>

        <div class="wide-offer-banner__content">
          <span class="wide-offer-banner__eyebrow">{{ section.settings.eyebrow }}</span>
          <span class="wide-offer-banner__headline">
            <span>{{ section.settings.heading }}</span>
            <strong>{{ section.settings.accent }}</strong>
          </span>
        </div>
      {% endif %}
    </a>
  </div>
</section>

<style>
  .wide-offer-banner-section {
    padding: clamp(1.25rem, 2.4vw, 2rem) 0 clamp(2.2rem, 4vw, 3.2rem);
    background: #ffffff;
  }

  .wide-offer-banner {
    position: relative;
    display: block;
    min-height: clamp(210px, 27vw, 286px);
    overflow: hidden;
    border-radius: 8px;
    color: var(--brand-text, #102F34);
    text-decoration: none;
    background:
      radial-gradient(circle at 72% 94%, rgba(var(--logo-purple-rgb), 0.2), transparent 15%),
      radial-gradient(circle at 8% 17%, rgba(var(--logo-green-rgb), 0.26), transparent 19%),
      linear-gradient(
        108deg,
        color-mix(in srgb, var(--logo-green) 28%, white) 0%,
        color-mix(in srgb, var(--logo-purple) 10%, white) 32%,
        color-mix(in srgb, var(--logo-green) 10%, white) 64%,
        #ffffff 100%
      );
    box-shadow: 0 12px 30px rgba(var(--logo-purple-rgb), 0.12);
    isolation: isolate;
  }

  .wide-offer-banner::before,
  .wide-offer-banner::after {
    content: "";
    position: absolute;
    inset: -20% auto auto -10%;
    width: 48%;
    height: 145%;
    background: linear-gradient(116deg, rgba(255, 255, 255, 0.2), rgba(255, 255, 255, 0));
    transform: rotate(18deg);
    z-index: 1;
  }

  .wide-offer-banner::after {
    inset: auto -12% -54% auto;
    width: 42%;
    height: 130%;
    transform: rotate(-24deg);
    background: radial-gradient(circle, rgba(255, 255, 255, 0.42), rgba(255, 255, 255, 0));
  }

  .wide-offer-banner__image {
    width: 100%;
    min-height: clamp(210px, 27vw, 286px);
    height: auto;
    display: block;
    object-fit: cover;
  }

  .wide-offer-banner__shine {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(130deg, transparent 0 20%, rgba(255,255,255,0.24) 20% 21.5%, transparent 21.5% 100%),
      linear-gradient(130deg, transparent 0 33%, rgba(255,255,255,0.18) 33% 34.2%, transparent 34.2% 100%);
    z-index: 1;
  }

  .wide-offer-banner__content {
    position: absolute;
    inset: 50% 10% auto;
    z-index: 4;
    display: grid;
    justify-items: center;
    gap: clamp(0.55rem, 1.2vw, 0.9rem);
    text-align: center;
    transform: translateY(-50%);
  }

  .wide-offer-banner__eyebrow {
    color: var(--brand-primary-dark, #06181B);
    font-size: clamp(1.65rem, 1.05rem + 2.4vw, 3.25rem);
    font-weight: 500;
    letter-spacing: 0.03em;
    line-height: 1;
  }

  .wide-offer-banner__headline {
    display: flex;
    align-items: baseline;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.2em;
    color: var(--logo-purple);
    font-family: var(--font-heading, "FuturaBT Bold", "Futura", "DM Sans", sans-serif);
    font-size: clamp(2.15rem, 1.35rem + 3vw, 4.55rem);
    font-weight: 900;
    letter-spacing: 0.035em;
    line-height: 0.98;
    text-transform: uppercase;
  }

  .wide-offer-banner__headline strong {
    color: var(--logo-green-dark);
    font: inherit;
  }

  .wide-offer-banner__products {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
  }

  .wide-offer-banner__product {
    position: absolute;
    display: block;
    filter: drop-shadow(0 16px 18px rgba(15, 23, 42, 0.2));
  }

  .wide-offer-banner__product img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .wide-offer-banner__product--1 {
    width: clamp(95px, 12vw, 168px);
    left: 1.4%;
    bottom: -16%;
    transform: rotate(-14deg);
  }

  .wide-offer-banner__product--2 {
    width: clamp(70px, 8vw, 118px);
    left: 8.5%;
    top: -5%;
    transform: rotate(-18deg);
  }

  .wide-offer-banner__product--3 {
    width: clamp(74px, 8.4vw, 128px);
    left: 1.5%;
    top: 24%;
    transform: rotate(-15deg);
  }

  .wide-offer-banner__product--4 {
    width: clamp(82px, 9vw, 136px);
    right: 12.5%;
    top: -3%;
    transform: rotate(13deg);
  }

  .wide-offer-banner__product--5 {
    width: clamp(110px, 13.2vw, 190px);
    right: 0.8%;
    top: 12%;
    transform: rotate(18deg);
  }

  .wide-offer-banner__product--6 {
    width: clamp(96px, 11vw, 160px);
    right: 7.8%;
    bottom: -18%;
    transform: rotate(-18deg);
  }

  .wide-offer-banner__sticker {
    position: absolute;
    z-index: 2;
    display: grid;
    place-items: center;
    width: clamp(48px, 5.6vw, 76px);
    height: clamp(48px, 5.6vw, 76px);
    color: #ffffff;
    background: var(--logo-purple);
    border-radius: 45% 55% 48% 52% / 53% 45% 55% 47%;
    font-size: clamp(1.65rem, 1rem + 1.8vw, 3rem);
    font-weight: 900;
    box-shadow: 0 10px 20px rgba(var(--logo-purple-rgb), 0.24);
  }

  .wide-offer-banner__sticker--one {
    left: 9.8%;
    top: 56%;
    transform: rotate(-10deg);
  }

  .wide-offer-banner__sticker--two {
    right: 15.5%;
    top: 17%;
    background: var(--logo-green);
    box-shadow: 0 10px 20px rgba(var(--logo-green-rgb), 0.22);
    transform: rotate(12deg);
  }

  .wide-offer-banner__sticker--three {
    right: 21%;
    bottom: -12%;
    width: clamp(72px, 8.4vw, 118px);
    height: clamp(72px, 8.4vw, 118px);
    transform: rotate(-9deg);
  }

  @media (max-width: 900px) {
    .wide-offer-banner__content {
      left: 7%;
      right: 7%;
    }

    .wide-offer-banner__product--3,
    .wide-offer-banner__product--4,
    .wide-offer-banner__product--6,
    .wide-offer-banner__sticker--three {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .wide-offer-banner {
      min-height: 230px;
    }

    .wide-offer-banner__eyebrow {
      font-size: clamp(1.35rem, 6vw, 2rem);
      line-height: 1.12;
    }

    .wide-offer-banner__headline {
      font-size: clamp(1.75rem, 9vw, 2.75rem);
    }

    .wide-offer-banner__product--1,
    .wide-offer-banner__product--2,
    .wide-offer-banner__product--5,
    .wide-offer-banner__sticker--one,
    .wide-offer-banner__sticker--two {
      opacity: 0.72;
    }
  }
</style>

{% schema %}
{
  "name": "Wide Offer Banner",
  "tag": "section",
  "class": "section-wide-offer-banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Top line",
      "default": "Unbeatable Offers Are Live Now!"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main heading",
      "default": "Buy More,"
    },
    {
      "type": "text",
      "id": "accent",
      "label": "Accent heading",
      "default": "Spend Less"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Products for floating images"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Banner link"
    }
  ],
  "presets": [
    {
      "name": "Wide Offer Banner"
    }
  ]
}
{% endschema %}
