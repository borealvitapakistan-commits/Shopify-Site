{%- comment -%}
  Compact homepage trust strip.
{%- endcomment -%}

<section class="homepage-trust-strip" id="HomepageTrustStrip-{{ section.id }}">
  <div class="container homepage-trust-strip__container">
    <div class="homepage-trust-strip__grid" aria-label="Boreal Vita trust signals">
      <article class="homepage-trust-strip__item">
        <span class="homepage-trust-strip__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
            <path d="M12 3 5 6v5c0 4.5 2.8 8.2 7 10 4.2-1.8 7-5.5 7-10V6l-7-3Z"></path>
            <path d="m8.8 12 2.1 2.1 4.3-4.5"></path>
          </svg>
        </span>
        <span class="homepage-trust-strip__copy">
          <strong>Halal Certified</strong>
          <small>All our products are Halal certified</small>
        </span>
      </article>

      <article class="homepage-trust-strip__item">
        <span class="homepage-trust-strip__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
            <path d="M19 4c-7 1-12 6-12 13"></path>
            <path d="M6 20c6-1 12-6 13-16-8 1-15 4-16 12 0 3 2 4 3 4Z"></path>
          </svg>
        </span>
        <span class="homepage-trust-strip__copy">
          <strong>Clean Ingredients</strong>
          <small>No artificial colors, flavors or fillers</small>
        </span>
      </article>

      <article class="homepage-trust-strip__item">
        <span class="homepage-trust-strip__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
            <path d="M12 3 20 7v6c0 5-3.8 8-8 9-4.2-1-8-4-8-9V7l8-4Z"></path>
            <path d="M9 12.5 11 15l5-6"></path>
          </svg>
        </span>
        <span class="homepage-trust-strip__copy">
          <strong>Quality You Can Trust</strong>
          <small>Third-party tested for purity and potency</small>
        </span>
      </article>

      <article class="homepage-trust-strip__item">
        <span class="homepage-trust-strip__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
            <path d="M3 7h11v10H3z"></path>
            <path d="M14 10h4l3 3v4h-7z"></path>
            <circle cx="7" cy="18" r="1.6"></circle>
            <circle cx="17.5" cy="18" r="1.6"></circle>
          </svg>
        </span>
        <span class="homepage-trust-strip__copy">
          <strong>Fast Delivery</strong>
          <small>Quick and reliable delivery across Pakistan</small>
        </span>
      </article>
    </div>
  </div>
</section>

<style>
  .homepage-trust-strip {
    padding: clamp(1rem, 2vw, 1.6rem) 0;
    background: #ffffff;
  }

  .homepage-trust-strip__container {
    width: min(1540px, calc(100vw - clamp(2rem, 4.2vw, 4rem)));
    max-width: 1540px;
    padding: 0;
  }

  .homepage-trust-strip__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-radius: 18px;
    background: var(--brand-primary, #0A282C);
    color: #ffffff;
    overflow: hidden;
  }

  .homepage-trust-strip__item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 0.85rem;
    min-height: 118px;
    padding: clamp(1rem, 1.6vw, 1.35rem);
  }

  .homepage-trust-strip__item + .homepage-trust-strip__item {
    border-left: 1px solid rgba(255, 255, 255, 0.18);
  }

  .homepage-trust-strip__icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 999px;
    color: #ffffff;
  }

  .homepage-trust-strip__icon svg {
    width: 26px;
    height: 26px;
  }

  .homepage-trust-strip__copy {
    display: grid;
    gap: 0.18rem;
    min-width: 0;
  }

  .homepage-trust-strip__copy strong {
    color: #ffffff;
    font-size: clamp(0.82rem, 0.86vw, 0.96rem);
    font-weight: 900;
    line-height: 1.18;
  }

  .homepage-trust-strip__copy small {
    max-width: 18rem;
    color: rgba(255, 255, 255, 0.82);
    font-size: clamp(0.72rem, 0.74vw, 0.82rem);
    font-weight: 600;
    line-height: 1.35;
  }

  @media (max-width: 989px) {
    .homepage-trust-strip__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .homepage-trust-strip__item:nth-child(3) {
      border-left: 0;
      border-top: 1px solid rgba(255, 255, 255, 0.18);
    }

    .homepage-trust-strip__item:nth-child(4) {
      border-top: 1px solid rgba(255, 255, 255, 0.18);
    }
  }

  @media (max-width: 639px) {
    .homepage-trust-strip__container {
      width: min(100%, calc(100vw - 2rem));
    }

    .homepage-trust-strip__grid {
      grid-template-columns: 1fr;
    }

    .homepage-trust-strip__item + .homepage-trust-strip__item {
      border-left: 0;
      border-top: 1px solid rgba(255, 255, 255, 0.18);
    }
  }
</style>

{% schema %}
{
  "name": "Homepage trust strip",
  "tag": "section",
  "class": "section-homepage-trust-strip",
  "presets": [
    {
      "name": "Homepage trust strip"
    }
  ]
}
{% endschema %}
