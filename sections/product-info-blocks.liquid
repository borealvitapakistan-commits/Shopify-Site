{%- comment -%}
  Product Information Blocks
  - Modular blocks powered by product metafields
{%- endcomment -%}

{% capture blocks_markup %}
  {% for block in section.blocks %}
    {% assign content = nil %}
    {% if block.settings.content_metafield != blank %}
      {% assign parts = block.settings.content_metafield | split: '.' %}
      {% assign namespace = parts[0] %}
      {% assign key = parts[1] %}
      {% if namespace != blank and key != blank %}
        {% assign content = product.metafields[namespace][key] %}
      {% endif %}
    {% endif %}
    {% if content != blank %}
      <div class="product-info__block" {{ block.shopify_attributes }}>
        {% if block.settings.heading != blank %}
          <h3 class="product-info__heading">{{ block.settings.heading }}</h3>
        {% endif %}
        <div class="rte product-info__content">
          {{ content | metafield_tag }}
        </div>
      </div>
    {% endif %}
  {% endfor %}
{% endcapture %}

{% assign blocks_clean = blocks_markup | strip %}
{% if blocks_clean != '' %}
  <section class="product-info">
    <div class="container">
      {% if section.settings.heading != blank %}
        <h2 class="product-section-heading">{{ section.settings.heading }}</h2>
      {% endif %}
      <div class="product-info__grid" style="--info-columns: {{ section.settings.columns_desktop }};">
        {{ blocks_markup }}
      </div>
    </div>
  </section>

  <style>
    .product-info {
      padding: 2.5rem 0;
      background: var(--color-muted);
    }

    .product-info__grid {
      display: grid;
      gap: 1.5rem;
      grid-template-columns: repeat(var(--info-columns, 1), minmax(0, 1fr));
    }

    .product-info__block {
      background: #fff;
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
      padding: 1.5rem;
      box-shadow: var(--shadow-sm);
    }

    .product-info__heading {
      font-size: 1.1rem;
      margin-bottom: 0.75rem;
    }

    .product-info__content {
      color: var(--color-foreground);
    }

    @media (max-width: 900px) {
      .product-info__grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
{% endif %}

{% schema %}
{
  "name": "Product info blocks",
  "tag": "section",
  "class": "section-product-info",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Product information"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    }
  ],
  "blocks": [
    {
      "type": "info_block",
      "name": "Info block",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "content_metafield",
          "label": "Content metafield (namespace.key)",
          "info": "Example: health.ingredients"
        }
      ]
    }
  ],
  "max_blocks": 6
}
{% endschema %}
