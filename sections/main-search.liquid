{%- comment -%}
  Search Results Page - Matches React design with filters
{%- endcomment -%}

<div class="main-search">
  <div class="container">
    <div class="search-shell">
      <div class="search-shell__main">
        {%- comment -%} Search Header {%- endcomment -%}
        <div class="search-header">
          <h1 class="page-title">
            {%- if search.performed -%}
              Search Results for "<span class="search-query">{{ search.terms | escape }}</span>"
            {%- else -%}
              Search
            {%- endif -%}
          </h1>

          {%- if search.performed -%}
            <p class="results-count">{{ search.results_count }} {{ search.results_count | pluralize: 'result', 'results' }}</p>
          {%- else -%}
            <p class="search-subtitle">Find supplements, ingredients, and wellness guides in seconds.</p>
          {%- endif -%}
        </div>

        {%- comment -%} Search Form {%- endcomment -%}
        <div class="search-form-wrapper">
          <form action="{{ routes.search_url }}" method="get" class="search-form" role="search">
            <div class="search-input-wrapper">
              {% render 'icon-search' %}
              <input
                type="search"
                name="q"
                value="{{ search.terms | escape }}"
                placeholder="Search for products, articles..."
                class="search-input"
                autofocus
              >
              <input type="hidden" name="type" value="product,article">
              <button type="submit" class="search-submit" aria-label="Search">
                {% render 'icon-search' %}
                <span class="visually-hidden">Search</span>
              </button>
            </div>
          </form>
        </div>

        {%- unless search.performed -%}
          <div class="search-popular" aria-label="Popular searches">
            <span class="search-popular-label">Popular searches:</span>
            <div class="suggestion-tags">
              <a href="{{ routes.search_url }}?q=vitamin" class="suggestion-tag">Vitamin</a>
              <a href="{{ routes.search_url }}?q=protein" class="suggestion-tag">Protein</a>
              <a href="{{ routes.search_url }}?q=omega" class="suggestion-tag">Omega-3</a>
              <a href="{{ routes.search_url }}?q=probiotic" class="suggestion-tag">Probiotic</a>
            </div>
          </div>
        {%- endunless -%}
      </div>
    </div>

    {%- if search.performed -%}
      {%- if search.results_count > 0 -%}
        {%- paginate search.results by section.settings.products_per_page -%}
          {%- comment -%} Filters Bar {%- endcomment -%}
          <div class="filters-bar">
            <div class="filter-tabs">
              <a href="{{ routes.search_url }}?q={{ search.terms | url_encode }}&type=product,article" 
                class="filter-tab {% unless search.types contains 'article' and search.types.size == 1 %}active{% endunless %}">
                All
              </a>
              <a href="{{ routes.search_url }}?q={{ search.terms | url_encode }}&type=product" 
                class="filter-tab {% if search.types.size == 1 and search.types contains 'product' %}active{% endif %}">
                Products
              </a>
              <a href="{{ routes.search_url }}?q={{ search.terms | url_encode }}&type=article" 
                class="filter-tab {% if search.types.size == 1 and search.types contains 'article' %}active{% endif %}">
                Articles
              </a>
            </div>

            <div class="sort-wrapper">
              <label for="SortBy" class="sort-label">Sort by:</label>
              <select id="SortBy" class="sort-select" onchange="window.location.href = this.value">
                <option value="{{ routes.search_url }}?q={{ search.terms | url_encode }}&sort_by=relevance" {% if search.sort_by == 'relevance' %}selected{% endif %}>Relevance</option>
                <option value="{{ routes.search_url }}?q={{ search.terms | url_encode }}&sort_by=price-ascending" {% if search.sort_by == 'price-ascending' %}selected{% endif %}>Price: Low to High</option>
                <option value="{{ routes.search_url }}?q={{ search.terms | url_encode }}&sort_by=price-descending" {% if search.sort_by == 'price-descending' %}selected{% endif %}>Price: High to Low</option>
                <option value="{{ routes.search_url }}?q={{ search.terms | url_encode }}&sort_by=title-ascending" {% if search.sort_by == 'title-ascending' %}selected{% endif %}>Title: A-Z</option>
              </select>
            </div>
          </div>

          {%- comment -%} Results Grid {%- endcomment -%}
          <div class="search-results-grid">
            {%- for item in search.results -%}
                {%- case item.object_type -%}
                {%- when 'product' -%}
                  {% render 'product-card-amzn',
                    product: item,
                    show_rating: section.settings.show_rating,
                    show_pricing: section.settings.show_pricing,
                    show_unit_price: section.settings.show_unit_price,
                    show_delivery: section.settings.show_delivery,
                    show_social_proof: section.settings.show_social_proof,
                    show_add_to_cart: section.settings.show_add_to_cart
                  %}
                
                {%- when 'article' -%}
                  <article class="article-card">
                    {%- if item.image -%}
                      <a href="{{ item.url }}" class="article-image">
                        <img
                          src="{{ item.image | image_url: width: 400 }}"
                          alt="{{ item.title }}"
                          width="{{ item.image.width }}"
                          height="{{ item.image.height }}"
                          loading="lazy"
                        >
                      </a>
                    {%- endif -%}
                    <div class="article-content">
                      <span class="article-type">Article</span>
                      <h3 class="article-title">
                        <a href="{{ item.url }}">{{ item.title }}</a>
                      </h3>
                      <p class="article-excerpt">{{ item.content | strip_html | truncatewords: 20 }}</p>
                      <a href="{{ item.url }}" class="read-more">
                        Read More
                        {% render 'icon-chevron-right' %}
                      </a>
                    </div>
                  </article>
              {%- endcase -%}
            {%- endfor -%}
          </div>

          {%- comment -%} Pagination {%- endcomment -%}
          {%- if paginate.pages > 1 -%}
            {% render 'pagination', paginate: paginate %}
          {%- endif -%}
        {%- endpaginate -%}
      {%- else -%}
        {%- comment -%} No Results {%- endcomment -%}
        <div class="no-results">
          {% render 'icon-search' %}
          <h2>No results found</h2>
          <p>Try different keywords or check your spelling</p>
          
          <div class="search-suggestions">
            <h3>Popular Searches</h3>
            <div class="suggestion-tags">
              <a href="{{ routes.search_url }}?q=vitamin" class="suggestion-tag">Vitamin</a>
              <a href="{{ routes.search_url }}?q=protein" class="suggestion-tag">Protein</a>
              <a href="{{ routes.search_url }}?q=omega" class="suggestion-tag">Omega-3</a>
              <a href="{{ routes.search_url }}?q=probiotic" class="suggestion-tag">Probiotic</a>
            </div>
          </div>
        </div>
      {%- endif -%}
    {%- else -%}
      {%- comment -%} Initial Search State {%- endcomment -%}
      <div class="search-initial">
        <div class="search-initial__heading">
          <h2>Popular Categories</h2>
          <p>Start with a category and quickly narrow down to your ideal formula.</p>
        </div>
        <div class="category-grid">
          {%- for collection in collections limit: 6 -%}
            {%- capture category_accent -%}{% cycle 'search-category-accent': '#0A282C', '#163E43', '#33585D', '#C89F27', '#FAD054', '#0F363B' %}{%- endcapture -%}
            <a href="{{ collection.url }}" class="category-card" style="--category-accent: {{ category_accent }};">
              <div class="category-card__media">
                {%- if collection.image -%}
                  <img
                    src="{{ collection.image | image_url: width: 240 }}"
                    alt="{{ collection.title | escape }}"
                    width="120"
                    height="120"
                    loading="lazy"
                  >
                {%- else -%}
                  <span class="category-card__badge">{{ collection.title | strip | slice: 0, 1 | upcase }}</span>
                {%- endif -%}
              </div>
              <div class="category-card__meta">
                <span class="category-card__title">{{ collection.title }}</span>
                {%- assign product_count = collection.products_count | default: collection.all_products_count -%}
                {%- if product_count > 0 -%}
                  <span class="category-card__count">{{ product_count }} {{ product_count | pluralize: 'product', 'products' }}</span>
                {%- else -%}
                  <span class="category-card__count">Shop collection</span>
                {%- endif -%}
                <span class="category-card__link">Explore</span>
              </div>
            </a>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Search",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 4,
      "max": 24,
      "step": 4,
      "default": 12,
      "label": "Products per page"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show rating",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_pricing",
      "label": "Show pricing",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_unit_price",
      "label": "Show unit price",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_delivery",
      "label": "Show delivery text",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_social_proof",
      "label": "Show social proof",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_add_to_cart",
      "label": "Show add to cart",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Search"
    }
  ]
}
{% endschema %}
