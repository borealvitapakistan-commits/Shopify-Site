{%- comment -%}
  Homepage category grid with expandable overflow categories.
{%- endcomment -%}

{% liquid
  assign eyebrow = section.settings.eyebrow | default: 'OUR BEST COLLECTION'
  assign desktop_columns = section.settings.columns | default: 6
  if section.blocks.size > 0 and section.blocks.size < desktop_columns
    assign desktop_columns = section.blocks.size
  endif
  if desktop_columns < 1
    assign desktop_columns = 1
  endif

  assign tablet_columns = desktop_columns
  if tablet_columns > 4
    assign tablet_columns = 4
  endif
  if tablet_columns < 2
    assign tablet_columns = desktop_columns
  endif

  assign mobile_columns = section.blocks.size
  if mobile_columns > 2
    assign mobile_columns = 2
  endif
  if mobile_columns < 1
    assign mobile_columns = 1
  endif

  assign initial_visible_count = section.settings.initial_visible_count | default: 5
  assign hidden_categories_count = 0
  if section.blocks.size > initial_visible_count
    assign hidden_categories_count = section.blocks.size | minus: initial_visible_count
  endif

  assign view_all_url = section.settings.view_all_link | default: routes.all_products_collection_url
  assign view_more_label = section.settings.view_more_label | default: 'View more'
  assign view_less_label = section.settings.view_less_label | default: 'View less'
  assign view_all_label = section.settings.view_all_label | default: 'View all products'
%}

<section
  id="CategoryIcons-{{ section.id }}"
  class="category-icons-section"
  data-category-icons-section
  style="
    --category-mobile-columns: {{ mobile_columns }};
    --category-tablet-columns: {{ tablet_columns }};
    --category-desktop-columns: {{ desktop_columns }};
  "
>
  <div class="container category-icons-container">
    {% if section.settings.title != blank %}
      <div class="category-icons-heading-wrap">
        {% if eyebrow != blank %}
          <p class="category-icons-eyebrow">{{ eyebrow }}</p>
        {% endif %}
        <h2 class="section-title category-icons-title">{{ section.settings.title }}</h2>
      </div>
    {% endif %}

    <div class="category-icons-grid" aria-label="{{ section.settings.title | default: 'Categories' | escape }}">
      {% for block in section.blocks %}
        {% liquid
          assign category_url = block.settings.collection.url | default: block.settings.link | default: routes.all_products_collection_url
          assign category_title = block.settings.title | default: block.settings.collection.title | default: 'Category'
          assign category_icon = block.settings.icon | default: 'general-health'
          assign category_tone = block.settings.tone | default: 'sky'
          assign is_extra = false
          if forloop.index > initial_visible_count
            assign is_extra = true
          endif
        %}
        <a
          href="{{ category_url }}"
          class="category-icon-card{% if is_extra %} is-extra{% endif %}"
          data-category-card
          style="--category-reveal-delay: {{ forloop.index0 | times: 55 }}ms;"
          {% if is_extra %}hidden{% endif %}
          {{ block.shopify_attributes }}
        >
          <span class="category-icon-card__media">
            <span class="category-icon-card__tile category-icon-card__tile--{{ category_tone }}" aria-hidden="true">
              {% case category_icon %}
                {% when 'mens-health' %}
                  <svg viewBox="0 0 80 80">
                    <circle cx="32" cy="46" r="17"/>
                    <path d="M44 34 62 16"/>
                    <path d="M47 16h15v15"/>
                  </svg>
                {% when 'womens-health' %}
                  <svg viewBox="0 0 80 80">
                    <circle cx="40" cy="27" r="17"/>
                    <path d="M40 44v25"/>
                    <path d="M28 58h24"/>
                  </svg>
                {% when 'nutri-sports' %}
                  <svg viewBox="0 0 80 80">
                    <path d="M20 27h31c5 0 9 4 9 9v24H20V27Z"/>
                    <path d="M24 27v-8h23v8"/>
                    <path d="M28 19v-5M35 19v-5M42 19v-5"/>
                    <path d="M34 42c5-5 11-5 16 0"/>
                    <path d="M55 34h10v26H55"/>
                    <path d="M61 41h7M61 50h7"/>
                  </svg>
                {% when 'gummies' %}
                  <svg viewBox="0 0 80 80">
                    <path d="M23 54c-3-9-1-25 8-34 8-8 24-6 30 6 5 10 3 26-7 33-11 7-27 4-31-5Z"/>
                    <path d="M44 26c4 5 11 6 16 2"/>
                    <path d="M22 46c8 5 19 4 26-3"/>
                    <circle cx="55" cy="34" r="4"/>
                    <circle cx="64" cy="39" r="3"/>
                  </svg>
                {% when 'multivitamins' %}
                  <svg viewBox="0 0 80 80">
                    <ellipse cx="27" cy="40" rx="9" ry="18" transform="rotate(27 27 40)"/>
                    <path d="M20 39l16 8"/>
                    <rect x="40" y="29" width="25" height="18" rx="9" transform="rotate(-42 52.5 38)"/>
                    <path d="M49 47 37 34"/>
                    <ellipse cx="39" cy="20" rx="17" ry="6"/>
                    <circle cx="57" cy="19" r="3"/>
                    <circle cx="64" cy="28" r="2"/>
                  </svg>
                {% when 'fertility-support' %}
                  <svg viewBox="0 0 80 80">
                    <path d="M40 62S18 49 18 32c0-8 6-14 14-14 4 0 7 2 10 5 3-3 6-5 10-5 8 0 14 6 14 14 0 17-26 30-26 30Z"/>
                    <path d="M31 51c-6-7-8-13-5-18"/>
                    <path d="M49 51c6-7 8-13 5-18"/>
                    <circle cx="27" cy="13" r="4"/>
                    <circle cx="54" cy="13" r="4"/>
                    <circle cx="40" cy="39" r="4"/>
                  </svg>
                {% when 'kids-teens-health' %}
                  <svg viewBox="0 0 80 80">
                    <rect x="18" y="36" width="19" height="19"/>
                    <rect x="43" y="36" width="19" height="19"/>
                    <rect x="31" y="16" width="19" height="19"/>
                    <path d="M40 22l3 7h-6l3-7Z"/>
                    <path d="M27 42l2 4 4 .5-3 3 .8 4-3.8-2-3.8 2 .8-4-3-3 4-.5 2-4Z"/>
                    <circle cx="52" cy="46" r="5"/>
                  </svg>
                {% when 'bones-joints' %}
                  <svg viewBox="0 0 80 80">
                    <path d="M22 27l35 10"/>
                    <path d="M20 36l34 9"/>
                    <path d="M27 25c1-8 9-11 14-5 4 4 1 10-4 10"/>
                    <path d="M54 37c6 2 8 8 4 13-5 6-13 2-12-5"/>
                    <path d="M42 34c6 9 5 19 0 28"/>
                    <path d="M51 47c3 6 2 12-2 17"/>
                  </svg>
                {% when 'stress-sleep' %}
                  <svg viewBox="0 0 80 80">
                    <path d="M52 16c-14 2-25 14-25 29 0 8 3 15 9 20-13-2-23-13-23-27 0-15 12-27 27-27 4 0 8 1 12 5Z"/>
                    <path d="M55 19h12l-12 14h12"/>
                    <path d="M57 40h10l-10 12h10"/>
                  </svg>
                {% when 'weight-management' %}
                  <svg viewBox="0 0 80 80">
                    <rect x="19" y="21" width="42" height="39" rx="6"/>
                    <path d="M29 36c4-8 18-8 22 0"/>
                    <path d="M40 29v8"/>
                    <circle cx="40" cy="38" r="3"/>
                    <path d="M28 48c3-5 7-7 12-7s9 2 12 7"/>
                    <path d="M28 53h24"/>
                  </svg>
                {% when 'immune-support' %}
                  <svg viewBox="0 0 80 80">
                    <path d="M40 65S19 55 19 35V20c10 0 16-4 21-9 5 5 11 9 21 9v15c0 20-21 30-21 30Z"/>
                    <path d="M40 29v20"/>
                    <path d="M30 39h20"/>
                  </svg>
                {% when 'brain-nerves' %}
                  <svg viewBox="0 0 80 80">
                    <path d="M29 56c-8 0-14-6-14-13 0-5 3-9 7-11 0-8 6-14 14-14 4 0 8 2 10 5 8-1 15 5 15 13 5 2 8 7 8 13 0 8-7 14-15 14"/>
                    <path d="M34 25c-4 2-6 6-5 11"/>
                    <path d="M47 24c4 3 5 8 3 13"/>
                    <path d="M24 44c5 2 11 1 15-3"/>
                    <path d="M44 45c5 1 9 4 11 9"/>
                    <path d="M38 55v10"/>
                    <path d="M50 55l5 9"/>
                  </svg>
                {% when 'muscle-support' %}
                  <svg viewBox="0 0 80 80">
                    <path d="M25 53c9 3 21 2 31-6"/>
                    <path d="M25 53c-6-4-7-12-2-18 4-5 10-4 12 1"/>
                    <path d="M36 36c6-13 15-19 22-17-7 5-9 10-7 16"/>
                    <path d="M34 41c4 2 7 5 9 9"/>
                    <path d="M19 58c15 7 33 5 45-6"/>
                  </svg>
                {% when 'blood-sugar-support' %}
                  <svg viewBox="0 0 80 80">
                    <rect x="24" y="16" width="22" height="29" rx="4"/>
                    <path d="M31 21h8"/>
                    <path d="M35 45v16"/>
                    <path d="M27 61h16"/>
                    <path d="M57 31c6 7 10 12 10 18 0 6-4 10-10 10s-10-4-10-10c0-6 4-11 10-18Z"/>
                  </svg>
                {% when 'heart-health' %}
                  <svg viewBox="0 0 80 80">
                    <path d="M40 61S18 47 18 31c0-8 6-14 14-14 4 0 7 2 10 6 3-4 6-6 10-6 8 0 14 6 14 14 0 16-26 30-26 30Z"/>
                    <path d="M20 40h12l5-10 7 19 5-9h11"/>
                  </svg>
                {% when 'vision-support' %}
                  <svg viewBox="0 0 80 80">
                    <path d="M11 40s11-17 29-17 29 17 29 17-11 17-29 17S11 40 11 40Z"/>
                    <circle cx="40" cy="40" r="8"/>
                    <path d="M40 18v-6"/>
                    <path d="M22 25l-4-5"/>
                    <path d="M58 25l4-5"/>
                  </svg>
                {% when 'gut-health' %}
                  <svg viewBox="0 0 80 80">
                    <path d="M28 18c-8 2-13 8-13 16 0 7 4 13 11 15"/>
                    <path d="M52 18c8 2 13 8 13 16 0 7-4 13-11 15"/>
                    <path d="M30 18v30c0 8 5 13 12 13 6 0 10-4 10-10 0-7-6-10-12-7"/>
                    <path d="M50 18v22"/>
                    <path d="M26 34h12"/>
                    <path d="M42 54c5 1 10-1 14-5"/>
                  </svg>
                {% when 'herbal-health' %}
                  <svg viewBox="0 0 80 80">
                    <path d="M40 65V37"/>
                    <path d="M40 45c-13-1-23-10-25-25 14 2 23 10 25 25Z"/>
                    <path d="M41 50c14-2 23-11 25-27-14 2-24 11-25 27Z"/>
                    <path d="M26 31c6 3 10 7 14 14"/>
                    <path d="M55 34c-6 4-10 9-14 16"/>
                  </svg>
                {% else %}
                  <svg viewBox="0 0 80 80">
                    <circle cx="40" cy="40" r="23"/>
                    <path d="M40 25v30"/>
                    <path d="M25 40h30"/>
                  </svg>
              {% endcase %}
            </span>
          </span>
          <span class="category-icon-card__label">{{ category_title }}</span>
        </a>
      {% endfor %}
    </div>

    {% if hidden_categories_count > 0 %}
      <div class="category-icons-footer">
        <button
          class="category-icons-view-all"
          type="button"
          data-category-icons-toggle
          data-view-more-label="{{ view_more_label | escape }}"
          data-view-less-label="{{ view_less_label | escape }}"
          aria-expanded="false"
        >
          {{ view_more_label }}
        </button>
      </div>
    {% elsif section.settings.show_view_all and view_all_url != blank %}
      <div class="category-icons-footer">
        <a class="category-icons-view-all" href="{{ view_all_url }}">{{ view_all_label }}</a>
      </div>
    {% endif %}
  </div>
</section>

<style>
  .category-icons-section {
    padding: clamp(2.35rem, 4.3vw, 4rem) 0 clamp(2.85rem, 4.8vw, 4.5rem);
    background: #ffffff;
  }

  .category-icons-container {
    max-width: 1320px;
  }

  .category-icons-heading-wrap {
    display: grid;
    justify-items: center;
    gap: 1rem;
    margin-bottom: clamp(1.9rem, 3vw, 2.7rem);
    text-align: center;
  }

  .category-icons-heading-line {
    display: none;
  }

  .category-icons-heading-line:last-child {
    display: none;
  }

  .category-icons-eyebrow {
    margin: 0;
    color: var(--brand-accent-dark, #C89F27);
    font-family: var(--font-heading, "FuturaBT Bold", "DM Sans", sans-serif);
    font-size: clamp(0.86rem, 1.05vw, 1.08rem);
    font-weight: 800;
    letter-spacing: 0.02em;
    line-height: 1;
    text-transform: uppercase;
  }

  .category-icons-title {
    margin: 0;
    color: var(--brand-primary, #0A282C);
    background: none;
    -webkit-background-clip: initial;
    background-clip: initial;
    font-family: var(--font-title, "FuturaBT Bold", "DM Sans", sans-serif);
    font-size: clamp(1.9rem, 3vw, 2.75rem);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.15;
    text-align: center;
    text-transform: none;
    white-space: normal;
    -webkit-text-fill-color: currentColor;
  }

  .category-icons-grid {
    display: grid;
    grid-template-columns: repeat(var(--category-mobile-columns), minmax(0, 1fr));
    gap: clamp(1.7rem, 2.8vw, 2.65rem) clamp(1rem, 2.1vw, 1.9rem);
    align-items: start;
    justify-items: center;
    justify-content: center;
    margin: 0 auto;
  }

  .category-icon-card[hidden] {
    display: none !important;
  }

  @media (min-width: 640px) {
    .category-icons-grid {
      grid-template-columns: repeat(var(--category-tablet-columns), minmax(0, 186px));
    }
  }

  @media (min-width: 1024px) {
    .category-icons-grid {
      grid-template-columns: repeat(var(--category-desktop-columns), minmax(0, 186px));
    }
  }

  .category-icon-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.82rem;
    width: 100%;
    min-width: 0;
    max-width: 186px;
    color: var(--brand-text, #102F34);
    text-decoration: none;
    opacity: 0;
    transform: translateY(22px);
    transition:
      opacity 780ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 780ms cubic-bezier(0.16, 1, 0.3, 1),
      color 280ms ease;
    transition-delay: var(--category-reveal-delay, 0ms);
    will-change: opacity, transform;
  }

  .category-icon-card.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .category-icon-card:hover,
  .category-icon-card:focus-visible {
    outline: none;
  }

  .category-icon-card__media {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 6.7rem;
    overflow: visible;
    background: transparent;
  }

  .category-icon-card__tile {
    display: grid;
    place-items: center;
    position: relative;
    overflow: hidden;
    width: clamp(6.35rem, 7.4vw, 7.55rem);
    height: clamp(3.95rem, 4.9vw, 4.8rem);
    color: var(--brand-primary, #0A282C);
    border-radius: 0.45rem;
    box-shadow: none;
    transition:
      transform 340ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 340ms ease,
      filter 340ms ease;
  }

  .category-icon-card__tile::after {
    content: '';
    position: absolute;
    inset: auto -22% -48% auto;
    width: 72%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.52) 0%, rgba(255, 255, 255, 0) 74%);
    opacity: 0;
    transform: translate3d(20%, 18%, 0) scale(0.82);
    transition:
      opacity 320ms ease,
      transform 460ms cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
  }

  .category-icon-card:hover .category-icon-card__tile,
  .category-icon-card:focus-visible .category-icon-card__tile {
    transform: translateY(-4px) scale(1.018);
    box-shadow: 0 18px 34px rgba(10, 40, 44, 0.14);
    filter: saturate(1.04);
  }

  .category-icon-card:hover .category-icon-card__tile::after,
  .category-icon-card:focus-visible .category-icon-card__tile::after {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
  }

  .category-icon-card__tile--sky { background: color-mix(in srgb, var(--brand-primary) 10%, white); }
  .category-icon-card__tile--pink { background: color-mix(in srgb, var(--brand-green) 18%, white); }
  .category-icon-card__tile--coral { background: color-mix(in srgb, var(--brand-primary) 18%, white); }
  .category-icon-card__tile--rose { background: color-mix(in srgb, var(--brand-green) 14%, white); }
  .category-icon-card__tile--aqua { background: color-mix(in srgb, var(--brand-primary) 8%, white); }
  .category-icon-card__tile--orchid { background: color-mix(in srgb, var(--brand-green) 24%, white); }
  .category-icon-card__tile--sand { background: color-mix(in srgb, var(--brand-green) 32%, white); }
  .category-icon-card__tile--lavender { background: color-mix(in srgb, var(--brand-primary) 16%, white); }
  .category-icon-card__tile--mint { background: color-mix(in srgb, var(--brand-green) 20%, white); }
  .category-icon-card__tile--teal { background: color-mix(in srgb, var(--brand-primary) 14%, white); }
  .category-icon-card__tile--salmon { background: color-mix(in srgb, var(--brand-green) 26%, white); }
  .category-icon-card__tile--gold { background: var(--brand-gold-gradient, linear-gradient(135deg, #FFF4C7 0%, #FAD054 100%)); }
  .category-icon-card__tile--leaf { background: color-mix(in srgb, var(--brand-green, #FAD054) 36%, #ffffff); }

  .category-icon-card__tile svg {
    width: clamp(3.35rem, 4.4vw, 4.25rem);
    height: clamp(3.35rem, 4.4vw, 4.25rem);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.65;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 340ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .category-icon-card:hover .category-icon-card__tile svg,
  .category-icon-card:focus-visible .category-icon-card__tile svg {
    transform: translateY(-1px) scale(1.04);
  }

  .category-icon-card__label {
    color: var(--brand-text, #102F34);
    font-family: var(--font-body, "DM Sans", sans-serif);
    font-size: clamp(0.94rem, 1.02vw, 1.06rem);
    font-weight: 700;
    line-height: 1.25;
    text-align: center;
    transition: transform 300ms ease, color 300ms ease;
  }

  .category-icon-card:hover .category-icon-card__label,
  .category-icon-card:focus-visible .category-icon-card__label {
    color: var(--brand-primary, #0A282C);
    transform: translateY(-1px);
  }

  .category-icons-footer {
    display: flex;
    justify-content: center;
    margin-top: clamp(2rem, 3vw, 2.8rem);
  }

  .category-icons-view-all {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 184px;
    min-height: 50px;
    padding: 0.9rem 1.8rem;
    border: 0;
    border-radius: 0.25rem;
    background: var(--brand-primary, #0A282C);
    color: #ffffff;
    font-family: var(--font-title, "FuturaBT Bold", "DM Sans", sans-serif);
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.06em;
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease;
  }

  .category-icons-view-all:hover,
  .category-icons-view-all:focus-visible {
    background: var(--brand-title-gradient, linear-gradient(135deg, #0A282C 0%, #163E43 100%));
    box-shadow: 0 14px 28px rgba(10, 40, 44, 0.18);
    outline: none;
    transform: translateY(-1px);
  }

  @media (max-width: 639px) {
    .category-icons-heading-wrap {
      gap: 0.72rem;
      margin-bottom: 1.6rem;
    }

    .category-icons-heading-line {
      display: none;
    }

    .category-icons-title {
      font-size: clamp(1.65rem, 8vw, 2.05rem);
      max-width: 18ch;
    }

    .category-icon-card {
      max-width: min(162px, 100%);
    }

    .category-icon-card__media {
      min-height: 6.1rem;
    }

    .category-icon-card__tile {
      width: min(100%, 6.55rem);
      height: 4rem;
    }

    .category-icons-view-all {
      width: 100%;
      max-width: 240px;
      font-size: 0.9rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .category-icon-card,
    .category-icon-card__tile,
    .category-icon-card__tile::after,
    .category-icon-card__tile svg,
    .category-icon-card__label {
      transition: none !important;
      animation: none !important;
    }

    .category-icon-card {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  (function () {
    var section = document.getElementById('CategoryIcons-{{ section.id }}');
    if (!section || section.dataset.initialized === 'true') return;

    section.dataset.initialized = 'true';
    var toggle = section.querySelector('[data-category-icons-toggle]');
    var cards = Array.prototype.slice.call(section.querySelectorAll('[data-category-card]'));
    var prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var observer = null;

    function getVisibleCards() {
      return Array.prototype.slice.call(section.querySelectorAll('[data-category-card]:not([hidden])'));
    }

    function updateRevealDelays(targetCards) {
      targetCards.forEach(function (card, index) {
        if (!card) return;
        card.style.setProperty('--category-reveal-delay', prefersReducedMotion ? '0ms' : (index * 90) + 'ms');
      });
    }

    function hideCard(card) {
      if (!card) return;
      card.classList.remove('is-visible');
    }

    function revealCard(card, restart) {
      if (!card || card.hidden) return;
      if (prefersReducedMotion) {
        card.classList.add('is-visible');
        return;
      }

      if (restart) {
        card.classList.remove('is-visible');
      }

      requestAnimationFrame(function () {
        card.classList.add('is-visible');
      });
    }

    function revealCards(targetCards, restart) {
      targetCards.forEach(function (card) {
        revealCard(card, restart);
      });
    }

    function syncVisibleCards(restart) {
      var visibleCards = getVisibleCards();
      updateRevealDelays(visibleCards);
      revealCards(visibleCards, restart);
    }

    if (prefersReducedMotion || !('IntersectionObserver' in window)) {
      syncVisibleCards(false);
    } else {
      observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          var card = entry.target;

          if (card.hidden) {
            hideCard(card);
            return;
          }

          if (entry.isIntersecting) {
            revealCard(card, false);
            return;
          }

          hideCard(card);
        });
      }, {
        threshold: 0.08,
        rootMargin: '0px 0px -8% 0px'
      });

      cards.forEach(function (card) {
        observer.observe(card);
      });
    }

    if (toggle) {
      toggle.dataset.initialized = 'true';
      toggle.addEventListener('click', function () {
        if (toggle.dataset.expanded === 'true') {
          section.querySelectorAll('.category-icon-card.is-extra:not([hidden])').forEach(function (card) {
            hideCard(card);
            card.hidden = true;
            card.setAttribute('hidden', '');
          });

          toggle.dataset.expanded = 'false';
          toggle.setAttribute('aria-expanded', 'false');
          toggle.textContent = toggle.dataset.viewMoreLabel || 'View more';
          syncVisibleCards(true);
          return;
        }

        var hiddenCards = Array.prototype.slice.call(section.querySelectorAll('.category-icon-card.is-extra[hidden]'));

        hiddenCards.forEach(function (card) {
          card.hidden = false;
          card.removeAttribute('hidden');
        });

        updateRevealDelays(getVisibleCards());
        revealCards(hiddenCards, true);

        toggle.dataset.expanded = 'true';
        toggle.setAttribute('aria-expanded', 'true');
        toggle.textContent = toggle.dataset.viewLessLabel || 'View less';
      });
    }
  })();
</script>

