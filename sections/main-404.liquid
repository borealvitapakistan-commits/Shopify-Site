{%- comment -%}
  404 Not Found Page - Matches React design
{%- endcomment -%}

{% liquid
  assign is_missing_about_page = false
  if request.path contains '/pages/about-us' or request.path contains '/pages/about'
    assign is_missing_about_page = true
  endif

  assign about_redirect_url = '/pages/contact?view=about-us'
  if pages['contact'] != blank
    assign about_redirect_url = pages['contact'].url | append: '?view=about-us'
  elsif pages['contact-us'] != blank
    assign about_redirect_url = pages['contact-us'].url | append: '?view=about-us'
  endif
%}

<script>
  (function () {
    var path = window.location.pathname.replace(/\/+$/, '');
    if (path === '/pages/about-us' || path === '/pages/about') {
      window.location.replace({{ about_redirect_url | json }});
    }
  })();
</script>

{% if is_missing_about_page %}
  <div class="main-404">
    <div class="container">
      <div class="not-found-content">
        <div class="error-icon">
          <span class="error-code">About</span>
        </div>
        <h1 class="error-title">Opening About Us</h1>
        <p class="error-message">We are taking you to the Boreal Vita About Us page.</p>

        <div class="error-actions">
          <a href="{{ about_redirect_url }}" class="btn btn-primary">
            Continue to About Us
          </a>
          <a href="{{ routes.root_url }}" class="btn btn-outline">
            Go to Homepage
          </a>
        </div>
      </div>
    </div>
  </div>

  <script>
    window.location.replace({{ about_redirect_url | json }});
  </script>
{% else %}
<div class="main-404">
  <div class="container">
    <div class="not-found-content">
      <div class="error-icon">
        <span class="error-code">404</span>
      </div>
      <h1 class="error-title">Page Not Found</h1>
      <p class="error-message">Sorry, we couldn't find the page you're looking for.</p>
      
      <div class="error-actions">
        <a href="{{ routes.root_url }}" class="btn btn-primary">
          Go to Homepage
        </a>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn-outline">
          Browse Products
        </a>
      </div>

      <div class="search-suggestion">
        <p>Or try searching:</p>
        <form action="{{ routes.search_url }}" method="get" class="search-form">
          <div class="search-input-wrapper">
            {% render 'icon-search' %}
            <input type="search" name="q" placeholder="Search products..." class="search-input">
            <button type="submit" class="btn btn-primary">Search</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{% endif %}

{% schema %}
{
  "name": "404",
  "settings": [],
  "presets": [
    {
      "name": "404"
    }
  ]
}
{% endschema %}
