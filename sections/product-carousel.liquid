  /* Product Card Carousel Styles */
  .product-card-carousel {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--color-background);
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    padding: 0.75rem;
    transition: transform 0.2s ease;
  }

  .product-card-carousel:hover {
    box-shadow: none;
    transform: translateY(-2px);
  }

  .product-card-carousel__image {
    position: relative;
    aspect-ratio: 1;
    background: #f2f2f2;
    border-radius: 14px;
    overflow: hidden;
    border: 0;
  }

  .product-card-carousel__image a {
    position: relative;
    display: block;
    height: 100%;
  }

  .product-card-carousel__image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: opacity 2.35s ease-in-out, transform 2.35s ease-in-out;
    padding: 0.25rem;
    will-change: opacity, transform;
  }

  .product-card-carousel__img--hover {
    position: absolute;
    inset: 0.35rem;
    z-index: 2;
    opacity: 0;
    object-fit: contain;
    object-position: center;
    padding: 0;
    transform: scale(1.025);
    transition: opacity 2.55s ease-in-out, transform 2.55s ease-in-out;
    transition-delay: 0.12s;
  }

  .product-card-carousel__image:hover img,
  .product-card-carousel__image:focus-within img {
    transform: scale(1.01);
  }

  .product-card-carousel__image:hover .product-card-carousel__img--primary:has(+ .product-card-carousel__img--hover),
  .product-card-carousel__image:focus-within .product-card-carousel__img--primary:has(+ .product-card-carousel__img--hover) {
    opacity: 0;
    transform: scale(0.985);
    transition-duration: 2.7s;
  }

  .product-card-carousel__image:hover .product-card-carousel__img--hover,
  .product-card-carousel__image:focus-within .product-card-carousel__img--hover {
    opacity: 1;
    transform: scale(1);
    transition-duration: 2.9s;
  }

  .product-card-carousel__badge {
    position: absolute;
    top: 10px;
    left: 10px;
    padding: 6px 10px;
    font-size: 0.7rem;
    font-weight: 700;
    border-radius: 4px;
    text-transform: uppercase;
  }

  .product-card-carousel__badge--save {
    background: var(--brand-green, #FAD054);
    color: var(--color-accent-foreground, #0A282C);
  }

  .product-card-carousel__badge--crazy {
    left: auto;
    right: 10px;
    top: 10px;
    background: var(--brand-green-gradient, var(--color-primary));
    color: var(--brand-green, #FAD054);
    width: 62px;
