{%- comment -%}
  Product Carousel Section
  Horizontal scrolling carousel with product cards including ratings and Quick Add
{%- endcomment -%}

{% assign carousel_collection = collections[section.settings.collection] %}
{% assign primary_products = blank %}
{% assign secondary_products = blank %}
{%- assign science_button_link = section.settings.science_button_link -%}
{%- assign carousel_eyebrow = section.settings.eyebrow | default: '' -%}

{%- if science_button_link == blank -%}
  {%- assign science_button_link = '/pages/about-us' -%}
  {%- if pages['about-us'] != blank -%}
    {%- assign science_button_link = pages['about-us'].url -%}
  {%- elsif pages['about'] != blank -%}
    {%- assign science_button_link = pages['about'].url -%}
  {%- elsif pages['contact'] != blank -%}
    {%- assign science_button_link = pages['contact'].url | append: '?view=about-us' -%}
  {%- elsif pages['contact-us'] != blank -%}
    {%- assign science_button_link = pages['contact-us'].url | append: '?view=about-us' -%}
  {%- endif -%}
{%- endif -%}

{% if carousel_collection != blank %}
  {% assign primary_products = carousel_collection.products %}
  {% if section.settings.products_order == 'newest' %}
    {% assign primary_products = primary_products | sort: 'published_at' | reverse %}
  {% elsif section.settings.products_order == 'oldest' %}
    {% assign primary_products = primary_products | sort: 'published_at' %}
  {% endif %}

  {% assign secondary_products = carousel_collection.products | sort: 'published_at' | reverse %}
{% endif %}

<section
  class="product-carousel-section"
  data-section-id="{{ section.id }}"
  data-carousel-collection-url="{{ carousel_collection.url | default: routes.all_products_collection_url }}"
  data-carousel-limit="{{ section.settings.products_to_show }}"
>
  <div class="container">

    {% if section.settings.header_style == 'featured_tabs' %}
      <div class="product-carousel__featured-header">
        {% if carousel_eyebrow != blank %}
          <p class="product-carousel__eyebrow">{{ carousel_eyebrow }}</p>
        {% endif %}
        <div class="product-carousel__featured-title-wrap">
          {% if section.settings.title != blank %}
            <h2 class="product-carousel__featured-title">{{ section.settings.title }}</h2>
          {% endif %}
        </div>

        <div class="product-carousel__featured-tabs" role="tablist" aria-label="Product categories">
          <button
            type="button"
            class="product-carousel__featured-tab is-active"
            data-product-carousel-tab="primary"
            id="ProductCarouselTab-{{ section.id }}-primary"
            role="tab"
            aria-selected="true"
            aria-controls="ProductCarouselPanel-{{ section.id }}-primary"
            tabindex="0"
          >
            {{ section.settings.primary_tab_label | default: 'Best Sellings' }}
          </button>
          <span class="product-carousel__featured-divider" aria-hidden="true">/</span>
          <button
            type="button"
            class="product-carousel__featured-tab"
            data-product-carousel-tab="secondary"
            id="ProductCarouselTab-{{ section.id }}-secondary"
            role="tab"
            aria-selected="false"
            aria-controls="ProductCarouselPanel-{{ section.id }}-secondary"
            tabindex="-1"
          >
            {{ section.settings.secondary_tab_label | default: 'New Arrivals' }}
          </button>
        </div>
      </div>
    {% elsif section.settings.header_style == 'centered_title' %}
      <div class="product-carousel__featured-header product-carousel__featured-header--title-only">
        {% if carousel_eyebrow != blank %}
          <p class="product-carousel__eyebrow">{{ carousel_eyebrow }}</p>
        {% endif %}
        <div class="product-carousel__featured-title-wrap">
          {% if section.settings.title != blank %}
            <h2 class="product-carousel__featured-title">{{ section.settings.title }}</h2>
          {% endif %}
        </div>
      </div>
    {% else %}
      <div class="product-carousel__header">
        <div class="product-carousel__header-copy">
          {% if carousel_eyebrow != blank %}
            <p class="product-carousel__eyebrow">{{ carousel_eyebrow }}</p>
          {% endif %}
          {% if section.settings.title != blank %}
            <h2 class="section-title">{{ section.settings.title }}</h2>
          {% endif %}
        </div>
        
        {% if section.settings.show_view_all %}
          <a href="{{ carousel_collection.url | default: '/collections/all' }}" class="product-carousel__view-all product-carousel__view-all--{{ section.settings.view_all_style | default: 'link' }}">
            {{ section.settings.view_all_label | default: 'View All' }}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        {% endif %}
      </div>
    {% endif %}

    {% if section.settings.header_style == 'featured_tabs' %}
      <div
        class="product-carousel__panel is-active"
        data-carousel-panel="primary"
        data-carousel-sort="best-selling"
        id="ProductCarouselPanel-{{ section.id }}-primary"
        role="tabpanel"
        aria-labelledby="ProductCarouselTab-{{ section.id }}-primary"
      >
        <div class="product-carousel__wrapper">
          <button type="button" class="carousel-nav carousel-nav--prev" aria-label="Previous" data-carousel-prev>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M15 18l-6-6 6-6"/>
            </svg>
          </button>
          
          <div class="product-carousel__track" data-carousel-track data-auto-marquee data-marquee-speed="0.04">
            {% for product in primary_products limit: section.settings.products_to_show %}
              <div class="product-carousel__slide">
                {% render 'product-card-amzn',
                  product: product,
                  show_rating: section.settings.show_rating,
                  show_pricing: section.settings.show_pricing,
                  show_unit_price: section.settings.show_unit_price,
                  show_delivery: section.settings.show_delivery,
                  show_social_proof: section.settings.show_social_proof,
                  show_add_to_cart: section.settings.show_add_to_cart
                %}
              </div>
            {% else %}
              <div class="product-carousel__empty">
                No products found. Add products to this collection in Shopify admin.
              </div>
            {% endfor %}
          </div>
          
          <button type="button" class="carousel-nav carousel-nav--next" aria-label="Next" data-carousel-next>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M9 18l6-6-6-6"/>
            </svg>
          </button>
        </div>
      </div>

      <div
        class="product-carousel__panel"
        data-carousel-panel="secondary"
        data-carousel-sort="created-descending"
        id="ProductCarouselPanel-{{ section.id }}-secondary"
        role="tabpanel"
        aria-labelledby="ProductCarouselTab-{{ section.id }}-secondary"
        hidden
      >
        <div class="product-carousel__wrapper">
          <button type="button" class="carousel-nav carousel-nav--prev" aria-label="Previous" data-carousel-prev>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M15 18l-6-6 6-6"/>
            </svg>
          </button>
          
          <div class="product-carousel__track" data-carousel-track data-auto-marquee data-marquee-speed="0.04">
            {% for product in secondary_products limit: section.settings.products_to_show %}
              <div class="product-carousel__slide">
                {% render 'product-card-amzn',
                  product: product,
                  show_rating: section.settings.show_rating,
                  show_pricing: section.settings.show_pricing,
                  show_unit_price: section.settings.show_unit_price,
                  show_delivery: section.settings.show_delivery,
                  show_social_proof: section.settings.show_social_proof,
                  show_add_to_cart: section.settings.show_add_to_cart
                %}
              </div>
            {% else %}
              <div class="product-carousel__empty">
                No products found. Add products to this collection in Shopify admin.
              </div>
            {% endfor %}
          </div>
          
          <button type="button" class="carousel-nav carousel-nav--next" aria-label="Next" data-carousel-next>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M9 18l6-6-6-6"/>
            </svg>
          </button>
        </div>
      </div>
    {% else %}
      <div class="product-carousel__wrapper">
        <button type="button" class="carousel-nav carousel-nav--prev" aria-label="Previous" data-carousel-prev>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M15 18l-6-6 6-6"/>
          </svg>
        </button>
        
        <div class="product-carousel__track" data-carousel-track data-auto-marquee data-marquee-speed="0.04">
          {% for product in primary_products limit: section.settings.products_to_show %}
            <div class="product-carousel__slide">
              {% render 'product-card-amzn',
                product: product,
                show_rating: section.settings.show_rating,
                show_pricing: section.settings.show_pricing,
                show_unit_price: section.settings.show_unit_price,
                show_delivery: section.settings.show_delivery,
                show_social_proof: section.settings.show_social_proof,
                show_add_to_cart: section.settings.show_add_to_cart
              %}
            </div>
          {% else %}
            <div class="product-carousel__empty">
              No products found. Add products to this collection in Shopify admin.
            </div>
          {% endfor %}
        </div>
        
        <button type="button" class="carousel-nav carousel-nav--next" aria-label="Next" data-carousel-next>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 18l6-6-6-6"/>
          </svg>
        </button>
      </div>
    {% endif %}

    {% if section.settings.show_science_banner %}
      <div class="product-carousel__science-banner">
        <div class="product-carousel__science-visual" aria-hidden="true">
          {% if section.settings.science_image != blank %}
            <img
              class="product-carousel__science-image"
              src="{{ section.settings.science_image | image_url: width: 2200 }}"
              srcset="
                {{ section.settings.science_image | image_url: width: 900 }} 900w,
                {{ section.settings.science_image | image_url: width: 1400 }} 1400w,
                {{ section.settings.science_image | image_url: width: 1800 }} 1800w,
                {{ section.settings.science_image | image_url: width: 2200 }} 2200w
              "
              sizes="(max-width: 767px) 100vw, 48vw"
              alt="{{ section.settings.science_image.alt | default: section.settings.science_heading | escape }}"
              width="{{ section.settings.science_image.width }}"
              height="{{ section.settings.science_image.height }}"
              loading="lazy"
            >
          {% else %}
            <img
              class="product-carousel__science-image"
              src="{{ 'wellness-bundles-science-doctor.jfif' | asset_url }}"
              alt="Healthcare professionals illustration"
              width="735"
              height="412"
              loading="lazy"
            >
          {% endif %}
        </div>

        <div class="product-carousel__science-content">
          {% if section.settings.science_heading != blank %}
            <h3 class="product-carousel__science-title">{{ section.settings.science_heading }}</h3>
          {% endif %}

          {% if section.settings.science_text != blank %}
            <div class="product-carousel__science-text rte">
              {{ section.settings.science_text }}
            </div>
          {% endif %}

          {% if section.settings.science_button_label != blank %}
            <a class="product-carousel__science-button" href="{{ science_button_link }}">
              {{ section.settings.science_button_label }}
            </a>
          {% endif %}
        </div>
      </div>
    {% endif %}
  </div>
</section>

<style>
  .product-carousel-section {
    padding: clamp(1.45rem, 2.8vw, 2.6rem) 0;
  }

  .product-carousel-section > .container {
    width: min(1280px, calc(100vw - clamp(2rem, 10vw, 11rem)));
    max-width: 1280px;
    padding-right: 0;
    padding-left: 0;
  }

  .product-carousel__featured-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.45rem;
    text-align: center;
  }

  .product-carousel__featured-title-wrap {
    display: block;
    width: 100%;
  }

  .product-carousel__featured-header--title-only {
    margin-bottom: 1.7rem;
  }

  .product-carousel__featured-line {
    display: none;
  }

  .product-carousel__featured-line:last-child {
    display: none;
  }

  .product-carousel__eyebrow {
    margin: 0;
    color: var(--brand-accent-dark, #C89F27);
    font-family: var(--font-heading, "FuturaBT Bold", "DM Sans", sans-serif);
    font-size: clamp(0.86rem, 1.05vw, 1.08rem);
    font-weight: 800;
    letter-spacing: 0.02em;
    line-height: 1;
    text-transform: uppercase;
  }

  .product-carousel__featured-title {
    margin: 0;
    color: var(--brand-primary, #0A282C);
    background: none;
    -webkit-background-clip: initial;
    background-clip: initial;
    font-family: var(--font-title, "FuturaBT Bold", "DM Sans", sans-serif);
    font-size: clamp(1.9rem, 3vw, 2.75rem);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.15;
    text-align: center;
    text-transform: none;
    white-space: normal;
    -webkit-text-fill-color: currentColor;
  }

  .product-carousel__featured-tabs {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: clamp(0.8rem, 1.25vw, 1.55rem);
    flex-wrap: wrap;
  }

  .product-carousel__featured-tab {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.5rem;
    padding: 0.5rem 1.15rem 0.68rem;
    border: none;
    background: transparent;
    border-radius: 0.3rem;
    color: #181419;
    font-size: clamp(0.98rem, 1.04vw, 1.12rem);
    font-weight: 800;
    letter-spacing: 0.03em;
    line-height: 1;
    text-transform: uppercase;
    cursor: pointer;
    transition: color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .product-carousel__featured-tab::after {
    content: "";
    position: absolute;
    right: 0.9rem;
    bottom: 0.18rem;
    left: 0.9rem;
    height: 3px;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--brand-accent-dark, #C89F27), var(--brand-accent, #FAD054));
    opacity: 0;
    transform: scaleX(0.45);
    transform-origin: center;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .product-carousel__featured-tab.is-active {
    background: transparent;
    color: var(--brand-primary, #0A282C);
    box-shadow: 0 0.55rem 1.1rem rgba(var(--brand-primary-rgb, 10, 40, 44), 0.08);
  }

  .product-carousel__featured-tab:hover,
  .product-carousel__featured-tab:focus-visible {
    background: transparent;
    box-shadow: 0 0.45rem 0.9rem rgba(var(--brand-primary-rgb, 10, 40, 44), 0.06);
    outline: none;
    transform: translateY(-1px);
  }

  .product-carousel__featured-tab.is-active::after,
  .product-carousel__featured-tab:hover::after,
  .product-carousel__featured-tab:focus-visible::after {
    opacity: 1;
    transform: scaleX(1);
  }

  .product-carousel__featured-divider {
    color: var(--brand-purple, #0A282C);
    font-size: 1.4rem;
    line-height: 1;
    font-weight: 700;
  }

  .product-carousel__header {
    display: grid;
    align-items: center;
    grid-template-columns: minmax(0, 1fr) auto;
    justify-content: space-between;
    margin-bottom: 1.25rem;
    gap: 1rem;
  }

  .product-carousel__header-copy {
    display: grid;
    justify-items: start;
    gap: 0.72rem;
  }

  .product-carousel__header .section-title {
    margin: 0;
    color: var(--brand-primary, #0A282C);
    background: none;
    -webkit-background-clip: initial;
    background-clip: initial;
    font-size: clamp(1.9rem, 3vw, 2.75rem);
    letter-spacing: 0;
    line-height: 1.15;
    text-transform: none;
    -webkit-text-fill-color: currentColor;
  }

  .product-carousel__view-all {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.34rem;
    min-height: 2.25rem;
    padding: 0 1rem;
    border-radius: var(--radius-pill, 999px);
    background: var(--brand-primary, #0A282C);
    color: #ffffff;
    font-size: 0.8rem;
    font-weight: 800;
    line-height: 1;
    text-decoration: none;
    transition: transform 0.2s ease, filter 0.2s ease, gap 0.2s ease;
  }

  .product-carousel__view-all:hover {
    gap: 0.48rem;
    color: #ffffff;
    filter: brightness(1.08);
    transform: translateY(-1px);
  }

  .product-carousel__view-all--button {
    background: var(--brand-primary, #0A282C);
  }

  .product-carousel__view-all--button:hover,
  .product-carousel__view-all--button:focus-visible {
    background: var(--brand-primary-dark, #06181B);
    color: #ffffff;
    outline: none;
  }

  .product-carousel__wrapper {
    position: relative;
  }

  .product-carousel__panel[hidden] {
    display: none;
  }

  .product-carousel__track {
    display: flex;
    gap: clamp(0.95rem, 1.35vw, 1.25rem);
    overflow-x: auto;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 1.15rem 0.2rem 1.15rem;
    margin: -0.45rem -0.2rem -0.7rem;
  }

  .product-carousel__track::-webkit-scrollbar {
    display: none;
  }

  .product-carousel__track[data-marquee-ready="true"] {
    scroll-snap-type: none;
  }

  .product-carousel__track[data-marquee-ready="true"] .product-carousel__slide {
    scroll-snap-align: none;
  }

  .product-carousel__slide {
    flex: 0 0 clamp(13rem, 17vw, 14.25rem);
    scroll-snap-align: start;
  }

  @media (min-width: 640px) {
    .product-carousel__slide {
      flex-basis: clamp(13.25rem, 18vw, 14.5rem);
    }
  }

  @media (min-width: 1024px) {
    .product-carousel__slide {
      flex-basis: clamp(13.75rem, 16vw, 14.75rem);
    }
  }

  .carousel-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--color-background);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    transition: all 0.2s ease;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  }

  .carousel-nav:hover {
    background: linear-gradient(135deg, var(--brand-purple-light, #163E43) 0%, var(--brand-purple, #0A282C) 100%);
    color: var(--color-primary-foreground);
    border-color: var(--brand-purple, #0A282C);
  }

  .carousel-nav:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .carousel-nav--prev {
    left: -12px;
  }

  .carousel-nav--next {
    right: -12px;
  }

  @media (max-width: 767px) {
    .product-carousel-section > .container {
      width: 100%;
      max-width: var(--site-content-max-width, var(--site-max-width, 1920px));
      padding-right: var(--site-edge-gutter, 0.9rem);
      padding-left: var(--site-edge-gutter, 0.9rem);
    }

    .product-carousel__featured-header {
      gap: 0.75rem;
      margin-bottom: 1.15rem;
    }

    .product-carousel__featured-title-wrap {
      display: block;
    }

    .product-carousel__featured-line {
      display: none;
    }

    .product-carousel__featured-title {
      font-size: clamp(1.65rem, 8vw, 2.05rem);
      max-width: 18ch;
    }

    .product-carousel__featured-tabs {
      gap: 0.65rem;
    }

    .product-carousel__featured-tab {
      min-height: 2.2rem;
      padding: 0.42rem 0.82rem;
      font-size: 0.86rem;
    }

    .product-carousel__featured-divider {
      font-size: 1.15rem;
    }

    .carousel-nav {
      display: none;
    }
  }

  .product-carousel__science-banner {
    display: grid;
    grid-template-columns: minmax(320px, 1.5fr) minmax(280px, 1fr);
    align-items: center;
    gap: clamp(1.3rem, 3vw, 3.4rem);
    margin-top: clamp(1.8rem, 3vw, 2.8rem);
    padding-top: clamp(0.2rem, 0.8vw, 0.45rem);
  }

  .product-carousel__science-visual {
    position: relative;
  }

  .product-carousel__science-visual::before,
  .product-carousel__science-visual::after {
    content: '';
    position: absolute;
    border-radius: 999px;
    background: rgba(147, 170, 216, 0.12);
    z-index: 0;
    pointer-events: none;
  }

  .product-carousel__science-visual::before {
    width: 74%;
    height: 84%;
    left: 10%;
    top: 8%;
    border-radius: 42% 58% 48% 52% / 46% 44% 56% 54%;
  }

  .product-carousel__science-visual::after {
    width: 28%;
    height: 26%;
    right: 7%;
    top: 2%;
    opacity: 0.7;
  }

  .product-carousel__science-image {
    position: relative;
    z-index: 1;
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
  }

  .product-carousel__science-content {
    display: grid;
    gap: 1rem;
    align-content: center;
    max-width: 30rem;
  }

  .product-carousel__science-title {
    margin: 0;
    color: var(--brand-primary, #0A282C);
    background: var(--brand-title-gradient, linear-gradient(135deg, #0A282C 0%, #163E43 100%));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    font-family: var(--font-title, "FuturaBT Bold", "DM Sans", sans-serif);
    font-size: clamp(1.35rem, 1rem + 1.2vw, 2rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: 0.045em;
    text-transform: uppercase;
  }

  .product-carousel__science-text {
    color: var(--brand-text, #22343A);
    font-family: var(--font-body, "DM Sans", "Segoe UI", sans-serif);
    font-size: clamp(0.96rem, 0.92rem + 0.18vw, 1.04rem);
    line-height: 1.85;
  }

  .product-carousel__science-text p {
    margin: 0;
  }

  .product-carousel__science-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.95rem;
    width: fit-content;
    padding: 0 1.45rem;
    border-radius: 0.45rem;
    background: var(--brand-green-gradient, linear-gradient(135deg, #C89F27 0%, #FAD054 100%));
    color: var(--brand-primary, #0A282C);
