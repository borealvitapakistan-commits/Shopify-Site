    border-radius: 12px;
    text-align: center;
    color: var(--color-muted-foreground);
    width: 100%;
  }
</style>

<script>
  (function() {
    const section = document.querySelector('[data-section-id="{{ section.id }}"]');
    if (!section) return;

    const wrapperStates = new Map();
    const collectionUrl = section.dataset.carouselCollectionUrl;
    const productLimit = parseInt(section.dataset.carouselLimit || '12', 10);

    const bindWrapper = (wrapper) => {
      if (!wrapper || wrapper.dataset.carouselBound === 'true') {
        return wrapperStates.get(wrapper) || null;
      }

      const track = wrapper.querySelector('[data-carousel-track]');
      const prevBtn = wrapper.querySelector('[data-carousel-prev]');
      const nextBtn = wrapper.querySelector('[data-carousel-next]');

      if (!track) {
        return null;
      }

      const getScrollAmount = () => {
        const slideWidth = track.querySelector('.product-carousel__slide')?.offsetWidth || 220;
        const trackStyles = window.getComputedStyle(track);
        const gap = parseFloat(trackStyles.columnGap || trackStyles.gap) || 16;
        return (slideWidth + gap) * 2;
      };

      const updateNavStates = () => {
        if (prevBtn) {
          prevBtn.disabled = track.scrollLeft <= 0;
        }
        if (nextBtn) {
          nextBtn.disabled = track.scrollLeft >= track.scrollWidth - track.clientWidth - 10;
        }
      };

      prevBtn?.addEventListener('click', () => {
        track.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' });
      });

      nextBtn?.addEventListener('click', () => {
        track.scrollBy({ left: getScrollAmount(), behavior: 'smooth' });
      });

      track.addEventListener('scroll', updateNavStates);
      window.addEventListener('resize', updateNavStates);

      const state = { track, updateNavStates };
      wrapper.dataset.carouselBound = 'true';
      wrapperStates.set(wrapper, state);

      window.requestAnimationFrame(updateNavStates);
      return state;
    };

    const fetchSortedPanelProducts = async (panel) => {
      if (!panel || !collectionUrl || panel.dataset.productsLoaded === 'true' || panel.dataset.productsLoading === 'true') {
        return;
      }

      const sortBy = panel.dataset.carouselSort;
      const track = panel.querySelector('[data-carousel-track]');
      if (!sortBy || !track) {
        return;
      }

      panel.dataset.productsLoading = 'true';

      try {
        const requestUrl = new URL(collectionUrl, window.location.origin);
        requestUrl.searchParams.set('sort_by', sortBy);

        const response = await fetch(requestUrl.toString(), {
          credentials: 'same-origin',
          headers: {
            'X-Requested-With': 'XMLHttpRequest'
          }
        });

        if (!response.ok) {
          throw new Error('Status ' + response.status);
        }

        const html = await response.text();
        const parser = new DOMParser();
        const doc = parser.parseFromString(html, 'text/html');
        const cards = Array.from(doc.querySelectorAll('.collection-products .products-grid > .amzn-card')).slice(0, productLimit);

        if (!cards.length) {
          throw new Error('No sorted products returned');
        }

        track.innerHTML = cards.map((card) => `<div class="product-carousel__slide">${card.outerHTML}</div>`).join('');
        track.scrollLeft = 0;

        if (window.resetAutoMarqueeTrack) {
          window.resetAutoMarqueeTrack(track);
        }

        const wrapper = panel.querySelector('.product-carousel__wrapper');
        const state = bindWrapper(wrapper);
        state?.updateNavStates();
        panel.dataset.productsLoaded = 'true';
      } catch (error) {
        console.error('Product carousel sort fetch failed:', error);
      } finally {
        delete panel.dataset.productsLoading;
      }
    };

    section.querySelectorAll('.product-carousel__wrapper').forEach((wrapper) => {
      bindWrapper(wrapper);
    });

    const tabs = Array.from(section.querySelectorAll('[data-product-carousel-tab]'));
    const panels = Array.from(section.querySelectorAll('[data-carousel-panel]'));

    if (!tabs.length || !panels.length) {
      return;
    }

    const setActivePanel = (panelName) => {
      tabs.forEach((tab) => {
        const isActive = tab.dataset.productCarouselTab === panelName;
        tab.classList.toggle('is-active', isActive);
        tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
        tab.setAttribute('tabindex', isActive ? '0' : '-1');
      });

      let activeState = null;

      panels.forEach((panel) => {
        const isActive = panel.dataset.carouselPanel === panelName;
        panel.hidden = !isActive;
        panel.classList.toggle('is-active', isActive);

        if (isActive) {
          fetchSortedPanelProducts(panel);
          const wrapper = panel.querySelector('.product-carousel__wrapper');
          activeState = bindWrapper(wrapper);
        }
      });

      if (activeState?.track) {
        activeState.track.scrollLeft = 0;
      }

      window.requestAnimationFrame(() => {
        window.dispatchEvent(new Event('resize'));
        activeState?.updateNavStates();
      });
    };

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        setActivePanel(tab.dataset.productCarouselTab);
      });
    });

    panels.forEach((panel) => {
      fetchSortedPanelProducts(panel);
    });

    setActivePanel(section.querySelector('[data-product-carousel-tab].is-active')?.dataset.productCarouselTab || 'primary');
  })();
</script>

