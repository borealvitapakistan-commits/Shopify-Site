{% layout none %}

<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_primary }}">
    <meta name="description" content="{{ 'gift_cards.issued.subtext' | t | escape }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {% if settings.favicon != blank %}
      <link rel="shortcut icon" href="{{ settings.favicon | image_url: width: 32, height: 32 }}" type="image/png">
    {% else %}
      <link rel="shortcut icon" href="{{ 'favicon-clear.png' | asset_url }}" type="image/png">
    {% endif %}

    {%- assign brand_name = 'Boreal Vita' -%}
    {%- assign formatted_initial_value = gift_card.initial_value | money_without_trailing_zeros: gift_card.currency | strip_html -%}
    <title>{{ 'gift_cards.issued.title_html' | t: value: formatted_initial_value, shop: brand_name }}</title>

    {% render 'css-variables' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>

    <style>
      .gift-card {
        min-height: 100vh;
        padding: 2rem 1rem 3rem;
        background: var(--color-muted);
        color: var(--color-foreground);
        display: grid;
        justify-items: center;
        align-content: start;
        gap: 1.5rem;
      }

      .gift-card__store-name {
        font-weight: 700;
      }

      .gift-card__container {
        width: min(100%, 36rem);
        background: var(--color-background);
        border: 1px solid var(--color-border);
        border-radius: var(--radius);
        padding: clamp(1.25rem, 4vw, 2.5rem);
        text-align: center;
        box-shadow: var(--shadow-lg);
      }

      .gift-card__title {
        font-size: clamp(1.75rem, 5vw, 2.5rem);
        margin-bottom: 1rem;
      }

      .giftcard-tag {
        display: inline-flex;
        padding: 0.35rem 0.7rem;
        border-radius: var(--radius-sm);
        background: var(--color-muted);
        color: var(--color-muted-foreground);
        font-size: 0.875rem;
        font-weight: 700;
        margin-bottom: 1rem;
      }

      .giftcard-tag--active {
        background: color-mix(in srgb, var(--color-primary) 12%, white);
        color: var(--color-primary);
      }

      .gift-card__graphic {
        margin: 1rem auto;
        border-radius: var(--radius);
        overflow: hidden;
        background: var(--color-muted);
      }

      .gift-card__graphic img {
        width: 100%;
        height: auto;
      }

      .gift-card__initial-balance {
        font-size: clamp(1.5rem, 4vw, 2rem);
        margin: 1rem 0 0.5rem;
      }

      .gift-card__remaining-balance,
      .gift-card__redeem {
        color: var(--color-muted-foreground);
        margin: 0.5rem 0 1rem;
      }

      .gift-card__code {
        display: block;
        padding: 1rem;
        border: 1px dashed var(--color-border);
        border-radius: var(--radius-sm);
        background: var(--color-muted);
        font-size: clamp(1rem, 4vw, 1.5rem);
        letter-spacing: 0.08em;
        font-weight: 700;
        word-break: break-word;
      }

      .gift-card__shopping-link,
      .print-giftcard {
        margin-top: 1rem;
      }

      #qr-code {
        display: grid;
        place-items: center;
        margin: 1.25rem auto 0;
      }

      .apple-wallet {
        display: inline-flex;
      }
    </style>

    {{ content_for_header }}
  </head>

  <body class="template-giftcard">
    <main class="gift-card {% if gift_card.expired or gift_card.enabled != true %} giftcard--disabled{% endif %}">
      <header role="banner" class="gift-card__store-name">
        <a href="{{ shop.url }}">Boreal Vita</a>
      </header>

      <section class="gift-card__container">
        <h1 class="gift-card__title">{{ 'gift_cards.issued.subtext' | t }}</h1>

        {% unless gift_card.enabled %}
          <span class="giftcard-tag">{{ 'gift_cards.issued.disabled' | t }}</span>
        {% endunless %}

        {%- assign gift_card_expiry_date = gift_card.expires_on | date: '%d/%m/%y' -%}

        {% if gift_card.expired and gift_card.enabled %}
          <span class="giftcard-tag">{{ 'gift_cards.issued.expired' | t: expiry: gift_card_expiry_date }}</span>
        {% endif %}

        {% if gift_card.expired != true and gift_card.expires_on and gift_card.enabled %}
          <span class="giftcard-tag giftcard-tag--active">
            {{ 'gift_cards.issued.active' | t: expiry: gift_card_expiry_date }}
          </span>
        {% endif %}

        <div class="gift-card__graphic">
          <img
            src="{{ 'gift-card/card.jpg' | shopify_asset_url }}"
            alt="Gift card illustration"
            width="560"
            height="373"
            loading="lazy"
          >
        </div>

        <h2 class="gift-card__initial-balance">
          {{ 'gift_cards.issued.initial_value' | t: value: formatted_initial_value }}
        </h2>

        {% assign formatted_current_balance = gift_card.balance | money %}
        {% if gift_card.balance != gift_card.initial_value %}
          <p class="gift-card__remaining-balance">
            {{ 'gift_cards.issued.remaining_html' | t: balance: formatted_current_balance }}
          </p>
        {% endif %}

        <span id="GiftCardDigits" class="gift-card__code">{{ gift_card.code | format_code }}</span>
        <p class="gift-card__redeem">{{ 'gift_cards.issued.redeem' | t }}</p>

        <a href="{{ shop.url }}" class="gift-card__shopping-link btn btn--primary" target="_blank" rel="noopener">
          {{ 'gift_cards.issued.shop_link' | t }}
        </a>

        <div id="qr-code"></div>
      </section>

      {% if gift_card.pass_url %}
        <a href="{{ gift_card.pass_url }}" class="apple-wallet" target="_blank" rel="noopener">
          <img
            class="apple-wallet-image"
            src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}"
            width="120"
            height="40"
            alt="{{ 'gift_cards.issued.add_to_apple_wallet' | t }}"
          >
        </a>
      {% endif %}

      <button type="button" class="print-giftcard btn btn--secondary" onclick="window.print();">
        {{ 'gift_cards.issued.print' | t }}
      </button>
    </main>

    <script>
      document.addEventListener('DOMContentLoaded', function() {
        if (window.QRCode) {
          new QRCode(document.getElementById('qr-code'), {
            text: {{ gift_card.qr_identifier | json }},
            width: 120,
            height: 120
          });
        }
      });
    </script>
  </body>
</html>
