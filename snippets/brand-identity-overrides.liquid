{% style %}
  body,
  input,
  textarea,
  select,
  button,
  .site-header,
  .site-footer {
    font-family: var(--font-body) !important;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6,
  .section-title,
  .header-tool-link,
  .header-language-link,
  .footer-brand__name,
  .footer-heading,
  .template-index .promo-deal__title,
  .template-index .collection-card__title,
  .template-product .product-main-buy__title,
  .template-product .product-description__heading,
  .template-product .product-info-accordions__heading,
  .template-product .product-recommendations__heading {
    font-family: var(--font-heading) !important;
    font-weight: 700 !important;
    letter-spacing: 0 !important;
  }

  .header-secondary-nav__link,
  .header-sticky-nav__link,
  .header-nav-dropdown,
  .header-nav-dropdown__catalog-group-title,
  .header-nav-dropdown__catalog-group-link,
  .header-nav-dropdown__browse-strong,
  .mobile-nav,
  .mobile-nav__rail-link,
  .mobile-nav__heading,
  .mobile-nav__title,
  .mobile-nav__sublink,
  .mobile-nav__benefit-link,
  .mobile-nav__footer-link {
    font-family: "DM Sans", ui-sans-serif, system-ui, "Segoe UI", Roboto, Helvetica, Arial, sans-serif !important;
  }

  .header-secondary-nav__link,
  .header-sticky-nav__link,
  .mobile-nav__rail-link,
  .mobile-nav__heading,
  .mobile-nav__title,
  .mobile-nav__footer-link {
    font-weight: 900 !important;
  }

  .section-title,
  .template-index .product-carousel__header .section-title,
  .template-index .category-icons-section .section-title,
  .template-index .collections-grid-section .section-title {
    color: var(--color-primary, #0A282C) !important;
    background: var(--brand-title-gradient, linear-gradient(135deg, #0A282C 0%, #163E43 100%));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    -webkit-text-stroke: 0 !important;
    text-shadow: none !important;
  }

  .ingredients,
  .ingredient,
  [data-ingredients],
  .product-description__ingredients {
    font-family: var(--font-ingredients) !important;
  }

  .rare-heading,
  [data-rare-heading] {
    font-family: var(--font-rare-heading) !important;
    font-weight: 700 !important;
    letter-spacing: 0 !important;
    text-transform: uppercase;
  }

  .price,
  .price-current,
  .price-compare,
  .amzn-card__price,
  .amzn-card__compare,
  .amzn-card__unit,
  .product-main-buy__price,
  .product-main-buy__compare,
  .product-main-buy__mobile-price,
  .cart-line__price,
  .cart-line__total,
  .cart-summary__total,
  .contact-item__address,
  .footer-payment,
  .payment-label {
    font-family: var(--font-price-address) !important;
    font-weight: 700 !important;
  }

  .btn--primary,
  .btn-primary {
    background: var(--brand-title-gradient, linear-gradient(135deg, #0A282C 0%, #163E43 100%)) !important;
    color: #ffffff !important;
    min-height: 48px !important;
    border-radius: var(--radius-pill, 999px) !important;
  }

  .btn--primary:hover,
  .btn-primary:hover {
    filter: brightness(1.12) !important;
    background: var(--brand-title-gradient, linear-gradient(135deg, #0A282C 0%, #163E43 100%)) !important;
  }

  .template-index .amzn-card__stars {
    --star-fill: var(--brand-accent, #FAD054) !important;
  }

  .template-index .shop-by-concern__heading,
  .template-index .category-icons-title,
  .template-index .product-carousel__featured-title,
  .template-index .product-carousel__header .section-title,
  .template-index .deals-picked__title,
  .template-index .homepage-blogs__title,
  .template-index .personalized-vitamin-banner__title,
  .template-index .balance-wellness__title {
    color: var(--brand-primary, #0A282C) !important;
    background: none !important;
    -webkit-background-clip: initial !important;
    background-clip: initial !important;
    -webkit-text-fill-color: currentColor !important;
    text-transform: none !important;
    letter-spacing: 0 !important;
  }
{% endstyle %}
