{% style %}
  @font-face {
    font-family: "DM Sans";
    font-style: normal;
    font-weight: 400 800;
    font-display: swap;
    src: url({{ 'dm-sans-latin.woff2' | asset_url }}) format("woff2");
  }

  @font-face {
    font-family: "Boreal Heading Fallback";
    font-style: normal;
    font-weight: 400 800;
    font-display: swap;
    src: url({{ 'montserrat-latin.woff2' | asset_url }}) format("woff2");
  }

  @font-face {
    font-family: "Boreal Accent Fallback";
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url({{ 'bebas-neue-latin.woff2' | asset_url }}) format("woff2");
  }
{% endstyle %}
