{%- comment -%}
  Simple Product Card for Deals Section
  Usage: {% render 'product-card-deals', product: product %}
{%- endcomment -%}

<div class="deals-card">
  <a href="{{ product.url }}" class="deals-card__media">
    {% if product.featured_media %}
      <img
        src="{{ product.featured_media | image_url: width: 500 }}"
        srcset="
          {{ product.featured_media | image_url: width: 300 }} 300w,
          {{ product.featured_media | image_url: width: 500 }} 500w
        "
        sizes="(min-width: 1200px) 18vw, (min-width: 768px) 25vw, 50vw"
        alt="{{ product.featured_media.alt | escape | default: product.title }}"
        loading="lazy"
        width="500"
        height="500"
      >
    {% else %}
      {{ 'product-1' | placeholder_svg_tag: 'deals-card__placeholder' }}
    {% endif %}

    {% if product.compare_at_price > product.price %}
      {% assign savings = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round %}
      <span class="deals-card__badge">Save {{ savings }}%</span>
    {% endif %}
  </a>

  <div class="deals-card__content">
    <h3 class="deals-card__title">
      <a href="{{ product.url }}">{{ product.title }}</a>
    </h3>

    <div class="deals-card__price">
      <span class="price-current">{{ product.price | money }}</span>
      {% if product.compare_at_price > product.price %}
        <span class="price-compare">{{ product.compare_at_price | money }}</span>
      {% endif %}
    </div>
  </div>
</div>

<style>
  .deals-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 390px;
    overflow: visible;
    background: #ffffff;
    border: 0;
    border-radius: 18px;
    box-shadow: none;
    transition: border-color 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease;
  }

  .deals-card:hover,
  .deals-card:focus-within {
    box-shadow: none;
    transform: translateY(-2px);
  }

  .deals-card__media {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1 / 1;
    min-height: 0;
    padding: clamp(0.65rem, 1.05vw, 1rem);
    background: #f2f2f2;
    border: 0;
    border-radius: 18px;
    overflow: hidden;
    margin: clamp(0.65rem, 1.05vw, 1rem);
  }

  .deals-card__media img {
    display: block;
    width: auto;
    max-width: 90%;
    height: 90%;
    object-fit: contain;
    background: transparent;
    filter: none;
    transition: transform 0.22s ease;
  }

  .deals-card:hover .deals-card__media img,
  .deals-card:focus-within .deals-card__media img {
    transform: scale(1.035);
  }

  .deals-card__placeholder {
    width: min(100%, 90%);
    height: 90%;
    border-radius: 14px;
    background: rgba(var(--brand-purple-rgb, 10, 40, 44), 0.06);
  }

  .deals-card__badge {
    position: absolute;
    top: 0.45rem;
    left: 0.45rem;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    min-height: 1.58rem;
    padding: 0 0.48rem;
    border-radius: 999px;
    background: var(--brand-green-gradient, linear-gradient(135deg, #C89F27 0%, #FAD054 100%));
    color: #1a2404;
    font-size: 0.76rem;
    font-weight: 800;
    line-height: 1;
    text-transform: uppercase;
    pointer-events: none;
  }

  .deals-card__content {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: clamp(0.65rem, 1.05vw, 1rem);
    flex: 1;
  }

  .deals-card__title {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.3;
    color: #1b171b;
  }

  .deals-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .deals-card__title a:hover {
    color: var(--brand-purple, #0A282C);
  }

  .deals-card__price {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-top: auto;
  }

  .deals-card__price .price-current {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--brand-purple-dark, #06181B);
    font-family: var(--font-price-address, "DM Sans", sans-serif);
  }

  .deals-card__price .price-compare {
    font-size: 0.9rem;
    color: var(--color-muted-foreground);
    text-decoration: line-through;
    font-family: var(--font-price-address, "DM Sans", sans-serif);
  }
</style>
