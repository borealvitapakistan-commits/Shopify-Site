{% liquid
  assign topic_key = topic_title | default: '' | downcase
  assign topic_icon = 'supplement'

  if topic_key contains 'hair' or topic_key contains 'skin' or topic_key contains 'acne' or topic_key contains 'dark spots' or topic_key contains 'photo-aging' or topic_key contains 'saggy' or topic_key contains 'shiny'
    assign topic_icon = 'beauty'
  elsif topic_key contains 'sleep' or topic_key contains 'insomnia' or topic_key contains 'anxiety' or topic_key contains 'stress'
    assign topic_icon = 'sleep'
  elsif topic_key contains 'brain' or topic_key contains 'migraine' or topic_key contains 'numbness'
    assign topic_icon = 'brain'
  elsif topic_key contains 'gut' or topic_key contains 'digestive' or topic_key contains 'constipation' or topic_key contains 'acidity' or topic_key contains 'cravings' or topic_key contains 'metabolism'
    assign topic_icon = 'gut'
  elsif topic_key contains 'heart' or topic_key contains 'blood pressure' or topic_key contains 'cholesterol'
    assign topic_icon = 'heart'
  elsif topic_key contains 'fertility' or topic_key contains 'pcos' or topic_key contains 'motherhood' or topic_key contains 'uti' or topic_key contains 'kids' or topic_key contains 'teens'
    assign topic_icon = 'fertility'
  elsif topic_key contains 'male' or topic_key contains 'prostate' or topic_key contains 'testosterone' or topic_key contains 'erectile'
    assign topic_icon = 'male'
  elsif topic_key contains 'eye' or topic_key contains 'eyesight'
    assign topic_icon = 'eye'
  elsif topic_key contains 'muscle' or topic_key contains 'joint' or topic_key contains 'bones' or topic_key contains 'workout' or topic_key contains 'gout'
    assign topic_icon = 'muscle'
  elsif topic_key contains 'cold' or topic_key contains 'flu' or topic_key contains 'immunity' or topic_key contains 'immune' or topic_key contains 'sore throat'
    assign topic_icon = 'shield'
  endif
%}

